__pycache__/
*.py[cod]

# Local settings (secrets)
.env

# Harvest logs and backfill progress markers
logs/
.claude/

# macOS Finder metadata
.DS_Store

# Editor swap/backup files (may contain .env secrets)
*.swp
*.swo
*~

# Derived database and releases (rebuild with `umdb db build` / `umdb release`)
data/umdb.sqlite
data/umdb.sqlite.*
dist/

# Harvested catalog: stored in GitHub Release assets (umdb catalog push/pull), not git
data/srr_catalog_*.jsonl
data/cache/*.json
data/seen_*.txt
data/.catalog-state.json
# GeoNames gazetteer (downloaded by `umdb geo fetch`; shipped in the catalog bundle)
data/reference/

# Nextflow research pipeline (pipeline/): work directories, run logs, results, conda cache
pipeline/work/
work/
.nextflow/
.nextflow.log*
results/
results-*/
pipeline/.conda/
