# UMDB harvester settings.
# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# Loaded automatically when the harvester runs from the repo root.
# Variables already exported in your shell (or set as CI secrets) take precedence.

# NCBI E-utilities. An API key raises the rate limit from 3 to 10 requests/second.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=umdb-srr-harvester

# Optional: request pacing. NCBI's limit is per key (10/s with a key, 3/s without).
# Lower UMDB_NCBI_RPS if two harvests share one key.
# UMDB_NCBI_RPS=8
# UMDB_NCBI_WORKERS=6

# Optional: AI-assisted curation (--ai-curate / curate-ai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: extra trusted root certificate(s), PEM, for networks that inspect HTTPS.
# UMDB_CA_BUNDLE=/path/to/organisation-root.pem
