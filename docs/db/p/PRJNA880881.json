{"v":"3.0.0","project":{"accession":"PRJNA880881","title":"Escherichia coli Genome sequencing","description":"This multicentre study, conducted in Brazil, Cameroon and Madagascar, aims to assess the impact of the COVID-19 pandemic on the spread of antimicrobial and biocide resistance in the environment, particularly in wastewater from health facilities receiving COVID-19 patients, municipal wastewater and slums. Whole genome culture and sequencing will allow the assessment of bacteria (diversity and relative abundance) and antimicrobial/biocide resistance genes respectively. Phylogenetic relationships between the isolated strains will be investigated using MLST and single nucleotide polymorphisms. This study will provide timely information on the potential risk of AMR spread in the downstream ecology during the Covid-19 pandemic and its consequences on public health.","organism":null,"data_type":"Genome sequencing and assembly","center_name":"Centre pasteur du Cameroun","submission_date":"2022/09/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38731087","Control water sample 1","2022-01-24","Brazil","São Paulo","São Paulo",null,null,"probable_urban","water_drainage","urban context stated at BioProject level only",null,"Lake biome","Sport center","Lake water",null,"country","BR",3448439,"probable","text","region's main city","Brazil: Sao Paulo, Raia da USP",2022],["SAMN38731088","Control water sample 2","2022-02-08","Brazil","São Paulo","São Paulo",null,null,"probable_urban","water_drainage","urban context stated at BioProject level only",null,"Lake biome","Sport center","Lake water",null,"country","BR",3448439,"probable","