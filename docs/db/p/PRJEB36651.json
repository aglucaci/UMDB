{"v":"3.0.0","project":{"accession":"PRJEB36651","title":"Community composition of various biosolids obtained from german wastewater treatment plants.","description":"Soil fertilization with biosolids from wastewater treatment plants (WWTPs) inherits the risk of disseminating resistance genes (RGs), mobile genetic elements (MGEs) and potentially selective pollutants (antibiotics [ABs], heavy metals, biocides) into soil. However, only few data are available on the parallel analysis of biosolid pollutant contents and RG/MGE abundances. In present study, total community (TC)-DNA of biosolids from 12 WWTPs (one large-scale and 11 small-/middle-scale) was analyzed for the abundance of RGs and MGEs via quantitative real-time PCR or PCR-Southern blot hybridization and concentrations of heavy metals, ABs and the biocides triclosan (TCS), triclocarban (TCC) and quaternary ammonium compounds were determined, together with prokaryotic community.","organism":null,"data_type":"Other","center_name":"DTU Bioengineering","submission_date":"2020/05/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA6529085","WWTP_AIII-1","2018","Germany",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2018],["SAMEA6529086","WWTP_AIII-2","2018","Germany",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2018],["SAMEA6529087","WWTP_AIII-3","2019","Germany",null,null,null,null,"probable_urban