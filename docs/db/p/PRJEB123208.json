{"v":"3.0.0","project":{"accession":"PRJEB123208","title":"16S rRNA gene amplicon sequencing of granular sludge microbial communities during mature landfill leachate treatment under different biodegradable COD/TN ratios","description":"This study characterized changes in the microbial community of a granular sludge reactor treating mature landfill leachate across five operational stages with different biodegradable chemical oxygen demand-to-total nitrogen ratios. Granular sludge samples were collected from the reactor during stages S1-S5. The V4 region of the 16S rRNA gene was analyzed using paired-end Illumina amplicon sequencing. These data support the investigation of microbial community succession associated with dissolved organic nitrogen removal and nitrogen transformation during reactor operation.","organism":null,"data_type":"Other","center_name":"University of Alberta","submission_date":"2026/08/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA123276203","Granular sludge microbial community sample S1R3","2023-06-30","Canada",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","CA",null,"unresolved",null,null,"Canada",2023],["SAMEA123276204","Granular sludge microbial community sample S2R3","2023-08-08","Canada",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","CA",null,"unresolved",null,null,"Canada",2023],["SAMEA123276205","Granular sludge microbial community sample S3R3","2023-09-22","Canada",null,null,null,null,"confirmed_urban","mun