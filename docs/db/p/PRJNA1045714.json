{"v":"3.0.0","project":{"accession":"PRJNA1045714","title":"XQ-20231007-00089_A-20231024-00432","description":"Anaerobic ammonia oxidation granular sludge (AnGS) stands out as a highly promising technology for wastewater treatment. However, in the realm of municipal and industrial wastewater treatment facilities, where diverse nanoplastic pollutants such as polyethylene, polystyrene, and polypropylene abound, the specific impact of one of the most prevalent plastics, polystyrene nanoplastics (PS-NPs), remains underexplored. Consequently, our study aimed to meticulously assess the effects of 100 nm-sized PS-NPs at varying concentrations (0.1, 0.5, and 2 mg L-1) on the performance of the mainstream anammox reactors.","organism":null,"data_type":"Raw sequence reads","center_name":"Hangzhou Normal University","submission_date":"2023/11/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38453668","P01","2023-07-24",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,"Sludge","unknown",null,null,"unresolved",null,null,null,2023],["SAMN38453669","P11","2023-07-25",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,"Sludge","unknown",null,null,"unresolved",null,null,null,2023],["SAMN38453670","P21","2023-07-26",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,"Sludge","unknown",null,null,"unresolved",null,null,null,2023],["SAMN38453671","P31","2023-07-27",null,null,null,null,null,"non_urban",null,"BioProject indicates an ag