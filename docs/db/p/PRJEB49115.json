{"v":"3.0.0","project":{"accession":"PRJEB49115","title":"New operational strategies to overcome technical barriers in anaerobic digestion and extend its fields of application by using meta-omic approaches","description":"The anaerobic digestion of sewage sludge is generally performed under mesophilic (30 – 40 C) or thermophilic (50 – 70 °C) conditions which implies the use of a significant amount of energy input to maintain the performances of the digester. The operation of anaerobic digestion of sewage sludge at low temperatures (between 30 °C and 25 oC) would lead to a reduction of the amount of energy required to heat the bioreactor.   Nevertheless, it has also been reported that a decrease in temperature below 30 °C impairs the methane yield of mesophilic digesters, probably because the microbial community structure is affected. To evaluate the effect of temperature on microbial communities, the present study shows the results of the application of low temperature anaerobic digestion at full-scale.","organism":null,"data_type":"Other","center_name":"INRAE","submission_date":"2021/12/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA11459469","Metagenome-Assembled Genome (MAG)",null,"Germany",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","human gut",null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",null],["SAMEA11459470","Metagenome-Assembled Genome (MAG)",null,"Germany",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","human gut",null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",null]