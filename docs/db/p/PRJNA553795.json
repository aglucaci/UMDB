{"v":"3.0.0","project":{"accession":"PRJNA553795","title":"High throughput 16S rRNA gene amplicon sequencing of three on-site wastewater treatment systems","description":"The bacterial community of three on-site wastewater treatment systems (OWTS) was characterized by 16S gene amplicon high throughput sequencing (2x300bp Illumina). Sampling times were January, February, April, July, November 2016. Samples collected from raw wastewater influent, septic tank effluent, partially treated wastewater, and treated wastewater. Sequences were used to determine similarities/differences between the three system. This constitutes the first description of OWTS microbial communities to this breadth and precision.","organism":null,"data_type":"Raw sequence reads","center_name":"Center for Clean Water Technology","submission_date":"2019/07/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN12250292","1X1","2016-01-13","United States","Massachusetts","Mashpee",41.642644,-70.543169,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","System X, Port 1","wastewater treatment plant [ENVO:00002043]","sewage [ENVO:00002018]",null,null,"coordinate","US",4943297,"probable","coordinates",null,"USA: Massachuettes",2016],["SAMN12250293","1X2","2016-01-13","United States","Massachusetts","Mashpee",41.642644,-70.543169,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","System X, Port 2","wastewater treatment plant [ENVO:00002043]","sewage [ENVO:00002018]",null,null,"coordinate","US",4943297,"probable","coordinates",null,"USA: Massachuettes",2016],["SAMN12250294","1X3","2016-01-13","Unit