{"v":"3.0.0","project":{"accession":"PRJNA1209223","title":"Comparison of Microbial Communities in SBRC and SBRH1 Sewage Treatment Processes at Different Time Points (1, 5, 14 days)","description":"This project aims to investigate the microbial diversity and community structure in the sludge-water mixtures of two sewage treatment systems, namely the control group SBRC (conventional SBR device) and the experimental group SBRH1 (SBR device with the addition of Corynebacterium xerosis). Samples were collected from both systems at three distinct time points: 1 day, 5 days, and 14 days. The study will utilize 16S rRNA sequencing to analyze the microbial communities, with the goal of understanding the impact of the added Corynebacterium xerosis on the microbial ecology and potential functional changes in the sewage treatment process. Insights gained from this research could provide valuable information for optimizing sewage treatment efficiency and understanding microbial interactions in such systems.","organism":null,"data_type":"Raw sequence reads","center_name":"Jilin Agricultural University","submission_date":"2025/01/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46209984","Metagenome or environmental sample from wastewater metagenome","2023-05","China","Jilin","Changchun",43.81,125.408,"uncertain",null,"conflicting evidence: environmental and host/clinical","in the SBR used for treating swine wastewater",null,null,null,"mud-water mixture","coordinate","CN",2038180,"verified","text+coordinates",null,"China:Changchun",2023],["SAMN46209985","Metagenome or environmental sample from wastewater metagenome","2023-05","China","Ji