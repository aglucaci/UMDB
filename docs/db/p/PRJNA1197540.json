{"v":"3.0.0","project":{"accession":"PRJNA1197540","title":"Dual role of carbon monoxide in medium-chain fatty acids production from food waste","description":"The study assessed the influence of carbon monoxide supplementation on the bacterial and archaeal community of a microbiome producing medium-chain fatty acids from food waste. The microbiome was originally derived from a municipal wastewater treatment plant in Finland. The impact of carbon monoxide was compared with other methanogenic inhibiting strategies, including 2-bromoethanesulfonate supplementation and thermal treatment at 100 degree Celsius.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Naples Federico II","submission_date":"2024/12/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46122714","MIMARKS Survey related sample from wastewater metagenome","2023-10-02","Finland","Pirkanmaa","Tampere",61.4991,23.7871,"non_environmental",null,"laboratory or culture material",null,"Wastewater","Anaerobic bioreactor","food waste fermentation broth",null,"coordinate","FI",634963,"verified","text+coordinates",null,"Finland: Tampere",2023],["SAMN46122715","MIMARKS Survey related sample from wastewater metagenome","2023-10-02","Finland","Pirkanmaa","Tampere",61.4991,23.7871,"non_environmental",null,"laboratory or culture material",null,"Wastewater","Anaerobic bioreactor","food waste fermentation broth",null,"coordinate","FI",634963,"verified","text+coordinates",null,"Finland: Tampere",2023],["SAMN46122716","MIMARKS Survey related sample from wastewater metagenome","2023-10-02","Finland","Pirkanmaa","Tampere",61.4991,23.7871,"non_environmental