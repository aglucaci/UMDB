{"v":"3.0.0","project":{"accession":"PRJNA390537","title":"Effect of Hydraulic Retention Time on Microbial Community Structure in Wastewater Treatment Electro-Bioreactors","description":"The impact of hydraulic retention time (HRT) on the performance and microbial community structure of control and electro-bioreactors was investigated. Control bioreactors and electro-bioreactors were operated at HRT ranging between 6 and 75 h. The total bacterial counts in addition to the removal efficiency of NH4+-N, sCOD, and PO43--P was assessed in all the reactors tested. In addition, Illumina sequencing was performed to determine the microbial communities that developed in these reactors under each HRT condition. Phylogenetic analysis showed that Proteobacteria and Bacteroidetes were the dominant phyla in those reactors. In addition, Nitrospira sp. and Pseudomonas sp. were found to be present in electro-bioreactors with higher relative abundance than in control bioreactors. The results presented here are the first to determine what different microbial communities in wastewater electro-bioreactors due to the application of an electric current under different HRTs.","organism":null,"data_type":"Raw sequence reads","center_name":"Masdar Institute of Science and Technology","submission_date":"2017/06/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN07237531","Control HRT 6 replica 1","2016-02","United Arab Emirates","Abu Dhabi","Abu Dhabi",24.4335,54.6177,"uncertain",null,"environmental sample; urban association not established","lab scale waste water treatment batch reactor HRT=6 Replica 1",null,null,null,null,"coordinate","AE",292968,"pr