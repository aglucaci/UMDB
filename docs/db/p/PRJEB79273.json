{"v":"3.0.0","project":{"accession":"PRJEB79273","title":"Urban sewage metagenomic analysis of Latvian Cities","description":"This study investigates the resistome in wastewater from 15 Latvian cities to assess the landscape of antibiotic resistance genes (ARGs). Utilizing next-generation sequencing and metagenomic analysis, untreated wastewater samples were collected between August and November 2020. The samples were analyzed to identify microbial communities and ARGs, with a focus on the influence of urban and industrial environments. Findings in this study revealed significant variations in the resistome across different municipalities, highlighting the prevalence of clinically relevant ARGs. This study provides a comprehensive overview of the antibiotic resistance landscape in Latvia, offering valuable insights for public health strategies and wastewater management practices.","organism":null,"data_type":"Other","center_name":"Latvian Biomedical Research and Study Centre","submission_date":"2025/03/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA115942724","Jelgava.1","2020-09-04","Latvia",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","LV",null,"unresolved",null,null,"Latvia",2020],["SAMEA115942725","Jelgava.2","2020-09-11","Latvia",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","LV",null,"unresolved",null,null,"Latvia",2020],["SAMEA115942726","Jelgava.3","2020-09-18","Latvia",null,null,null,null,"probable_urban","municipal_wast