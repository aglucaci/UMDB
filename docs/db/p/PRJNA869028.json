{"v":"3.0.0","project":{"accession":"PRJNA869028","title":"Study of microbiome of Ixodes ricinus ticks collected in Moscow","description":"Ixodes ricinus ticks were collected in August 2020 in Serebryannyi Bor city park in Moscow, Russia. The collected ticks were identified using a taxonomic keys. For shotgun analysis of microbiome a pool of adult female ticks (10 individuals) was used; ticks were dissected to collect guts or salivary glands for subsequent DNA isolation using a QIAamp DNA Microbiome kit.","organism":null,"data_type":"Genome sequencing and assembly","center_name":"Federal Research and Clinical Centre of Physical-Chemical Medicine","submission_date":"2022/08/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN30280417","Metagenome or environmental sample from tick metagenome","2020-08","Russia","Moscow","Moscow",55.780972,37.422833,"uncertain",null,"conflicting evidence: environmental and host/clinical","salivary glands of 10 female ticks",null,null,null,"Ixodes ricinus","coordinate","RU",524901,"verified","text+coordinates",null,"Russia: Moscow, Serebryannyi Bor city park",2020],["SAMN30280418","Metagenome or environmental sample from tick metagenome","2020-08","Russia","Moscow","Moscow",55.780972,37.422833,"uncertain",null,"conflicting evidence: environmental and host/clinical","guts of 10 female ticks",null,null,null,"Ixodes ricinus","coordinate","RU",524901,"verified","text+coordinates",null,"Russia: Moscow, Serebryannyi Bor city park",2020]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","rele