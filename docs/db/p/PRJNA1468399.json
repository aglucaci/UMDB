{"v":"3.0.0","project":{"accession":"PRJNA1468399","title":"Intermittent versus continuous ultra-low aeration in low-strength wastewater: Selective regulation of microbial structure and functional potential","description":"Transitioning wastewater treatment toward carbon neutrality necessitates low-oxygen aeration, yet the ecological consequences of different oxygen-restricting strategies on nitrifying communities remain poorly understood. Given that continuous and intermittent aeration impose distinct ecological selection pressures, their differential impacts on the adaptation and succession of ammonia-oxidizing bacteria (AOB) and nitrite-oxidizing bacteria (NOB) are unclear. This study systematically compared intermittent aeration and continuous ultra-low aeration in sequencing batch reactors. Intermittent aeration successfully achieved partial nitrification, strategically engineering oxygen pulse patterns likely provides a more effective selective strategy for advancing carbon-neutral wastewater treatment.","organism":null,"data_type":"Raw sequence reads","center_name":"GUangzhou university","submission_date":"2026/05/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60279508","Metagenome or environmental sample from sludge metagenome","2023-11-14","China","Guangdong","Guangzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge",null,null,null,null,"city","CN",1809858,"verified","text",null,"China: Guangzhou",2023],["SAMN60279509","Metagenome or environmental sample from sludge metagenome","2023-11-30","China","Guangdong","Guangzhou",null,null,"probable_urban