{"v":"3.0.0","project":{"accession":"PRJNA1282399","title":"Sewage sludge from anaerobic digesters treating aqeous pyrolytic lliquid produced from digested slduge Targeted loci environmental","description":"This study assessed the feasibility of circularly integrating anaerobic digestion (AD) and pyrolysis for sewage sludge treatment by utilizing existing AD infrastructure to valorize the aqueous phase of pyrolysis liquid (APL) produced from the pyrolysis of digested sludge (DS). APLs were prepared from DS at three pyrolysis temperatures: 350C, 500C, and 650C. Batch co-AD experiments were conducted to evaluate the inhibitory effects of APLs on methane production. Based on the results, the most and the least inhibitory APLs were selected for long-term continuous co-AD, aiming to enhance microbial adaptation and APL conversion. Changes in the microbial community during co-AD were analyzed to identify beneficial strains. This study might provide a practical approach for integrating DS-derived APL management into existing AD systems, thereby improving resource and energy recovery while minimizing environmental impacts.","organism":"sludge metagenome","data_type":"Targeted loci environmental","center_name":"Kyoto University","submission_date":"2025/06/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49649576","Inoculum","2024-06-18","Japan","Kyoto","Kyoto",35.0116,135.7681,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater treatment","anaerobic digester treating sewage sludge","sludge",null,"coordinate","JP",1857910,"verified","text+coordinates",null,"Japan: Kyoto",202