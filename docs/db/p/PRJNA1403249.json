{"v":"3.0.0","project":{"accession":"PRJNA1403249","title":"Metagenomic analysis of microbial community response to simulated domestic sewage input in the Qiantang River Estuary","description":"This study investigates how domestic sewage discharge affects the carbon cycle in estuarine ecosystems, using the Qiantang River Estuary as a model system. We conducted a laboratory microcosm experiment simulating sewage input, through integrated multi-omics approaches including 16S rRNA gene sequencing, metagenomics, and metatranscriptomics, we tracked the dynamic responses of the aquatic microbial community over a 28-day incubation.","organism":null,"data_type":"Raw sequence reads","center_name":"Zhejiang Sci-Tech University","submission_date":"2026/01/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54623400","Metagenome or environmental sample from bioreactor metagenome","2025-06-17",null,null,null,null,null,"non_environmental",null,"laboratory or culture material","water from the Qiantang River was supplemented with domestic sewage",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN54623401","Metagenome or environmental sample from bioreactor metagenome","2025-06-17",null,null,null,null,null,"non_environmental",null,"laboratory or culture material","water from the Qiantang River was supplemented with domestic sewage",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN54623402","Metagenome or environmental sample from bioreactor metagenome","2025-06-17",null,null,null,null,null,"non_environmental",null,"laboratory or culture material","water from the Qiantang River was su