{"v":"3.0.0","project":{"accession":"PRJNA1334593","title":"Microbial community dynamics and function during chain elongation for resource recovery from spent lithium-ion battery wastewater","description":"This project investigates the microbial community composition and dynamics in an anaerobic bioreactor converting spent lithium-ion battery discharging wastewater into valuable chemicals. The study focuses on a two-phase process involving hydrolysis/acidification followed by chain elongation stimulated by ethanol addition. Full-length 16S rRNA gene sequencing was employed to profile the microbial populations at high taxonomic resolution across different operational stages.","organism":null,"data_type":"Raw sequence reads","center_name":"Institute of process engineering, Chinese Academy of Sciences","submission_date":"2025/09/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51883413","day11","2024-05-05","China","Beijing","Beijing",40.19,116.38,"non_environmental",null,"laboratory or culture material","anaerobic digestion reactor",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China:Beijing",2024],["SAMN51883414","day12","2024-05-05","China","Beijing","Beijing",40.19,116.38,"non_environmental",null,"laboratory or culture material","anaerobic digestion reactor",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China:Beijing",2024],["SAMN51883415","day13","2024-05-05","China","Beijing","Beijing",40.19,116.38,"non_environmental",null,"laboratory or culture material","anaerobic digestion reactor",null,null,null,null,"coordinate","CN",1816670,"verified","text+coo