{"v":"3.0.0","project":{"accession":"PRJNA940590","title":"Aerosol bacterial communities in specialized hospitals","description":"Bacteria is abundant and ubiquitous in bioaerosols from hospital environments. Understanding the distribution and diversity of bacterial communities is important for mitigating their negative impacts. However, the specificity of bioaerosol microorganism, especially potential pathogens, in PM2.5 from specialized hospitals remains poorly understood. To fill this knowledge gap, we collected thirty PM2.5 filter samples in halls and wards of five different hospitals (i.e. oral, dermatology, chest, eye and general hospitals) in China. Bacterial component diversity at the species level were analyzed in all samples using single molecule real-time sequencing technology (SMRT).","organism":null,"data_type":"Raw sequence reads","center_name":"Shandong Normal University","submission_date":"2023/03/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN33574879","Metagenome or environmental sample from air metagenome","2021-09-23","China","Shandong",null,36.4,114.0,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",null,"unresolved",null,null,"China:Shandong",2021],["SAMN33574880","Metagenome or environmental sample from air metagenome","2021-09-25","China","Shandong",null,36.4,114.0,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",null,"unresolved",null,null,"China:Shandong",2021],["SAMN33574881","Metagenome or environmental sample from air metagenome","2021-09-27","China","Shando