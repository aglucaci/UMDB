{"v":"3.0.0","project":{"accession":"PRJNA1295163","title":"Overlooked risk source during landfill mining: High-risk airborne micropollutants and potential pathogenic bioaerosol","description":"This study selected seven types of HRAM in 2.5-micrometer particulate matter (PM2.5), inhalable particles (PM10) and total suspended particulates (TSP) during entire landfill mining process by suspect screening. PPM in these particulate matter (PM) samples were also screened, in order to unravelling the occurrence characteristics of HRAM and PPM. Meanwhile, aerosolization potential of HRAM and PPM were evaluated by aerosolization index (AI) based on the occurrence characteristics in PMs and waste. Structural equation model (SEM) was used to clarify the similarity and differences of cross media behavior. Results of this study can provide scientific reference and management suggestion for airborne pollution control during landfill mining.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2025/07/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50153277","bacterial metagenome1","2024-09","China","Zhejiang","Songyuan",27.6232278,119.0567627,"non_urban",null,"BioProject indicates an agricultural or industrial source","environmental sample1",null,null,null,null,"coordinate","CN",1793952,"probable","coordinates",null,"China: Zhejiang",2024],["SAMN50153278","bacterial metagenome2","2024-09","China","Zhejiang","Songyuan",27.6232278,119.0567627,"non_urban",null,"BioProject indicates an agricultural or industrial source","environmental sample2",null,null,null,null,"coordinate","CN",1793952,"p