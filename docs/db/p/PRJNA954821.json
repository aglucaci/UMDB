{"v":"3.0.0","project":{"accession":"PRJNA954821","title":"Microbial community of drinking water ozone contactor in Michigan","description":"Drinking water ozone contactor influent and effluent water samples were collected bi-weekly for 40 days to analyze differences in the microbial communities. Samples (3-10L) were filtered onto sterile 0.2 micron cartridge filters. DNA was extracted using a modified protocol for the QIAGEN DNeasy PowerWater kit (Vosloo et al. 2019; dx.doi.org/10.17504/protocols.io.66khhcw). Library preparation was conducted using a PCR assay targeting the V4 region of the 16S rRNA gene and a dual-indexing sequencing strategy (Kozich et al. 2013; https://doi.org/10.1128/AEM.01043-13). Sequencing was performed using an Illumina MiSeq using 250 base pair paired-end reads and the MiSeq Reagent Kit V2 500 cycles.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Michigan","submission_date":"2023/04/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN34156243","16s rRNA gene sequences of drinking water ozone contactor sample","2021-04-30","United States","Michigan",null,null,null,"uncertain",null,"no environmental-sample evidence",null,"drinking water","drinking water ozone contactor","drinking water",null,"region","US",null,"unresolved",null,null,"USA: Michigan",2021],["SAMN34156245","16s rRNA gene sequences of drinking water ozone contactor sample","2021-05-04","United States","Michigan",null,null,null,"uncertain",null,"no environmental-sample evidence",null,"drinking water","drinking water ozone contactor","drinking water",null,"region","US",null,"unresolved",null,null,"USA: Michig