{"v":"3.0.0","project":{"accession":"PRJDB17232","title":"16S rRNA gene sequencing, bacterial diversity in surface water samples.","description":"We conducted amplicon sequencing analysis, targeting full-length 16S rRNA genes, on various surface water samples. The primary goal was to elucidate the bacterial community composition and identify potential pathogenic bacteria. The MinION MK1b sequencing platform from Oxford Nanopore Technologies (ONT) was utilized, and the DNA library was prepared using the SQK-16S024 kit (ONT). Raw sequencing data in fast5 format were basecalled using Guppy v.5.0.16 (ONT) with the super high accuracy mode and a Q-score threshold of 10.","organism":"ecological metagenomes","data_type":"Targeted Locus (Loci)","center_name":"Urban Sanitary Department of Environmental Engineering Graduate School of Engineering, Kyoto University","submission_date":"2024/02/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00731736","Sewage effluent collected at 2021-10-25","2021-10-25","Japan","Kyoto","Kyoto",null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"freshwater biome [ENVO:00000873]","wastewater treatment plant [ENVO:00002043]","treated wastewater [ENVO:06105268]",null,"city","JP",1857910,"probable","text","region's main city","Japan:Kyoto",2021],["SAMD00731739","Sewage effluent collected at 2021-11-15","2021-11-15","Japan","Kyoto","Kyoto",null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"freshwater biome [ENVO:00000873]","wastewater treatment plant [ENVO:00002043]","treated wastewater [ENVO:06105268]",null