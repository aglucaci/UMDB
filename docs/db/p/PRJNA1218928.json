{"v":"3.0.0","project":{"accession":"PRJNA1218928","title":"Novel Insights into Biomethane Production from Stillage: The Role of Temperature, Organic Loading Rate, and Inoculum Variability","description":"Molasses stillage has been found to be a suitable feedstock for biogas production due to its high organic content and nutrient-rich composition. This study investigates the biochemical methane potential (BMP) of molasses stillage under varying conditions. The aim was to evaluate the methane production potential of molasses stillage across a spectrum of operational parameters. Additionally, the microbial community dynamics were explored using 16S rRNA sequencing, providing insights into the composition and shifts within the microbial populations under different experimental conditions.","organism":null,"data_type":"Raw sequence reads","center_name":"Masaryk University","submission_date":"2025/02/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46536827","40 C inoculum","2024-02-24","Czechia","South Moravian","Modřice",49.1306564,16.6310939,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","wastewater treatment plant",null,null,null,null,"coordinate","CZ",3070416,"verified","text+coordinates",null,"Czech Republic: Modrice",2024],["SAMN46536828","40 C OLR2","2024-02-24","Czechia","South Moravian","Modřice",49.1306564,16.6310939,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","wastewater treatment plant",null,null,null,null,"coordinate","CZ",3070416,"verified","text+coordinates",null,"Czech Republic: Modrice",2024],["SAMN46536829","40 C OLR5","2024-02-24