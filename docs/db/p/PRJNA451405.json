{"v":"3.0.0","project":{"accession":"PRJNA451405","title":"Microbial diversity in anaerobic digestion of sludge at different temperature regimes","description":"Biological treatment i.e anaerobic digestion of sludge has been considered as most efficient, environmentally sustainable and cost effective setup. However environmental conditions specifically temperature plays a crucial role on the microbial diversity. A complete knowledge of microbial profile is essentially required to develop operating strategies and to further improve process performance. It is crucially vital to associate the microbial community structures with the sludge treatment efficiency involving anaerobic digestion of organics.Moreover, the changing dynamics of a microbial community has been believed to affect the efficiency, robustness, and stability of wastewater treatment systems.","organism":null,"data_type":"Raw sequence reads","center_name":"Quaid-I-Azam University","submission_date":"2018/04/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN08969920","35C. A","2013-12-03","United States","District of Columbia","Washington",38.9072,-77.0369,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anerobically digested Sludge at 35C",null,null,null,null,"coordinate","US",4140963,"verified","text+coordinates",null,"USA:Washington DC",2013],["SAMN08969921","35C. B","2014-01-30","United States","District of Columbia","Washington",38.9072,-77.0369,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anerobically digested Sludge at 35C",null,null,null,null,"coordinate","US"