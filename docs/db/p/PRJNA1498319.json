{"v":"3.0.0","project":{"accession":"PRJNA1498319","title":"ZVI-amended microalgal-bacterial granular sludge","description":"This study investigated bacterial and phototrophic microbial community succession in an aeration-free microalgae-bacteria granular sludge system treating wastewater with a low carbon-to-nitrogen ratio. Biomass samples were collected from parallel upflow photobioreactors operated with and without zero-valent iron addition at different operational stages. Amplicon sequencing of bacterial 16S rRNA genes and phototrophic 23S rRNA genes was conducted to characterize microbial community composition and diversity and to evaluate microbial responses to zero-valent iron addition, granule development, and reactor operating conditions.","organism":null,"data_type":"Raw sequence reads","center_name":"The Hong Kong Polytechnic University","submission_date":"2026/07/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61840248","MIMARKS Survey related sample from wastewater metagenome","2025-03-21","Hong Kong",null,"Hong Kong",22.30583,114.17889,"non_environmental",null,"laboratory or culture material",null,"wastewater treatment system biome [ENVO:01000964]","bioreactor [ENVO:00000073]","activated sludge [ENVO:00002046]",null,"coordinate","HK",1819729,"probable","city-state",null,"China: Hong Kong",2025],["SAMN61840249","MIMARKS Survey related sample from wastewater metagenome","2025-04-24","Hong Kong",null,"Hong Kong",22.30583,114.17889,"non_environmental",null,"laboratory or culture material",null,"wastewater treatment system biome [ENVO:01000964]","bioreactor [ENVO:00000073]","activated sludge [ENVO:00002046]",null,