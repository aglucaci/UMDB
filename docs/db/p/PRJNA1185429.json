{"v":"3.0.0","project":{"accession":"PRJNA1185429","title":"inoculum and modified biocarriers biofilm sequencing","description":"Biochar and tourmaline powders are commonly used functional materials in biocarriers modification, characterized by porous structure and large specific surface area, which are conducive to the biomass retention and biofilm formation of functional microorganism. It was reported that the redox functional groups and conductivity of biochar surface could serve as electron shuttle to facilitate electron transfer, which could enhance nitrogen removal performance and attenuate inhibitory effects on Anammox processes. Previous studies have indicated that the polarity and permanent spontaneous polarization of tourmaline can generate unique electric field that enhances the growth and metabolism of microorganisms. To further explore the mechanism of the effect modified biocarrier on Anammox bacteria, metagenomic analysis was performed.","organism":null,"data_type":"Raw sequence reads","center_name":"Harbin Institute of Technology (Shenzhen)","submission_date":"2024/11/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44703667","Metagenome or environmental sample from sludge metagenome","2024-03","China",null,null,38.64,114.11,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","R1bioreactor",null,null,null,null,"coordinate","CN",null,"unresolved",null,null,"China:Shenzhen",2024],["SAMN44703668","Metagenome or environmental sample from sludge metagenome","2024-03","China",null,null,38.64,114.11,"probable_urban","municipal_wastewater","city-level location without sampl