{"v":"3.0.0","project":{"accession":"PRJNA1245373","title":"Contribution of microbial metabolism to geogenic phosphorus enrichment in groundwater","description":"Microbial mediation in the enrichment of geogenic phosphorus (P) is often mentioned but rarely explored, especially in P enrichment processes through the mineralization of dissolved organic matter (DOM) containing natural P. To bridge the theoretical gap, this study investigated the mechanisms of P enrichment through microbially mediated mineralization of natural P-containing DOM by adopting an approach combining comprehensive field investigation with hydrochemical and molecular biological analyses.","organism":null,"data_type":"Raw sequence reads","center_name":"China University of Geosciences","submission_date":"2025/04/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47752449","Metagenome or environmental sample from groundwater metagenome","2024","China","Hubei","Xiulin",29.69,112.54,"probable_urban",null,"city-level location without sample-site confirmation","groundwater from plain",null,null,null,null,"coordinate","CN",1788268,"probable","coordinates","text 'Jinzhou city' did not match nearby places","China: Jinzhou city",2024],["SAMN47752450","Metagenome or environmental sample from groundwater metagenome","2024","China","Hubei","Xiulin",29.81,112.3,"probable_urban",null,"city-level location without sample-site confirmation","groundwater from plain",null,null,null,null,"coordinate","CN",1788268,"probable","coordinates","text 'Jinzhou city' did not match nearby places","China: Jinzhou city",2024],["SAMN47752451","Metagenome or environmental sample from ground