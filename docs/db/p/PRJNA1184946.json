{"v":"3.0.0","project":{"accession":"PRJNA1184946","title":"Selection and optimization of biofilm carriers as high-effective microbial separator in microbial fuel cells","description":"In this study, four types of MSs were prepared using conventional carriers (ceramsite and polyurethane sponge) and functional carriers (pyrite and manganese ore) as cost-effective alternatives to PEM in dual-chamber MFCs. By comparing the mass transfer and barrier capacity of different MSs, as well as the power generation performance and COD removal performance of MFCs equipped with different MSs, the suitability and performance of different carriers as biofilm carriers for MSs were evaluated. Specifically, the influence of thickness variation on the properties of MSs and MFC equipped with MSs was investigated by using the preferred polyurethane sponge and pyrite. In addition, the regeneration performance and cost-effectiveness of MSs were also examined to assess their overall practicality.","organism":null,"data_type":"Raw sequence reads","center_name":"Southeast university","submission_date":"2024/11/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44677806","Metagenome or environmental sample from wastewater metagenome","2022-08-21","China","Jiangsu","Nanjing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"city","CN",1799962,"probable","text-population","largest of 3 places named 'Nanjing'","China: Nanjing",2022],["SAMN44677807","Metagenome or environmental sample from wastewater metagenome","2022-08-22","China","Jiangsu","Nanjing",null,null,"probab