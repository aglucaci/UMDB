{"v":"3.0.0","project":{"accession":"PRJNA1135324","title":"Algal-bacterial granular sludge","description":"Despite the ecological and biotechnological significance of microalgae-bacterium symbionts, the response of microalgae-bacterium-virus interactions to external fluctuations and the role of viruses in phycosphere remain largely unexplored. Herein, we employed algal-bacterial granular sludge (ABGS) with varying light intensity and organic carbon loading to investigate the response mechanisms of microalgae-bacterium symbionts to environmental fluctuations.","organism":null,"data_type":"Raw sequence reads","center_name":"Zhejiang University","submission_date":"2024/07/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN42474384","Metagenome or environmental sample from sludge metagenome","2020-11-18",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample1",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2020],["SAMN42474385","Metagenome or environmental sample from sludge metagenome","2020-11-18",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample2",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2020],["SAMN42474386","Metagenome or environmental sample from sludge metagenome","2020-11-18",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample3",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2020],["SAMN42474387","Metagenome or environmental sample from sludge metagenome","2020-11-1