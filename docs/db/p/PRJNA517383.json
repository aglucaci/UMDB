{"v":"3.0.0","project":{"accession":"PRJNA517383","title":"16S amplicons from the microbial community in mesophilic, batch reactors injected with hydrogen for biogas upgrading","description":"Conventional biogas production yields a product that is approximately half methane and half carbon dioxide. For use as a transportation fuel, the methane content must be increased through a process referred to as upgrading. In this study, biological upgrading is investigated whereby glucose-fed, mesophilic, batch reactors were injected with hydrogen in order to stimulate the conversion of carbon dioxide in the biogas to methane through microbial activity including hydrogenotrophic methanogenesis. The dataset for this project consists of 16S amplicon sequence data across a timeseries of triplicate, control reactors and triplicate, hydrogen-injected, experimental reactors with associated metadata consisting of process parameters like pH, biogas production, etc.","organism":"biogas fermenter metagenome","data_type":"Targeted loci environmental","center_name":"NMBU","submission_date":"2019/01/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN10840281","CR1W1","2017-06-02","Norway","Akershus","Ås",59.66226,10.75111,"non_environmental",null,"laboratory or culture material",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge",null,"coordinate","NO",3162797,"verified","text+coordinates",null,"Norway: As",2017],["SAMN10840282","CR2W1","2017-06-02","Norway","Akershus","Ås",59.66226,10.75111,"non_environmental",null,"laboratory or culture material",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge",null,"coo