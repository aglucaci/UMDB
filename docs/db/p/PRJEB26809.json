{"v":"3.0.0","project":{"accession":"PRJEB26809","title":"Antibiotic manufacturing effluent enriches resistance genes and alter the structure of microbial communities","description":"In this work, we have examined sludge samples from a Croatian azithromycin production plant using shotgun metagenomics, to better understand the full diversity of known resistance genes, mobile genetic elements and the impact on taxonomic composition caused by extensive antibiotic selection pressures. We compare this data to sludge from a wastewater treatment plant receiving municipal sewage. We find that the sludge from pharmaceutical production harbors around three times as much resistance genes as the municipal sewage sludge, with particularly large enrichments of aminoglycoside, amphenicol and sulfonamide resistance genes. The findings highlight that antibiotic production does contribute to the development of antibiotic resistance also in European settings and indicate a large potential for co-selection of resistance genes to a variety of antibiotic classes.","organism":null,"data_type":"Other","center_name":"UNIVERSITY OF GOTHENBURG","submission_date":"2019/01/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA4668225","Croatian wastewater treatment sludge","2017","Croatia",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","HR",null,"unresolved",null,null,"Croatia",2017],["SAMEA4668226","Croatian wastewater treatment sludge","2017","Croatia",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,