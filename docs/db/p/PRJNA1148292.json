{"v":"3.0.0","project":{"accession":"PRJNA1148292","title":"Effect of acidification pretreatment on two-phase anaerobic digestion of acidified food waste","description":"Food waste is perishable and generates large quantities of organic acids during collection, transportation, and storage, contributing to a strong acidic odor. Additionally, anaerobic digestion has emerged as a viable end-of-pipe treatment for food waste. However, this process can lead to the accumulation of organic acids, which may destabilize the anaerobic digestion system. In our study, acidified food waste underwent pre-fermentation via biological treatment, followed by anaerobic digestion. We analyzed microbial metabolic pathways, key enzymes, and community structures to elucidate the potential mechanism of acidification pretreatment on acid production and methane production.","organism":null,"data_type":"Raw sequence reads","center_name":"Ocean University of China","submission_date":"2024/08/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43192883","Metagenome or environmental sample from sludge metagenome","2024-06-07","China","Shandong","Qingdao",36.1,120.25,"uncertain",null,"conflicting evidence: environmental and host/clinical","fermentation liquid1",null,null,null,"sludge1","coordinate","CN",1797929,"verified","text+coordinates",null,"China: Qingdao",2024],["SAMN43192884","Metagenome or environmental sample from sludge metagenome","2024-06-07","China","Shandong","Qingdao",36.1,120.25,"uncertain",null,"conflicting evidence: environmental and host/clinical","fermentation liquid2",null,null,null,"sludge2","coordinate","CN",1797929,"verified","text+c