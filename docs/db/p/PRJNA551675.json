{"v":"3.0.0","project":{"accession":"PRJNA551675","title":"Benzalkonium chloride effect over activated sluge","description":"As a representative of the most common type of WWTPs in Costa Rica, we selected a small size residential plant located in the city of Mora, San José (9.920687, -84.243345). From the selected plant we collected a sample of the activated sludge (4 L) from an aeration tank (4 meters deep). The sample was then transferred to a sterile amber glass container, kept at a temperature of 4 ºC, and immediately transported to the laboratory. Once in the laboratory, the sample was divided into three portions. The first portion (T1 samples) was frozen immediately and used as a baseline. The second portion (T2 samples) was homogenized, distributed in 3 aliquots of 500 mL (A, B and C) and enriched with 10 mg BAC/L. Later, the three containers enriched were incubated with aeration at a temperature of 20 ºC for 96 hours. The third portion (T3) was used as a control of the process, where it followed the same protocol as B samples except that it did not have enrichment with BAC.","organism":null,"data_type":"Raw sequence reads","center_name":"Universidad de Costa Rica","submission_date":"2019/06/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN12162861","Dosed","2015-01-13","Costa Rica","San José","San José",9.92,-84.24,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","activated sludge",null,null,null,null,"coordinate","CR",3621849,"probable","coordinates",null,"Costa Rica",2015],["SAMN12162862","Dosed","2015-01-13","Costa Rica","San José","San José",9.92,-84.24,"probable_urban","mu