{"v":"3.0.0","project":{"accession":"PRJNA1168510","title":"Unveiling the role of dissolved CO2 in a metabolic pathway switch during biological methanation","description":"This study investigated the impact of dissolved CO2 on the selection of metabolic pathway using a methanation membrane bioreactor supplied with H2/CO2. Various ratios of H2/CO2 were applied (3, 3.3, 3.8, 4, 4.5, and 5 (v:v)) to manipulate the dissolved CO2 levels in the medium. The findings revealed a correlation between the concentration of dissolved CO2 and the production of CH4 (positive) and acetate (negative). Specifically, at a dissolved CO2 above 2 mmol/L, production of CH4 was favored. Conversely, acetate production was favored at lower dissolved CO2 concentrations, with a peak accumulation of 1.94 g/L observed at 0.94 mmol/L of dissolved CO2. This study demonstrates the modification of dissolved CO2 levels in a methanation bioreactor can provide a strategy for the selection of metabolic pathways and microbial communities, thereby offering a promising opportunity for optimizing the conversion of CO2 into high-value products such as CH4 and acetate.","organism":null,"data_type":"Raw sequence reads","center_name":"SUEZ","submission_date":"2024/10/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44049287","M1_1","2021-07-12","France","Île-de-France","Croissy-sur-Seine",48.884862,2.1199,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge_replicate1",null,null,null,null,"coordinate","FR",3022380,"verified","text+coordinates",null,"France: Croissy-sur-Seine",2021],["SAMN44049288","M1_2","2021-07-12","Fr