{"v":"3.0.0","project":{"accession":"PRJDB7071","title":"Instantaneous changes in microbial community structure by a high-pressure jet device for sludge solubilization","description":"In this study, HPJD (high-pressure jet device) treatment was applied to activated sludge as complex microbial community for 16S rRNA gene in the sludge and supernatant analysis by amplicon sequencing was performed. At same time, eukaryotic cell damage was confirmed by microscopic analysis before and after HPJD treatment. Revealed distinct damage from microbial species by HPJD treatment and considered possibility of change of HPJD condition lead distinct microbial community by HPJD treatment.","organism":"activated sludge metagenome","data_type":"Other","center_name":"Tokyo University of Agriculture and Technology","submission_date":"2020/05/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00127196","activated sludge before HPJD treatmemt","2015-07-07","Japan","Tokyo","Tokyo",35.698,139.518,"non_environmental",null,"laboratory or culture material",null,null,"bioreactor","activated sludge",null,"coordinate","JP",1850147,"verified","text+coordinates",null,"Japan:Tokyo",2015],["SAMD00127197","activated sludge after R0 condition HPJD treatmemt","2015-07-07","Japan","Tokyo","Tokyo",35.698,139.518,"non_environmental",null,"laboratory or culture material",null,null,"bioreactor","activated sludge",null,"coordinate","JP",1850147,"verified","text+coordinates",null,"Japan:Tokyo",2015],["SAMD00127198","activated sludge after R1 condition HPJD treatmemt","2015-07-07","Japan","Tokyo","Tokyo",35.698,139.518,"non_environmental",null,"laboratory or culture mate