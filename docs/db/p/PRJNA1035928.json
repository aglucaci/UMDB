{"v":"3.0.0","project":{"accession":"PRJNA1035928","title":"Stable ammonium assimilation mediates the metabolic adaption of halophilic microbiome to hypo-osmotic stress","description":"Salinity barrier shapes distinct microbial ecology on earth, and applications of microbiomes are frequently hindered by trans-osmotic challenges. As a central nutrient metabolism, nitrogen transformations may contribute to conquering osmotic perturbations in microbiomes, and thus understanding the nitrogen metabolic responses to non-isosmotic exposure is crucial. Here we uncover that ammonium assimilation mediates the maintenance of physicochemical properties in a marine-derived halophilic microbiome when adapting to hypo-osmotic stress from salinity of 3% to 0.5% and recovery.","organism":null,"data_type":"Raw sequence reads","center_name":"Shandong University","submission_date":"2023/11/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38105955","S1","2021-09-08","China","Shandong","Jinan",36.7,117.0,"non_environmental",null,"laboratory or culture material","Bioreactor",null,null,null,null,"coordinate","CN",1805753,"probable","text-population","largest of 3 places named 'Jinan'","China: Jinan",2021],["SAMN38105956","S2","2021-09-09","China","Shandong","Jinan",36.7,117.0,"non_environmental",null,"laboratory or culture material","Bioreactor",null,null,null,null,"coordinate","CN",1805753,"probable","text-population","largest of 3 places named 'Jinan'","China: Jinan",2021],["SAMN38105957","S3","2021-09-10","China","Shandong","Jinan",36.7,117.0,"non_environmental",null,"laboratory or culture material","Bioreactor",null,null,null,null,"coordinate"