{"v":"3.0.0","project":{"accession":"PRJEB27589","title":"Analysis of the microbial community dynamics during acclimatization of a membrane bioreactor treating table olive processing wastewater","description":"Biological treatment of Table Olive Processing Wastewater (TOPW) may be problematic due to its high organic and polyphenolic compounds content. Biomass acclimatization is a necessary stage for efficient TOPW biological treatment; Next-Generation Sequencing technologies can provide valuable insights for this critical process step. An aerobic Membrane Bioreactor (MBR) system, initially inoculated with municipal activated sludge, was acclimatized to treat TOPW. Samples at different time stages were analyzed to profile the microbial community using 16S and 18S amplicon metabarcoding and metatranscriptomics.","organism":null,"data_type":"Other","center_name":"Centre for research and Technology Hellas - Institute of Applied Biosciences","submission_date":"2019/01/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA4776585","Analysis of the microbial community dynamics during acclimatization of a membrane bioreactor treating table olive processing wastewater","2014-04-04","Greece",null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"country","GR",null,"unresolved",null,null,"Greece",2014],["SAMEA4776586","Analysis of the microbial community dynamics during acclimatization of a membrane bioreactor treating table olive processing wastewater","2014-04-04","Greece",null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"country","GR"