{"v":"3.0.0","project":{"accession":"PRJEB70517","title":"Supplementation with the short-chain fatty acid acetate for improving age-associated arterial dysfunction in mice","description":"Our overall purpose is to investigate the efficacy of acetate supplementation for treating age-related arterial dysfunction in mice. We are secondarily interested in the relative efficacy of acetate supplementation compared to consumption of a high-fiber diet. We are interested in determining gut microbiome composition (fecal samples), as acetate supplementation has been shown to increase abundance of acetate-producing bacteria, and high-fiber diets increase abundance of overall SCFA-producing bacteria.","organism":null,"data_type":"Other","center_name":"University of California San Diego Microbiome Initiative","submission_date":"2024/11/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA114720095",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA114720096",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA114720097",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA114720098",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA114720099",null,null,null,null,