{"v":"3.0.0","project":{"accession":"PRJEB85534","title":"Establishing protocol for sequencing HA, NA and M segments Influenza A (H1N1 & H3N2) from wastewater.","description":"Influenza A virus (IAV) poses significant public health challenges due to seasonal outbreaks and pandemics. Its rapid evolution requires continuous monitoring to inform vaccine and antiviral development. Wastewater-based surveillance (WBS) offers an unbiased and cost-effective approach to track infectious diseases, including dynamics and genomic evolution. We developed a novel primer panel for genomic WBS of IAV, targeting surface protein segments (HA, NA, M) of circulating H1N1 and H3N2 subtypes. Using this panel, we sequenced nucleic acid extracts from 59 wastewater samples from Switzerland during the 2022/2023 and 2023/2024 winter seasons. We found a significant correlation between clinical and wastewater-based abundance estimates of the dominant H1N1 clades in the 2023/2024 season. Additionally, we detected mutations in vaccine and drug target sites, aligning with clinical data. Our findings demonstrate that Influenza A evolution, including acquisition of mutations relevant to vaccine and antiviral strategies, can be effectively derived through wastewater-based surveillance.","organism":null,"data_type":"Other","center_name":"sib - eth zurich cbg","submission_date":"2025/04/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA117988248","H1N1-H3N2/Switzerland/barcode59/2022","2024-03-28","Switzerland",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","CH",null,"unresolved