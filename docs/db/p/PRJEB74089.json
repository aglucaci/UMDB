{"v":"3.0.0","project":{"accession":"PRJEB74089","title":"Exploiting the ancient microbial response to reactive oxygen species to degrade persistent emerging contaminants","description":"This project deals with bioactive and toxic ‘Emerging contaminants’ (ECs) that are widely present but poorly removed in municipal wastewater treatment systems. Leveraging microbial evolutionary defenses against reactive oxygen species (ROS), we strategically enhance enzyme production for EC degradation. Our approach involves manipulating dissolved oxygen levels to influence microbial functions related to ROS production, nitrogen and carbon metabolism, cell growth, and EC degradation. The activated sludge was obtained from Auckland’s Māngere wastewater treatment plant in New Zealand. Our findings unravel the potential of oxygen modulation to significantly enhance the effectiveness of the wastewater microbial community in eliminating ECs.","organism":null,"data_type":"Other","center_name":"University of Auckland","submission_date":"2024/09/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA115427579","Activated sludge_T0_1","2021-05","New Zealand",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","NZ",null,"unresolved",null,null,"New Zealand",2021],["SAMEA115427580","Activated sludge_T0_2","2021-05","New Zealand",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","NZ",null,"unresolved",null,null,"New Zealand",2021],["SAMEA115427581","Activated sludge_T0_3","2021