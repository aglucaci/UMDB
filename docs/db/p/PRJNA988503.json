{"v":"3.0.0","project":{"accession":"PRJNA988503","title":"Continuous Co-treatment of Mine Drainage with Municipal Wastewater","description":"Synthetic acid mine drainage (AMD) was co-treated with synthetic MWW in a continuously-operating (24 hr/d) bench-scale sequencing batch reactor (SBR). The treatment system simulates addition of AMD after aeration but before secondary settling. SBRs treated MWW with two strengths of AMD (91 and 720 mg/L as CaCO3 Acidity) to capture the variations of coal AMD chemistry and strength observed in the field. Each co-treatment phases lasted 40+ days, during which clarified effluent and settled sludge quality was routinely monitored to determine impacts of co-treatment on the wastewater microbial community.","organism":null,"data_type":"Raw sequence reads","center_name":"Iowa State University","submission_date":"2023/06/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN36022855","MIMARKS Survey related sample from metagenome","2022-05-18","United States","Rhode Island","South Kingstown",41.4862,-71.5307,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,"wastewater","acid mine drainage1","wastewater",null,"coordinate","US",8436572,"probable","coordinates",null,"USA: Rhode Island",2022],["SAMN36022856","MIMARKS Survey related sample from metagenome","2022-05-18","United States","Rhode Island","South Kingstown",41.4862,-71.5307,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,"wastewater","acid mine drainage2","wastewater",null,"coordinate","US",8436572,"probable","coordinates",null,"USA: Rhode Island",2022],["SAMN36022857","MIMARKS