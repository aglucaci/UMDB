{"v":"3.0.0","project":{"accession":"PRJNA1414543","title":"Urban wastewater Metagenome","description":"This project comprises shotgun metagenomic sequencing of 13 municipal wastewater samples collected from the influent of an urban wastewater treatment plant in Guelph, Ontario, Canada. Samples were collected between October 2023 and July 2024 and processed using the Illumina Viral Surveillance Panel 2 hybrid capture enrichment protocol to enhance detection of viral nucleic acids. Libraries were sequenced on an Illumina NextSeq 1000 platform (2 x 150 bp), and resulting reads were analyzed using the DRAGEN microbial enrichment plus pipeline for taxonomic profiling.","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"University of Guelph","submission_date":"2026/01/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54904225","Metagenome or environmental sample from metagenome","2024-07-02","Canada","Ontario","Guelph",43.5228,-80.2661,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level","municipal wastewater",null,null,null,null,"coordinate","CA",5967629,"verified","text+coordinates",null,"Canada: Ontario, Guelph",2024],["SAMN54904226","Metagenome or environmental sample from metagenome","2024-04-02","Canada","Ontario","Guelph",43.5228,-80.2661,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level","municipal wastewater",null,null,null,null,"coordinate","CA",5967629,"verified","text+coordinates",null,"Canada: Ontario, Guelph",2024],["SAMN54904227","Metagenome or environmental sample from metagenome","2024-04-29","Canada","Ontario","Guelph",43.5228,-8