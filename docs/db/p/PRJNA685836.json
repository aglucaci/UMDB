{"v":"3.0.0","project":{"accession":"PRJNA685836","title":"Pilot study of bioaerosols in Athens","description":"It is the first study of the airborne microbiome over the Thisseion area in Athens by metagenomics. We used Rutgers Electrostatic Passive Sampler (REPS)for bioaerosol collection during three long samplings in summer and fall, 2019. Bacterial communities associated with bioaerosol particles were characterized following molecular culture-independent methods with primers (analysis of 16S rRNA genes). We analyzed the taxonomy, diversity, and frequency of occurrence of bacteria and archaea in air particulate matter (bioaerosols) by DNA extraction, purification, and next-generation sequence analysis.","organism":null,"data_type":"Raw sequence reads","center_name":"NOA","submission_date":"2020/12/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN17098068","Metagenome or environmental sample from air metagenome","2019-06-14","Greece","Attica","Athens",37.98,23.73,"confirmed_urban","air_dust","explicit urban setting at sample level","Urban air",null,null,null,"air PM","coordinate","GR",264371,"probable","coordinates",null,"Greece",2019],["SAMN17098069","Metagenome or environmental sample from air metagenome","2019-08-16","Greece","Attica","Athens",37.98,23.73,"confirmed_urban","air_dust","explicit urban setting at sample level","Urban air",null,null,null,"air PM","coordinate","GR",264371,"probable","coordinates",null,"Greece",2019],["SAMN17098070","Metagenome or environmental sample from air metagenome","2020-08-16","Greece","Attica","Athens",37.98,23.73,"uncertain",null,"conflicting evidence: environmental and host/clinica