{"v":"3.0.0","project":{"accession":"PRJNA273257","title":"Waste-mixed sludge (WMS) Metagenome","description":"The aim of the present study was to investigate the microbial population of anaerobic co-digestion of Waste-mixed sludge (WMS) with vegetable waste (FVW) at different operating conditions. Using a pilot-scale apparatus, different runs were performed at rising organic loading rates (OLR) and reduced hydraulic retention time (HRT). The microbial guilds were revealed by the Illumina MiSeq high-throughput sequencing and correlated with environmental factors and process performance.","organism":"sludge metagenome","data_type":"Metagenome","center_name":"IGA Technology Services Srl","submission_date":"2015/01/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN03288004","Metagenome or environmental sample from sludge metagenome","2013-02-05","Italy","The Marches","San Ginesio",43.12,13.35,"uncertain",null,"environmental sample; urban association not established","sludge",null,null,null,null,"coordinate","IT",3168318,"probable","coordinates",null,"Italy",2013],["SAMN03288005","Metagenome or environmental sample from sludge metagenome","2013-02-05","Italy","The Marches","San Ginesio",43.12,13.35,"uncertain",null,"environmental sample; urban association not established","sludge",null,null,null,null,"coordinate","IT",3168318,"probable","coordinates",null,"Italy",2013],["SAMN03288006","Metagenome or environmental sample from sludge metagenome","2013-02-05","Italy","The Marches","San Ginesio",43.12,13.35,"uncertain",null,"environmental sample; urban association not established","Anaerobic sludge",null,null,null,null,"coordinate",