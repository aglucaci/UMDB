{"v":"3.0.0","project":{"accession":"PRJEB102709","title":"Viral metagenomics of pig feces and sewage","description":"Samples 1–3 consist of viral-enriched metagenomic DNA extracted from pig feces, while samples 4–5 originate from sewage. Metagenomic DNA was sequenced by Eurofins Genomics using the INVIEW METAGENOME service. Sequencing included standard genomic library preparation followed by paired-end Illumina sequencing (2 × 150 bp), generating a minimum of 10 million read pairs per sample.       Raw sequencing reads were processed with the ViPER pipeline (Virome Paired-End Reads) to generate viral contigs (De Coninck et al., 2024). This pipeline applies Trimmomatic (Bolger et al., 2014) to trim low-quality bases and adapters from raw reads, followed by assembling the paired-end reads of 1 %, 10 % and 100 % subsets into contigs using metaSPAdes (Nurk et al., 2017). These contigs were clustered using a combination of BLAST+ (Camacho et al., 2009), and anicalc.py and aniclust.py scripts from the CheckV packages (Nayfach et al., 2021). Contigs larger than 500 bp were retained.","organism":null,"data_type":"Other","center_name":"Ghent University","submission_date":"2025/12/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA120553874",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA120553875",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA120553876",null,null,null,null,null,null,n