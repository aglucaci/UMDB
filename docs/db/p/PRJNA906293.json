{"v":"3.0.0","project":{"accession":"PRJNA906293","title":"Effect of air mixing on high-solids anaerobic digestion of cow manure and its mechanism","description":"Laboratory tests and engineering application have proved that air mixing can improve methane production in conventional low solid content anaerobic digestion process. In this study, different mixing intensities were adopted under the condition of high-solids. Further, through the analysis of methane yield, organic matter removal efficiency, hydrolysis efficiency, carbon mass balance and microbial community structure, the performance of air mixing on high-solids anaerobic digestion system was clarified.","organism":null,"data_type":"Raw sequence reads","center_name":"Southwest University of Science and Technology","submission_date":"2022/11/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN31914604","R10_1","2022-11-26",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN31914605","R10_2","2022-11-26",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN31914606","R30_1","2022-11-26",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN31914607","R30_2","2022-11-26",null,null,null,null,null,"uncertain",null,"environmental sample; urban as