{"v":"3.0.0","project":{"accession":"PRJNA896721","title":"Microbiological impacts of blending advanced-treated wastewater in pipe loops","description":"Direct potable reuse offers water-scarce regions a local and reliable source of drinking water through advanced treatment of wastewater, but few studies have investigated the microbial water quality impacts of introducing advanced-treated wastewater to drinking water distribution systems. The microbial water quality was characterized throughout an advanced wastewater treatment train and in pilot-scale simulated drinking water distribution systems. Drinking water distribution systems were simulated as pipe loops that recirculated 100 L of either conventional drinking water or blends of advanced-treated wastewater and conventional drinking water. Microbial water quality was assessed via 16S rRNA gene amplicon sequencing as well as flow cytometry-based cell counts, adenosine triphosphate concentration, and qPCR.","organism":null,"data_type":"Raw sequence reads","center_name":"University of California, Berkeley","submission_date":"2022/11/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41934921","field sampling blank for biofilm","2018-01-10","United States","California","San Francisco",37.8719,-122.2585,"uncertain",null,"environmental sample; urban association not established","control",null,null,null,null,"coordinate","US",5391959,"probable","coordinates",null,"USA: California",2018],["SAMN41934922","field sampling blank for bulk water","2018-03-13","United States","California","San Francisco",37.8719,-122.2585,"uncertain",null,"no environmental-sample evidence","control",nu