{"v":"3.0.0","project":{"accession":"PRJNA1241301","title":"Metagenomic Whole Genome Shotgun Analysis of the Airway Microbiome in Laryngotracheal Stenosis: A Pilot study","description":"The airway microbiome has been implicated in the pathogenesis of laryngotracheal stenosis (LTS), yet studies using amplicon-based 16S rRNA sequencing are limited to sub-genus level resolution. Metagenomic whole genome shotgun sequencing (mWGS) allows for strain-level taxonomic and functional genomic analysis, providing detailed insights into the specific organisms and pathways involved. A pilot study was conducted to explore the feasibility, advantages, and challenges of mWGS in investigating the airway metagenome in LTS","organism":"respiratory tract metagenome","data_type":"Metagenome","center_name":"University of Cincinnati","submission_date":"2025/03/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47552728","Human Airway Metagenome - Control_1","2022-12-22T15:00:00Z","United States","Ohio","Cincinnati",39.1393,-84.506,"non_environmental",null,"host-derived or clinical material",null,"human respiratory system biome [ENVO:01001779]|host-associated biome [ENVO:00002030]|mucosal surface biome [ENVO:01000254]","hospital building [ENVO:01000254]|mucosal surface [ENVO:01000254]","host-associated material [ENVO:00002006]","Homo sapiens","coordinate","US",4508722,"verified","text+coordinates",null,"USA: Ohio, Cincinnati",2022],["SAMN47552729","Human Airway Metagenome - Stenotic Airway_3","2023-10-05T10:45:00Z","United States","Ohio","Cincinnati",39.1393,-84.506,"non_environmental",null,"host-derived or clinical material",null,"human respiratory 