{"v":"3.0.0","project":{"accession":"PRJNA961351","title":"1234 Raw sequence reads","description":"In this study, the effects of roxarsone on anammox process performance were systemically investigated through continuous-flow experiments, aiming to reveal the inhibitory mechanism of roxarsone on anammox consortia. Based on the above summary, it was speculated that oxidative stress involves in the responding process. Thus, the abundance of key genes and oxidative stress levels were further quantified. In addition, roxarsone-induced microbial community evolution was evaluated, and the potential mechanism of anammox consortia in responding to roxarsone was finally illustrated.","organism":"anaerobic ammonium-oxidizing bacterium enrichment culture","data_type":"Raw sequence reads","center_name":"Hangzhou Normal University","submission_date":"2023/04/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN34360705","R1","2022-03-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Sludge","unknown",null,null,"unresolved",null,null,null,2022],["SAMN34360706","R1","2022-03-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Sludge","unknown",null,null,"unresolved",null,null,null,2022],["SAMN34360707","R1","2022-03-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Sludge","unknown",null,null,"unresolved",null,null,null,2022],["SAMN34360708","R1","2022-03-20",null,null,null,null,null,"uncertain",null,"environmental sample; u