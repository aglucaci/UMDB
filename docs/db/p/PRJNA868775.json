{"v":"3.0.0","project":{"accession":"PRJNA868775","title":"WGS from Microbial communities colonising plastics during transition from wastewater treatment plant to marine water","description":"The aim of this study was to use a series of ex situ mesocosm to imitate plastic waste transport from the wastewater treatment plant to the marine zone. Changes have been tracked in bacteria community structure on the plastics from the early stages of colonisation to one week.Whole genome sequencing was used to determine microbial community structures. Colonization was studied on four of the most common types of plastics found in marine zone: polypropylene (PP), high-density and low-density polyethylene (HDPE, LDPE) and polyethylene terephthalate (PET).","organism":null,"data_type":"Raw sequence reads","center_name":"Bangor University","submission_date":"2022/08/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN30273568","MIMS Environmental/Metagenome sample from metagenome","2020-10-20","United Kingdom","Wales","Llanrwst",53.13963,-3.80351,"probable_urban","water_drainage","urban context stated at BioProject level only",null,"Freshwater [ENVO:00002011]","River Freshwater [ENVO:01000297]","Wastewater [ENVO:00002001]",null,"coordinate","GB",2643957,"probable","coordinates",null,"United Kingdom: Conwy River, North Wales",2020],["SAMN30273569","MIMS Environmental/Metagenome sample from metagenome","2020-10-20","United Kingdom","Wales","Llanrwst",53.14296,-3.807,"probable_urban","water_drainage","urban context stated at BioProject level only",null,"Freshwater [ENVO:00002011]","River Freshwater [ENVO:01000297]","Wastewater [ENVO:00002001]",n