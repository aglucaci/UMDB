{"v":"3.0.0","project":{"accession":"PRJNA1122238","title":"Tracing sources of microbial eukaryotic contamination in the Pasig River System in Metro Manila, Philippines using community-based microbial source tracking","description":"Community-based Microbial Source Tracking (MST) is a recent approach to trace sources of contamination in a polluted environment. Here, this method is employed to track the sources of contamination in the Pasig River System in Metro Manila, Philippines specifically targeting microbial eukaryotes. Potential host sources (fecal and sewage samples) were collected at different animal farm sites and treatment plants surrounding the rivers.","organism":null,"data_type":"Raw sequence reads","center_name":"University of the Philippines Diliman","submission_date":"2024/06/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41783608","SW1","2023-03-03","Philippines","National Capital Region","Quezon City",14.66186,121.0204,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sewage",null,null,null,null,"coordinate","PH",1692192,"probable","coordinates",null,"Philippines: Sewage Treatment Plant",2023],["SAMN41783610","SW3","2023-05-25","Philippines","National Capital Region","Quezon City",14.58856,120.9931,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sewage",null,null,null,null,"coordinate","PH",1692192,"probable","coordinates",null,"Philippines: Sewage Treatment Plant",2023],["SAMN41783611","SW4","2023-05-25","Philippines","National Capital Region","Quezon City",14.58856,120.9931,"probable_urban","municipal_wastewat