{"v":"3.0.0","project":{"accession":"PRJNA914103","title":"Evaluating the roles of zero valent iron on the metagenome during thermophilic anaerobic digestion of sludge","description":"To reduce the knowledge gaps, metagenomic approach has been used to provide a full profile in WAS before and after the TAD treatment with mZVI.Four batch experimental groups spiked with mZVI of 0, 25, 100, and 250 mg/g TS were carried out for anaerobic digestion, and each group was parallel, marked as Z1, Z2, Z3 and Z0, respectively. All reactors were firstly loaded with 200 mL of WAS in 250 mL serum bottles, then flushed with high-purity nitrogen for 2 min and sealed with rubber stoppers, and incubated at thermophilic in the water bath. The whole operation period lasted for 32 d. Samples collected at the endwere centrifuged at 8,000 rpm for 10 min to obtain sludge samples for metagenomic analysis.","organism":null,"data_type":"Raw sequence reads","center_name":"Sichuan University","submission_date":"2022/12/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN32320630","Metagenome or environmental sample from sludge metagenome","2022-01-30","China","Sichuan","Chengdu",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"city","CN",1815286,"verified","text",null,"China: Chengdu",2022],["SAMN32320631","Metagenome or environmental sample from sludge metagenome","2022-01-30","China","Sichuan","Chengdu",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"city","CN",1815286,"verified","text",null,"