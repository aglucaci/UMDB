{"v":"3.0.0","project":{"accession":"PRJNA1140288","title":"Farm-to-fork Changes in Poultry Microbiomes and Resistomes in Maputo City, Mozambique","description":"Increasing demand for poultry has spurred poultry production in low- and middle-income countries like Mozambique. Poultry may be an important source of foodborne, antimicrobial resistant bacteria to consumers in settings with limited water, sanitation, and hygiene infrastructure. The ChEEP ChEEP (Chicken Exposures and Enteric Pathogens in Children Exposed through Environmental Pathways) study was conducted in Maputo City, Mozambique from 2019-2021 to quantify enteric pathogen exposures along the supply chain for commercial and local (i.e. scavenger) chicken breeds. Here, we performed metagenomic sequencing of total DNA from banked ChEEP ChEEP samples to characterize fecal and carcass microbiome and resistome diversity between chicken breeds and along the supply chain. Fecal samples (26) were collected from commercial and local chickens at production sites and markets, and carcass (49) and rinse bucket samples (26) from markets. We conducted taxonomic profiling and identified antimicrobial resistance genes (ARGs) from metagenomic sequence data, focusing especially on known human pathogens and high-risk ARGs. We estimated alpha diversity for each sample and compared by site and breed. We estimated Bray-Curtis dissimilarity between samples and examined clustering. We found that commercial and local chickens harbored distinct fecal pathogens and resistomes at production and market sites. Many bacterial pathogens and ARGs present in chicken fecal samples are also present on carcasses sold to consumers. Finally, commercial chicken carcasses contain high-risk ARGs that are not necessarily introduced from chicken feces. These results indicate markets are an important site of pathogen and ARG exposure.","organism":null,"data_type":"Raw sequence reads","center_name":"Emory University","submission_date":"2024/07/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN42828292","MIMS Environmental/Metagenome sample from metagenome",null,"Mozambique","Maputo City","Maputo",-25.9692,32.5732,"uncertain",null,"no environmental-sample evidence",null,"tropical","urban","Carcass",null,"coordinate","MZ",1040652,"probable","coordinates",null,"Mozambique:Maputo",null],["SAMN42828311","MIMS Environmental/Metagenome sample from metagenome",null,"Mozambique","Maputo City","Maputo",-25.9692,32.5732,"non_environmental",null,"host-derived or clinical material",null,"tropical","urban","Fecal",null,"coordinate","MZ",1040652,"probable","coordinates",null,"Mozambique:Maputo",null],["SAMN42828317","MIMS Environmental/Metagenome sample from metagenome",null,"Mozambique","Maputo City","Maputo",-25.9692,32.5732,"non_environmental",null,"host-derived or clinical material",null,"tropical","urban","Fecal",null,"coordinate","MZ",1040652,"probable","coordinates",null,"Mozambique:Maputo",null],["SAMN42828320","MIMS Environmental/Metagenome sample from metagenome",null,"Mozambique","Maputo City","Maputo",-25.9692,32.5732,"non_environmental",null,"host-derived or clinical material",null,"tropical","urban","Fecal",null,"coordinate","MZ",1040652,"probable","coordinates",null,"Mozambique:Maputo",null],["SAMN42828321","MIMS Environmental/Metagenome sample from metagenome",null,"Mozambique","Maputo City","Maputo",-25.9692,32.5732,"non_environmental",null,"host-derived or clinical material",null,"tropical","urban","Fecal",null,"coordinate","MZ",1040652,"probable","coordinates",null,"Mozambique:Maputo",null],["SAMN42828326","MIMS Environmental/Metagenome sample from metagenome",null