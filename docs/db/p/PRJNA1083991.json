{"v":"3.0.0","project":{"accession":"PRJNA1083991","title":"Impact of Nitrate Dosing and Conductive Media on Anaerobic Fluidised-bed Treatment of Low-Strength Wastewater","description":"The purpose of this study is to study the chemical and biological impacts of nitrate dosing on anaerobic fluidised-bed reactors treating a low-strength synthetic wastewater. To do so, two lab-scale reactors were operated, one containing non-conductive PVDF media, the other containing the same media with a polyaniline coating applied. Samples were taken at two time points from both the media biofilm and the bulk suspension from each reactor. This study forms part of a PhD thesis of the same title.","organism":null,"data_type":"Raw sequence reads","center_name":"Imperial College London","submission_date":"2024/03/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40265679","GR1P1biofilm","2023-03-02","United Kingdom","England","London",51.5,-0.18,"uncertain",null,"environmental sample; urban association not established","biofilm of conductive media",null,null,null,null,"coordinate","GB",2643743,"probable","coordinates",null,"United Kingdom",2023],["SAMN40265680","GR1P1bulk","2023-03-02","United Kingdom","England","London",51.5,-0.18,"uncertain",null,"no environmental-sample evidence","bulk suspension of conductive reactor",null,null,null,null,"coordinate","GB",2643743,"probable","coordinates",null,"United Kingdom",2023],["SAMN40265681","GR1P2biofilm","2023-06-07","United Kingdom","England","London",51.5,-0.18,"uncertain",null,"environmental sample; urban association not established","biofilm of conductive media",null,null,null,null,"coordinate",