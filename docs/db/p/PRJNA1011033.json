{"v":"3.0.0","project":{"accession":"PRJNA1011033","title":"anammox under nitrite stress Raw sequence reads","description":"The objective of this study was to elucidate the transcriptomic response mechanism of AnAOB and the shift in the cross-feeding relationship within anammox consortia during the collapse of the anammox system induced by excessive nitrite. The findings provide valuable insights into the mechanisms underlying bacterial growth and the nitrogen removal performance of the anammox system under these conditions. This research contributes to establishing a theoretical foundation and offering technical support for mitigating nitrite inhibition in the anammox process.","organism":null,"data_type":"Raw sequence reads","center_name":"Peking University","submission_date":"2023/08/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37217750",null,"2019-02-15","China","Guangdong","Shenzhen",22.52,113.92,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",1795565,"probable","coordinates",null,"China:Guangdong",2019],["SAMN37217751",null,"2019-02-28","China","Guangdong","Shenzhen",22.52,113.92,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",1795565,"probable","coordinates",null,"China:Guangdong",2019],["SAMN37217752",null,"2019-03-06","China","Guangdong","Shenzhen",22.52,113.92,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",1795565,"probable","coordinates",null,"China:Guangdong",2019],["SAMN37217753",null,"2019-03-13","C