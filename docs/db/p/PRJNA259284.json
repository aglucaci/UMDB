{"v":"3.0.0","project":{"accession":"PRJNA259284","title":"Diversity of bacteria from municipal dumpsite","description":"Urbanization and population growth has resulted in poor solid waste management in urban areas. Domestic, industrial and biomedical solid wastes are not sorted. High interaction between wild and domestic animals as well as people is evident in urban dumps. This project seeks to understand the diversity, abundance and dynamics of bacteria circulation such a complex interface and contaminating the river near the dumpsite","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"Nelson Mandela African Institution of Sciences and Technology","submission_date":"2014/08/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN03009814","River sludge 1","2013-03-01","Tanzania","Arusha","Arusha",-3.424616,36.6795,"probable_urban","water_drainage","city-level location without sample-site confirmation",null,"River sludge","River banks","water",null,"coordinate","TZ",161325,"verified","text+coordinates",null,"Tanzania: Arusha",2013]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","release_date","spots","bases","avg_length","size_mb","scientific_name","urban_status","experiment_title"],"runs":[["SRR1560101",0,"SRX687868","Amplicon","AMPLICON","METAGENOMIC","PCR","PAIRED","ILLUMINA","Illumina MiSeq","2014-09-26 00:00:00",160549,80595598,502,52.0,"freshwater sediment metagenome","probable_urban","Diversity of bacteria from the river sludge near municipal dumpsite"],["SRR1560277",0,"SRX687868","Am