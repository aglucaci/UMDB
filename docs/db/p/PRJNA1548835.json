{"v":"3.0.0","project":{"accession":"PRJNA1548835","title":"Effects of different pretreatments whether sterilized or not on Streptococcus carbonicus","description":"pretreatment primarily establishes substrate accessibility and precursor availability, whereas indigenous microorganisms facilitate subsequent substrate conversion and functional coordination with exogenous CEB. A two-stage fermentation system integrating different pretreatment strategies with retention or inactivation of indigenous microorganisms was established. The objectives were to: (i) evaluate their effects on MCFAs production and selectivity; (ii) clarify their roles in SCFAs conversion, substrate utilization, and reducing conditions; and (iii) reveal the associated microbial and metabolic mechanisms through community and metagenomic analyses.","organism":null,"data_type":"Raw sequence reads","center_name":"Taiyuan University of Technology","submission_date":"2026/10/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64364814","MIMARKS Survey related sample from sludge metagenome","2025-06-20","China","Shanxi","Taiyuan",37.81,112.56,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Sludge microorganism","Anaerobic acclimation","Sludge",null,"coordinate","CN",1793511,"probable","coordinates",null,"missing: data agreement-established pre-2023",2025],["SAMN64364815","MIMARKS Survey related sample from sludge metagenome","2025-06-16","China","Shanxi","Taiyuan",37.81,112.56,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Sludge microorganism","pretreatment","