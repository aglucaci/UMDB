{"v":"3.0.0","project":{"accession":"PRJNA989503","title":"hospital wastewater Metagenome","description":"Metagenomic insights into the resistomes hospital wastewater. These metagenomic insights offer a comprehensive understanding of the resistome composition, encompassing both the abundance of ARGs, host, and potential pathways of dissemination. Such investigations shed light on the role of hospital wastewater as a reservoir for antibiotic resistance, highlighting the need for effective wastewater treatment strategies and stringent infection control measures in healthcare settings to mitigate the spread of resistance genes and combat the global challenge of antimicrobial resistance.","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"Chinese Center for Disease Control and Prevention","submission_date":"2023/06/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN35882476","Metagenome or environmental sample from hospital metagenome","2022-10-11","China",null,null,35.0,105.0,"uncertain",null,"environmental sample; urban association not established","hospital wastewater",null,null,null,null,"coordinate","CN",null,"unresolved",null,null,"China",2022],["SAMN35882477","Metagenome or environmental sample from hospital metagenome","2022-10-11","China",null,null,35.0,105.0,"uncertain",null,"environmental sample; urban association not established","hospital wastewater",null,null,null,null,"coordinate","CN",null,"unresolved",null,null,"China",2022],["SAMN35882478","Metagenome or environmental sample from hospital metagenome","2022-10-11","China",null,null,35.0,105.0,"uncertain",null,"environmental sample; urban a