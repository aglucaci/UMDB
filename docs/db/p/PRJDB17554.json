{"v":"3.0.0","project":{"accession":"PRJDB17554","title":"Significance of homogeneous operation in light-assisted fixed-bed bioprocess under ammonia stress: Optimization, long-term operation and metagenomic analysis","description":"This study aims to optimize light-assisted anaerobic digestion with bio-fixed bed amendment for efficient methane production from ammonia-stressed substrates. Through 90-day pilot-scale operation under solar light, the research establishes a uniformly illuminated biosystem, showcasing robust methane yields. This approach offers a promising, sustainable method for waste-to-energy conversion at scale.","organism":"cellular organisms","data_type":"Targeted Locus (Loci)","center_name":"Institutes of Biological and Agricultural Sciences, University of Tsukuba","submission_date":"2024/02/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00747470","Inoculum_1","2022-06","Japan","Tochigi","Oyama",36.28442593,139.98906691,"uncertain",null,"environmental sample; urban association not established",null,"terrestrial biome[ENVO_00000446]","terrestrial environmental zone[ENVO_01001199]","waste water[ENVO_00002001]",null,"coordinate","JP",1853483,"probable","coordinates",null,"Japan",2022],["SAMD00747472","Dark_1","2022-02","Japan","Tochigi","Oyama",36.28442593,139.98906691,"uncertain",null,"environmental sample; urban association not established",null,"terrestrial biome[ENVO_00000446]","terrestrial environmental zone[ENVO_01001199]","waste water[ENVO_00002001]",null,"coordinate","JP",1853483,"probable","coordinates",null,"Japan",2022],["SAMD00747474","Light_1","2022-02","Japan","Tochigi","Oyama",36.28442593,139