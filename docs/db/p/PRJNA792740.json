{"v":"3.0.0","project":{"accession":"PRJNA792740","title":"Deep Insight into Species and Functional Composition Variation of A Partial Nitrification Activated Sludge Community through Metagenomic Analysis","description":"To achieve energy-efficient shortcut nitrogen removal of wastewater in the future, selective elimination of nitrite-oxidizing bacteria (NOB) and enrichment of ammonia-oxidizing microorganisms is a key step. However, the underlying mechanisms by which nitrifying microorganisms are selectively inhibited during partial nitrification are still not well understood, especially for the newly discovered ultrasound-based partial nitrification. This study aimed to further elucidate this issue. We set up two bioreactors, one of which established partial nitrification by ultrasonic treatment. During the long-term operation of the reactors, the microbial community and functional genes were investigated through metagenome analysis.","organism":null,"data_type":"Raw sequence reads","center_name":"Tsinghua","submission_date":"2021/12/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN24462048","Activated sludge","2017-02-14","China","Beijing","Beijing",40.01,116.32,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","THU-WWTP-bioreactor1",null,null,null,"activated sludge metagenome","coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2017],["SAMN24462049","Activated sludge","2017-05-03","China","Beijing","Beijing",40.01,116.32,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","THU-WWTP-bioreactor2",null,null,null,"activated sludge