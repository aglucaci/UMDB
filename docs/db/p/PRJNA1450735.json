{"v":"3.0.0","project":{"accession":"PRJNA1450735","title":"Swine wastewater anaerobic ceramic membrane bioreactor metagenome","description":"This study investigates the concentration-dependent effects of chlortetracycline (CTC) on methanogenesis, microbial community dynamics, and antibiotic resistance genes (ARGs) in an anaerobic ceramic membrane bioreactor (AnCMBR) treating swine wastewater. Metagenomic sequencing was performed on sludge and effluent samples from four operational stages (0, 10, and 50 mg/L CTC, and a recovery phase) to elucidate the microbial mechanisms underlying CTC-induced promotion or inhibition of methane production and the associated spread of ARGs.","organism":null,"data_type":"Raw sequence reads","center_name":"an University of Architecture and Technology (XAUAT)","submission_date":"2026/04/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57169990","sludge","2025-03","China","Shaanxi","Xi’an",null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","sludge",null,null,null,null,"city","CN",1790630,"probable","text-population","largest of 5 places named 'xian'","China:xian",2025],["SAMN57169991","sludge","2025-05","China","Shaanxi","Xi’an",null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","sludge",null,null,null,null,"city","CN",1790630,"probable","text-population","largest of 5 places named 'xian'","China:xian",2025],["SAMN57169992","sludge","2025-07","China","Shaanxi","Xi’an",null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","sludge",null,null,null,null,"city","CN",1790630,"probable","text-popul