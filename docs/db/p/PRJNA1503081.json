{"v":"3.0.0","project":{"accession":"PRJNA1503081","title":"16S rRNA gene amplicon sequencing of microbial communities in HZ9-bioaugmented sequencing batch reactors under increasing ammonium loading","description":"This project characterizes bacterial community succession in two laboratory sequencing batch reactors treating synthetic landfill-leachate-like wastewater under stepwise increases in influent ammonium concentration. One reactor was repeatedly bioaugmented with Stutzerimonas stutzeri HZ9, whereas the control reactor received an equal volume of sterile water. The reactors were operated for 30 days across three ammonium-loading stages, with influent NH4+-N concentrations of 300, 500, and 800 mg/L and an operational duration of 10 days per stage. Sludge samples were analyzed by 16S rRNA gene amplicon sequencing to compare microbial community restructuring between the bioaugmented and control reactors and to evaluate community responses to increasing ammonium stress.","organism":null,"data_type":"Raw sequence reads","center_name":"Chinese Academy of Sciences","submission_date":"2026/07/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62003256","Metagenome or environmental sample from activated sludge metagenome","2026-04","China","Hubei",null,null,null,"uncertain",null,"environmental sample; urban association not established","activated sludge",null,null,null,null,"region","CN",null,"unresolved",null,null,"China:Hubei",2026],["SAMN62003257","Metagenome or environmental sample from activated sludge metagenome","2026-04","China","Hubei",null,null,null,"uncertain",null,"environmental sample; urban association not establi