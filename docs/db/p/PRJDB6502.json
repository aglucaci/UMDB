{"v":"3.0.0","project":{"accession":"PRJDB6502","title":"Microbial community analysis of anaerobic reactors treating PTA wastewater","description":"Anaerobic biological process has been applied for the treatment of purified terephthalic acid (PTA) wastewater containing complex aromatic compounds; however, the performance of the treatment has significant potential for greater efficiency if the limited knowledge of metabolic capacity and interaction of anaerobic microbes in these systems is deepened. In this study, we perform microbial community profiling of seven full-scale and three lab-scale anaerobic bioreactors treating PTA wastewater by using 16S rRNA gene amplicon sequencing approach to elucidate the co-occurrence network patterns of dominant microbial constituents, including syntrophic substrate oxidizing bacteria, methanogenic archaea, and functionally unknown organisms in the systems.","organism":"bioreactor sludge metagenome","data_type":"Targeted Locus (Loci)","center_name":"Bioproduction Research Institute, Bioproduction Research Institute, National Institute of Advanced Industrial Science and Technology (AIST)","submission_date":"2017/11/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00099652","anaerobic sludge A10","2014","United States","Illinois","Champaign",40.1139,-88.2267,"non_environmental",null,"laboratory or culture material",null,"anaerobic bioreactor","waste treatment plant","anaerobic sludge",null,"coordinate","US",4887158,"probable","coordinates",null,"USA",2014],["SAMD00099653","anaerobic sludge A11","2014","United States","Illinois","Champaign",40.1139,-88.2267,"non_environmental",null,"laborato