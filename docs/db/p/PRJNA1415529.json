{"v":"3.0.0","project":{"accession":"PRJNA1415529","title":"Virome Analysis of Selected Bat Species in Davao City, Philippines","description":"This project aims to characterize the virome of selected bat species using RNA-based shotgun metagenomic sequencing. RNA extracts from pooled swab (rectal and oral) and fecal samples were processed for library preparation using the Illumina Stranded Total RNA Prep Ligation kit with Ribo-Zero Plus and sequenced using NovaSeq 6000 SP reagent kit v1.5 with 100 cycles in a paired end format. Taxonomic profiling was done using Kraken2 standard viral database and abundance refined with Bracken.","organism":null,"data_type":"Raw sequence reads","center_name":"Philippine Genome Center Mindanao","submission_date":"2026/01/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54938143","MIMS Environmental/Metagenome sample from metagenome","2021-06/2022-09","Philippines","Davao Region","Davao",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"Urban Green Spaces","Forests and Synanthropic Habitats",null,"Ptenochirus jagorii","city","PH",1715348,"verified","text",null,"Philippines: Davao City",2021],["SAMN54938144","MIMS Environmental/Metagenome sample from metagenome","2021-06/2022-09","Philippines","Davao Region","Davao",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"Urban Green Spaces","Subterranean Habitats",null,"Rhinolophus","city","PH",1715348,"verified","text",null,"Philippines: Davao City",2021],["SAMN54938145","MIMS Environmental/Metagenome sample from metagenome","2021-06/2022-09","Philippines","Davao Region",