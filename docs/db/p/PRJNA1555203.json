{"v":"3.0.0","project":{"accession":"PRJNA1555203","title":"Bacterial Community Diversity and Predicted Functions in Constructed Wetland-Microbial Electrolysis Cell Systems Treating Aquaculture Wastewater","description":"This study investigated the bacterial community diversity, composition, and predicted functions in constructed wetland-microbial electrolysis cell (CW-MEC) systems treating aquaculture wastewater. Five experimental configurations, including CW, CW-MEC1, CW-MEC2, CW-MEC3, and CW-MEC4, were established to evaluate wastewater treatment performance and microbial community characteristics. Microbial samples from different functional layers, including the cathode, substrate, and anode layers of the CW-MEC systems, were analyzed using 16S rRNA gene amplicon sequencing. The study examined the effects of MEC coupling and operating conditions on bacterial community structure and predicted metabolic functions, with particular attention to microbial processes potentially associated with organic matter removal, nitrogen and phosphorus cycling, and sulfamethoxazole (SMX) degradation. The results provide insights into microbial community dynamics and their potential roles in improving aquaculture wastewater treatment using CW-MEC systems.","organism":null,"data_type":"Raw sequence reads","center_name":"Chengdu University of Information Technology","submission_date":"2026/11/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64612305","CW cathode zone substrate microbiome A1_1","2024-11-27","China","Sichuan","Chengdu",30.5845,103.9862,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,"wastewat