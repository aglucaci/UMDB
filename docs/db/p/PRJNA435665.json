{"v":"3.0.0","project":{"accession":"PRJNA435665","title":"16S amplicon sequencing of the microbial communities from a refinery wastewater treatment pipeline in Uran, India","description":"Freshwater is an irreplaceable natural resource essential for the quality of ecosystems and human life. The effluents released from industrial activities contain a large amount of harmful compounds and contribute to the pollution of freshwater resources if not treated properly. An effective wastewater treatment greatly relies on the functional capabilities of the microbial communities from the activated sludges and on the efficiency and stability of the biodegradation process, which in turn depends on optimal operative conditions, environmental factors and bioavailability of the compounds. Therefore, a comprehensive analysis of the influent wastewater physico-chemical parameters and of the dynamics of the microbial communities (variation in composition and metabolic functionalities) will allow to understand mechanisms underpinning the biodegradative process and develop strategies to improve the performance of the wastewater treatment.","organism":"wastewater metagenome","data_type":"Raw sequence reads","center_name":"Universidade do Minho","submission_date":"2018/02/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN08583655","Surge_pond_winter_replicate1","2016-01","India","Maharashtra","Uran",18.88,72.94,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"wastewater treatment plant","wastewater treatment plant","wastewater",null,"coordinate","IN",1253702,"verified","text+coordinates",null,"India: Ur