{"v":"3.0.0","project":{"accession":"PRJNA1045818","title":"Combining pre-fermentation and dual-chamber microbial electrolysis cell for efficient high-purity hydrogen production from food wastewater","description":"This study comprehensively investigated the effects of HRT and OLR on the composition of pre-fermentation effluents from food wastewater and the subsequent performance of dual-chamber MECs utilizing the effluents. Pre-fermentation was conducted without pH control to reflect a more sustainable and realistic approach. Both the pre-fermentation and MEC processes were closely monitored for their performance and active microbial community structures at the RNA level. The outcomes of this study will advance the understanding and potential of MECs combined with pre-fermentation for handling food wastewater and involved microbes.","organism":null,"data_type":"Raw sequence reads","center_name":"Ulasn National Institute of Science and Technology","submission_date":"2023/11/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38454961","Metagenome or environmental sample from anaerobic digester metagenome","2023-10-09","South Korea",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","KR",null,"unresolved",null,null,"South Korea",2023],["SAMN38454962","Metagenome or environmental sample from anaerobic digester metagenome","2023-10-09","South Korea",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","KR",null,"unresolved",null,null,"South Korea",2023],["SAMN38454963","Metage