{"v":"3.0.0","project":{"accession":"PRJNA1099306","title":"Fate and Transport of Antimicrobial Resistance Genes in Algal-bacterial Wastewater Treatment Systems","description":"The concrete goal of is to invest the algal-bacterial consortia for wastewater treatments and use function-based metagenomic analyses to illustrate the role of algal-bacterial consortia in reduction of antimicrobially resistant microbes and antimicrobial resistance genes (ARGs). Shotgun metagenomics was proposed to be applied to identify antimicrobial resistance ARGs and taxonomic composition throughout the wastewater treatment. In order to link ARGs with specific microbial hosts, we expanded the initially proposed work to conduct Hi-C sequencing. As well as we performing shotgun sequencing of some samples using Nanopore sequencing (Oxford Nanopore Technologies, ONT). These data analyses will allow us to quantify longitudinal changes in target ARGs and associate changes with changes in the taxonomic composition of microbiomes.","organism":null,"data_type":"Raw sequence reads","center_name":"PSU","submission_date":"2024/04/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40935687","Metagenome or environmental sample from wastewater metagenome","2022-12-08","United States","Pennsylvania","State College",40.798214,-77.859909,"uncertain",null,"environmental sample; urban association not established","Metagenome--EnvironmentalWastewater-Algal bacterial biomass- Seed","ENVO:00000428","ENVO:00000486","ENVO:00010483",null,"coordinate","US",5213681,"probable","coordinates",null,"USA",2022],["SAMN40935688","Metagenome or environmental sample from wastewater me