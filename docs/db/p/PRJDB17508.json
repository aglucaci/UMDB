{"v":"3.0.0","project":{"accession":"PRJDB17508","title":"Microbial community structure analysis of microbial fuel cell with intermitted aeration","description":"This project explore the microbial community in microbial fuel cell (MFCs) with intermitted aeration. The sampling sites were selected to represent diverse areas where the presence of microorganisms could impact the performance of MFCs, including anodes of carbon brush (CB), sponges in aeration parts (SP), and the anolyte (AL). Afterward, we determine the function of each microorganism for electricity generation and organic matter removal from sewage.","organism":"microbial fuel cell metagenome","data_type":"Targeted Locus (Loci)","center_name":"Nagoya Institute of Technology","submission_date":"2024/02/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00738023","Bottom of carbon brush anode","2022-08-31","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample evidence",null,"aquatic biome","seawage","seawage",null,"coordinate","JP",1856057,"verified","text+coordinates",null,"Japan:Aichi, Nagoya",2022],["SAMD00738024","Middle of carbon brush anode","2022-08-31","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample evidence",null,"aquatic biome","seawage","seawage",null,"coordinate","JP",1856057,"verified","text+coordinates",null,"Japan:Aichi, Nagoya",2022],["SAMD00738025","Top of carbon brush anode","2022-08-31","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample evidence",null,"aquatic biome","seawage","seawage",null,"coordinate","JP",1856057,"verified","text+coordina