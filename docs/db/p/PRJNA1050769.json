{"v":"3.0.0","project":{"accession":"PRJNA1050769","title":"Enhancing Nitrogen Removal Efficiency through Partial Nitrification-Denitrification in the integrated internal circulation aerated reactor: Microbial Evolution.","description":"An integrated internal circulation aerated bioreactor, possessing a high circulation ratio and the capability to generate oxygen gradients, was optimized and developed in this study, using an air-lift circulating reactor as a foundation, for the treatment of urban sewage. Under the optimal conditions (sludge concentration of 5000 mg/L, HRT of 8 h , and aeration rate of 0.6 L/min), The ammonia oxidation rate and nitrite reduction rate have increased by 35.0% and 213.3%, respectively, significantly improving the nitrogen removal efficiency. The biological samples were 16S sequencing data of sludge samples before and after reactor domestication, which revealed the changing pattern of microbial community inside the reactor.","organism":null,"data_type":"Raw sequence reads","center_name":"Huazhong University of Science and Technology","submission_date":"2023/12/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38751013","Original one","2021-09-06","China","Hubei","Wuhan",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor samples",null,null,null,null,"city","CN",1791247,"verified","text",null,"China: Wuhan",2021],["SAMN38751014","Original two","2021-09-06","China","Hubei","Wuhan",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor samples",null,null,null,null,"city","CN",1791