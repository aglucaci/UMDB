{"v":"3.0.0","project":{"accession":"PRJNA1173482","title":"The effects of Bacillus subtilis and Trichoderma harzianum on the microbial community of pepper soil.","description":"The occurrence of soil-borne plant diseases is closely related to rhizosphere microbiome diversity. Our study analyzed the effects of B. subtilis and T. harzianum on soil microbial diversity and community structure, identifing microbial genera like Agromyces, Nocardiopsis, MND1, Gaiella, Iamia, Massilia, Micromonospora, Fusarium, Gibberella, and Gibellulopsis as manipulable components to help suppress diseases. In summary, we demonstrated that these microbial inoculants can alter the composition and functionality of the soil microbiome, thereby effectively inhibiting PPB and improving pepper yield. These findings contribute to the exploration of specific beneficial rhizosphere microorganisms, providing a scientific basis for the development of rhizosphere microbe-mediated sustainable agriculture.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Cologne","submission_date":"2024/10/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44304639","Bs1aR1","2021-09-15",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2021],["SAMN44304641","Bs2aR1","2021-09-15",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2021],["SAMN44304643","Bs3aR1","2021-09-15",null,null