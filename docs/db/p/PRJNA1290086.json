{"v":"3.0.0","project":{"accession":"PRJNA1290086","title":"Mutual effects of tungsten, molybdenum and selenium on anaerobic digestion microbiome","description":"Molybdenum, tungsten and selenium are essential trace metals required for anaerobic digestion (AD) requried for enzyme function and structural integrity, their synergistic interactions have not been studied in literature. Authors hypothesised that the simultaneous exposure of TE mix and metals (molybdenum, tungsten, or selenium) to anaerobic granular sludge causes differential phenotypic outcomes. The aim of the study is to investigate the role of W, Mo, and Se prevalence on TE mix (Fe, Ni, Co, Cu) solubility and retention, methanogenic activity, EPS production, microbial community composition/ activity. Therefore, furthering the knowledge of unique metal-specific responses of AD microbiome members. Consecutively, utilising this information to identify responsive candidate indicator taxa, observe parallel metal effects, and compare pros and cons of trace metals dosing combinations at optimal concentrations","organism":null,"data_type":"Raw sequence reads","center_name":"MSCA EJD M2eX ITN","submission_date":"2025/07/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49909914","F1","2022-05","Ireland","Connacht","Galway",53.19,-9.02,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater methanogenic granules","diary wastewater sludge","sludge",null,"coordinate","IE",2964180,"verified","text+coordinates",null,"Ireland: Galway",2022],["SAMN49909915","F2","2022-05","Ireland","Connacht","Galway",53.19,-9.02,"probable