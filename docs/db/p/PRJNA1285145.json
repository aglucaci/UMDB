{"v":"3.0.0","project":{"accession":"PRJNA1285145","title":"Maximizing volatile fatty acid yields from sewage sludge: Electrodialysis with bipolar membranes enhanced fermentation driven by heat-alkali pretreatment and pH optimization","description":"High-throughput 16S rRNA sequencing was employed to examine microbial shifts within the system and their impact on volatile fatty acid (VFA) yields. By analyzing the microbial community composition, the study aimed to identify key shifts in microbial populations that influence the efficiency of VFA production. This approach provides deeper insights into the relationship between microbial diversity and the optimization of VFA yields, contributing to a better understanding of the processes driving anaerobic fermentation.","organism":null,"data_type":"Raw sequence reads","center_name":"QIBIBET","submission_date":"2025/07/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49751597","MIMARKS Survey related sample from sludge metagenome","2025-04-12","China","Shandong","Qingdao",36.0671,120.3826,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Waste water","pH=6.8, Temp = 37 Oc","DI water",null,"coordinate","CN",1797929,"verified","text+coordinates",null,"China: Qingdao",2025],["SAMN49751598","MIMARKS Survey related sample from sludge metagenome","2025-04-13","China","Shandong","Qingdao",36.0671,120.3826,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Waste water","pH=6.8, Temp = 37 Oc","DI water",null,"coordinate","CN",1797929,"verified","text+coordinates",null,"China: Qingdao",2025