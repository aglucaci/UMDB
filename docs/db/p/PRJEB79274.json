{"v":"3.0.0","project":{"accession":"PRJEB79274","title":"Hospital metagenome sewage study","description":"A  better understanding of environmental transmission of antibiotic resistance genes (ARG) is required, to control the spread of MDR bacteria in hospitals. Thus our pilot study is aiming to characterize ARG transmission within a tertiary-care hospital and to evaluate the utility of  wastewater as an indicator of ARG landscape within the hospital.      Carbapenemase-producing Klebsiella pneumoniae were isolated from six patients, ten sinks and two wastewater samples. For ARG environmental reservoir assessment samples from ten sinks in two ICUs and a 24-hour composite wastewater sample was taken from the hospital building's outlet. Bacterial whole genome and metagenomic sequencing was used to evaluate the transmission of ARG from patients through sinks to hospital wastewater. Sequence assemblies were analyzed using Resistance Gene Identifier (RGI) combined with the Comprehensive Antibiotic Resistance Database (CARD), to identify known ARG, and a DeepARG (ML) model to compare its performance against the curated database.","organism":null,"data_type":"Other","center_name":"Latvian Biomedical Research and Study Centre","submission_date":"2025/03/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA115988388","SN_1","2023-03-07","Latvia",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","LV",null,"unresolved",null,null,"Latvia",2023],["SAMEA115988390","SN_52","2024-01-24","Latvia",null,null,null,null,"uncertain",null,"environmental sample; urban ass