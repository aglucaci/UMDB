{"v":"3.0.0","project":{"accession":"PRJNA1266479","title":"Metagenomic Profiling of Microbial Communities and the Resistome within Egyptian Hospital Wastewater and Tap water.","description":"Background Antimicrobial resistance (AMR) is a worldwide health concern that endangers the successful treatment of a growing array of infectious diseases, particularly in low- and middle-income countries.AMR is exaggerated by the spread of antimicrobial resistance genes (ARGs) and microbes across humans, animals and the environment. Hospital wastewater (HWW) is the main source of antimicrobial resistant bacteria (ARB) and ARGs in the environment. The current study used high throughput metagenomic nanopore sequencing to investigate the microbial abundance and ARGs or risistome associated with both HWW and tap water in five different hospitals in Cairo, Egypt.","organism":null,"data_type":"Raw sequence reads","center_name":"Nile University","submission_date":"2025/05/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48678712","Metagenome or environmental sample from metagenome","2023-08","Egypt","Cairo","Cairo",30.04778,31.26306,"uncertain",null,"environmental sample; urban association not established","water",null,null,null,"environmental","coordinate","EG",360630,"probable","coordinates",null,"Egypt",2023],["SAMN48678713","Metagenome or environmental sample from metagenome","2023-09","Egypt","Cairo","Cairo",30.0773,31.2778,"uncertain",null,"environmental sample; urban association not established","water",null,null,null,"environmental","coordinate","EG",360630,"probable","coordinates",null,"Egypt",2023],["SAMN48678714","Metagenome or env