{"v":"3.0.0","project":{"accession":"PRJNA1192232","title":"Activated sludge metagenome and metatranscriptome, sequencing and assembly","description":"Sequences belonging to denitrifying endosymbionts associated with protist hosts were searched in publicly-available metagenomes and several metagenome-assembled genomes were retrieved. Additionally, the diversity of denitrifying endosymbionts within one wastewater treatment plant was assessed. The sampled plant is located in Bremen, Germany (53.115 N 8.7105 E) and operates following the anaerobic-anoxic-oxic process. Total DNA was extracted from supernatant and sludge wastewater sampled in the aeration and/or anoxic tanks at three timepoints (October 2022, August 2023, November 2023). DNA was used for metagenomic sequencing (2x150 bp, Illumina NextSeq 2000). Total RNA was extracted from supernatant and sludge wastewater sampled in the aeration tank at two timepoints (August 2023, November 2023). Total RNA was subjected to rRNA depletion followed by metatranscriptomic sequencing (2x150 bp, Illumina NextSeq 2000).","organism":"wastewater metagenome","data_type":"Genome sequencing","center_name":"Max Planck Institute for Marine Microbiology","submission_date":"2024/11/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN45137015","MIMS Environmental/Metagenome sample from wastewater metagenome","2022-10-17","Germany","Bremen","Bremen",53.115,8.7105,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Activated Sludge [ENVO:00002046]","Waste Water [ENVO:00002001]","Waste Water [ENVO:00002001]",null,"coordinate","DE",2944388,"verified","