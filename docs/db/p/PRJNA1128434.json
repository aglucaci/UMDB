{"v":"3.0.0","project":{"accession":"PRJNA1128434","title":"Metagenomic reveals the metabolic mechanism of enhancing anaerobic digestion of lignocellulosic biomass mediated by CO2/O2-Nanobubble water","description":"Nanobubble water (NW) has been reported to enhance anaerobic digestion (AD), but its influence on the metabolic pathway of anaerobic microorganisms remains unclear. In this study, CO2NW and O2NW were employed as AD accelerants to enhance biomethane production from lignocellulosic biomass. The results indicated that the specific methane yields of rice straw in the CO2NW and O2NW treatments increased by 6.9% and 18.3%, respectively, compared with the DW treatment.","organism":null,"data_type":"Raw sequence reads","center_name":"China Agricultural University","submission_date":"2024/06/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN42050715","Metagenome or environmental sample from sludge metagenome","2023-11-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN42050716","Metagenome or environmental sample from sludge metagenome","2023-11-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN42050717","Metagenome or environmental sample from sludge metagenome","2023-11-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,n