{"v":"3.0.0","project":{"accession":"PRJNA1539041","title":"Size-dependent effects of polyethylene micro- and nanoplastics on microalgal-bacterial granular sludge development and microbial community","description":"This project investigates the size-dependent effects of polyethylene micro- and nanoplastics on the development, structural stability, treatment performance, and microbial community of microalgal-bacterial granular sludge (MBGS). Shotgun metagenomic sequencing was used to characterize microbial community composition and functional potential under continuous exposure to nanoplastics of different particle sizes during MBGS formation and maturation. The dataset supports analysis of taxonomic shifts, functional genes, and metabolic pathways associated with granulation, extracellular polymeric substance remodeling, nutrient transformation, and stress response.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Szeged","submission_date":"2026/10/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN63984554","Metagenome or environmental sample from sludge metagenome","2026-05","Hungary","Csongrád","Szeged",46.25,20.14,"uncertain",null,"conflicting evidence: environmental and host/clinical","laboratory",null,null,null,"mixed community","coordinate","HU",715429,"verified","text+coordinates",null,"Hungary: Szeged",2026],["SAMN63984555","Metagenome or environmental sample from sludge metagenome","2026-07","Hungary","Csongrád","Szeged",46.25,20.14,"uncertain",null,"conflicting evidence: environmental and host/clinical","laboratory",null,null,null,"mixed community","coordinate","HU",715429,"verified","