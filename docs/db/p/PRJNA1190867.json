{"v":"3.0.0","project":{"accession":"PRJNA1190867","title":"Algal and bacterial communities in mixotrophic cultures","description":"We investigated a potential of monoculturing Monoraphidium minutum using flue gas condensate water and cheese whey water in outdoor pilot-scale open ponds. Biocontamination is unevitable for cultivations in outdoor open systems. For successful cultivations, invaders should not outcompete the dominant species. In the study, 18S and amplicon sequencing using 18S and 16S rRNA gene markers were applied to keep track on the biocontamination throughout the experiment.","organism":null,"data_type":"Raw sequence reads","center_name":"Linnaeus University","submission_date":"2024/11/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN45059695","P28408_1001","2022-10-19","Sweden","Kalmar","Kalmar",null,null,"uncertain",null,"environmental sample; urban association not established","Baltic Sea, Oland, Kalmar, Sweden",null,"2 wastewaters_replicate 1","Fluegas_whey",null,"country","SE",2702261,"probable","text","region's main city","Sweden: Moskogen, Kalmar",2022],["SAMN45059696","P28408_1002","2022-10-19","Sweden","Kalmar","Kalmar",null,null,"uncertain",null,"environmental sample; urban association not established","Baltic Sea, Oland, Kalmar, Sweden",null,"1 wastewater_replicate 1","Fluegas",null,"country","SE",2702261,"probable","text","region's main city","Sweden: Moskogen, Kalmar",2022],["SAMN45059697","P28408_1003","2022-10-19","Sweden","Kalmar","Kalmar",null,null,"uncertain",null,"environmental sample; urban association not established","Baltic Sea, Oland, Kalmar, Sweden",null,"2 wastewaters_replicate 2",