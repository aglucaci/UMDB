{"v":"3.0.0","project":{"accession":"PRJNA1172352","title":"biofilm metagenome Raw sequence reads","description":"In this study, a three-dimensional biofilm electrode reactor coupled with a pyrite autotrophic denitrification system was constructed to operate under intermittent electric field conditions. The research aimed to explore the denitrification performance and microbial characteristics of the system under different power on/off electrical conditions. High-throughput sequencing results were used to investigate the microbial community structure and key functional genes of the system under intermittent electrical conditions. Additionally, the relationship between microbial characteristics and denitrification efficiency was analyzed.","organism":"biofilm metagenome","data_type":"Raw sequence reads","center_name":"Wuhan University of Technology","submission_date":"2024/10/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44268123","ZTPSN23LC475-R1_5_20_R1.fq","2023-05-29","China","Hubei","Wuhan",30.31,114.2,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"[ENVO:00000428]",null,null,null,"coordinate","CN",1791247,"verified","text+coordinates",null,"China:Wuhan",2023],["SAMN44268124","ZTPSN23LC476-R2_4_20_R1.fq","2023-06-24","China","Hubei","Wuhan",30.31,114.2,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"[ENVO:00000428]",null,null,null,"coordinate","CN",1791247,"verified","text+coordinates",null,"China:Wuhan",2023],["SAMN44268125","ZTPSN23LC477-R3_3_20_R1.fq","2023-07-19","China","Hubei","Wuhan",30.31,114.2,"probable_