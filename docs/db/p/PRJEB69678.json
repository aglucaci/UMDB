{"v":"3.0.0","project":{"accession":"PRJEB69678","title":"Development of an in vitro biofilm model for the study of the impact of fluoroquinolones on sewer biofilm microbiota","description":"Sewer biofilms are likely to constitute hot spots for selecting and accumulating antibiotic-resistant bacteria and antibiotic resistance genes. The objective of this study was to optimize culture conditions to obtain a stable and reproducible in vitro biofilm, mimicking the biofilm collected in sewers, in order to study the impact of fluoroquinolones on sewer biofilm microbiota. Biofilms were produced on coupons in CDC Biofilm Reactors®, continuously fed with nutrient and inoculum. Different culture conditions were tested: (i) initial inoculum: diluted wastewater with or without sewer biofilm, (ii) coupon material: concrete vs polycarbonate, and (iii) time of culture: 7 days (d7) vs 14 days (d14). Biofilms were collected on d7 and d14. Once the growth conditions have been determined, the impact of fluoroquinolones on sewer biofilm microbiota, alone or in combination, was evaluated.","organism":null,"data_type":"Other","center_name":"pf bioinfo genotoul inrae toulouse","submission_date":"2024/03/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA115036622","Wastewater 2","2021-03-02","France",null,null,null,null,"uncertain",null,"environmental sample; urban association not established","sewer",null,null,null,null,"country","FR",null,"unresolved",null,null,"France",2021],["SAMEA115036623","Wastewater 3","2021-03-23","France",null,null,null,null,"uncertain",null,"environmental sample; urban association not established","sewer",null,null,nul