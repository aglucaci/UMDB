{"v":"3.0.0","project":{"accession":"PRJNA1182537","title":"Utilizing Metagenomics to Trace Major Pathogens in Foodborne Diarrhea Outbreaks in Wujiang District, Suzhou, China, 2023","description":"In 2023, students from Suzhou Bay Foreign Language School in Wujiang District reported symptoms of diarrhea. Upon investigation, it was discovered that all students exhibiting these symptoms had consumed pasta served by the school's cafeteria the previous day. To identify the primary pathogen responsible for the incident, samples were collected and analyzed using a combined approach of Illumina next-generation sequencing and Nanopore third-generation sequencing. Further analyses included species annotation, LEfSe (LDA Effect Size) analysis, and evolutionary analyses.","organism":null,"data_type":"Raw sequence reads","center_name":"Soochow University","submission_date":"2024/11/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44598934","Metagenome or environmental sample from indoor metagenome","2023-11-18","China","Jiangsu","Suzhou",31.3,120.58,"probable_urban","built_environment","city-level location without sample-site confirmation","Environment-H11",null,null,null,null,"coordinate","CN",1886760,"probable","coordinates",null,"China: suhzou",2023],["SAMN44598935","Metagenome or environmental sample from indoor metagenome","2023-11-18","China","Jiangsu","Suzhou",31.3,120.58,"probable_urban","built_environment","city-level location without sample-site confirmation","Environment-H13",null,null,null,null,"coordinate","CN",1886760,"probable","coordinates",null,"China: suhzou",2023],["SAMN44598936","Metagenome or environmental sample f