{"v":"3.0.0","project":{"accession":"PRJNA489301","title":"Genome sequencing and assembly of Buchnera aphidicola","description":"Symbiotic interaction between hosts and microbes promotes the establishment of new ecological niches and has profound impacts on the evolutionary trajectory of eukaryotic lineages. Many insects harbor maternally transmitted endosymbionts that provision hosts with key nutrients. One key evolutionary consequence of vertically transmitted symbiosis is rapid degradation of symbiont genomes. We use the system of aphids and their obligate endosymbionts, Buchnera aphidicola, to explore the evolutionary process of symbiont genome degradation and the functional consequences of this process.","organism":null,"data_type":"Genome sequencing and assembly","center_name":"Integrative Biology, University of Texas at Austin","submission_date":"2018/09/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN09980500","Buchnera_aphidicola_str._Aar","2011","Canada","Alberta",null,49.1156,-110.4688,"non_environmental",null,"host-derived or clinical material",null,"sagebrush","sagebrush","air","Artemisaphis artemisicola","coordinate","CA",null,"unresolved",null,null,"Canada: Onefour, Alberta",2011],["SAMN09980501","Buchnera_aphidicola_str._Acr","2010","United States","Arizona","Tucson",32.2318,-110.9507,"non_environmental",null,"host-derived or clinical material",null,"fava bean","fava bean","air","Aphis craccivora","coordinate","US",5318313,"verified","text+coordinates",null,"USA: Tucson, Arizona",2010],["SAMN09980502","Buchnera_aphidicola_str._Ala","2005","United States","Arizona","Tucson",32.2318,-110.9507,"non_environment