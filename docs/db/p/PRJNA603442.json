{"v":"3.0.0","project":{"accession":"PRJNA603442","title":"Planktonic archaea in suspended particulate matter from Northwestern Pacific Ocean surface waters","description":"Planktonic archaea include predominantly Marine Group I Thaumarchaeota (MG I) and Marine Group II Euryarchaeota (MG II), which play important roles in the oceanic carbon cycle. MG I produce specific lipids called isoprenoid glycerol dialkyl glycerol tetraethers (GDGTs), which are being used in the sea surface temperature proxy. Although MG II are the most abundant planktonic archaeal group in surface water, their lipid composition remains elusive because of the lacking of pure cultures. We coupled the archaeal 16S rRNA gene abundance and sequencing to archaeal lipid analysis on surface water samples from Northwestern Pacific Ocean (NWPO) and East China Sea (ECS) in order to determine the contribution of MG II archaea on GDGT distribution in these regions.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2020/01/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN13931403","Metagenome or environmental sample from seawater metagenome","2015-04",null,null,null,36.0,147.0,"non_urban",null,"environmental sample from a non-urban site","ocean water",null,null,null,null,"coordinate",null,null,"unresolved",null,null,"Pacific Ocean",2015],["SAMN13931404","Metagenome or environmental sample from seawater metagenome","2015-04",null,null,null,34.0,147.83,"non_urban",null,"environmental sample from a non-urban site","ocean water",null,null,null,null,"coordinate",null,null,"unresolved",null,null,"Pacific Ocean",2015],[