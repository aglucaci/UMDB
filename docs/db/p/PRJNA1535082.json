{"v":"3.0.0","project":{"accession":"PRJNA1535082","title":"Detection and characterization of Vibrio parahaemolyticus recovered from some wastewater systems in South Africa: A One Health perspective","description":"Antimicrobial resistance (AMR) is an increasing global public health challenge driven by the widespread misuse of antibiotics and the environmental dissemination of antimicrobial resistant microorganisms and antimicrobial resistance genes (ARGs). Wastewater treatment plants (WWTPs) serve as critical reservoirs for antibiotic-resistant bacteria (ARB) and ARGs, due to the inflow of influent from various sources (including hospitals), with many studies reporting municipal WWTPs facilitating ARG persistence and spread into the environment. This study investigated the occurrence and antibiogram characteristics of Vibrio parahaemolyticus isolated from selected WWTPs in the Eastern Cape Province, within the One Health framework.","organism":null,"data_type":"Raw sequence reads","center_name":"University of the Witwatersrand","submission_date":"2026/09/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN63554577","Vibrio parahaemolyticus  53","2025-09-03","South Africa","Eastern Cape","Dimbaza",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","Wastewater treatment plant",null,null,null,null,"country","ZA",1009863,"verified","text",null,"South Africa: Eastern Cape, Dimbaza",2025],["SAMN63554578","Vibrio parahaemolyticus  55","2025-09-03","South Africa","Eastern Cape","Dimbaza",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","Wastewater treatment plant",null