{"v":"3.0.0","project":{"accession":"PRJNA661120","title":"Microbial community composition of a lab-scale submerged MBR","description":"Membrane fouling is a major problem to the widespread application of membrane technologies. In this study, the microbial community composition in a MBR was characterised over time using high-throughput sequencing. In addition, the efficacy of nitric oxide (NO) for reducing transmembrane pressure (TMP) and microbial community changes was investigated. Sequence analysis revealed Bacteroidetes (average at 51%) and Proteobacteria (average at 31.4%) were the most abundant organisms present. There was a strong correlation between the significant reduction in the relative abundance of Saprospiraceae (10.3%) and unclassified TM7-3 (6.7%) in the sludge samples at the time when the TMP began to increase dramatically. Backwashing of the membranes with the NO donor, DETA NONOate, led to a reduction of the TMP by 35% compared to 21% obtained by the control (P-value < 0.05), demonstrating that DETA NONOate effectively reduced biofouling as shown by the improvement in TMP.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Technology Sydney","submission_date":"2020/09/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN15973152","Raw sludge","2018-04","Australia",null,null,-33.8832,115.2005,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"aquatic biome [ENVO:00002023]","wastewater treatment plant [ENVO:00002043]","Activated sludge [ENVO:00002046]",null,"coordinate","AU",null,"unresolved",null,null,"Australia: NSW",2018],["SAMN15973153","S