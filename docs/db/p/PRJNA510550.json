{"v":"3.0.0","project":{"accession":"PRJNA510550","title":"Effect of triclosan on partial denitrification, microbial community and antibiotic resistance genes (ARGs) of a sequencing biofilm batch reactor (SBBR)","description":"The effects of triclosan (TCS) on the performance, extracellular polymeric substances (EPS), microbial community and antibiotic resistance genes (ARGs) of a sequencing batch bioﬁlm reactor (SBBR) were evaluated during partial denitrification. The protein (PN) contents were always higher than polysaccharide (PS) contents in both loosely bound EPS (LB-EPS) and tightly bound EPS (TB-EPS), and the content of TB-EPS was higher than LB-EPS. The community structure of biofilm was obviously different from that of floccular sludge, and it was similar in biofilm and floccular sludge at 5 mg/L TCS. Pseudomonas, Aeromonas, Shewanella and Thaurea were predominant genera. The abundance of nirS was relatively stable and was higher than narG and nosZ.mexF, acrA-02, fabK, etc was screened only when TCS concentration was 5 mg/L.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2018/12/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN10607392","Activated sluage","2017-10-16","China",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","activated sludge",null,null,null,"laboratory","country","CN",null,"unresolved",null,null,"China",2017],["SAMN10607393","Activated sluage","2017-11-21","China",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","activated sludge",null,null,n