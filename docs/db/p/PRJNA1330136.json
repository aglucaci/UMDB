{"v":"3.0.0","project":{"accession":"PRJNA1330136","title":"16S rRNA gene sequencing of soils along a two-year recovery gradient after low-temperature thermal desorption remediation","description":"This dataset contains the raw sequencing data of 16S rRNA gene amplicons generated from soil samples collected in an urban brownfield site following low-temperature desorption (LTTD) remediation. The samples were collected over a two-year period to track the recovery of soil chemistry and microbial communities after remediation treatment. The data include sequences from multiple time points, providing insights into changes in microbial diversity, community structure, and predicted functional profiles in response to the remediation process.","organism":null,"data_type":"Raw sequence reads","center_name":"Peking University","submission_date":"2025/09/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51437921","P1","2025-04","China",null,null,null,null,"confirmed_urban","soil_greenspace","explicit urban setting at sample level","Urban Soil",null,null,null,"soil","city","CN",null,"ambiguous","text","2 places named 'Rudong'","China: Rudong",2025],["SAMN51437922","P2","2025-04","China",null,null,null,null,"confirmed_urban","soil_greenspace","explicit urban setting at sample level","Urban Soil",null,null,null,"soil","city","CN",null,"ambiguous","text","2 places named 'Rudong'","China: Rudong",2025],["SAMN51437923","P3","2025-04","China",null,null,null,null,"confirmed_urban","soil_greenspace","explicit urban setting at sample level","Urban Soil",null,null,null,"soil","city","CN",null,"ambiguous","text","2 places named 'Rudong'","China: Ru