{"v":"3.0.0","project":{"accession":"PRJNA529982","title":"Community-level human gut microbiome study in Oslo, Norway.","description":"In a current BioProject we share the data from the first community-level human gut microbiome study conducted in Norway. The microbial taxa are mirroring community socioeconomic status in the area and its public health status.We have used microbial 16S metabarcoding to study the microbiome of the raw sewage samples collected at VEAS municipal wastewater treatment plant (WWTP) in Oslo Norway. The WWTP serves around 600.000 inhabitants of the municipalities of Oslo, Bærum, Asker, Røyken, Nesodden and is largest WWTP in Norway. The sewage sludge from the WWTP is used as agricultural fertilizer on local farms.The current study was conducted by Alexander K. Bekkelund in frames of the project “The effects of sub-lethal levels of antibiotics on the competitive fitness of E. coli genotypes in the community/hospital sewage”.","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"Creek-Bio","submission_date":"2019/03/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN11290741","Metagenome or environmental sample from wastewater metagenome","2017-04","Norway","Oslo","Oslo",59.7931,10.4974,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level","Raw municipal sewage",null,null,null,null,"coordinate","NO",3143244,"verified","text+coordinates",null,"Norway: Oslo, VEAS WWTP",2017],["SAMN11290742","Metagenome or environmental sample from wastewater metagenome","2017-04","Norway","Oslo","Oslo",59.7931,10.4974,"confirmed_urban","municipal_wastewater","explicit urba