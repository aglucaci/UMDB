{"v":"3.0.0","project":{"accession":"PRJNA1429359","title":"Metabarcoding stem residue as a novel environmental DNA (eDNA) tool to identify spread of Phragmites australis biological control agents.","description":"We assessed whether environmental DNA (eDNA) metabarcoding of stem residues could be used to detect and distinguish the stem-boring noctuid moths Archanara neurica and Lenisa geminipuncta, biological control agents of introduced Phragmites australis released in Ontario, Canada. Using 16S rDNA metabarcoding supplemented with newly generated reference sequences, we analyzed stem residue samples spanning a gradient of quality, including laboratory culture stems (in which agent larvae were present at the time of sampling), confirmed Canadian release sites, and degraded stems from unmanaged Phragmites stands in western New York, USA.","organism":null,"data_type":"Raw sequence reads","center_name":"USACE-Engineer Research and Development Center","submission_date":"2026/02/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56007264","MIMS Environmental/Metagenome sample from metagenome","2025-02-05","Canada","Ontario","Toronto",43.657,-79.39033,"non_environmental",null,"laboratory or culture material",null,"built environment","laboratory culture","plant stem residue","Phragmites australis","coordinate","CA",6167865,"probable","coordinates",null,"Canada: Ontario, University of Toronto",2025],["SAMN56007265","MIMS Environmental/Metagenome sample from metagenome","2024-06-18","Canada","Ontario","Toronto",43.657,-79.39033,"non_environmental",null,"laboratory or culture material",null,"built environment","laboratory culture","p