{"v":"3.0.0","project":{"accession":"PRJNA1302326","title":"Project of controlling antibiotic resistance genes pollution in wastewater","description":"Antibiotics frequently detected in wastewater drive the dissemination of antibiotic resistance genes (ARGs), posing a global public health threat. Microalgae-bacteria symbiosis (MaBS) systems show promise in mitigating ARG spread, yet comparative insights into ARG attenuation performance and mechanisms between biomass and effluent phases remain limited. Here, we investigated phase-specific ARG removal in a conventional sequencing batch reactor (SBR) and MaBS systems. Using metagenomic and metabolomic analyses, we explored ARG distribution, horizontal gene transfer potential, and the role of microalgal metabolites. Collectively, the investigation highlight the phase-specific mechanisms by which microalgae mitigate ARG propagation and emphasize the ecological significance of MaBS in antimicrobial resistance control.","organism":null,"data_type":"Raw sequence reads","center_name":"Qingdao University of Science and Technology","submission_date":"2025/08/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50468486","Metagenome or environmental sample from sludge metagenome","2024-08-30","China","Shandong","Qingdao",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor sample",null,null,null,null,"city","CN",1797929,"verified","text",null,"China: Qingdao",2024],["SAMN50468487","Metagenome or environmental sample from sludge metagenome","2024-08-30","China","Shandong","Qingdao",null,null,"probable_urban","municipal_wastewater"