{"v":"3.0.0","project":{"accession":"PRJNA830987","title":"Pasture soil microbiome after monospecies and multispecies livestock grazing","description":"Soil health has been highlighted as a key dimension of regenerative agriculture, given its critical importance for food production, carbon sequestration, water filtration, and nutrient cycling. Microorganisms are critical components of soil health, as they are responsible for mediating 90% of soil functions. Multi-species rotational grazing is a promising strategy for maintaining and improving soil health, yet the potential effects of this grazing management on soil microbiomes are poorly understood. To address this knowledge gap, we collected soil microbial samples at three timepoints during the 2020 grazing season for 12 total paddocks, which were equally split into four different grazing treatments---cattle only, sheep only, swine only, or multi-species. Shallow shotgun metagenomic sequencing was used to identify taxonomic and functional characteristics of the soil microbial communities.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Oregon","submission_date":"2022/04/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN27745684","cow_paddock1_june_replicateB","2020-06-18","United States","Oregon","Springfield",44.1278,-123.2206,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,"anthropogenic terrestrial biome [ENVO:01000219]","area of pastureland or hayfields [ENVO:01000891]","pasture soil [ENVO:00005773]",null,"coordinate","US",5754005,"verified","text+coordinates",null,"USA: Oregon, Springfield",2020],["SAMN27