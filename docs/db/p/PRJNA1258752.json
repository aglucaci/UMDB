{"v":"3.0.0","project":{"accession":"PRJNA1258752","title":"Microbial community succession during low temperature anaerobic digestion","description":"Anaerobic digestion (AD) is a circular approach to managing organic waste as well as producing biogas (renewable energy) and the process by-product, digestate. Digestate arising from low temperature AD harbors microorganisms that are cold-tolerant. This study seeks to investigate microbial succession in response to gradual temperature reduction during AD. Cold-resilient microbes will be identified and their potential applications in improving low temperature AD will be highlighted.","organism":null,"data_type":"Raw sequence reads","center_name":"Agricultural Research Council - Soil, Climate and Water","submission_date":"2025/05/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48330773","MIMARKS Survey related sample from anaerobic digester metagenome","2022","South Africa","Gauteng","Pretoria",null,null,"probable_urban",null,"city-level location without sample-site confirmation",null,"anaerobic digester",null,null,null,"city","ZA",964137,"verified","text",null,"South Africa: Pretoria",2022],["SAMN48330774","MIMARKS Survey related sample from anaerobic digester metagenome","2022","South Africa","Gauteng","Pretoria",null,null,"probable_urban",null,"city-level location without sample-site confirmation",null,"anaerobic digester",null,null,null,"city","ZA",964137,"verified","text",null,"South Africa: Pretoria",2022],["SAMN48330775","MIMARKS Survey related sample from anaerobic digester metagenome","2022","South Africa","Gauteng","Pretoria",null,null,"probable_urban",null,"city-leve