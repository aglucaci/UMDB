{"v":"3.0.0","project":{"accession":"PRJNA698443","title":"Microbial community of H2/CO2 gas fermentation reactor Raw sequence reads","description":"Waste gas fermentations for commodity chemicals production are showcased as the means to achieve de-fossilization of the chemical industry and more generally the human economy. However, biological production might be hindered by pollutants, such as sulfide, inherent to industrial waste gases. In this work we have looked at the effects of sulfide on fermentative acetogenesis in a 10-L mixed culture fermenter supplied with CO2 and electrolytically produced H2. Highlight of the findings include selective inhibition of methanogenesis compared to acetogenesis, increased production of butyric acid and decrease of the taxonomic diversity of the bacterial community, upon sulfide inhibition.","organism":"bioreactor metagenome","data_type":"Raw sequence reads","center_name":"Ghent University","submission_date":"2021/02/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN17718878","A_EN_BAC_01","2019-10-30","Belgium","Flanders","Gent",51.0527829,3.7067699,"non_environmental",null,"laboratory or culture material",null,"anaerobic bioreactor [ENVO:00002124]","anaerobic bioreactor [ENVO:00002124]","industrial wastewater [ENVO:01000964]",null,"coordinate","BE",2797656,"verified","text+coordinates",null,"Belgium:Ghent",2019],["SAMN17718879","A_EN_BAC_12","2020-01-27","Belgium","Flanders","Gent",51.0527829,3.7067699,"non_environmental",null,"laboratory or culture material",null,"anaerobic bioreactor [ENVO:00002124]","anaerobic bioreactor [ENVO:00002124]","industrial wastewater [ENVO:01000964]",null