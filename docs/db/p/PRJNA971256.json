{"v":"3.0.0","project":{"accession":"PRJNA971256","title":"Seoul 18 Spring Fungi Metagenome","description":"Airborne microorganisms interact with air components (water-soluble ions, pollutants, organic matters and so on) and were affected by local and season. However, the information about airborne microbiome is lack. Especially East Asia have many PM2.5 and pollutants so study of aerosol is essential. To investigate airborne fungal community in Seoul, South Korea during 2018 spring, collecting PM2.5 in quartz filters and sequencing were performed. ITS3/ITS4 was used as primer set (universal primers) for targeting ITS2 gene amplification.","organism":"fungal sp.","data_type":"Metagenome","center_name":"Ewha womans univ.","submission_date":"2023/05/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN35028984","Metagenome or environmental sample from metagenome","2018-03-11","South Korea","Seoul","Seoul",37.61,126.93,"probable_urban","air_dust","city-level location without sample-site confirmation","PM2.5 colleted in quartz filters",null,null,null,"air particulate matter","coordinate","KR",1835848,"verified","text+coordinates",null,"South Korea: Seoul",2018],["SAMN35028985","Metagenome or environmental sample from metagenome","2018-03-12","South Korea","Seoul","Seoul",37.61,126.93,"probable_urban","air_dust","city-level location without sample-site confirmation","PM2.5 colleted in quartz filters",null,null,null,"air particulate matter","coordinate","KR",1835848,"verified","text+coordinates",null,"South Korea: Seoul",2018],["SAMN35028986","Metagenome or environmental sample from metagenome","2018-03-13","South Korea","Seoul","Seo