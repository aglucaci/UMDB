{"v":"3.0.0","project":{"accession":"PRJNA1170315","title":"Metagenomics Analysis in Architectural Heritage: the Ji family's Residence in the Southeast of Shanxi Province, China","description":"Microbial corrosion poses a significant threat to architectural heritage worldwide. This paper used metagenomics to investigate the microbial diversity and taxonomic groups present in the door walls of the residential houses of Ji family, as well as their biological functions and chemical cycles. Taxonomic annotation revealed the predominant microbial taxa associated with wall corrosion, shedding light on their potential impact on structural integrity.","organism":null,"data_type":"Raw sequence reads","center_name":"shanghaibiogenuinetech.co.ltd","submission_date":"2024/10/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44103343","DBD","2023-04-26","China",null,null,36.42,113.07,"uncertain",null,"conflicting evidence: environmental and host/clinical","surface of Dwelling-bad-door on ji family",null,null,null,"metagenomics","coordinate","CN",null,"unresolved",null,null,"China: southern region of Shanxi Province",2023],["SAMN44103344","DBW","2023-04-26","China",null,null,36.42,113.07,"uncertain",null,"conflicting evidence: environmental and host/clinical","surface of Dwelling-bad wall on ji family",null,null,null,"metagenomics","coordinate","CN",null,"unresolved",null,null,"China: southern region of Shanxi Province",2023],["SAMN44103345","DGD","2023-04-26","China",null,null,36.42,113.07,"uncertain",null,"conflicting evidence: environmental and host/clinical","surface of Dwelling-good-door on ji family",null,null,null,"metagenomics","c