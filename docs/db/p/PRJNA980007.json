{"v":"3.0.0","project":{"accession":"PRJNA980007","title":"Free-living and particle associated microbial community dynamics in a free water surface constructed wetland","description":"The dataset contains 16S rRNA sequences of planktonic and sediment microbial community in a free water surface CW operating as a polishing step for secondary treated wastewater. The investigated constructed wetland was located in the South-West England. The study was carried out in summertime (July-September). Water and sediment samples were collected at different sampling points within the CW including inflow and outflow points as well as 2 internal sampling points. Water samples were filtered using 3um membranes to separate particle associated planktonic community and the filtrate was further filtered on 0.22um to capture free-living planktonic community. Sediment samples were collected at the same sampling points as water samples to observe association between sediment and planktonic community.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Bath","submission_date":"2023/06/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN35619136","MIMS Environmental/Metagenome sample from wastewater metagenome","2021-07-14","United Kingdom","England","Bath",51.36,-2.27,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater","secondary treated wastewater in constucted wetland","water sample",null,"coordinate","GB",2656173,"probable","coordinates",null,"United Kingdom: Gloucestershire",2021],["SAMN35619137","MIMS Environmental/Metagenome sample from wastewater metagenome