{"v":"3.0.0","project":{"accession":"PRJNA395598","title":"MICROPLASTICS FROM MUNICIPAL WASTEWATER TREATMENT","description":"Microplastics (<5 mm) are a major and growing global pollution problem. Wastewater treatment plants, or water and resource recovery facilities (WRRFs), are suspected as a point source for microplastics, but the fate of microplastics during wastewater treatment is largely unknown. In this study, we estimated the microplastic load to WRRFs across the United States of America (USA). Further, using 16S rRNA gene sequencing, we evaluated the microbial biofilm colonizing the microplastic surface and identified the influence of wasterwater microbial community on biofilm formation.","organism":"wastewater metagenome","data_type":"Raw sequence reads","center_name":"University of Kansas","submission_date":"2017/07/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN07375673","Influent after grit","2015-06-01","United States","Kansas",null,38.58,-95.13,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"coordinate","US",null,"unresolved",null,null,"USA:Kansas",2015],["SAMN07375674","Activated_slduge","2015-06-01","United States","Kansas",null,38.58,-95.13,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"coordinate","US",null,"unresolved",null,null,"USA:Kansas",2015],["SAMN07375675","Effluent","2015-06-01","United States","Kansas",null,38.58,-95.13,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"coordinate","US",null,"unresolved",null,null,"USA:Kansas",2015],["SAMN07375676","Microplastic collected from Inffluent","