{"v":"3.0.0","project":{"accession":"PRJEB122947","title":"Shifting ammonium loading in rapid sand filters .","description":"Rapid sand filtration is an efficient technology to biologically remove ammonium and manganese during drinking water production. However, when ammonium concentrations are high (>80 µmol L-1), nitrification can interfere with manganese removal. We investigated how variations in ammonium concentration affect the removal of ammonium and manganese and the microbial community composition in two large-scale pilot sand filters filled with either 100% biologically coated sand (“mature filter”) or 83% clean sand supplemented with 17% biologically coated sand (“inoculated filter”).","organism":null,"data_type":"Other","center_name":"Radboud University Nijmegen","submission_date":"2026/07/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA123191793","WO_INOC","2024","The Netherlands",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","NL",null,"unresolved",null,null,"Netherlands",2024],["SAMEA123191794","C1W10B","2024","The Netherlands",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","NL",null,"unresolved",null,null,"Netherlands",2024],["SAMEA123191795","C1W10M","2024","The Netherlands",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","NL",null,"unresolved",null,null,"Netherlands",2024],["SAMEA123191796","C1W10T","2024","The Netherlands",null,null,null,null,"uncertain",null,"