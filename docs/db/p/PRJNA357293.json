{"v":"3.0.0","project":{"accession":"PRJNA357293","title":"Chlorella vulgaris associated bacterial community in a microbial fuel cell treating wastewater - Raw sequence reads","description":"Chlorella vulgaris can be used to treat wastewater and produce oxygen at the cathode of microbial fuel cells (MFCs), thereby enabling biomass and electricity production. We combined both features by growing C. vulgaris at the cathode of MFCs in wastewater previously treated by anodic bacteria. The bioelectrochemical performance was investigated with different catholytes including phosphate buffer and anode effluent either with or without C. vulgaris.","organism":"microbial fuel cell metagenome","data_type":"Raw sequence reads","center_name":"University of Technology Sydney","submission_date":"2016/12/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN06140797","Bacterial_associated_Anode_MFC1","2016-04",null,null,null,null,null,"non_environmental",null,"laboratory or culture material","Fuel cell wastewater bioreactor",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2016],["SAMN06140798","Bacterial_associated_Anode_MFC2","2016-04",null,null,null,null,null,"non_environmental",null,"laboratory or culture material","Fuel cell wastewater bioreactor",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2016],["SAMN06140799","Bacterial_associated_Cathode_MFC1","2016-04",null,null,null,null,null,"non_environmental",null,"laboratory or culture material","Fuel cell wastewater bioreactor",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2016],["SAMN06140800","Bacterial_associated_Cathode_MFC2","2