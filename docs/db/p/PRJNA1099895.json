{"v":"3.0.0","project":{"accession":"PRJNA1099895","title":"Impact of complex carbon on deep sea sediment microbial community structure and function","description":"Deep sea sediments cover two thirds of the planet's surface and are critical contributors to global carbon and nutrient cycles. Despite their importance, the drivers of microbial community structure in these systems are poorly understood. In order to determine the effect of complex carbon on deep sea sediment community structure and function, we conducted highly replicated incubations of serially diluted whale fall sediment with the complex ubiquitous marine polymer chitin and its monomer N-acetylglucosamine. With 16S rRNA gene sequencing, we were able to demonstrate the impact of carbon complexity on these sediment communities, particularly on organisms hypothesized to carry out the low-energy terminal respiratory processes of sulfate reduction and methanogenesis.","organism":null,"data_type":"Raw sequence reads","center_name":"California Institute of Technology","submission_date":"2024/04/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40950294","50 cycle no template PCR negative control 20220614","2022-06-14","United States","California","Pasadena",34.136354,-118.127572,"probable_urban","built_environment","city-level location without sample-site confirmation","PCR contamination",null,null,null,null,"coordinate","US",5381396,"verified","text+coordinates",null,"USA: California, Pasadena",2022],["SAMN40950295","50 cycle agencourt DNA extraction negative control 20220620","2022-06-20","United States","California","Pasadena",34.136354,-118.127572,"probable_urban