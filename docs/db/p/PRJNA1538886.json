{"v":"3.0.0","project":{"accession":"PRJNA1538886","title":"16S rRNA gene profiling of aerobic granular sludge in reactors treating rare-earth tailwater","description":"This study characterizes bacterial communities in aerobic granular sludge from four laboratory sequencing batch reactors (R1-R4) used to evaluate the treatment of rare-earth tailwater. At the end of reactor operation, three sludge samples were independently collected from each reactor, yielding 12 samples in total. Sampling was conducted on 29 April 2026 at Jiangxi University of Science and Technology in Ganzhou, Jiangxi, China. The V3-V4 region of the bacterial 16S rRNA gene was amplified using primers 338F and 806R and subjected to paired-end sequencing. This project provides the raw sequencing reads to support characterization and comparison of bacterial communities among the four reactors.","organism":null,"data_type":"Raw sequence reads","center_name":"Jiangxi University of Science and Technology","submission_date":"2026/10/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN63971788","AGS sample R1_1","2026-04-29","China","Jiangxi","Ganzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","aerobic granular sludge from reactor R1, independent sample 1",null,null,null,null,"city","CN",1810638,"probable","text-population","largest of 2 places named 'Ganzhou'","China: Jiangxi, Ganzhou",2026],["SAMN63971789","AGS sample R1_2","2026-04-29","China","Jiangxi","Ganzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","aerobic granular sludge from react