{"v":"3.0.0","project":{"accession":"PRJEB18627","title":"Intergenerational transfer of antibiotic-perturbed microbiota enhances colitis in susceptible mice","description":"Antibiotics have long-lasting consequences on the gut microbiota with the potential to impact host physiology and health. However, little is known about the transgenerational impact of an antibiotic-perturbed microbiota. Here we demonstrated that adult pregnant female mice inoculated with a gut microbial community shaped by antibiotic exposure passed on their dysbiotic microbiota to their offspring. This dysbiotic microbiota remained distinct from controls for at least 5 months in the offspring without any continued exposure to antibiotics. By using IL-10 deficient mice, which are genetically susceptible to colitis, we showed mice that received an antibiotic-perturbed gut microbiota from their mothers had increased risk of colitis. Taken together, our findings indicate that the consequences of antibiotic exposure affecting the gut microbiota can extend to a second generation.","organism":null,"data_type":"Genome sequencing and assembly","center_name":"NEW YORK UNIVERSITY SCHOOL OF MEDICINE","submission_date":"2017/03/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA27197668","ERR7745687_bin.126","2013-09-07","Tanzania",null,null,null,null,"non_environmental",null,"host-derived or clinical material","human feces",null,null,null,null,"country","TZ",null,"unresolved",null,null,"Tanzania",2013],["SAMEA27198418","ERR7746321_bin.192","2014-04-05","Tanzania",null,null,null,null,"non_environmental",null,"host-derived or clinical material","human feces",null,nul