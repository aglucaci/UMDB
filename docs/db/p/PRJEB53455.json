{"v":"3.0.0","project":{"accession":"PRJEB53455","title":"particle-attached microbial diversity during the AT2018 cruise to the Arctic Ocean","description":"RV Akademik Tryoshnikov left Arkhangelsk on August 17 2018, and on August 22-30 for observations in the western part of the Laptev Sea under the auspice of CATS (The Changing Arctic Transpolar System)/Transdrift program.   water samples for microbial diversity from 40-60L for the big size fraction (Large particles > 100µm, denoted as 'LD') and 2L for the small size fraction (particles < 100µm, denoted as 'SD'). All samples were prefiltered through 100µm nylon mesh. For the large size fraction particles from the pre-filter were flushed onto 0.22µm Sterivex filters and filtrate was pumped for the small size fraction onto 0.22µm Sterivex filters using a Masterflex pump and silicone hoses.  Samples were stored in -80° until DNA extraction. Sequencing was performed using an Illumina MiSeq at the AWI, Bremerhaven, Germany.","organism":null,"data_type":"Other","center_name":"German Federation for Biological Data","submission_date":"2022/09/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA110070135","LD24_18S","2018-09-21",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Arctic Ocean",2018],["SAMEA110070136","LD23_18S","2018-09-18",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Arctic Ocean",2018],["SAMEA110070137","LD21_18S","2018-09-16",null,null,null,null,null,"