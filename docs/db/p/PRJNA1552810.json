{"v":"3.0.0","project":{"accession":"PRJNA1552810","title":"Multi-omics sequencing of sludge samples","description":"Using phenol in sulfate-rich wastewater as an electron donor to drive sulfate reduction is a promising waste-to-resource strategy, but its efficiency and stability remain constrained by limited understanding of how phenol-derived reducing equivalents are partitioned among microbial populations and metabolic pathways. Here, a long-term continuous-flow sulfate-reducing reactor was operated with phenol as the sole external electron donor, and batch inhibition experiments were integrated with genome-resolved metagenomics, meta-transcriptomics, and metabolomics.","organism":null,"data_type":"Raw sequence reads","center_name":"Shanxi University","submission_date":"2026/10/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64520814","Metagenome or environmental sample from sludge metagenome","2025-09-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Sludge sample","unknown",null,null,"unresolved",null,null,null,2025],["SAMN64520815","Metagenome or environmental sample from sludge metagenome","2025-09-13",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Sludge sample","unknown",null,null,"unresolved",null,null,null,2025],["SAMN64520816","Metagenome or environmental sample from sludge metagenome","2025-09-14",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Sludge sample","unknown",null,null,"unresolved",