{"v":"3.0.0","project":{"accession":"PRJNA1548839","title":"Metagenome of sludge-derived biofilm attached on modified anion exchange resin for fluoroquinolone degradation under co-adsorption-biodegradation synergistic system","description":"This BioProject contains metagenomic sequencing data of sludge-derived biofilm attached on **chemically modified anion exchange resin**. Different from the previously submitted project (PRJNA15111975) which adopted unmodified resin carrier, this study focuses on the synergistic removal mechanism of fluoroquinolone antibiotics via combined adsorption and biodegradation. The resin was modified to tune surface hydrophilicity and functional groups, which regulated the colonization, community structure and functional metabolic pathways of biofilm. The metagenomic data was used to characterize microbial composition, antibiotic degradation related functional genes and the underlying synergistic transformation mechanism.","organism":null,"data_type":"Raw sequence reads","center_name":"NJU","submission_date":"2026/10/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64364945","Metagenome or environmental sample from sludge metagenome","2025-05-10T14:24:21Z","China","Jiangsu","Nanjing",32.119572,118.958368,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge derived resin attached biofilm",null,null,null,null,"coordinate","CN",1799962,"verified","text+coordinates",null,"China: Nanjing",2025],["SAMN64364946","Metagenome or environmental sample from sludge metagenome","2025-05-10T14:35:21Z","China","Jiangsu","Nanjing",32.119572,118.958368,"probable_ur