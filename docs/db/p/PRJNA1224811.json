{"v":"3.0.0","project":{"accession":"PRJNA1224811","title":"Aerobic granular sludge from wastewater treatment Raw sequence reads","description":"This study investigates the impact of intermittent aeration on the structure and microbial community of aerobic granular sludge in wastewater treatment. Four reactors were operated under different aeration strategies to evaluate the effects on granule compactness, organic matter, and nitrogen removal efficiency. The microbial diversity and abundance were assessed using 16S rDNA sequencing, with taxonomic classification based on the SILVA database. The findings contribute to understanding how operational conditions influence sludge granulation and microbial composition, providing insights for optimizing wastewater treatment processes.","organism":"sludge metagenome","data_type":"Raw sequence reads","center_name":"Federal University of Rio de Janeiro","submission_date":"2025/02/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46867490","Metagenome or environmental sample from sludge metagenome","2023-08-07","Spain","Andalusia","Granada",37.18322,-3.61567,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater",null,null,null,"granules","coordinate","ES",2517117,"verified","text+coordinates",null,"Spain: Granada, Granada",2023],["SAMN46867543","Metagenome or environmental sample from sludge metagenome","2023-08-17","Spain","Andalusia","Granada",37.18322,-3.61567,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater",null,null,null,"granules","coordinate","ES",2517117,"verified","text+coordinates",null,"Spain: Granada, Granada