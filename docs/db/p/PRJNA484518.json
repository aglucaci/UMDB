{"v":"3.0.0","project":{"accession":"PRJNA484518","title":"Global studies of microbial diversity during a nitrification-denitrification treatment of landfill leachates","description":"In this work, bacterial populations present in samples taken from different points during a nitrification-denitrification treatment of landfill leachates were characterized. Relative abundance of phyla and classes throughout the biological process were determined. In this sense, the samples analized were the following: i) raw leachate (S1), ii) denitrification reactor output (S2), iii) nitrification reactors output (S3 and S4) and iv) ultrafiltration sludge (S5).","organism":null,"data_type":"Raw sequence reads","center_name":"University of Oviedo","submission_date":"2018/08/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN09765719","Denitrification Nitrification Treatment","2016","Spain","Asturias","Gijón",43.496,-5.813,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Raw leachate",null,null,null,null,"coordinate","ES",3121424,"probable","coordinates",null,"Spain: Asturias",2016],["SAMN09765720","Denitrification Nitrification Treatment","2016","Spain","Asturias","Gijón",43.496,-5.813,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Denitrification reactor output",null,null,null,null,"coordinate","ES",3121424,"probable","coordinates",null,"Spain: Asturias",2016],["SAMN09765721","Denitrification Nitrification Treatment","2016","Spain","Asturias","Gijón",43.496,-5.813,"probable_urban","municipal_wastewater","city-level location without sample-site confi