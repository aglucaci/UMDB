{"v":"3.0.0","project":{"accession":"PRJNA1477390","title":"Shotgun metagenomics and metatranscriptomics of naproxen-metabolizing microbial consortia enriched from WWTPs","description":"This BioProject includes shotgun metagenomic and metatranscriptomic sequencing data generated from microbial consortia enriched from wastewater treatment plants (WWTPs) using naproxen as the target substrate. The datasets were produced to characterize the microbial community structure, functional gene content, and gene expression profiles associated with naproxen metabolism. Metagenomic sequencing was used to assess the taxonomic and functional composition of the consortia, while metatranscriptomic sequencing was performed to identify genes and pathways actively expressed during naproxen degradation. The resulting datasets provide a comprehensive resource for investigating microbial processes involved in the biodegradation of pharmaceutical pollutants in wastewater environments.","organism":null,"data_type":"Raw sequence reads","center_name":"Universidad de Salamanca","submission_date":"2026/06/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60754766","Consortium MPO979","2021","Spain","Andalusia","Sevilla",37.31,-5.99,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Wastewater treatment plant",null,null,null,null,"coordinate","ES",2510911,"verified","text+coordinates",null,"Spain: Seville",2021],["SAMN60754767","Consortium MPO981","2021","Spain","Andalusia","Sevilla",37.31,-5.99,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Wastewater treatment plant",null,null,