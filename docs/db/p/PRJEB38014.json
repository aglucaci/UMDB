{"v":"3.0.0","project":{"accession":"PRJEB38014","title":"Mining the ecology of resistome between four wastewater treatment plants","description":"In this project, we collected influent, sludge, and effluent samples from four WWTPs (MNIT, JC, JNU and EHCC) in Jaipur City of India. Among them, MNIT WWTP only treats sewage within the university; JC WWTP primarily receives municipal sewage, but it also receives the discharges from many major hospitals of the city, of which some of them have onsite wastewater treatment facilities such as EHCC and JNU; JNU WWTP is receiving wastewater from the hospital as well as residential colony within the university campus; EHCC WWTP only treats hospital wastewater and adopts chlorine treatment for disinfection. We conducted this metagenomic survey to characterize and compare the compositions of ARGs and biocide/metal resistance genes (BMRGs) in four functioning WWTPs","organism":null,"data_type":"Other","center_name":"the chinese university of hong kong","submission_date":"2021/05/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA6803740","Indian WWTPs","2019-07","India",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","IN",null,"unresolved",null,null,"India",2019],["SAMEA6803741","Indian WWTPs","2019-07","India",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","IN",null,"unresolved",null,null,"India",2019],["SAMEA6803742","Indian WWTPs","2019-07","India",null,null,null,null,"confirmed_urban","municipal_wastew