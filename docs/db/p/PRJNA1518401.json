{"v":"3.0.0","project":{"accession":"PRJNA1518401","title":"16S and 18S rRNA gene amplicon sequencing of algal-bacterial symbiotic sludge","description":"This project contains 16S and 18S rRNA gene amplicon sequencing data of algal-bacterial symbiotic sludge samples. The 16S rRNA gene was amplified to characterize bacterial community structure, and the 18S rRNA gene was amplified to characterize eukaryotic community structure. Samples were collected from a wastewater treatment reactor in China. High-throughput sequencing was performed on the Illumina platform. This dataset provides insights into the microbial community composition and diversity in algal-bacterial symbiotic sludge systems.","organism":"sludge metagenome","data_type":"Raw sequence reads","center_name":"Chongqing Jiaotong University","submission_date":"2026/08/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62690372","Algal-bacterial symbiotic sludge sample D1","2025-07-01","China","Chongqing","Chongqing",29.5,106.5,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"wastewater treatment plant","algal-bacterial symbiotic sludge","sludge",null,"coordinate","CN",1814906,"verified","text+coordinates",null,"China: Chongqing",2025],["SAMN62690373","Algal-bacterial symbiotic sludge sample D2","2025-07-20","China","Chongqing","Chongqing",29.5,106.5,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"wastewater treatment plant","algal-bacterial symbiotic sludge","sludge",null,"coordinate","CN",1814906,"verified","text+coordinates",null,"China: Chongqing",2025],["SAMN62690374","Algal-bacte