{"v":"3.0.0","project":{"accession":"PRJNA1509979","title":"Dynamic Remodeling of the Pulmonary Microenvironment in Paragonimus proliferus Infection","description":"Paragonimiasis, a food-borne zoonosis caused by Paragonimus spp., induces severe pulmonary inflammation and fibrosis. However, the stage-specific interactions among the host, parasite and lung microbiome remain poorly understood. Here, we systematically investigated the dynamic pathogenesis of Paragonimus proliferus (P. proliferus) infection in a rat model across key infection stages (14, 28 and 42 days post-infection dpi) and following triclabendazole (TCBZ) treatment. We employed integrated histopathological, molecular, and microbiome profiling approaches, including multi-region (5R) 16S rRNA gene sequencing and fluorescence in situ hybridization (FISH). Infection induced progressive pulmonary inflammation and fibrosis that peaked at 42 dpi, these changes were significantly alleviated following TCBZ treatment.","organism":null,"data_type":"Raw sequence reads","center_name":"Kunming Medical University","submission_date":"2026/08/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62282149","Ctrl1","2025-05-13","China","Yunnan","Kunming",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","lung",null,null,null,"rat","city","CN",1804651,"verified","text",null,"China: Kunming",2025],["SAMN62282150","Ctrl2","2025-05-13","China","Yunnan","Kunming",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","lung",null,null,null,"rat","city","CN",1804651,"verified","text",null,"China: Kunming",2025],["SAMN62282151","