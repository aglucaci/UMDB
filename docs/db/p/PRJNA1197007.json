{"v":"3.0.0","project":{"accession":"PRJNA1197007","title":"GHG emissions from  algal-bacterial granules","description":"This study aimed to investigate N2O emission characteristics and its mitigation potential using photosynthetically reduced carbon dioxide (CO2). With increasing Chlorophyll-a contents (0-13.4 mg/g-MLVSS), N2O emission factors largely fluctuated within 0.4-3.0%, but uncorrelated with algae contents. The photosynthetically reduced CO2 emissions were positively correlated (R2=0.88) with Chlorophyll-a contents, and it can offset average N2O emissions (1.4%) when Chlorophyll-a achieved 11.1 mg/g-MLVSS. However, the algal-bacterial granules underwent disintegration twice due to decreasing CO2 availability, which indicated that Cyanobacteria-dominated granules can retain higher Chlorophyll-a content compared to Chlorophyta-dominated granules.","organism":null,"data_type":"Raw sequence reads","center_name":"Shanghai Academy of Environmental Sciences","submission_date":"2024/12/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN45771088","Sludge","2023-11-27",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN45771089","Sludge","2023-11-27",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN45771090","Sludge","2023-11-27",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor 