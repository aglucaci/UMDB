{"v":"3.0.0","project":{"accession":"PRJNA1177763","title":"Identification of Wastewater Treatment Plant-Specific Microbial Markers Using 16S rRNA Sequencing","description":"We collected 57 effluent samples for 16S rRNA v4 sequencing from six treatment plants in the Tampere region of Finland between 2016 and 2018. Characterising the microbiome revealed that although each plant had unique microbial profiles, their overall diversity and richness were similar. This provided a robust foundation for identifying plant-specific microbes. Using ANOVA-F for feature selection, we focused on the genus level due to its informative prevalence. Among various models tested, the Gaussian Naive Bayes model yielded the highest accuracy with the fewest relevant microbes. We identified nine bacterial genera and one archaeon, whose relative abundances predicted the origin of the effluent with 92% accuracy.","organism":null,"data_type":"Raw sequence reads","center_name":"Tampere University","submission_date":"2024/10/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44450032","Wastewater effluent WWTP2","2018-07-04","Finland","Pirkanmaa","Tampere",61.49,23.76,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Wastewater effluent",null,null,null,null,"coordinate","FI",634963,"probable","coordinates",null,"Finland: Pirkanmaa",2018],["SAMN44450033","Wastewater effluent WWTP2","2018-08-15","Finland","Pirkanmaa","Tampere",61.49,23.76,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Wastewater effluent",null,null,null,null,"coordinate","FI",634963,"probable","co