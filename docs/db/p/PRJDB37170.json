{"v":"3.0.0","project":{"accession":"PRJDB37170","title":"Metagenomic sequencing of livestock farm wastewater samples from Chongqing, China (PRJCA041830)","description":"This project involves metagenomic sequencing of wastewater samples collected from livestock farms in Chongqing, China. The study aims to investigate microbial community composition, functional gene profiles, and the occurrence of antibiotic resistance genes in agricultural wastewater. Sequencing was performed on the BGI T7 platform, with each sample generating over 20 Gb of paired-end data. The dataset contributes to understanding the ecological impact and public health relevance of microbial pollutants in livestock wastewater environments.","organism":"wastewater metagenome","data_type":"Other","center_name":"Ecological and Environment Monitoring Center of Chongqing","submission_date":"2025/09/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD01632681","CQLS-TZ1 (SAMC5318632)","2023-09-17",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,"farm","sewage","waste water",null,"city",null,null,"unresolved",null,null,"missing: data agreement established pre-2023",2023],["SAMD01632682","CQLS-TZ2 (SAMC5318633)","2023-09-17",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,"farm","sewage","waste water",null,"city",null,null,"unresolved",null,null,"missing: data agreement established pre-2023",2023],["SAMD01632683","CQLS-TZ3 (SAMC5318634)","2023-09-17",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,"farm","sewage","waste water",null,"city