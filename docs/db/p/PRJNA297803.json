{"v":"3.0.0","project":{"accession":"PRJNA297803","title":"Enriched Fermenting and Methanogenic Microbial Communities raw sequence reads","description":"Inoculum from an anaerobic digester was exposed to different concentrations of different fermentable substrates under anaerobic batch conditions in order to understand how loading rate shifts the products of fermentation between methane and volatile fatty acids and what effect this shift has on the fermenting microbial community. This work illustrates how loading rates can effect the distribution of products and community members in various fields where fermentation plays a key role including waste water treatment, biological chemical production, and the human microbiome.","organism":"anaerobic digester metagenome","data_type":"Raw sequence reads","center_name":"Arizona State University","submission_date":"2015/10/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN04146735","Ethanol 100 me- eq./L","2013-03-21","United States","Arizona","Mesa",33.433647,-111.88047,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"desert","anaerobic digester sludge","municipal wastewater",null,"coordinate","US",5304391,"verified","text+coordinates",null,"USA: Mesa, Arizona",2013],["SAMN04146736","Ethanol 200 me- eq./L","2013-03-21","United States","Arizona","Mesa",33.433647,-111.88047,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"desert","anaerobic digester sludge","municipal wastewater",null,"coordinate","US",5304391,"verified","text+coordinates",null,"USA: Mesa, Arizona",2013],["SAMN04146737","Ethanol 400 me- eq./