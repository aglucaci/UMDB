{"v":"3.0.0","project":{"accession":"PRJNA1301052","title":"Gut microbiota changes following PM2.5 exposure in allergic airway inflammation","description":"The goal was to assess the impact of particulate matter 2.5 (PM2.5) exposure on gut microbiota composition in BALB/c mice using an ovalbumin (OVA)-induced allergic airway inflammation model. Fecal pellets were collected at the end of the experimental period to evaluate compositional changes in the gut microbiota among four groups: naive mice, OVA-sensitized mice, PM2.5-exposed mice, and OVA-sensitized mice exposed to PM2.5.","organism":null,"data_type":"Raw sequence reads","center_name":"National Taiwan University","submission_date":"2025/08/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50434178","PBS01","2022","Taiwan","Taiwan","Taipei",25.03553921,121.5183428,"non_environmental",null,"host-derived or clinical material","feces",null,null,null,"Mus musculus","coordinate","TW",1668341,"probable","coordinates",null,"Taiwan:Taipei",2022],["SAMN50434179","PBS02","2022","Taiwan","Taiwan","Taipei",25.03553921,121.5183428,"non_environmental",null,"host-derived or clinical material","feces",null,null,null,"Mus musculus","coordinate","TW",1668341,"probable","coordinates",null,"Taiwan:Taipei",2022],["SAMN50434180","PBS03","2022","Taiwan","Taiwan","Taipei",25.03553921,121.5183428,"non_environmental",null,"host-derived or clinical material","feces",null,null,null,"Mus musculus","coordinate","TW",1668341,"probable","coordinates",null,"Taiwan:Taipei",2022],["SAMN50434181","PBS04","2022","Taiwan","Taiwan","Taipei",25.03553921,121.5183428,"non_environmental",null,"host-derived or cli