{"v":"3.0.0","project":{"accession":"PRJNA792230","title":"Microbial analysis effected by NaClO","description":"Sodium hypochlorite (NaClO) is a commonly used chemical to deal with membrane fouling, but it is toxic to microorganisms. Since the toxic effect in the anaerobic reaction is currently unclear, in the long-term experiment, a lower concentration solution is generally used as a membrane cleaning reagent refers to the aerobic reaction process. In this study, effects of NaClO concentration on the biodegradation performance and the microbial activity was investigated at a NaClO concentration range of 0-9 g/L related to the anaerobic membrane bioreactor via batch experiments and the microbial community analysis. In addition, for seeking a way to maintain the performance of the anaerobic digestion process under the impact of high NaClO concentration, a follow-up batch experiment was further implemented.","organism":null,"data_type":"Raw sequence reads","center_name":"Tohoku University","submission_date":"2021/12/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN24404847","blank","2020-10-19","Japan","Miyagi","Sendai",38.27,140.87,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","blank sludge",null,null,null,null,"coordinate","JP",2111149,"probable","coordinates",null,"Japan:Miyagi",2020],["SAMN24404848","0.5g/L","2020-10-19","Japan","Miyagi","Sendai",38.27,140.87,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","0.5g/L sludge",null,null,null,null,"coordinate","JP",2111149,"probable","coordinates",null,"Japan:Miyagi",2020],["SAMN2440