{"v":"3.0.0","project":{"accession":"PRJNA736108","title":"The skin microbiome in skin cancer progression","description":"The skin microbiome plays a critical role in skin homeostasis and disorders. UV-radiation is the major cause for nonmelanoma skin cancer, but the microbiome might be an additional, unexplored risk factor and potential disease biomarker. We collected and sequenced skin swabs from patients with actinic keratosis (AK) and squamous cell carcinoma (SCC) as well as healthy control individuals. The idea was to identify microbial biomarkers for cancer-precursor AK and malignant SCC to gain understanding of the potential microbial component contributing to skin carcinogenesis.","organism":null,"data_type":"Raw sequence reads","center_name":"The Jackson Laboratory for Genomic Medicine","submission_date":"2021/06/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN19709024","Metagenome or environmental sample from air metagenome","2016/2018","Germany","Baden-Wurttemberg","Heidelberg",49.4169,8.66307,"probable_urban","air_dust","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","DE",2907911,"verified","text+coordinates",null,"Germany: Heidelberg",2016],["SAMN19709136","Metagenome or environmental sample from air metagenome","2016/2018","Germany","Baden-Wurttemberg","Heidelberg",49.4169,8.66307,"probable_urban","air_dust","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","DE",2907911,"verified","text+coordinates",null,"Germany: Heidelberg",2016],["SAMN19709143","Metagenome or environmental sample from air metagenome","2016/2018","German