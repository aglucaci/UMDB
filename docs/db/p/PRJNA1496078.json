{"v":"3.0.0","project":{"accession":"PRJNA1496078","title":"Transcriptomic analysis of Rhodococcus pyridinivorans grown in Organic Liquid Extract (OLE) derived from polyurethane ozonolysis","description":"This project investigates the transcriptomic response of Rhodococcus pyridinivorans grown in an Organic Liquid Extract (OLE) generated by the aqueous ozonolytic depolymerization of polyurethane waste. RNA sequencing was performed to identify differentially expressed genes and metabolic pathways involved in the assimilation of OLE-derived compounds, providing insights into the microbial mechanisms underlying the biological valorization of polyurethane waste.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Seville","submission_date":"2026/07/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61667317","bacterial culture","2022-10-14","Spain","Andalusia","Salteras",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","Sludge from slaughterhouse wastewater treatment plant",null,null,null,null,"city","ES",2511495,"verified","text",null,"Spain: slaughterhouse Matadero del Sur (Salteras)",2022],["SAMN61667318","bacterial culture","2022-10-14","Spain","Andalusia","Salteras",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","Sludge from slaughterhouse wastewater treatment plant",null,null,null,null,"city","ES",2511495,"verified","text",null,"Spain: slaughterhouse Matadero del Sur (Salteras)",2022],["SAMN61667319","bacterial culture","2022-10-14","Spain","Andalusia","Salteras",null,null,"uncertain",null,"conflicting evidence: environmental an