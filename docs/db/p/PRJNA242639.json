{"v":"3.0.0","project":{"accession":"PRJNA242639","title":"Urban river microbes Targeted Locus (Loci)","description":"Microplastic may offer a novel habitat for microbes in the environment, and waste water treatment plant (WWTP) effluent provides a concentrated means for microplastic's entry in rivers. Analysis of our samples compares the bacterial community composition that colonizes microplastic in comparison to those that colonize natural substrate. Samples were collected from the following: water column upstream of a WWTP, water column downstream of a WWTP, organic material downstream of a WWTP, and microplastic.","organism":"aquatic metagenome","data_type":"Targeted Locus (Loci)","center_name":"Loyola University Chicago","submission_date":"2014/03/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN02700017","MIMS Environmental/Metagenome sample from wastewater metagenome","2013-09-13","United States","Illinois","Chicago",42.0220009,-87.7101659,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,null,null,null,null,"coordinate","US",4887398,"verified","text+coordinates",null,"USA: North Shore Channel, Chicago",2013],["SAMN02700018","MIMS Environmental/Metagenome sample from wastewater metagenome","2013-09-13","United States","Illinois","Chicago",42.0220009,-87.710166,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,null,null,null,null,"coordinate","US",4887398,"verified","text+coordinates",null,"USA: North Shore Channel, Chicago",2013],["SAMN02700019","MIMS Environmental/Metagenome sample from wastewater metagenome","2013-09-13","United States","Illi