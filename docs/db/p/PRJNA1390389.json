{"v":"3.0.0","project":{"accession":"PRJNA1390389","title":"Mechanisms of  Quinone-Functionalized FeOOH for Enhanced Nitrogen Removal in a  Micro-aerobic Activated Sludge Process Treating Low C/N Wastewater","description":"Micro-aerobic biological nitrogen treatment technology for low carbon-to nitrogen (C/N) ratio wastewater often faces issues such as high effluent nitrate concentration and unstable treatment performance. This is because the inoculated sludge is typically dominated by heterotrophic denitrification and lacks the specialecological niche of multiple functional microorganisms coexisting under microaerobic conditions. In this study, quinone-functionalized FeOOH was synthesized via a green method and added to a microaerobic bioreactor to investigate its effects on activated sludge and the underlying promotion mechanisms.","organism":null,"data_type":"Raw sequence reads","center_name":"Taiyuan University of Technology","submission_date":"2025/12/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54181269","Metagenome or environmental sample from metagenome","2023-11-08","China","Shanxi","Jinzhong",37.45,112.43,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","activated sludge",null,null,null,null,"coordinate","CN",10942283,"verified","text+coordinates",null,"China:Shanxi,Jinzhong",2023],["SAMN54181270","Metagenome or environmental sample from metagenome","2024-01-12","China","Shanxi","Jinzhong",37.45,112.43,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","activated sludge",null,null,null,null,"coordinate","CN",10942283,"ver