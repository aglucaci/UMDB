{"v":"3.0.0","project":{"accession":"PRJNA705238","title":"Comparative analysis of nitrogen removals and microbial communities in air and pure oxygen aeration systems during treatment of municipal solid waste incineration (MSWI) leachate","description":"In this study, two parallel-operated full-scale anoxic-oxic process trains, one use PO aeration with IS-OTM system and the another used conventional air aeration, were used to evaluate the impact of PO use on the removal efficiencies of pollutions in the MSWI leachate treatment. Furthermore, a comparative metagenomic analysis were performed to reveals the changes of the microbial diversity, metabolism and biological nitrogen removal pathway between two trains.","organism":null,"data_type":"Genome sequencing and assembly","center_name":"South China University of Technology","submission_date":"2021/02/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN18079559","activated sludge","2015-09-22","China","Jiangsu","Changzhou",31.7224,120.0508,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","air aeration tank sample AAT.1",null,null,null,null,"coordinate","CN",1815456,"verified","text+coordinates",null,"China: Changzhou,Jiangsu",2015],["SAMN18079560","activated sludge","2015-09-22","China","Jiangsu","Changzhou",31.7224,120.0508,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","air aeration tank sample AAT.2",null,null,null,null,"coordinate","CN",1815456,"verified","text+coordinates",null,"China: Changzhou,Jiangsu",2015],["SAMN18079561","activated sludge","2015-09-22","China","Jiangsu","Changz