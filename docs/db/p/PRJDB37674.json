{"v":"3.0.0","project":{"accession":"PRJDB37674","title":"Investigating the resistome, bacterial composition, and mobilome in hospital wastewaters in Metro Manila using a shotgun metagenomics approac","description":"We employed shotgun metagenomics to profile the relative abundances of antibiotic resistance genes (ARGs), bacterial composition, and mobile genetic elements (MGEs) in untreated hospital wastewater (HWW) from three tertiary hospitals in Metro Manila, Philippines. A total of 18 HWW samples were collected biweekly over a three-month period (May to July 2023), between 8:00 and 11:00 AM, from three hospitals (Hospital A, Hospital B, and Hospital C) located in Metro Manila. These samples were processed and subjected to shotgun metagenomic sequencing and bioinformatics analysis. DNA was extracted from all 18 samples, and Nextera XT library preparation was performed, followed by shotgun metagenomic sequencing using the Illumina NovaSeq 6000 platform. The resulting sequence reads were analyzed to identify bacterial taxa, ARGs, and MGEs using a range of curated databases. The relative abundances of the resistome, bacterial community, and mobilome were profiled to compare the distinct hospital wastewater environments.","organism":"wastewater metagenome","data_type":"Other","center_name":"Bioinformatics Laboratory, De La Salle University","submission_date":"2026/02/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD01689185","HWW metagenome from Hospital A 2023_05_WK1","2023-05","Philippines","National Capital Region","Quezon City",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"terti