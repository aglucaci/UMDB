{"v":"3.0.0","project":{"accession":"PRJDB7446","title":"Effects of conductive carbon nanomaterials on methanogens","description":"Nano-sized conductive carbon materials have been reported to stimulate methanogenesis by anaerobic microbiomes, while other studies have shown their antibiotic effects on methanogenic and other microbes. The present study examined effects of conductive carbon nanoparticles (carbon black Valcan, CB) on methanogenesis by anaerobic-digester sludge. We found that a high concentration (2% w/v) of CB substantially inhibited methanogenesis from glucose, where acetate was accumulated. Pyrosequencing of 16S rRNA gene fragments amplified from methanogenic sludge samples revealed that methanogens specifically decreased in the presence of CB, suggesting that methanogens are severely damaged by CB.","organism":"sludge metagenome","data_type":"Targeted Locus (Loci)","center_name":"Tokyo University of Pharmacy and Life Sciences","submission_date":"2019/06/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00138520","CB1","2016","Japan","Tokyo","Hachiōji",35.6693,139.4257,"uncertain",null,"environmental sample; urban association not established",null,"anaerobic","anaerobic sludge","water",null,"coordinate","JP",1863440,"verified","text+coordinates",null,"Japan:Tokyo, Hachioji",2016],["SAMD00138521","CB2","2016","Japan","Tokyo","Hachiōji",35.6693,139.4257,"uncertain",null,"environmental sample; urban association not established",null,"anaerobic","anaerobic sludge","water",null,"coordinate","JP",1863440,"verified","text+coordinates",null,"Japan:Tokyo, Hachioji",2016],["SAMD00138522","CB3","2016","Japan","Tokyo","Ha