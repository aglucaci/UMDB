{"v":"3.0.0","project":{"accession":"PRJNA1527086","title":"Microbial community profiling of PHA-accumulating mixed consortia under different organic loading rates","description":"This project investigates the microbial community dynamics in mixed microbial consortia (MMC) used for polyhydroxyalkanoate (PHA) accumulation under four different organic loading rates (1.00x, 1.75x, 2.50x, and 3.25x relative to the chemical oxygen demand of anaerobic fermentation liquor). The 16S rRNA gene V3-V4 region was sequenced to analyze bacterial community composition, beta diversity, and differentially abundant taxa across the four loading conditions. The data support the study of energy allocation strategies and PHA storage mechanisms in mixed microbial cultures. Samples were collected after an 8-hour accumulation period from fed-batch reactors. Sequencing was performed on an Illumina platform. Raw sequence reads are available in the SRA.","organism":null,"data_type":"Raw sequence reads","center_name":"Hunan University","submission_date":"2026/09/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN63068267","PHA accumulation LE rep1","2025-09-01","China","Hunan","Changsha",28.19,112.98,"non_environmental",null,"laboratory or culture material","activated sludge from a sequencing batch reactor","wastewater treatment plant","aerobic bioreactor","activated sludge",null,"coordinate","CN",1815577,"verified","text+coordinates",null,"China: Changsha",2025],["SAMN63068268","PHA accumulation LE rep2","2025-09-01","China","Hunan","Changsha",28.19,112.98,"non_environmental",null,"laboratory or culture material","activated sludge from a sequencing batc