{"v":"3.0.0","project":{"accession":"PRJNA912347","title":"Re-utilization of Fenton sludge as an iron source for the promotion of anammox processes: performance and microbial community","description":"In this study, GF and Fe/GF carriers were used in anammox systems to investigated the feasibility of re-utilization of Fenton sludge. After 90 days cultivation, the NRR of Fe/GF-CSTR reached 72.85%, while it was 52.68% in the GF-CSTR. The loaded iron in GF could promote the cell biosynthesis and metabolic ability of anammox bacteria. Furthermore, Fe/GF also caused the increase microbial diversity contributing to the functional genes related to nitrogen transformation, resulting in the increase on reactor performance. This study offers a novel approach of the re-utilization of Fenton sludge in anammox processes, showing the high potential of anammox engineering application.","organism":null,"data_type":"Raw sequence reads","center_name":"Nanjing Agricultural University","submission_date":"2022/12/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN32237730","sludge","2022-09-06","China","Jiangsu","Nanjing",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","reactor2 d90 sample",null,null,null,"reactor2 sample","city","CN",1799962,"probable","text-population","largest of 3 places named 'Nanjing'","China: Nanjing",2022],["SAMN32237731","sludge","2022-09-06","China","Jiangsu","Nanjing",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","reactor1 d90 sample",null,null,null,"reactor1 sample","city","CN",1799962,"probable","text-population","largest of 3 places named 'Nanji