{"v":"3.0.0","project":{"accession":"PRJNA741046","title":"Drivers and functionality of methanogenic niches within an arid landfill (16S)","description":"Microbiome analysis is now common in select municipal and service ecosystems, including wastewater treatment and anaerobic digestion, but its potential as a diagnostic tool has not yet been evaluated in landfills. Methanogenesis mediated by Archaea is known to be highly active in solid waste microbiomes but is commonly neglected in studies employing next generation sequencing techniques. High resolution of methanogenic niches within a single landfill details operational decisions that positively or negatively impact the commercial production of methane known as biomethanation.Included in this bioproject are 16S sequences only. The same samples were amplified for mcrA and are included in a separate bioproject.","organism":null,"data_type":"Raw sequence reads","center_name":"Arizona State University","submission_date":"2021/06/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN19843592","MIMARKS Survey related sample from aquatic metagenome","2018-06-12","United States","Arizona","Mesa",33.50680741,-111.78764352,"uncertain",null,"no environmental-sample evidence",null,"anthropogenic terrestrial_1","landfill_1","anthropogenic environmental_1",null,"coordinate","US",5304391,"probable","coordinates",null,"USA: Arizona",2018],["SAMN19843593","MIMARKS Survey related sample from aquatic metagenome","2018-06-12","United States","Arizona","Mesa",33.50680741,-111.78764352,"uncertain",null,"no environmental-sample evidence",null,"anthropogenic terrestrial_2","landfill_2","anthropogenic 