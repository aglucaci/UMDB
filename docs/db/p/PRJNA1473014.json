{"v":"3.0.0","project":{"accession":"PRJNA1473014","title":"Synergistic regulation of comammox-anammox coupled autotrophic nitrogen removal by ammonium load and extrinsic AHL signals","description":"The coupling of complete ammonia oxidation (comammox) bacteria and anaerobic ammonium oxidation (anammox) bacteria offers a novel pathway for efficient autotrophic nitrogen removal. However, both are slow-growing autotrophs, and their enrichment and synergistic regulation pose bottlenecks for process application. While acyl-homoserine lactones (AHLs) have been demonstrated to individually promote the growth of either comammox bacteria or anammox bacteria, their regulatory mechanisms within the coupled system, particularly their functional patterns under varying environmental conditions, remain unclear. To address this, seven laboratory-scale continuous-flow biofilm reactors were constructed and operated for 120 days at three influent ammonia loads (13, 26 and 52 mg-N/L/d), with each condition supplemented with either C6-HSL or C8-HSL.","organism":null,"data_type":"Raw sequence reads","center_name":"Anhui university","submission_date":"2026/05/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60531211","sludge sample","2025-03-26","China","Anhui","Hefei",31.77,117.19,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"coordinate","CN",1808722,"probable","coordinates",null,"China",2025],["SAMN60531212","sludge sample","2025-03-26","China","Anhui","Hefei",31.77,117.19,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null