{"v":"3.0.0","project":{"accession":"PRJNA1495419","title":"Air metagenome","description":"This study investigates the microbial community structure and the metabolic potential of carbon (C), nitrogen (N), phosphorus (P), and sulfur (S) cycling in atmospheric particulate matter. Samples of PM2.5 and TSP were collected using high-volume air samplers on a teaching building rooftop at Shandong University (Jinan Campus). By employing shotgun metagenomic sequencing, we aim to characterize the functional gene profiles responsible for nutrient transformation within bioaerosols. Specifically, the study explores how airborne microbes contribute to atmospheric biogeochemical processes through pathways such as nitrogen fixation, sulfur oxidation, and carbon metabolism. These findings provide a deeper understanding of the ecological roles of microorganisms in the urban atmosphere and their potential influence on regional elemental cycling and air quality.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji university","submission_date":"2026/07/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61635113","Metagenome or environmental sample from air metagenome","2015-12-28/2015-12-29","China","Shandong","Jinan",36.67,117.05,"probable_urban","air_dust","urban context stated at BioProject level only","air",null,null,null,null,"coordinate","CN",1805753,"verified","text+coordinates",null,"China: Shandong, Jinan, Shandong University",2015],["SAMN61635114","Metagenome or environmental sample from air metagenome","2015-12-28/2015-12-29","China","Shandong","Jinan",36.67,117.06,"probable_urban","air_dust","urban context stated 