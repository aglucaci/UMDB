{"v":"3.0.0","project":{"accession":"PRJNA1452936","title":"Lytic phages enrich antibiotic-resistant bacteria in activated sludge through preferential infection of antibiotic-susceptible bacteria","description":"This project investigates the contribution of lytic phages to the propagation of antibiotic resistance genes (ARGs) within activated sludge microbiomes. Experimental co-cultures were conducted with varying initial phage-to-bacteria ratios (from 10 to 10000) alongside a control group with no phage addition. Shotgun metagenomic sequencing was performed to evaluate how elevated phage predation pressure drives shifts in bacterial community composition and enriches the abundance of ARGs and mobile genetic elements (MGEs).","organism":null,"data_type":"Raw sequence reads","center_name":"University of Science and Technology BeijingUniversity of Science and Technology Beijing","submission_date":"2026/04/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57246157","CK","2022-08","China","Beijing","Beijing",39.9,116.53,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"urban biome","wastewater treatment plant","activated sludge",null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2022],["SAMN57246158","S10","2022-08","China","Beijing","Beijing",39.9,116.53,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"urban biome","wastewater treatment plant","activated sludge",null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2022],["SAMN57246159","S100","2022-08","China","Beijing","Beijing",39.9,116.53