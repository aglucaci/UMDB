{"v":"3.0.0","project":{"accession":"PRJDB11604","title":"Autothermal thermophilic aerobic digestion for human excreta treatment","description":"Autothermal thermophilic aerobic digestion (ATAD) is used to treat human excreta hygienically. We previously reported a unique full-scale ATAD, showing distinctive bacterial community transitions and producing high-nitrogen-content liquid fertilizer; nevertheless, the mechanism remains unclear. One hypothesis involves using a gas-inducing (GI) agitator. We designed a lab-scale GI system and compared it with a disk-turbine (DT) agitator system by mimicking the temperature shift of full-scale ATAD. The agitation system and its agitation speed greatly affected physicochemical properties and bacterial community structure.","organism":"human feces metagenome","data_type":"Metagenome","center_name":"Kyushu university","submission_date":"2025/09/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00319306","raw human excreta sludge","2019-06-10","Japan","Fukuoka",null,33.5939,130.2135,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"waste treatment plant","seaside","human excreta sludge",null,"coordinate","JP",null,"conflicting","text","'Chikujo' is 77 km from the reported coordinates","Japan:Fukuoka, Chikujo",2019],["SAMD00319307","human excreta sludge after digested for 1 day","2019-06-10","Japan","Fukuoka",null,33.5939,130.2136,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"waste treatment plant","seaside","human excreta sludge",null,"coordinate","JP",null,"conflicting","text","'Chikujo' is 77 km from the reported coordinates",