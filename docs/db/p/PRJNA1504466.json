{"v":"3.0.0","project":{"accession":"PRJNA1504466","title":"Water WWTP Metagenome","description":"Based on metagenomics methods, this study conducted measurements on water samples from a sewage treatment plant in Yinchuan City, focusing on screening antibiotic types. Erythromycin and ofloxacin were identified as the main target antibiotics based on high detection rates. Combined with environmental factor analysis, the occurrence patterns of resistance genes and their correlation with water quality factors were explored. Meanwhile, through host identification, the microbial groups potentially carrying resistance genes were preliminarily revealed, providing a scientific basis for risk prevention and control of resistance genes in sewage treatment plants.","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"Ningxia University","submission_date":"2026/07/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62061502","Yinchuan No.2 WWTP outlet","2024-09-02","China","Ningxia","Yinchuan",null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","anammox sludge",null,null,null,null,"city","CN",1786657,"verified","text",null,"China: Yinchuan",2024],["SAMN62061503","Dali WWTP Phase I outlet","2024-09-02","China","Ningxia","Yinchuan",null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","anammox sludge",null,null,null,null,"city","CN",1786657,"verified","text",null,"China: Yinchuan",2024],["SAMN62061504","Dali WWTP Phase II outlet","2024-09-02","China","Ningxia","Yinchuan",null,null,"confirmed_urban","municipal_wastewater","named urban i