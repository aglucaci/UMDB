{"v":"3.0.0","project":{"accession":"PRJNA1091578","title":"Pre-filled density gradient centrifugation of HPB sludge","description":"The relative abundance of PAOs gradually decreased, indicating that polyphosphate bacteria mainly distributed in the light-density region of active sludge, mainly in free sludge flocs. Denitrifying bacteria's relative abundance increased with density, and the proportion of composite powder carriers also increased, suggesting that denitrifying bacteria tended to attach on the surface of carriers. In the L7 layer, denitrifying bacteria's relative abundance significantly decreased, indicating that denitrifying functional microorganisms preferentially grown on composite powder carriers than inorganic grit particles. This was attributed to the high specific surface area, abundant pore structure, and excellent bio-affinity of composite powder carriers, providing ample active sites for microbial enrichment.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2024/03/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40599170","MIMARKS Survey related sample from wastewater metagenome","2023-08-15","China","Hubei","Wuhan",30.5,114.3,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"wastewater treatment plant","HPB technology","wastewater treatment",null,"coordinate","CN",1791247,"probable","coordinates",null,"China",2023],["SAMN40599171","MIMARKS Survey related sample from wastewater metagenome","2023-08-15","China","Hubei","Wuhan",30.5,114.3,"confirmed_urban","municipal_wastewater","named urban infrastructure at