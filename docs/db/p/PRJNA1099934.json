{"v":"3.0.0","project":{"accession":"PRJNA1099934","title":"Sampling of Pipeline Biofilm and Wastewater","description":"This investigation delves into the issue of elevated hydrogen sulfide (H2S) concentrations within the urban pipeline network of Zhongshan City, China. By collecting biofilm and wastewater samples from the pipeline's interior, the study aims to uncover the microbial communities and bacteriophage dynamics that contribute to these high levels of H2S. The purpose of examining these sample types is to identify the specific microbial interactions and processes responsible for H2S production. Insights gained from this research are expected to inform the development of effective strategies for mitigating the associated risks, thereby safeguarding public health and the integrity of the city's infrastructure.","organism":null,"data_type":"Raw sequence reads","center_name":"Sun Yat-sen University","submission_date":"2024/04/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40961147","Metagenome or environmental sample from metagenome","2022-05","China","Guangdong","Zhongshan",22.52,113.39,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Site1",null,null,null,"Sewage","coordinate","CN",6986104,"verified","text+coordinates",null,"China:Zhongshan",2022],["SAMN40961148","Metagenome or environmental sample from metagenome","2022-05","China","Guangdong","Zhongshan",22.52,113.39,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Site2",null,null,null,"Sewage","coordinate","CN",6986104,"verified","text+coordinates",null,"China:Zhongsha