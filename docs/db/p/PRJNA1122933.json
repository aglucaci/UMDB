{"v":"3.0.0","project":{"accession":"PRJNA1122933","title":"Anaerobic digestion at different voltages","description":"Study on biogas production from pig manure wastewater by microbial electrosynthesis at sub-psychrophilic conditions. In this study, the applied voltage 0.4 V and 0.8 V of MES significantly increased the biogas production and COD removal rate. Biogas production and COD removal rate increased most when the voltage reached 0.8 V, and decreased when the voltage was 1.2 V. Low voltage did not significantly alter the microbial structure, but higher voltage resulted in a significant decrease in Clostridium and Methanosarcina.","organism":null,"data_type":"Raw sequence reads","center_name":"southwest university","submission_date":"2024/06/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41793731","0","2022-09-06","China","Chongqing","Chongqing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","anaerobic digest reactor sample",null,null,null,null,"city","CN",1814906,"probable","text","region's main city","China: Chongqing",2022],["SAMN41793732","0.4","2022-09-06","China","Chongqing","Chongqing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","anaerobic digest reactor sample",null,null,null,null,"city","CN",1814906,"probable","text","region's main city","China: Chongqing",2022],["SAMN41793733","0.8","2022-09-06","China","Chongqing","Chongqing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","anaerobic digest reactor sample",null,null,null,null,"city",