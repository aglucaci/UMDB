{"v":"3.0.0","project":{"accession":"PRJNA625921","title":"Transcriptomic analysis  of female sharpbelly (Hemiculter lucidus) in Ba River","description":"This work aimed at predicting the toxic effects of phenolic compounds in Ba River on the health of female sharpbelly (Hemiculter lucidus) by the de novo transcriptomic analysis of the liver. Sharpbelly, a native fish living in freshwater ecosystem of East Asia, were sampled upstream, near, and downstream of a wastewater discharge to the Ba river. Based on the occurrence of bisphenol A (BPA), nonylphenol (NP), and 4-tert-octylphenol (4-t-OP) in the water and fish sampled from each site, up-, mid-, and down-stream were interpreted as control, high, and low treatment groups, respectively.","organism":null,"data_type":"Raw sequence reads","center_name":"Northwest University","submission_date":"2020/04/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN14611320","Model organism or animal sample from Hemiculter lucidus","2019-03-22","China","Shaanxi","Xi’an",34.368,109.0174,"uncertain",null,"conflicting evidence: environmental and host/clinical","4km upstream of 5th sewage treatment plant (STP5) outfall in Ba river replicate 1",null,null,null,null,"coordinate","CN",1790630,"probable","coordinates",null,"China",2019],["SAMN14611321","Model organism or animal sample from Hemiculter lucidus","2019-03-22","China","Shaanxi","Xi’an",34.368,109.0174,"uncertain",null,"conflicting evidence: environmental and host/clinical","4km upstream of 5th sewage treatment plant (STP5) outfall in Ba river replicate 2",null,null,null,null,"coordinate","CN",1790630,"probable","coordinates",null,"China",2