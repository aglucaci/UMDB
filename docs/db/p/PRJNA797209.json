{"v":"3.0.0","project":{"accession":"PRJNA797209","title":"Wastewater metagenome","description":"Comparison of taxonomic profiles from hospital wastewater and river water. This is significant because it highlights the importance of environmental spread of some priority AR bacteria which share ARGs with other bacteria cohabiting within the same environment. Wastewaters, carrying thousands of human waste samples, can act as early alarming systems to detect AR bacteria coming from the community. In developing countries like Pakistan with largely no wastewater treatment, these contaminating AR bacteria are introduced directly into the fresh water bodies thereby becoming part of that environment.","organism":null,"data_type":"Raw sequence reads","center_name":"University of the Punjab","submission_date":"2022/01/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN24969812","Metagenome or environmental sample from wastewater metagenome","2020-08-22","Pakistan","Punjab","Lahore",31.572139,74.314881,"uncertain",null,"conflicting evidence: environmental and host/clinical","Public Hospital",null,null,null,null,"coordinate","PK",1172451,"verified","text+coordinates",null,"Pakistan: Lahore",2020]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","release_date","spots","bases","avg_length","size_mb","scientific_name","urban_status","experiment_title"],"runs":[["SRR17658478",0,"SRX13826510","Amplicon","AMPLICON","METAGENOMIC","PCR","PAIRED","ILLUMINA","Illumina MiSeq","2022-01-18 22:58:54",161563,80781500,500,38.0,"wastewater me