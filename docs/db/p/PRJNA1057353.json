{"v":"3.0.0","project":{"accession":"PRJNA1057353","title":"Five activated sludge and biofilm samples from a wastewater treatment plant","description":"Microbial community structure diversity was analyzed by 16S rRNA sequencing, five activated sludge and biofilm samples were collected from two reactors, respectively, they were named R1 (inoculated sludge), R2 (oxic phosphorus removal sludge, 56 days), R3 (biofilm, 56 days), R4 (denitrifying phosphorus removal sludge, 136 days), R5 (biofilm, 136 days). Sequencing was performed using IIlumina MiSeq platform and (Shanghai Meiji Technology Co., LTD.), and microbial community structure diversity was analyzed using Mothur (v.1.31.2) and QIIME (vl.8.0) software.The PCR amplified primer name was 338F_806R, the F-terminal sequence was ACTCCTACGGGAGGCAGCAG, and the R-terminal sequence was GGACTACHVGGGTWTCTAAT.","organism":null,"data_type":"Raw sequence reads","center_name":"Qingdao University of Technology","submission_date":"2023/12/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN39129698","sludge","2022-12-15",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","inoculated sludge sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN39129699","sludge","2022-12-15",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","oxic phosphorus removal sludge sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN39129700","biofilm","2022-12-15",null,null,null,null,null,"probable_urban","municipal_wastewater