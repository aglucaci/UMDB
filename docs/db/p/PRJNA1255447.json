{"v":"3.0.0","project":{"accession":"PRJNA1255447","title":"Mechanism Analysis of Multi-pathway Electron Transfer in Anaerobic Ammonia-oxidizing Bacteria Enhanced by Synergistic Fermentation Microbial Consortia","description":"This study delves into the mechanism of multi-pathway electron transfer in anaerobic ammonium-oxidizing bacteria. It particularly emphasizes how fermentation microbial communities can synergistically enhance this process. By exploring the interactions between different microbial groups and their impact on electron transfer pathways, this research aims to provide deeper insights into the functioning of anaerobic ammonium-oxidizing bacteria. Such knowledge is valuable for improving our understanding of microbial processes in environmental biotechnology and related fields.","organism":null,"data_type":"Raw sequence reads","center_name":"Qingdao University","submission_date":"2025/04/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48144233","Biofilm_1","2023-07-01T11:40:20Z","China",null,null,37.510902,122.10054,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",null,"conflicting","text","'qingdao' is 222 km from the reported coordinates","China: qingdao",2023],["SAMN48144234","Biofilm_2","2023-08-01T10:30:20Z","China",null,null,37.510902,122.10054,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",null,"conflicting","text","'qingdao' is 222 km from the reported coordinates","China: qingdao",2023],["SAMN48144235","Biofilm_3","2023-09