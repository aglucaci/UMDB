{"v":"3.0.0","project":{"accession":"PRJNA1260180","title":"Metagenomic sequencing of activated sludge from sewage treatment plants","description":"Achieving energy-efficient simultaneous removal of nitrogen and phosphorus is a key goal for the sustainable development of municipal sewage treatment. This study focused on a large municipal sewage treatment plant in a tropical region. The staged influent multi-stage AO process was adopted to systematically investigate the enrichment characteristics of anaerobic ammonia-oxidizing bacteria in aerobic biofilms and their role in mainstream denitrification. Microbial data were measured by metagenomic sequencing.","organism":null,"data_type":"Raw sequence reads","center_name":"Hainan university","submission_date":"2025/05/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48387612","Metagenome or environmental sample from sludge metagenome","2024-06-27","China","Hainan","Haikou",20.06,110.33,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP-1",null,null,null,"water","coordinate","CN",1809078,"verified","text+coordinates",null,"China:haikou",2024],["SAMN48387613","Metagenome or environmental sample from sludge metagenome","2024-06-27","China","Hainan","Haikou",20.06,110.33,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP-2",null,null,null,"water","coordinate","CN",1809078,"verified","text+coordinates",null,"China:haikou",2024],["SAMN48387614","Metagenome or environmental sample from sludge metagenome","2024-06-27","China","Hainan","Haikou",20.06,110.33,"uncertain",null,"conflicting evidence: environmental and host/clinical","WW