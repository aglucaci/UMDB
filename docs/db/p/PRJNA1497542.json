{"v":"3.0.0","project":{"accession":"PRJNA1497542","title":"Microbial community analysis of ethanol- and methanol-fed partial denitrification-anammox MBBR systems treating real municipal wastewater","description":"16S/18S rRNA gene amplicon sequencing (V4-V8 regions, Oxford Nanopore PromethION) of biofilm samples scraped from AnoxKaldnes K5 carriers in two parallel moving bed bioreactor (MBBR) systems. The reactors were operated for 156 days comparing ethanol and methanol as external carbon sources for a single-stage partial denitrification-anammox (PdNA) process treating real municipal secondary effluent. Biofilm was sampled at three timepoints: inoculation (day 0), end of 20 degrees Celsius operation (day 127), and end of 15 degrees Celsius operation (day 156).","organism":null,"data_type":"Raw sequence reads","center_name":"University of Bologna","submission_date":"2026/07/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61810786","MBBR inoculum biofilm day 0","2024-03-28","Sweden","Skåne","Lund",55.72265083,13.22432203,"non_environmental",null,"laboratory or culture material",null,"urban biome [ENVO:01000249]","anaerobic bioreactor [ENVO:00002124]","biofilm [ENVO:00002034]",null,"coordinate","SE",2693678,"verified","text+coordinates",null,"Sweden: Lund",2024],["SAMN61810787","Methanol PdNA biofilm day 127","2024-08-02","Sweden","Skåne","Lund",55.72265083,13.22432203,"non_environmental",null,"laboratory or culture material",null,"urban biome [ENVO:01000249]","anaerobic bioreactor [ENVO:00002124]","biofilm [ENVO:00002034]",null,"coordinate","SE",2693678,"verified","text+coordinates",null,"Sweden: Lund",2024],["SAMN6181078