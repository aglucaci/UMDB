{"v":"3.0.0","project":{"accession":"PRJNA1007406","title":"Mechanisms  of indigenous bacteria response to copper stress in biogas slurry system","description":"Indigenous bacteria effectively removed copper from biogas slurry. More heavy metals accumulated in LB-EPS, though bacteria secreted more TB-EPS than LB-EPS. The primary removal pathway for copper involved their mineralized precipitation in the cell wall and binding to functional groups in various cellular components. Heavy metal stress significantly altered both the species structure and functional gene composition of the indigenous bacterial community. The indigenous bacterial community upregulated genes related to heavy metal homeostasis, efflux, and DNA repair, enhancing its resistance to high concentrations of copper","organism":null,"data_type":"Raw sequence reads","center_name":"College of Food Science & Technology Nanchang University","submission_date":"2023/08/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37068775","Metagenome or environmental sample from sludge metagenome",null,"China","Jiangxi",null,28.41,115.55,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"coordinate","CN",null,"unresolved",null,null,"China: JiangXi",null],["SAMN37068776","Metagenome or environmental sample from sludge metagenome",null,"China","Jiangxi",null,28.41,115.55,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"coordinate","CN",null,"unresolved",null,null,"China: JiangXi",null],["SAMN37068777","Metagenome or environmental sample from sludge metagen