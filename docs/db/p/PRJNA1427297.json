{"v":"3.0.0","project":{"accession":"PRJNA1427297","title":"Airborne microbial metagenomes of Sudwala Caves, South Africa","description":"This project investigates the composition and functional potential of airborne microbial communities within Sudwala Caves, South Africa, using long-read PacBio HiFi metagenomic sequencing. Air samples were collected from multiple internal cave compartments and external reference sites across two seasonal periods and enriched prior to DNA extraction. Metagenomic sequencing data are accompanied by physicochemical air quality measurements, including particulate matter fractions, formaldehyde concentration, ambient temperature, and relative humidity. The resulting datasets provide a reference resource for studying airborne microbiomes in subterranean environments and support comparative analyses of microbial diversity, functional gene content, and environmental associations.","organism":null,"data_type":"Raw sequence reads","center_name":"University of South Africa","submission_date":"2026/02/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN55910676","Metagenome or environmental sample from metagenome","2024-10","South Africa","Mpumalanga",null,-25.3699,30.6998,"probable_urban","air_dust","city-level location without sample-site confirmation","Cave: Air",null,null,null,null,"coordinate","ZA",null,"unresolved",null,null,"South Africa: Mankelele Mountains, Mpumalanga Province",2024],["SAMN55910677","Metagenome or environmental sample from metagenome","2024-10","South Africa","Mpumalanga",null,-25.3699,30.6998,"probable_urban","air_dust","city-level location without sample-site confirmation","Ca