{"v":"3.0.0","project":{"accession":"PRJNA485391","title":"Response of acetate-degrading methanogenic microbial community to inhibitors","description":"Investigating the effects of kinds of inhibitors on the activity of the acetate-degrading microbial community in methane fermentation is critically important for making countermeasures to decrease inhibition and keep stable operation. In this study, a mesophilic chemostat fed with acetate as the sole carbon source was construct and the dynamic change of acetate-degrading microbial community under the conditions with different concentrations of inhibitors (sulfide, ammonium, chlortetracycline and enrofloxacin) were investigated by using high-throughput sequencing.","organism":null,"data_type":"Raw sequence reads","center_name":"Sichuan University","submission_date":"2018/08/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN09789173","AML-N",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN09789174","AN-18(1)",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN09789175","AN-18(2)",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN09789176","N1-18(1)",null,null,null,null,null,null,"uncertain",null,"enviro