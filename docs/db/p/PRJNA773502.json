{"v":"3.0.0","project":{"accession":"PRJNA773502","title":"Oxidative stress enhances integrase activity during wastewater treatment","description":"We analyzed the prevalence of bacterial resistance to inhibitors of folate biosynthesis in treatment wetlands, a nature-based technology often used for decentralised wastewater treatment. Over a four-year period, we compared an aerated and a non-aerated horizontal subsurface flow wetland receiving the same pre-treated municipal wastewater. We found that while aeration lowers AR gene abundances in the effluent, it also resulted in a transient increase of class 1 integrons copy numbers and integrase activity.","organism":null,"data_type":"Raw sequence reads","center_name":"Karlsruhe Institute of Technology","submission_date":"2021/10/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN22487514","MIMARKS Survey related sample from wastewater metagenome","2014","Germany",null,null,51.50613,12.89758,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"ENVO:00002043","primary treatment effluent","wastewater",null,"coordinate","DE",null,"unresolved",null,null,"Germany: ecotechnology research facility in Langenreichenbach",2014],["SAMN22487515","MIMARKS Survey related sample from wastewater metagenome","2014","Germany",null,null,51.50613,12.89758,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"ENVO:00002043","horizontal sub-surface constructed wetland, fractional length 0.12","wastewater",null,"coordinate","DE",null,"unresolved",null,null,"Germany: ecotechnology research facility in Langenr