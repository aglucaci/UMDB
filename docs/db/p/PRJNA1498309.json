{"v":"3.0.0","project":{"accession":"PRJNA1498309","title":"Bifunctional Humic Acid Governs Synchronous Al- and Fe-bound P Mobilization: Coupled Ligand Competition with Biotic Reduction","description":"Fe-Al composite flocculants applied for wastewater phosphorus (P) removal produce a large amount of Fe-Al co-precipitated sludge. However, the stable lattice structure of Fe/Al-bound P and the distinct mobilization pathways severely restrict the transformation of solid-phase P. In this study, humic acid (HA) was employed as a bifunctional natural mediator to simultaneously destabilize Al-bound P and activate Fe-bound P, bridging the persistent decoupling between these two release pathways.","organism":null,"data_type":"Raw sequence reads","center_name":"TAI YUAN UNIVERSITY OF TECHNOLOGY","submission_date":"2026/07/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61838451","Sludge","2025-06-18",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN61838452","Sludge","2025-06-16",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN61838453","Sludge","2025-06-15",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN61838454","Sludge","2025-06-14",null,null,null,null,null,"uncertain",null,"environmental sa