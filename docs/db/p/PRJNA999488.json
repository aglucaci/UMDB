{"v":"3.0.0","project":{"accession":"PRJNA999488","title":"Hospital wastewater metagenome- the impact of wastewater disinfection on the wastewater microbiome and resistome","description":"The project aims to completely understand the metagenome of hospital wastewater and to determine the effect of chemical disinfection (chlorination) on changes in the metagenome of hospital wastewater. The results will indicate whether hospital wastewater is a reservoir of ARGs and groups of microorganisms with an increased hazardous and importance status.The research will help to better understand the nature and threats posed by hospital wastewater and itsdisinfection. The results could increase the significance of hospital wastewater analysis as an alternativeprogram to monitor specific microbial resistance mechanisms within individual medical units, regions or countries.","organism":null,"data_type":"Raw sequence reads","center_name":"Uniwersytet Warminsko-Mazurski w Olsztynie","submission_date":"2023/07/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN36736192","hospital wastewater metagenome: untreated M2_1","2021-04-20","Poland","Warmia-Masuria","Olsztyn",53.77,20.48,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"hospital wastewater metagenome","untreated hospital wastewater","Wastewater",null,"coordinate","PL",763166,"verified","text+coordinates",null,"Poland:Olsztyn",2021],["SAMN36736193","hospital wastewater metagenome: untreated M2_2","2021-08-24","Poland","Warmia-Masuria","Olsztyn",53.77,20.48,"probable_urban","municipal_wastewater","city-level location without sample-site con