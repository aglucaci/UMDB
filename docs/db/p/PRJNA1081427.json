{"v":"3.0.0","project":{"accession":"PRJNA1081427","title":"Sequencing and DNA Yield Data for Zymo Microbial Community Standard (Cat# D6300) Extracted From Multiple Field-Deployable Sampler Options","description":"Shotgun-sequencing analysis of indoor microbiomes is critical to understanding the impacts of urban environments on human health and wellbeing. However, challenges in collecting sufficient biological material indoors, alongside sampling and processing inconsistencies, contribute to a field-wide crisis of replicability. Here, a sampling method utilizing deployable polydimethylsiloxane coupons optimized for commercially available extraction kits demonstrated greater DNA yields over swab-based protocols, which would improve the replicability of future indoor microbiome research.","organism":null,"data_type":"Raw sequence reads","center_name":"Yale CEA","submission_date":"2024/02/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40175492","Metagenome or environmental sample from synthetic metagenome","2021-11-03","United States","New York","New York City",40.6935461,-73.98750421,"non_environmental",null,"laboratory or culture material","Zymo Microbial Community Standard (Cat# D6300",null,null,null,"Environmental","coordinate","US",5128581,"verified","text+coordinates",null,"USA: NYC, 370 J Street",2021],["SAMN40175493","Metagenome or environmental sample from synthetic metagenome","2021-11-03","United States","New York","New York City",40.6935461,-73.98750421,"non_environmental",null,"laboratory or culture material","Zymo Microbial Community Standard (Cat# D6300",null,null,null,"Environmental","coordinate","US",5128581