{"v":"3.0.0","project":{"accession":"PRJNA1398561","title":"nformation on the microbial community of actual coal-to-hydrogen wastewater treated by partial denitrification -anammox process(PD/A)","description":"The microbial community data is categorized into three systems: the PD/A system, PD/A-FeS system, and PD/A-FeS@ZVI system. Specifically, A_1 and A_2 represent the microbial community information of the PD/A system before and after the toxic shock, respectively. B_1, B_2, B_3, and B_4 correspond to the microbial community data of the PD/A-FeS system before the shock, immediately after the shock, and during the stabilization phase. B_5 and B_6 represent the microbial community data of the PD/A-FeS@ZVI system. These microbial community profiles reflect the microbial succession in the PD/A process during the treatment of actual coal-to-hydrogen wastewater.","organism":null,"data_type":"Raw sequence reads","center_name":"Hefei University of Technology","submission_date":"2026/01/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54453831","MIMARKS Specimen sample from metagenomes","2023-07-10","China","Anhui","Hefei",31.5,117.17,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"biome [ENVO:00000428]","wastewater treatment plant [ENVO:00000340]","anaerobic environment [ENVO:00002032]",null,"coordinate","CN",1808722,"verified","text+coordinates",null,"China: Hefei",2023],["SAMN54453832","MIMARKS Specimen sample from metagenomes","2023-10-20","China","Anhui","Hefei",31.5,117.17,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"biome [ENVO:000004