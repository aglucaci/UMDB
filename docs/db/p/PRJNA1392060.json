{"v":"3.0.0","project":{"accession":"PRJNA1392060","title":"Microbial Mechanisms of Nitrogen Reduction Effects on SOC Pools Under Straw Return in Paddy Soils","description":"This study identified a critical threshold of 20% synthetic nitrogen reduction (80%NR) with full straw return in rice-wheat rotations. The 80%NR treatment maintained grain yield while significantly improving soil carbon dynamics: increasing labile soil organic carbon (36% higher readily oxidizable carbon, 37% more microbial biomass carbon) and enhancing macroaggregate stability. Microbial analysis revealed 28% greater abundance of cellulolytic Firmicutes and Actinobacteria, along with suppressed methanogen populations. Metagenomic data demonstrated upregulation of CO2 fixation genes through the reductive TCA cycle and reduced methane production potential. These findings provide a scientifically validated approach to maintain productivity while enhancing soil carbon sequestration in intensive rice-wheat systems.","organism":null,"data_type":"Raw sequence reads","center_name":"Institute of Plant Protection and Soil Fertilizer, Hubei Academy of Agricultural Sciences","submission_date":"2025/12/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54242428","FN0R0","2025-04-01",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN54242429","FN0R0","2025-04-01",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,20