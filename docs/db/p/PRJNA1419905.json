{"v":"3.0.0","project":{"accession":"PRJNA1419905","title":"Study of cave microbiomes","description":"We conducted a broad survey of microbial diversity in three natural limestone caves and two abandoned mines spanning continental, subtropical, and arid climates in the United States. Using amplicon sequencing of samples composed of soil, rock, water, air, and guano, microbiome composition was found to be primarily structured by cave location, followed by environmental matrix, and transect distance from the cave entrance. Significant heterogeneity was observed both between and within caves, underscoring the need for spatially explicit and multi-matrix sampling to capture representative community profiles.","organism":null,"data_type":"Raw sequence reads","center_name":"U.S. Army Engineer Research and Development Center","submission_date":"2026/02/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN55200728","Metagenome or environmental sample from air metagenome","2022-09","United States","New York",null,42.39,-74.01,"probable_urban","air_dust","city-level location without sample-site confirmation","Cave",null,null,null,null,"coordinate","US",null,"unresolved",null,null,"USA: Hailes Cave, New York",2022],["SAMN55200745","Metagenome or environmental sample from air metagenome","2022-09","United States","New York",null,42.39,-74.01,"probable_urban","air_dust","city-level location without sample-site confirmation","Cave",null,null,null,null,"coordinate","US",null,"unresolved",null,null,"USA: Hailes Cave, New York",2022],["SAMN55200762","Metagenome or environmental sample from air metagenome","2022-09","United States","New York",nu