{"v":"3.0.0","project":{"accession":"PRJNA1552623","title":"Study on the Removal of Quinolone Antibiotics from Water by Microorganisms Immobilized on Polyurethane Carriers","description":"Quinolone antibiotics are widely present in various water bodies and resistant to natural degradation, making effective treatment urgent. Immobilized biological technology shows significant potential for low-concentration pollutant removal, but optimal operating conditions and microbial mechanisms under different environmental factors remain insufficiently understood. In this study, polyurethane (PU) was employed as a carrier to investigate the removal efficiency of quinolone antibiotics (ciprofloxacin, norfloxacin, and enoxacin) and the underlying evolution of microbial communities.","organism":null,"data_type":"Raw sequence reads","center_name":"NJU","submission_date":"2026/10/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64511604","Metagenome or environmental sample from sludge metagenome","2024-05-10T14:24:21Z","China","Jiangsu","Nanjing",32.119572,118.958368,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge derived resin attached biofilm metagenome",null,null,null,null,"coordinate","CN",1799962,"verified","text+coordinates",null,"China: Nanjing",2024],["SAMN64511605","Metagenome or environmental sample from sludge metagenome","2024-05-10T14:35:21Z","China","Jiangsu","Nanjing",32.119572,118.958368,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge derived resin attached biofilm metagenome",null,null,null,null,"coordinate","CN",17