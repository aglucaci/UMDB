{"v":"3.0.0","project":{"accession":"PRJNA1288732","title":"Brucella anthropi A54 and A54_5 was isolated from oil-contaminated sludge samples in Tianjin, China.  Collected in National Petroleum Corporation Research Institute of Safety and Environmental Technology, 05-Aug-2023","description":"Whole Genome Sequencing Analysis of Brucella anthropi A54 and A54_5. This study aims to explore the genomic structural characteristics of Brucella anthropi A54 and A54_5 through whole-genome sequencing technology, systematically analyze its potential functional genes related to petroleum hydrocarbon degradation and carbon assimilation metabolic pathways, and thus clarify the degradation mechanism of petroleum hydrocarbon pollutants and carbon source utilization capacity of this strain at the molecular level. The results will provide genomic evidence for further exploring its application potential in the field of environmental pollutant bioremediation.","organism":null,"data_type":"Raw sequence reads","center_name":"State Key Laboratory of Petroleum Pollution Control","submission_date":"2025/07/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49860973","Brucella anthropi","2023-08-05","China","Tianjin","Tianjin",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","oil-contaminated sludge sample",null,null,null,null,"city","CN",1792947,"probable","text","region's main city","China: Tianjin",2023],["SAMN49860974","Brucella anthropi","2023-08-05","China","Tianjin","Tianjin",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","oil-contam