{"v":"3.0.0","project":{"accession":"PRJNA1169846","title":"Isolation and characterization of bacteriophages with lytic activity against multidrug-resistant non-typhoidal Salmonella from Nairobi City County, Kenya","description":"Non-typhoidal Salmonella NTS are associated with self-limiting enterocolitis in humans, but certain strains can lead to life threatening invasive diseases, particularly in sub-Saharan Africa. In Kenya, multidrug-resistant MDR NTS strains with increasing non-susceptibility to third-generation cephalosporins have been reported, posing a significant public health concern that requires urgent attention. Bacteriophages are increasingly being considered as an alternative treatment for MDR bacterial infections because of the growing ineffectiveness of traditional antimicrobial therapies. This study aimed to isolate and characterize bacteriophages as a potential alternative therapy for infections caused by MDR and ESBL producing NTS.","organism":null,"data_type":"Raw sequence reads","center_name":"Kenya Medical Research Institute","submission_date":"2024/10/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44083729","Viral sample from Salmonella phage vB_SEnST11_KE06","2022-10-15","Kenya","Nairobi County","Nairobi",null,null,"non_environmental",null,"host-derived or clinical material","Sewage",null,null,null,"Salmonella","country","KE",184745,"probable","text","region's main city","Kenya:Nairobi, Ruai sewage treatment influent",2022],["SAMN44083731","Viral sample from Salmonella phage vB_STmST19_KE12","2022-10-15","Kenya","Nairobi County","Nairobi",null,null,"non_environmental",null,"host-derived or clinica