{"v":"3.0.0","project":{"accession":"PRJNA1557617","title":"Microbial community and metagenomic responses of a hydrolysis acidification/oxic wastewater treatment system to berberine hydrochloride exposure","description":"This project investigates the effects of berberine hydrochloride (BH) exposure on microbial communities and functional potential in a hydrolysis acidification/oxic (HA/O) wastewater treatment system. Activated sludge samples were collected from control and BH-exposed HA and oxic stages during long-term operation. Bacterial community succession was characterized by 16S rRNA gene amplicon sequencing, while shotgun metagenomic sequencing was used to evaluate taxonomic composition and functional genes associated with carbon metabolism, nitrogen transformation, electron transfer, carbohydrate-active enzymes, and antibiotic resistance. The dataset was generated to elucidate microbial and functional responses to BH exposure and to assess potential resistance-related ecological risks during biological wastewater treatment.","organism":null,"data_type":"Raw sequence reads","center_name":"Donghua university","submission_date":"2026/11/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64709522","Activated sludge from control HA reactor","2020-08-15","China","Shanghai","Shanghai",31.06,121.21,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","activated sludge",null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2020],["SAMN64709523","Activated sludge from BH-exposed HA reactor","2020-08-15","China","Shanghai","Shanghai",31.06,121