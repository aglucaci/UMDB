{"v":"3.0.0","project":{"accession":"PRJNA926812","title":"Landfill leachate, wastewater and river water sequencing","description":"The main purpose of the study was to determine relationships between the presence of landfill leachate in wastewater delivered to wastewater treatment plant (WWTP) and the changes in microbial community as well as spread of drug resistance in the environment. For the study, two WWTPs characterized by a similar composition of the received wastewater and treatment technology was selected, one of which additionally carried out the leachate co-treatment process. Both leachate, as well as treated and untreated wastewater, and river water samples before and after wastewater point discharge, collected from both WWTPs were analyzed.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Warmia and Mazury in Olsztyn, Poland","submission_date":"2023/01/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN32884807","treated wastewater","2021-10","Poland","Warmia-Masuria","Nowe Miasto Lubawskie",53.41,19.57,"non_urban",null,"BioProject indicates an agricultural or industrial source","wastewater",null,null,null,"environment","coordinate","PL",3090613,"probable","coordinates",null,"Poland: Warmia and Mazury",2021],["SAMN32884808","treated wastewater","2021-10","Poland",null,null,53.49,22.21,"non_urban",null,"BioProject indicates an agricultural or industrial source","wastewater",null,null,null,"environment","coordinate","PL",null,"unresolved",null,null,"Poland: Warmia and Mazury",2021],["SAMN32884809","untreated wastewater","2021-10","Poland","Warmia-Masuria","Nowe Miasto Lubawskie",53.41