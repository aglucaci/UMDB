{"v":"3.0.0","project":{"accession":"PRJNA1146144","title":"Biodegradable polylactic acid shapes the nitrogen-transforming microbial community structure and function of wastewater treatment ecosystems","description":"The partial nitrification/denitrification (PND) process is green biotechnology for nitrogen removal in low C/N wastewater. However, it faces challenges in inhibiting nitrite-oxidizing bacteria (NOB). Here, we proposed a novel operation strategy with dosage of polylactic acid (PLA), a representative biodegradable plastic, aiming at selectively eliminate NOB as well as enrich AOB and denitrifiers in wastewater treatment. Additionally, we further explored how PLA regulates the structure and function of nitrogen-transforming bacteria (NTB).","organism":null,"data_type":"Raw sequence reads","center_name":"SUN YAT-SEN UNIVERSITY","submission_date":"2024/08/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43085251","Metagenome or environmental sample from activated sludge metagenome","2022-12-23","China","Guangdong","Guangzhou",23.47,113.23,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","activate sludge",null,null,null,null,"coordinate","CN",1809858,"verified","text+coordinates",null,"China:Guangzhou, Guangdong",2022],["SAMN43085252","Metagenome or environmental sample from activated sludge metagenome","2022-12-23","China","Guangdong","Guangzhou",23.47,113.23,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","activate sludge",null,null,null,null,"coordinate","CN",1809858,"verified","text+coordinates",null,"China:Guangzhou, Gua