{"v":"3.0.0","project":{"accession":"PRJNA1119721","title":"Particulate matter pollution alters the bacterial community structure on the human skin with enriching the Acinetobacter and Psedomonas in vivo","description":"This study aims to investigate the effects of particulate matter pollution on the bacterial community structure of the human skin. We analyzed skin microbiota samples collected during haze and non-haze days in spring and winter. Using high-throughput sequencing, we examined the diversity, taxonomic composition, cooccurrence network, and functional potential of the skin bacterial community. Our findings contribute to the understanding of how environmental pollution affects the skin bacterial community and highlight the potential health risks associated with the altered skin bacteria due to haze pollution.","organism":null,"data_type":"Raw sequence reads","center_name":"Xinxiang Medical University","submission_date":"2024/06/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41663151","MIMS Environmental/Metagenome sample from skin metagenome","2018-11-29","China","Henan","Xinxiang",35.28,113.93,"non_environmental",null,"host-derived or clinical material",null,"skin biome","retroauricular crease","female","Homo sapiens","coordinate","CN",1788572,"verified","text+coordinates",null,"China: Xinxiang",2018],["SAMN41663152","MIMS Environmental/Metagenome sample from skin metagenome","2018-12-30","China","Henan","Xinxiang",35.28,113.93,"non_environmental",null,"host-derived or clinical material",null,"skin biome","retroauricular crease","female","Homo sapiens","coordinate","CN",1788572,"verified","text+coordinates",nu