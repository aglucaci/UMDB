{"v":"3.0.0","project":{"accession":"PRJNA1397345","title":"Metagenomic and 16S rRNA gene sequencing of microbial communities in Nitrospira-driven partial denitrification coupled with anammox systems","description":"This dataset comprises metagenomic and 16S rRNA gene amplicon sequences from laboratory-scale bioreactors investigating the coupling between Nitrospira-driven partial denitrification and anammox for enhanced nitrogen removal. The project aims to 1) characterize the partial denitrification kinetics of Nitrospira under different electron donors, 2) evaluate the coupling efficiency and contribution to nitrogen removal, and 3) elucidate the underlying molecular mechanisms driving the metabolic shift from nitrite oxidation to nitrate reduction. Samples include NOB-enriched biomass (Nitrospira japonica), AnAOB-enriched biomass (Candidatus Brocadia), and partial nitrification-anammox (PNA) biofilms treated with sodium formate, acetate, or glucose. The data capture the resulting microbial community dynamics and functional potential, revealing the key role of formate in facilitating a synergistic partnership between Nitrospira and anammox bacteria. This resource provides foundational insights into a novel nitrogen-removal pathway and supports further research in optimizing microbial interactions for advanced wastewater treatment.","organism":null,"data_type":"Raw sequence reads","center_name":"Jinan University","submission_date":"2026/01/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54422578","Metagenome or environmental sample from activated sludge metagenome","2025-11","China","Guangdong","Guangzhou",23.01,113.41528