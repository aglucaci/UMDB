{"v":"3.0.0","project":{"accession":"PRJNA1097068","title":"Feasibility Study on In Situ Coupled System of Microalgae-Bacteria and Photocatalysis for Coking Wastewater Treatment: Synergistic Mechanism and Treatment Performance","description":"Traditional biological treatment technologies have difficulty stably treating industrial wastewater with high biological toxicity, such as coking wastewater. This study constructed an in situ coupled system of algal-bacterial consortium and immobilized photocatalysis for treating practical industrial coking wastewater. The introduction of polyether polyurethane-graphene foam carrier in situ coupled photocatalysis, bacteria and algae with good biocompatibility and enhanced the ecological stability of the system. This study verified the efficiency and synergistic mechanism of immobilized photocatalysis-algal-bacterial consortium in situ coupled system for treating practical industrial coking wastewater, providing ideas for the R&amp;D of novel biological intensified treatment technologies.","organism":null,"data_type":"Raw sequence reads","center_name":"Shaanxi University of Science and Technology","submission_date":"2024/04/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40861424","Original aerobic activated sludge1","2021-09-15","China","Shaanxi","Xi’an",null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","activated sludge",null,null,null,null,"city","CN",1790630,"probable","text-population","largest of 5 places named 'Xi'an'","China:Xi'an",2021],["SAMN40861425","Original aerobic activated sludge2","2021-09-15","China","Shaanxi","Xi’an",null,null,"no