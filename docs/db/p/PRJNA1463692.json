{"v":"3.0.0","project":{"accession":"PRJNA1463692","title":"Sludge from different pore-modified biochar groups Genome sequencing and assembly","description":"Precise regulation of pore size distribution is the key factor for maximizing methane production. This requires a strategic balance between transport channels and microbial colonization spaces. The directional regulation of biochar pore structure for optimizing AD performance remains poorly elucidated. This work systematically studied how different modification methods regulate the surface and structural traits of biochar. This work aimed to reveal underlying mechanisms of biochar-mediated AD and provide theoretical guidance for the precise design of tailored porous structure.","organism":"sludge metagenome","data_type":"Genome sequencing and assembly","center_name":"Xi'an University of Architecture and Technology","submission_date":"2026/05/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN59598940","MIMARKS Survey related sample from metagenome","2024-08-16T13:45:30Z","China","Shaanxi","Xi’an",34.24,108.97,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered","anaerobic digester sludge","sludge",null,"coordinate","CN",1790630,"verified","text+coordinates",null,"China:Xi'an",2024],["SAMN59598941","MIMARKS Survey related sample from metagenome","2024-08-16T14:00:10Z","China","Shaanxi","Xi’an",34.24,108.97,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered","anaerobic digester sludge","sludge",null,"coordinate","CN",1790630,"verified","text+coordinates"