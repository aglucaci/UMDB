{"v":"3.0.0","project":{"accession":"PRJNA1148285","title":"Sulfur metabolism 16S Raw sequence reads","description":"Biotrickling filter (BTF) is a green and effective method in odor mitigation, which has the advantages of low cost and less by-products. Here, hydrogen sulfide (H2S), dimethyl sulfide (DMS) and dimethyl disulfide (DMDS) were seen as the dominant sulphureous odorants, and the biodegradation performance of these odorants was evaluated in BTF, in which was packed with two modified PP materials and the SDBS was also added. The microbial adaption was investigated under starvation and low temperature under PP modification. Microbial samples were obtained from four stages: starvation (124th day), recovery from starvation (153th day), low temperature (184th day), and recovery to 25 (216th day).","organism":"biofilter metagenome","data_type":"Raw sequence reads","center_name":"Zhejiang University","submission_date":"2024/08/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43191384","MIMARKS Survey related sample from activated sludge metagenome","2024-02-21","China",null,null,29.11,118.5,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",null,"conflicting","text","'Hangzhou' is 208 km from the reported coordinates","China:Hangzhou",2024],["SAMN43191385","MIMARKS Survey related sample from activated sludge metagenome","2024-02-21","China",null,null,29.11,118.6,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",null,"conflicting","text","'Hangzhou' 