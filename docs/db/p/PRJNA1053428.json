{"v":"3.0.0","project":{"accession":"PRJNA1053428","title":"Rumen microbial sequencing of Wenshan cattle","description":"Wenshan cattle is one of the local cattle breeds with the largest single stock and the most complete genetics in China. It is favored by people because of its strong adaptability, fast growth, strong physique, tender meat and rich protein. Therefore, in the case of high corn prices, the use of barley to replace some corn can improve the efficiency of Wenshan cattle breeding. In this study, barley was used to replace part of corn and soybean meal for the fattening of Wenshan cattle, and its effects on host fattening performance, blood indexes and rumen microorganisms were explored to provide basic research data for short-term fattening.","organism":null,"data_type":"Raw sequence reads","center_name":"Yunnan Agricultural University","submission_date":"2023/12/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38859351","SAMN37211705","2021-10-30T14:41:36Z",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","activated sluge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2021],["SAMN38859352","SAMN37211706","2021-10-30T14:41:37Z",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","activated sluge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2021],["SAMN38859353","SAMN37211707","2021-10-30T14:41:38Z",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","activated sluge",null,null,null,null,"unknown",null,null,"unresolv