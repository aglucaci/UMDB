{"v":"3.0.0","project":{"accession":"PRJNA1020651","title":"Microbial consortium from extremely effective sugar factory wastewater treatment plant","description":"The on-site wastewater treatment plant in Dobrzelin sugar factory is a closed system efficiently treating wastewater generated as a result of sugar production process in self-sustainable water circuit. Modernization efforts have been undertaken to enable the use of the resulting bio-methane for energy purposes in its entirety.In this study we characterize the microbial community from the Dobrzelin sugar factory wastewater treatment plant and indicate modernization efforts undertaken to enable its operation in self-sustainable energy and water circuits.","organism":null,"data_type":"Raw sequence reads","center_name":"Institute of Biochemistry and Biophysics Polish Academy of Sciences","submission_date":"2023/09/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37527267","before_modernization 1","2017-10-26/2017-11-22","Poland","Łódź Voivodeship","Żychlin",52.22728461,19.6002283,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Waste treatment plant","[ENVO:00002043]","[ENVO:2000003]",null,"coordinate","PL",3079897,"probable","coordinates",null,"Poland:Dobrzelin",2017],["SAMN37527268","before_modernization 2","2017-10-26/2017-11-22","Poland","Łódź Voivodeship","Żychlin",52.22728461,19.6002283,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Waste treatment plant","[ENVO:00002043]","[ENVO:2000003]",null,"coordinate","PL",3079897,"probable","coordinates",null,"Poland: