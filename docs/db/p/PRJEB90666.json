{"v":"3.0.0","project":{"accession":"PRJEB90666","title":"Optimizing storage, high-molecular weight DNA extraction and genome reconstructions from human faecal samples","description":"We assessed the effectiveness of extracting high molecular weight DNA from faecal samples, using different combinations of collection, storage and extraction kits. Faecal samples were either immediately processed, frozen at -80°C or stored in DNA/RNA Shield, GutAlive or OMNIgeneGUT and then subjected to 3 different DNA isolation kits, totalling 32 evaluated combinations. Isolated DNA was assessed for its quality and quantity using Qubit, NanoDrop and Tapestation; taxonomic consistency of extracted microbiomes was validated using  metataxonomics.","organism":null,"data_type":"Other","center_name":"Quadram Institute Bioscience","submission_date":"2025/08/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA118581495",null,null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA118581496",null,null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA118581497",null,null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA118581498",null,null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,nu