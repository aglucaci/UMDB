{"v":"3.0.0","project":{"accession":"PRJNA1439590","title":"16S rRNA amplicon sequencing of wastewater microbial communities","description":"This project aims to characterize the microbial community composition of wastewater samples using 16S rRNA gene amplicon sequencing. Wastewater environments harbor diverse microbial populations that play important roles in nutrient cycling, pollutant degradation, and public health monitoring. By analyzing the taxonomic profiles of these microbial communities, this study provides insights into microbial diversity, environmental dynamics, and potential indicators of contamination or ecosystem changes. The generated data will contribute to a better understanding of wastewater microbiomes and support future environmental and epidemiological studies.","organism":"wastewater metagenome","data_type":"Targeted loci environmental","center_name":"Gyeongsang National University","submission_date":"2026/03/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56587575","MIMARKS Survey related sample from wastewater metagenome","2025-05-12","South Korea","Gyeongsangnam-do","Chinju",35.2047,128.1243,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"South Korea: Jinju Domestic wastewater treatment plant","activated sludge","sludge",null,"coordinate","KR",1846052,"probable","coordinates",null,"South Korea: wastewater treatment plant",2025],["SAMN56587576","MIMARKS Survey related sample from wastewater metagenome","2025-05-12","South Korea","Gyeongsangnam-do","Chinju",35.2047,128.1243,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample lev