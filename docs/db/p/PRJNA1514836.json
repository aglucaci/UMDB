{"v":"3.0.0","project":{"accession":"PRJNA1514836","title":"Integrated cross-sectoral surveillance of antimicrobial resistance genotypes and phenotypes across disparate reservoirs","description":"Disparate environmental samples were collected from natural, urban and agricultural settings across Melbourne, VIC, Australia. These samples were subjected to metagenome sequencing, but also used to culture bacterial isolates for genome sequencing with the ultimate goal of understanding AMR distribution in these environments. Here, we demonstrate that, following sample-specific pre-processing, common surveillance approaches can be applied consistently to profile AMR abundance, distribution, and phenotypes across diverse reservoirs from both urban and agricultural settings.","organism":null,"data_type":"Raw sequence reads","center_name":"Monash University","submission_date":"2026/08/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62523395","Metagenome or environmental sample from soil metagenome","2020-10-19","Australia","Victoria","Melbourne",-37.871947,145.032775,"confirmed_urban","soil_greenspace","explicit urban setting at sample level","urban park soil",null,null,null,null,"coordinate","AU",2158177,"verified","text+coordinates",null,"Australia: Melbourne",2020],["SAMN62523396","Metagenome or environmental sample from soil metagenome","2020-10-19","Australia","Victoria","Melbourne",-37.871622,145.030669,"confirmed_urban","soil_greenspace","explicit urban setting at sample level","urban park soil",null,null,null,null,"coordinate","AU",2158177,"verified","text+coordinates",null,"Australia: Melbourne",2020],["SAMN62523397","Metage