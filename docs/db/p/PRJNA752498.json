{"v":"3.0.0","project":{"accession":"PRJNA752498","title":"Alkaline co-fermentation of municipal wastes for volatile fatty acids production","description":"Volatile fatty acid (VFA) production via alkaline co-fermentation is an efficient strategy to maximize resource recovery from organic wastes. This study comprehensively investigated the effect of substrate proportions on alkaline co-fermentation of primary sludge (PS) and external organic waste (OW) at initial pH 10 with OW proportions of 0%, 25%, 50%, 75%, 100% in terms of COD. Subsequently, an up-scaled semi-continuous experiment with 50% OW was performed at a set pH of 10 and 9 for 315 days to elucidate system robustness and microbial community dynamics.","organism":null,"data_type":"Raw sequence reads","center_name":"KTH Royal Institute of Technology","submission_date":"2021/08/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN20599615","D0.1","2019-02-11","Sweden","Stockholm","Stockholm",59.30965637,18.10889692,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered_system","anaerobic_reactor","Sewage_Sludge_food_waste",null,"coordinate","SE",2673730,"verified","text+coordinates",null,"Sweden: Stockholm",2019],["SAMN20599616","D0.2","2019-02-11","Sweden","Stockholm","Stockholm",59.30965637,18.10889692,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered_system","anaerobic_reactor","Sewage_Sludge_food_waste",null,"coordinate","SE",2673730,"verified","text+coordinates",null,"Sweden: Stockholm",2019],["SAMN20599617","D0.3","2019-02-11","Sweden","Stockholm",