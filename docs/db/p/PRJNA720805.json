{"v":"3.0.0","project":{"accession":"PRJNA720805","title":"Mesocosm sludge bioreactors under sustained 3-chloroaniline (3-CA) stress (with controls) Metagenome and Metatranscriptome","description":"This study demonstrated the impact of a sustained stress on activated sludge community and wastewater treatment process and its subsequent recovery. Using a combination of techniques in a controlled and replicated experiment, it was shown that microbial communities can evolve degradative capacity following a sustained xenobiotic input, specific functions like nitrification can fully or partially recover and targeted culture-independent approaches can be used to elucidate the mechanisms of adaptation.","organism":"bioreactor metagenome","data_type":"Metagenomic assembly","center_name":"NTU","submission_date":"2021/04/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN28196509","HSLTS_1705_R2","2014-05-17","Singapore",null,"Singapore",1.3451,103.6798,"uncertain",null,"environmental sample; urban association not established",null,"anthropogenic environmental material","activated sludge","waste material",null,"coordinate","SG",1880252,"probable","city-state",null,"Singapore",2014],["SAMN28196510","HSLTS_1705_R4","2014-05-17","Singapore",null,"Singapore",1.3451,103.6798,"uncertain",null,"environmental sample; urban association not established",null,"anthropogenic environmental material","activated sludge","waste material",null,"coordinate","SG",1880252,"probable","city-state",null,"Singapore",2014],["SAMN28196511","HSLTS_1705_R5","2014-05-17","Singapore",null,"Singapore",1.3451,103.6798,"uncertain",null,"environmental sample; urban asso