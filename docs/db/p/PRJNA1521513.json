{"v":"3.0.0","project":{"accession":"PRJNA1521513","title":"Next-generation sequencing-based approaches for biodetection in complex environments","description":"Generalizable, data-driven approaches are needed to quantify the performance of metagenomic workflows and enable high-confidence decision-making. Here, we generate a well-characterized matrix of experimental samples, parameterizing variables such as biological target type and quantity, and background composition and complexity. Genomic DNA from Bacillus anthracis str Sterne, Bacillus thuringiensis, and/or human adenovirus 40 strain Dugan was added to nucleic acid extracted from aerosol and tissue backgrounds in a range of defined concentrations. Samples were sequenced on both Illumina and ONT platforms.","organism":null,"data_type":"Raw sequence reads","center_name":"MIT Lincoln Laboratory","submission_date":"2026/08/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62802809","Aerosol DNA + Bacillus thuringiensis DNA spike 1e4 copies/ul","2024-12-12/2024-12-13","United States","Massachusetts","Boston",42.4589,-71.2675,"confirmed_urban","air_dust","explicit urban setting at sample level","urban aerosol",null,null,null,null,"coordinate","US",4930956,"probable","coordinates",null,"USA: Massachusetts",2024],["SAMN62802810","Aerosol DNA + Bacillus thuringiensis DNA spike 1e3 copies/ul","2024-12-12/2024-12-13","United States","Massachusetts","Boston",42.4589,-71.2675,"confirmed_urban","air_dust","explicit urban setting at sample level","urban aerosol",null,null,null,null,"coordinate","US",4930956,"probable","coordinates",null,"USA: Massachusetts",2024],["SAMN62802811","Aer