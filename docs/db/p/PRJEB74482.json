{"v":"3.0.0","project":{"accession":"PRJEB74482","title":"Effects of mouse-to-mouse fecal microbiota transplantation on vascular function with age and diet","description":"Transplantation of fecal microbiota from young mice into old mice improved endothelium-dependent dilation to acetylcholine (P = 0.05) and reduced aortic stiffness (P = 0.005), whereas transplanting old microbiota into young mice had the opposite effect. Collectively, these findings implicate the gut microbiome as a contributor to vascular dysfunction with aging, possibly via activation of proinflammatory pathways.","organism":null,"data_type":"Other","center_name":"University of California San Diego Microbiome Initiative","submission_date":"2024/04/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA115463530",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA115463531",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA115463532",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA115463533",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA115463534",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,