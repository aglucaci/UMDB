{"v":"3.0.0","project":{"accession":"PRJNA1442870","title":"Impact of perfluorooctanoic acid on microalgal-bacterial aerobic granular sludge","description":"This project investigated the effects of perfluorooctanoic acid (PFOA) exposure on the performance, extracellular polymeric substances (EPS), and microbial functional responses of a lab-scale microalgal-bacterial aerobic granular sludge (MB-AGS) system treating wastewater. Reactors were exposed to 100, 500, and 1000 ppb PFOA, and system performance was evaluated in terms of carbon, nitrogen, and phosphorus removal. Metagenomic and metatranscriptomic sequencing were conducted to characterize microbial community structure and gene expression responses under PFOA stress. The dataset supports analysis of microbial adaptation, nutrient removal stability, PFOA partitioning, and resistance-related functional profiles in MB-AGS systems exposed to PFOA.","organism":null,"data_type":"Raw sequence reads","center_name":"Ghent University","submission_date":"2026/03/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56710990","Microalgal-bacterial aerobic granular sludge (R1), day 120","2024-12-22","South Korea","Incheon","Incheon",37.4752,126.6313,"non_environmental",null,"laboratory or culture material",null,"Wastewater","Lab-scale microalgal bacterial granules","Microalgal bacterial granules",null,"coordinate","KR",1843564,"verified","text+coordinates",null,"South Korea: Incheon",2024],["SAMN56710991","Microalgal-bacterial aerobic granular sludge (R1), day 140","2025-01-11","South Korea","Incheon","Incheon",37.4752,126.6313,"non_environmental",null,"laboratory or culture material",n