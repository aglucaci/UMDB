{"v":"3.0.0","project":{"accession":"PRJEB107198","title":"Stormwater effects on two segrass species in the Derwent Estuary, Tasmania","description":"We examined how the condition of Zostera muelleri and Heterozostera nigricaulis and their below-ground bacterial communities (bulk sediment and rhizosphere) responded to large-scale abiotic factors and localized water quality stressors (e.g. proximity to stormwater outfalls) along the Derwent estuary, Tasmania. Overall, our results highlight the dominant influence of localized water quality stressors on seagrass condition and associated microbial communities in a highly urbanised temperate estuary.","organism":null,"data_type":"Other","center_name":"University of New South Wales","submission_date":"2026/07/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA121072945","Bulk_BB1_HeZos","2022-02/2022-05","Australia",null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,"Zostera nigricaulis","country","AU",null,"unresolved",null,null,"Australia",2022],["SAMEA121072946","Bulk_BB2_HeZos","2022-02/2022-05","Australia",null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,"Zostera nigricaulis","country","AU",null,"unresolved",null,null,"Australia",2022],["SAMEA121072947","Bulk_BB3_HeZos","2022-02/2022-05","Australia",null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,"Zostera nigricaulis","country","AU",null,"unresolved",null,null,"Australia",2022],["SAMEA121072948","Bulk_NTC_2","2022-02/2022-05","Australia",null,null,null,null,"uncertain",null