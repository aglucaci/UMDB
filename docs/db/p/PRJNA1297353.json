{"v":"3.0.0","project":{"accession":"PRJNA1297353","title":"Mixotrophic Nitrification Denitrification","description":"The integration of sequential nitrification/heterotrophic denitrification (SNHD) or sequential nitrification/mixotrophic denitrification (SNMD) within a single reactor has been scarcely reported. This study aimed to adapt an industrial inoculum to SNHD and SNMD using two types of sequential batch reactors: a control (SBR) and one with zeolite (SBBR). Over 276 days (d), reactors operated in 7-day cycle (3.38 d nitrification; 3.38 d denitrification; 0.5 d medium replacement). No significant differences were observed between the system with carriers (zeolite) and the system without carriers, although zeolite has a role in the type of microorganisms that developed in SBBR.","organism":null,"data_type":"Raw sequence reads","center_name":"Universidad de Santiago de Chile","submission_date":"2025/07/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50222036","MIMARKS Survey related sample from sludge metagenome",null,"Chile","O'Higgins Region","Rancagua",-34.19890148,-70.86777725,"non_urban",null,"environmental sample from a non-urban site",null,"treatment plant biome","piggery wastewater","aerated lagoon",null,"coordinate","CL",3873775,"probable","coordinates",null,"Chile: Doigue",null],["SAMN50222037","MIMARKS Survey related sample from sludge metagenome",null,"Chile","Santiago Metropolitan","Santiago",-33.44732229,-70.68144622,"non_environmental",null,"laboratory or culture material",null,"bioreactor biome","control","sequential nitrification/heterotrophic denitrification",null,"coordinate","CL",3871336,"verified