{"v":"3.0.0","project":{"accession":"PRJNA1287549","title":"Greenland Ice Sheet air and snow microbial community composition","description":"The surface of the Greenland Ice Sheet (GrIS) is one of the largest supraglacial habitats in the world, and the biogeochemical processes that occur on and near the ice surface impact albedo, surface melting, and the resultant sea level rise. This habitat hosts pigmented glacier ice and snow algae that grow in blooms on the surface during the summer melt season. Here we characterize the microbial communities of air and snow samples from a location in the southwest of the GrIS and connect these results to other geochemical and atmospheric measurements. The bacterial and eukaryotic community compositions were characterized using 16S and 18S rRNA amplicon sequencing.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Waterloo","submission_date":"2025/07/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49823914","Metagenome or environmental sample from air metagenome","2016-07-29","Greenland",null,null,67.07,-49.36,"probable_urban","air_dust","city-level location without sample-site confirmation","air",null,null,null,null,"coordinate","GL",null,"unresolved",null,null,"Greenland: SW Greenland Ice Sheet",2016],["SAMN49823915","Metagenome or environmental sample from air metagenome","2016-07-30","Greenland",null,null,67.07,-49.36,"probable_urban","air_dust","city-level location without sample-site confirmation","air",null,null,null,null,"coordinate","GL",null,"unresolved",null,null,"Greenland: SW Greenland Ice Sheet",2016],["SAMN49823916","Metagenome or environmenta