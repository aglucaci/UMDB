{"v":"3.0.0","project":{"accession":"PRJNA1431916","title":"Shotgun metagenomes of extracellular vesicle-associated DNA from municipal wastewater treatment plant effluents","description":"This BioProject provides shotgun metagenomic sequencing data generated from DNA extracted from extracellular vesicles (EVs) isolated from municipal wastewater treatment plant process effluent samples. EVs were recovered from wastewater using size-based filtration and/or centrifugation-based concentration, followed by EV-associated DNA extraction. The purpose of this dataset is to characterize the taxonomic composition and functional gene content (including antibiotic resistance genes) associated with EV DNA in treated wastewater. The raw sequence reads are deposited in the Sequence Read Archive (SRA) to support reuse in environmental microbiome, wastewater surveillance, and resistome studies.","organism":null,"data_type":"Raw sequence reads","center_name":"Inner Mongolia University","submission_date":"2026/03/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56331214","extracellular vesicles (EVs) isolated from raw wastewater (influent)","2025-06","China","Inner Mongolia","Hohhot",40.8426,111.7492,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",2036892,"verified","text+coordinates",null,"China: Inner Mongolia, Hohhot",2025],["SAMN56331215","extracellular vesicles (EVs) isolated from AAO process effluent","2025-06","China","Inner Mongolia","Hohhot",40.8426,111.7492,"probable_urban","municipal_wastewater","city-level location without sample-site confirma