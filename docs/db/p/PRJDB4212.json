{"v":"3.0.0","project":{"accession":"PRJDB4212","title":"Dynamics of a simulated riparian micobiome treating severely polluted urban effluent","description":"Changes in microbial communities analysed using high throughput sequencing and correlations with physico-chemical properties of a rhizofiltration system treating severely polluted urban effluent.  The aim of the study was to describe the dynamics of microbes associated with the rhizomes of wetland plants growing in an urban effluent phytoremediation system. High throughput sequencing technology was used the characterize the bacterial communities, with the objective of determining their response to high pollutant loads which included nutrients and human associated microflora. Ultimately this work contributed to a better understanding of the potential mechanisms involved in pollutant removal through urban effluent best management practices.","organism":"soil metagenome","data_type":"Targeted Locus (Loci)","center_name":"Stellenbosch University","submission_date":"2016/12/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00040681","Unplanted control 1_0C","2014-04-18","South Africa","Western Cape","Somerset West",-33.9433,18.82425,"probable_urban","soil_greenspace","city-level location without sample-site confirmation",null,"Rhizofiltration system/Constructed wetland/Riparian zone","sand filter bed unplanted","Coarse sand",null,"coordinate","ZA",6951112,"probable","coordinates",null,"South Africa:Stellenbosch Wastewater Treament Works",2014],["SAMD00040682","Bulk sand 1_0RB","2014-04-18","South Africa","Western Cape","Somerset West",-33.9433,18.82425,"probable_urban","soil