{"v":"3.0.0","project":{"accession":"PRJNA1558825","title":"Genomic Characterisation of Escherichia coli From Urban Wastewater and Outpatient Urine Cultures","description":"This study provides genomic comparisons of Escherichia coli from urban wastewaterand outpatient urine cultures in Cote d Ivoire, using portable nanopore sequencing in anational public health laboratory. It addresses a major gap in West Africa, wheregenomic data on antimicrobial resistance outside hospitals are scarce, revealing CTXM-15 spread across unrelated lineages, plasmid-mediated AmpC genes, and thecolistin resistance gene mcr-1.1 in wastewater. Clinical and wastewater isolates weregenomically distinct, showing that wastewater captures resistance determinantscirculating in the community that clinical surveillance alone may miss. These findingssupport integrating genomic wastewater surveillance into national AMR action plansand show that this approach is feasible with locally available, affordable sequencingtechnology.","organism":null,"data_type":"Raw sequence reads","center_name":"INSTITUT PASTEUR DE COTE D'IVOIRE","submission_date":"2026/11/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64748715","One Health Enteric sample from Escherichia coli","2024-11","Ivory Coast",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater",null,null,null,null,"country","CI",null,"ambiguous","text","2 places named 'Abidjan; Adjame'","Cote d'Ivoire: Abidjan, Adjame",2024],["SAMN64748716","One Health Enteric sample from Escherichia coli","2024-11","Ivory Coast",null,null,null,null,"uncertain",null,"conflicting evi