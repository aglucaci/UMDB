{"v":"3.0.0","project":{"accession":"PRJNA1117599","title":"Nitrogen removal performance, ammonia oxidation contribution rate and community structure variation of ammonia-oxidizing microorganisms based on pure biofilm system","description":"Nitrification is the key and rate-limiting step in the biological nitrogen removal process of wastewater. In order to quantify the contribution of ammonia-oxidizing microorganisms (AOMs) in the nitrification process and promote cooperation among microorganisms, so as to achieve highly efficient nitrification, this study constructed a kind of pure biofilm system based on anoxic/ oxic (AO) process, and comparatively explored the nitrification performance of four different fillers and the growth and enrichment of related microorganisms. The system has been running for 165 days.","organism":null,"data_type":"Raw sequence reads","center_name":"Qingdao University of Technology","submission_date":"2024/05/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41576595","sludge-1","2023-09-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN41576596","sludge-2","2023-09-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN41576597","sludge-3","2023-09-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,