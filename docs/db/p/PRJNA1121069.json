{"v":"3.0.0","project":{"accession":"PRJNA1121069","title":"Microorganisms in two UMSRs","description":"Up-flow microaerobic sludge reactor (UMSR) can effectively remove pollutants such as COD, ammonia, and antibiotics from manure-free piggery wastewater. To investigate the impact of multiple antibiotics on the performance of UMSR, two identical reactors were operated in parallel. Twelve antibiotics were introduced into the feed of one reactor (marked as R2), while the other reactor (marked as R1) functioned as a control. We investigated the succession of microbial communities during the operation of two reactors.","organism":null,"data_type":"Raw sequence reads","center_name":"Harbin Institute of Technology","submission_date":"2024/06/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41725983","sludge","2020-07-18",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor R1 sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2020],["SAMN41725984","sludge","2020-08-16",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor R1 sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2020],["SAMN41725985","sludge","2020-09-15",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor R1 sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2020],["SAMN41725986","sludge","2020-10-16",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor R1 sample",