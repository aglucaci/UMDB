{"v":"3.0.0","project":{"accession":"PRJDB35461","title":"Optimal phosphate concentration for growth and normal functioning of the marine anammox bacteria, Candidatus Scalindua sp.","description":"The anammox process using marine anammox bacteria is a promising nitrogen removal process for recirculating aquaculture system wastewater. Marine anammox bacteria are typically found in oxygen-deficient zones and coastal areas under low phosphate concentrations. The optimal phosphate concentration for marine anammox bacteria remains still unknown because most laboratories studies of these bacteria have been conducted under high phosphate concentrations. This study investigated the long-term effects of varying phosphate concentrations on the marine anammox bacterium, Candidatus Scalindua sp., to determine the optimal range of phosphate. Anammox activity and growth rates were evaluated under seven phosphate concentrations (0, 0.23, 0.46, 0.68, 1.14, 6.15 (control), and 15.48 mg-P L-1) over a period of 70 days.","organism":"bioreactor metagenome","data_type":"Metagenome","center_name":"Hiroshima University","submission_date":"2025/06/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD01045711","Sample collected from the reactor Run1","2024-09","Japan","Hiroshima","Higashihiroshima",34.4,132.71,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"coordinate","JP",11611627,"verified","text+coordinates",null,"Japan:Hiroshima, Higashihiroshima city",2024],["SAMD01045712","Sample collected from the reactor Run2","2024-09","Japan","Hiroshima","Higashihiroshima",34.4,132.71,"non_environmental",null,"laboratory o