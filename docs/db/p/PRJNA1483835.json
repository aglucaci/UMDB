{"v":"3.0.0","project":{"accession":"PRJNA1483835","title":"Sulfamethoxazole and acetaminophen increase methane yield while exerting different effects on key metabolic pathways and antibiotic resistance gene dynamics during anaerobic digestion","description":"This study investigated the effects of sulfamethoxazole (SMX) and acetaminophen (ACT) on batch anaerobic digestion performance, microbial community dynamics, and antibiotic resistance gene (ARG) profiles. Both compounds enhanced methane production and promoted methanogenic populations, but induced distinct microbial and genetic responses. SMX increased total ARG abundance and was associated with vertical gene transfer and conjugation-related horizontal gene transfer, whereas ACT reduced total ARG abundance but altered ARG host patterns and showed evidence of SOS-mediated responses. These results highlight that antibiotic and non-antibiotic pharmaceuticals can improve anaerobic digestion performance while driving divergent ARG dissemination pathways.","organism":null,"data_type":"Raw sequence reads","center_name":"Hanyang University","submission_date":"2026/06/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61207513","Wastewater activated sludge metagenome, sulfamethoxazole, 0d","2024-04-26","South Korea","Seoul","Seoul",37.5572,127.0453,"uncertain",null,"environmental sample; urban association not established",null,"ENVO:00002275","ENVO:00002213","ENVO:00002018",null,"coordinate","KR",1835848,"verified","text+coordinates",null,"South Korea: Seoul, Seongdong-gu",2024],["SAMN61207514","Wastewater activated sludge metagenome, sulfamethoxazole, 5d","2024-05-01","South Kor