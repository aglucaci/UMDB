{"v":"3.0.0","project":{"accession":"PRJNA1327443","title":"Microbial dynamic of chicken littler mesophilic digestion","description":"This study was carried out in batch system digester at 37 C. Chicken litter was used to feed the 10 L digesters. The inoculum (5% v/v) were obtain from a mesophilic digester, which has been operated for four years in stable conditions. Assay was conducted for 191 days. During this time, cell samples were collected, at specific time points along the BMP curve, cell samples were selected for sequencing using Illumina technology to compare the microbial structure at different stages of the degradation process. Metagenomic analysis was performed to analyze changes in microbial dynamics and estimate the functional genes involved in the anaerobic degradation pathways of chicken litter.","organism":null,"data_type":"Raw sequence reads","center_name":"Universidad Autonoma Chapingo","submission_date":"2025/09/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51281408","MIMS Environmental/Metagenome sample from sludge metagenome","2018-07-18","Mexico","México","Texcoco de Mora",19.49330555,-98.88975,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Sludge microbiome","Chicken litter digester","Anaerobic sludge",null,"coordinate","MX",3515715,"verified","text+coordinates",null,"Mexico: Texcoco, Mexico State",2018],["SAMN51281409","MIMS Environmental/Metagenome sample from sludge metagenome","2018-09-12","Mexico","México","Texcoco de Mora",19.49330555,-98.88975,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",