{"v":"3.0.0","project":{"accession":"PRJNA384848","title":"Setaria Microbiomes","description":"We surveyed and dissected the bacterial assemblages of surface-sterilized roots and panicles of wild S. pumila and S. viridis collected from 15 different sampling locations in Austria by 16S rRNA gene-based Illumina sequencing. Our main objective was to gain understanding of the factors shaping the microbiota associated with each of these plant tissues, particularly of disseminative organs (panicles, grains and seeds) and to which extent endophytes are potentially vertically transmitted.","organism":"Setaria","data_type":"Metagenome","center_name":"Austrian Institute of Technology (AIT)","submission_date":"2017/04/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN06849117","Metagenome or environmental sample from plant metagenome","2013-08","Austria","Burgenland","Gols",47.88,16.91,"non_environmental",null,"host-derived or clinical material","S.pumila panicle","Roadside","Roadside-B1SpF1","soil","Setaria pumila","coordinate","AT",2778355,"verified","text+coordinates",null,"Austria: Gols",2013],["SAMN06849118","Metagenome or environmental sample from plant metagenome","2013-08","Austria","Burgenland","Gols",47.88,16.91,"non_environmental",null,"host-derived or clinical material","S.pumila panicle","Roadside","Roadside-B1SpF2","soil","Setaria pumila","coordinate","AT",2778355,"verified","text+coordinates",null,"Austria: Gols",2013],["SAMN06849119","Metagenome or environmental sample from plant metagenome","2013-08","Austria","Burgenland","Gols",47.88,16.91,"non_environmental",null,"host-derived or clinical material","S.pumila panicle