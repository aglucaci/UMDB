{"v":"3.0.0","project":{"accession":"PRJDB4257","title":"Miseq Sequencing Analysis of Microbial Communities in Different Membrane Bioreactors","description":"Membrane bioreactors (MBR) for wastewater treatment are hampered particularly by membrane biofouling, resulting from microbial growth. Although the biological understanding of biofouling mechanism is crucial for the development of biofouling control strategies, the information of the microbial ecology is not sufficient. In this study, we studied microbial communities from 10 full-scale MBR plants with different membrane modules and wastewaters using 16S rRNA genes Miseq sequencing analysis.","organism":"bioreactor metagenome","data_type":"Targeted Locus (Loci)","center_name":"School of chemical and Biological enginnering, Seoul National Univeristy","submission_date":"2017/09/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00041518","Gangwon_A_sludge_1","2015-02-12","South Korea","Gangwon-do",null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,"wastewater treatment plant","sludge",null,"city","KR",null,"unresolved",null,null,"South Korea:Gangwon-do",2015],["SAMD00041519","Gangwon_A_sludge_2","2015-02-12","South Korea","Gangwon-do",null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,"wastewater treatment plant","sludge",null,"city","KR",null,"unresolved",null,null,"South Korea:Gangwon-do",2015],["SAMD00041520","Gangwon_A_sludge_3","2015-02-12","South Korea","Gangwon-do",null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure a