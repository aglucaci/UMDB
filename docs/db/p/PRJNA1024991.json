{"v":"3.0.0","project":{"accession":"PRJNA1024991","title":"Metagenomic sequencing of green stormwater infrastructure","description":"25 soil samples were collected in various green stormwater infrastructure systems, i.e., bioswales, bioretention cells, and constructed wetland. DNA was extracted via QIAGEN DNeasy PowerLyzer PowerSoil Kit. A composite sample of the extracts was prepared for each site by combining the triplicate samples by an equal DNA mass. One sample was sequenced per site. Metagenomic sequencing completed on Illumina NextSeq 2000 platform (151 bp paired end) at a sequencing depth of 650 Mbp. Deposited sequences are full-length, untrimmed reads.","organism":null,"data_type":"Raw sequence reads","center_name":"Marquette University","submission_date":"2023/10/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37707366","Metagenome or environmental sample from soil metagenome","2021-08-06","United States","Wisconsin",null,42.936,-88.473,"uncertain",null,"environmental sample; urban association not established","Natural protected prairie",null,null,null,null,"coordinate","US",null,"unresolved",null,null,"USA:Wisconsin",2021],["SAMN37707367","Metagenome or environmental sample from soil metagenome","2021-07-20","United States","Wisconsin","Milwaukee",43.062,-87.94,"uncertain",null,"environmental sample; urban association not established","bioswale",null,null,null,null,"coordinate","US",5263045,"probable","coordinates",null,"USA:Wisconsin",2021],["SAMN37707368","Metagenome or environmental sample from soil metagenome","2021-08-06","United States","Wisconsin","Milwaukee",43.059,-87.938,"uncertain",null,"environmenta