{"v":"3.0.0","project":{"accession":"PRJNA1144857","title":"Metatranscriptomes taken during aerobic granule formation","description":"The active microbial community and the gene expression was studied during the formation of aerobic granule in a sequencing batch reactor using de novo metatranscriptomics. The influence of the phosphate concentration, from high to low, was also studied. Four metatranscriptomics samples were taken at day 13 (mean particle size around 172 um, COD/P ratio of 12), day 26 (300 um, COD/P ratio of 12), day 103 (1000 um, COD/P ratio of 12) and day 182 (1000 um, COD/P ratio of 200). In the first part of the experiment, high concentration of phosphate, the biomass aggregated to form round shape granules along side with the enrichment of Candidatus Accumulibacter. In the second part of the experiment, when reducing the phosphate concentration, Propionivibrio became the most abundant microorganism and the granule remained round and bigger than 1000 um.","organism":null,"data_type":"Raw sequence reads","center_name":"EPFL","submission_date":"2024/08/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43045084","Feeding_Day13_Cycle_1","2022-10-11","Switzerland","Bern","Thun",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Feeding_Day13_Cycle_1",null,null,null,null,"city","CH",2658377,"verified","text",null,"Switzerland: Thun",2022],["SAMN43045085","Feeding_Day13_Cycle_2","2022-10-12","Switzerland","Bern","Thun",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Feeding_Day13_Cycle_2",null,null,null