{"v":"3.0.0","project":{"accession":"PRJDB40348","title":"Hydrogen production using forward osmosis-concentrated municipal sewage","description":"This project investigates hydrogen production from municipal sewage concentrated by forward osmosis (FO). The study evaluates photofermentation by Rhodopseudomonas palustris under pH-controlled conditions and examines microbial community dynamics using full-length 16S rRNA gene amplicon sequencing. The results demonstrate that FO pretreatment enriches biodegradable organic substrates and reduces ammonium inhibition, enabling effective hydrogen production. This project contributes to the development of FO-PNSB hybrid systems for sustainable energy recovery from wastewater.","organism":"metagenome","data_type":"Targeted Locus (Loci)","center_name":"Faculty of Chemistry and Biochemistry, Kanagawa University","submission_date":"2026/05/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD01818151","a-pre","2024-01-15","Japan","Kanagawa","Yokohama",null,null,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level","municipal wastewater",null,null,null,null,"city","JP",1848354,"probable","text-population","largest of 2 places named 'Yokohama'","Japan:Yokohama",2024],["SAMD01818152","a-after","2024-01-15","Japan","Kanagawa","Yokohama",null,null,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level","municipal wastewater",null,null,null,null,"city","JP",1848354,"probable","text-population","largest of 2 places named 'Yokohama'","Japan:Yokohama",2024],["SAMD01818153","b-pre","2024-01-15","Japan","Kanagawa","Yokohama",null,null,"probable_urban