{"v":"3.0.0","project":{"accession":"PRJDB35963","title":"Quantification of Cefotaxime-Resistant Escherichia coli and Class 1 Integron Integrase Genes as Key Indicators of Antimicrobial Resistance in Urban Wastewater in Two Cities in Japan","description":"Antimicrobial resistance (AMR) is a pressing global health threat. Wastewater surveillance is a promising approach to comprehensively evaluate the prevalence of antimicrobial resistant bacteria and antimicrobial resistance genes in the urban areas. Although cefotaxime-resistant E. coli and class 1 integron integrase gene were proposed as key indicators of AMR, their levels in wastewater in Japan remain unknown. This study quantified these parameters in wastewater samples collected every two months from two cities in Japan. Metagenomic analysis with hybrid capture enrichment identified dominant genes conferring resistance to tetracyclines, aminoglycosides, beta-lactams, and macrolides, with a particular focus on ESBL, carbapenemase, and colistin resistance genes.","organism":"wastewater metagenome","data_type":"Other","center_name":"The University of Tokyo","submission_date":"2025/08/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD01614213","Influent_City_A_Jun_2024","2024-06-27","Japan",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","domestic wastewater",null,null,null,null,"country","JP",null,"unresolved",null,null,"Japan",2024],["SAMD01614214","Influent_City_A_Aug_2024","2024-08-22","Japan",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","domestic was