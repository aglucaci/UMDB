{"v":"3.0.0","project":{"accession":"PRJDB17448","title":"Metagenom analysis of grape, raisin, and fermented raisin water","description":"In this study we conducted metagenomic analysis targeting fungi (ITS region) and bacteria (16S rRNA V3-V4 region) colonized on raw grapes and raisins. We also examined changes of microbiome along with fermentation of raisin in sterile water. In addition, we dried raw grapes with three ways (sun dry, sun and oven dry, and oven dry) and compared their microbiome.","organism":"metagenome","data_type":"Targeted Locus (Loci)","center_name":"Kyoto University","submission_date":"2024/01/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00735727","Air_vacuum_ITS","2023-09-24","Japan","Kyoto","Uji",34.91,135.8,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,"Vitis labrusca x Vitis vinifera","coordinate","JP",1849372,"verified","text+coordinates",null,"Japan:Kyoto, Uji",2023],["SAMD00735743","Air_vacuum_16S","2023-09-24","Japan","Kyoto","Uji",34.91,135.8,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,"Vitis labrusca x Vitis vinifera","coordinate","JP",1849372,"verified","text+coordinates",null,"Japan:Kyoto, Uji",2023]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","release_date","spots","bases","avg_length","size_mb","scientific_name","urban_status","experiment_title"],"runs":[["DRR527940",0,"DRX511818","Amplicon","AMPLICON","METAGENOMIC","PCR","PAIRED","ILLUMINA","Illumina MiSeq","2024-01-30 12