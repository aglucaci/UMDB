{"v":"3.0.0","project":{"accession":"PRJNA701372","title":"Biodegradation of estrone in activated sludge","description":"In this project, we conducted biochemical and molecular studies to elucidate estrone biodegradation pathways and identify key estrone-degrading bacteria in activated sludge from Tubli wastewater treatment plant in Bahrain. We collected activated sludge samples and used them in laboratory microcosms amended with estrone. Samples were retrieved at time intervals from the test and control microcosms to analyze the biodegradation intermediates by UPLC-HRMS. Moreover, DNA was isolated from the activated sludge samples to study the compositional shifts of the activated sludge bacterial community and identify key estrone degraders by Illumina-MiSeq amplicon sequencing and bioinformatics analyses.","organism":"activated sludge metagenome","data_type":"Metagenome","center_name":"Arabian Gulf University","submission_date":"2021/02/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN17864501","Microcosm","2019-10","Bahrain","Manama","Manama",26.1947,50.5533,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Activated Sludge from wastewater treatment plant",null,null,null,null,"coordinate","BH",290340,"verified","text+coordinates",null,"Bahrain: Manama",2019]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","release_date","spots","bases","avg_length","size_mb","scientific_name","urban_status","experiment_title"],"runs":[["SRR13881507",0,"SRX10261923","Amplicon","AMPLICON"