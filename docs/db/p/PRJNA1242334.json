{"v":"3.0.0","project":{"accession":"PRJNA1242334","title":"Comparing mcrA and V4 16S rRNA sequencing in methanogenic archaea","description":"Methanogenic archaea have been increasingly investigated concerning their impact on the environment, role in human health, and technological applications, including the industrial production of biofuel methane as a part of a sustainable energy economy.High-throughput DNA sequencing of the functional mcrA gene is the ideal tool for assessing methanogenic archaea diversity in environmental, biotechnological, and clinical samples. Compared to the 16S rRNA gene, the mcrA gene is specific to methanogenic archaea and provides higher resolution in the phylogeny analysis of methanogens.","organism":null,"data_type":"Raw sequence reads","center_name":"Masaryk University","submission_date":"2025/03/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47586146","Sewage sludge","2019-01-01","Czechia","South Moravian","Modřice",49.1261833,16.6309781,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sewage",null,null,null,null,"coordinate","CZ",3070416,"verified","text+coordinates",null,"Czech Republic: Modrice",2019]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","release_date","spots","bases","avg_length","size_mb","scientific_name","urban_status","experiment_title"],"runs":[["SRR32868395",0,"SRX28149854","Amplicon","AMPLICON","METAGENOMIC","PCR","PAIRED","ILLUMINA","Illumina MiniSeq","2026-04-30 00:28:05",188372,56726283,301,17.0,"wastewat