{"v":"3.0.0","project":{"accession":"PRJEB25754","title":"Using salinity to select for progressive onset denitrifiers","description":"To gain an understanding of the bacteria capable of performing nitrite accumulation from nitrate (denitratation) in such system a study of a nitrite accumulation bioreactor has been undertaken. Our goal was to assess how the salinity parameter affected the nitrogen removal performance of this bioreactor, and which microorganisms were responsible for the nitrite accumulation needed to sustain the denitration process in this bioreactor. The reactor used in this study was a mixed, unsealed, electron donor-limited continuous reactor with acetate and nitrate as substrates operated under diverse salinity regimes.","organism":null,"data_type":"Other","center_name":"Cornell University","submission_date":"2018/06/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA104723945",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA104723946",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA104723947",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA104723948",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],