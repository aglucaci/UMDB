{"v":"3.0.0","project":{"accession":"PRJNA1472975","title":"aerobic granular sludge metagenome","description":"Aerobic granular sludge samples were collected on day 280 from laboratory-scale sequential batch reactors (SBRs) treating synthetic wastewater (low C/N ratio). The inoculated sludge was originally obtained from a municipal wastewater treatment plant in Beijing, China. Reactors were operated under different long-term exposure conditions: control (no micro/nanoplastics), microplastics, and nanoplastics . These metagenomic samples were used to investigate microbial community structure, functional gene abundance (e.g., c-di-GMP metabolic pathways), and key species involved in extracellular polymeric substance regulation under micro/nanoplastic stress. Sampling location: Beijing University of Technology, Beijing, China.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2026/05/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60528629","Metagenome or environmental sample from sludge metagenome","2024-02-04T13:30:10Z","China","Beijing","Beijing",39.875357,116.480595,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Sludge in R0",null,null,null,null,"coordinate","CN",1816670,"probable","coordinates",null,"China: The laboratory in Beijing",2024],["SAMN60528630","Metagenome or environmental sample from sludge metagenome","2024-02-04T13:30:11Z","China","Beijing","Beijing",39.875357,116.480595,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Sludge in R0",null,null,nul