{"v":"3.0.0","project":{"accession":"PRJDB10627","title":"Effects of a recirculating aquaculture system wastewater on anammox performance and community structure","description":"Recirculating aquaculture systems (RAS) are good candidates for the sustainable development of the aquaculture sector. A current limitation of RAS is the production and accumulation of nitrogenous wastes, which could affect the fish health. We herein investigated the potential of the anaerobic ammonia oxidation (anammox) process to treat the RAS wastewater. We demonstrated that the marine anammox bacteria, Candidatus Scalindua is a potential candidate. However, its activity was affected by unknown compounds in the RAS wastewater and/or the absence of essential trace elements. Future studies need to address these issues for the optimal conditions of Candidatus Scalindua to treat the RAS wastewater.","organism":"wastewater metagenome","data_type":"Targeted Locus (Loci)","center_name":"Environmental Preservation Engineering, Civil and Environmental Engineering, Hiroshima University","submission_date":"2022/03/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00251081","day0","2019-11-03","Japan","Hiroshima","Higashihiroshima",34.4,132.71,"non_environmental",null,"laboratory or culture material",null,"bioreactor",null,"biofilm",null,"coordinate","JP",11611627,"verified","text+coordinates",null,"Japan:Hiroshima, Higashihiroshima city",2019],["SAMD00251082","day78","2020-01-22","Japan","Hiroshima","Higashihiroshima",34.4,132.71,"non_environmental",null,"laboratory or culture material",null,"bioreactor",null,"biofilm",null,"coordinate","JP",11611627,"verifi