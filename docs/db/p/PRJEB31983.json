{"v":"3.0.0","project":{"accession":"PRJEB31983","title":"Naturally-diverse aerobiology and mice gut microbiota","description":"We subjected 54 x 3-5 week old inbred BALB/C mice (27 female, 27 male) to a 7 week exposure to airborne environmental microbiota treatments in the form of light soil dust, using soils from a high biodiversity woodland, a low biodiversity grassland, and no soil (control).  We tracked changes in soil microbiota, air (dust) microbiota, and mice gut microbiota. Specifically, we targeted the bacterial 16S rRNA V3-V4 gene region using forward primer 341F (CCTAYGGGRBGCASCAG) and reverse primer 806R (GGACTACNNGGGTATCTAAT). PCR and sequencing was performed by the Australian Genome Research Facility (AGRF) using the Illumina Miseq plaftorm.","organism":null,"data_type":"Other","center_name":"THE UNIVERSITY OF ADELAIDE","submission_date":"2019/11/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA5554622","ABLK1w6-16S_V3-V4","2018-10-08","Australia",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","AU",null,"unresolved",null,null,"Australia",2018],["SAMEA5554623","ABLK2w6-16S_V3-V4","2018-10-08","Australia",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","AU",null,"unresolved",null,null,"Australia",2018],["SAMEA5554624","bat11blk-16S_V3-V4","2018-10-22","Australia",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","AU",null,"unresolved",null,null,"Australia",2018],["SAMEA