{"v":"3.0.0","project":{"accession":"PRJNA1525052","title":"Community sequencing of Winogradsky column layers before and after Biofilm enrichment","description":"The goal was to determine the community composition of six Winogradsky column layers, developed over 2-years using urban stream sediment, supplemented with PHB bioplastic. The communities were used as starting material for a second enrichment step or 'biofilm assay', in which biomass was encouraged to form on plastic beads (PHB and PET), over 4-weeks. These 'biofilm' communities were then sequenced to allow for comparison between the Winogradsky community (WC) and Biofilm community (BF) composition.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Canterbury","submission_date":"2026/09/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62993377","Winogradsky Column Community 1","2023-05-24","New Zealand","Canterbury","Christchurch",-43.52,172.58,"confirmed_urban",null,"explicit urban setting at sample level","Winogradsky column made from urban stream sediment",null,null,null,null,"coordinate","NZ",2192362,"verified","text+coordinates",null,"New Zealand: Christchurch",2023],["SAMN62993378","Winogradsky Column Community 2","2023-05-24","New Zealand","Canterbury","Christchurch",-43.52,172.58,"confirmed_urban",null,"explicit urban setting at sample level","Winogradsky column made from urban stream sediment",null,null,null,null,"coordinate","NZ",2192362,"verified","text+coordinates",null,"New Zealand: Christchurch",2023],["SAMN62993379","Winogradsky Column Community 3","2023-05-24","New Zealand","Canterbury","Christchurch",-43.52,172.58,"conf