{"v":"3.0.0","project":{"accession":"PRJNA474791","title":"activated sludge Genome sequencing and assembly","description":"A novel ABS system based on SBSBR was developed for domestic wastewater treatment. Introducing algae to sequencing batch suspended biofilm reactor enhanced both TN and TP removal, with the effluent concentration of 12.44 ± 0.21 and 0.26 ± 0.12 mg/L. The novel A-SBSBR achieved TN and TP removal improvement by enhancing the removal contribution of both sludge and biofilm, and the algae and bacteria related to nutrients removal were enriched in A-SBSBR. It was noted that the accumulation enhancement of algae could achieve nutrients removal improvement from wastewater.","organism":"activated sludge metagenome","data_type":"Genome sequencing and assembly","center_name":"HIT","submission_date":"2018/06/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN09381410","sludge","2017-11-30",null,null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","sludge sample1",null,null,null,"Bacteria","unknown",null,null,"unresolved",null,null,null,2017],["SAMN09381411","sludge","2017-11-30",null,null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","sludge sample2",null,null,null,"Bacteria","unknown",null,null,"unresolved",null,null,null,2017],["SAMN09381412","sludge","2017-11-30",null,null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","sludge sample3",null,null,null,"Bacteria","unknown",null,null,"unresolved",null,null,null,2017],["SAMN09381413","sludge","2017-11-30",null,null,null,null,null,"uncertain",null,