{"v":"3.0.0","project":{"accession":"PRJNA849266","title":"OneWater Nevada Advanced Purified Water Demonstration Field Demonstration at Reno-Stead Water Reclamation Facility","description":"The investigation was performed in conjunction with the OneWater Nevada, which is a regional effort to study the technical feasibility and the economic, social, and environmental impacts of advanced purified water on sustainable water management in the Truckee Meadows region. University of Nevada, Reno (UNR) collaborated with the OneWater Nevada team to develop and demonstrate the AWT train for aquifer injection following State of Nevada Category A+ reclaimed water regulations. The system utilized secondary effluent from the Reno-Stead Water Reclamation Facility (RSWRF), followed by coagulation, flocculation, sedimentation, filtration, ozonation, BAC filtration, GAC filtration, UV disinfection and a cartridge filter before injection. Environmental samples were collected and sequenced before and after each process during multiple sampling events. The demonstration project was held between December 2019 to November 2020.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Nevada Reno","submission_date":"2022/06/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN29048225","MIMARKS Survey related sample from wastewater metagenome","2020-07-17","United States","Nevada","Reno",39.64,-119.87,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Secondary WW effluent","Advanced Water Treatment","Liquid Sample",null,"coordinate","US",5511077,"verified","text+coordinates",null