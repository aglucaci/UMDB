{"v":"3.0.0","project":{"accession":"PRJNA1056946","title":"Enhancement effect of nanobubble water addition on anaerobic digestion of rice straw under biogas digestate soaking pretreatment","description":"This study investigated the enhancement effect of nanobubble water on pretreatment efficiency and biogas production of rice straw. Different types of NW (CO2NW and O2NW) with biogas digestate were used to soak rice straw for 1, 2, 3, 5, and 7 d.This study provides new insights into soaking pretreatment of combined NW addition and digestate and present a low-cost pretreatment method of rice straw.","organism":null,"data_type":"Raw sequence reads","center_name":"China Agricultural University","submission_date":"2023/12/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN39114333","Metagenome or environmental sample from sludge metagenome","2023-05-23",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN39114334","Metagenome or environmental sample from sludge metagenome","2023-05-23",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN39114335","Metagenome or environmental sample from sludge metagenome","2023-05-23",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN39114336","Metagenome or environme