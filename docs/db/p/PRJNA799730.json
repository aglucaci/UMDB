{"v":"3.0.0","project":{"accession":"PRJNA799730","title":"Acid coal mine Microbial community Genome sequencing and assembly","description":"Acid mine drainage (AMD) is a contaminated water body left after coal mining. In the Shanxi Province (China), we collected acid mine drainage surrounding water, sediment and soil sample microbial community with high-throughput sequencing. The 16S rRNA genes specific for bacteria analysis could help to deepen the understanding of microbial communities in coal AMD ecosystem, which was important for the treatment and protection of polluted water.","organism":"mine drainage metagenome","data_type":"Genome sequencing and assembly","center_name":"China University of Geosciences","submission_date":"2022/01/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN25209731","Metagenome or environmental sample from sludge metagenome","2020-08-24","China","Shanxi","Yangquan",38.02,113.5,"non_urban",null,"BioProject indicates an agricultural or industrial source","sediment",null,null,null,"Environment","coordinate","CN",1787351,"probable","coordinates",null,"China: Shanxi",2020],["SAMN25692539","Metagenome or environmental sample from sludge metagenome","2020-08-24T11:05:12Z","China","Shanxi","Yangquan",38.02,113.5,"non_urban",null,"BioProject indicates an agricultural or industrial source","sediment",null,null,null,null,"coordinate","CN",1787351,"verified","text+coordinates",null,"China:Yangquan",2020],["SAMN25692540","Metagenome or environmental sample from sludge metagenome","2020-08-24T11:50:14Z","China","Shanxi","Yangquan",38.02,113.5,"non_urban",null,"BioProject indicates an agricultural or industri