{"v":"3.0.0","project":{"accession":"PRJNA882743","title":"Anaerobic digestion of kitchen waste with hyperthermophilically pretreated grass for biohydrogen and biomethane production","description":"The study investigates the semi-continuous co-digestion experiments using kitchen waste and grass after hyperthermophilic pretreatment. Grass was preliminary treated at 70 Celsius degrees and then mixed with kitchen waste for anaerobic digestion in the second step, performed under mesophilic and thermophilic conditions. Simultaneously, pretreated grass was also treated in mono-digestion experiments at the same temperatures. Each experimental run was operated at two retention times of 30 and 20 days, and the digestate were collected twice a week for chemical analyses. The biogas was monitored daily with measurement of its composition, including contents of methane and hydrogen. At the end of each experimental run, the samples of the digestate were collected for metagenomic analysis","organism":null,"data_type":"Raw sequence reads","center_name":"Lodz University of Technology","submission_date":"2022/09/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN30948435","digestate kitchen waste and grass thermophilic 30 days","2021-09","Poland",null,null,51.0,20.0,"uncertain",null,"environmental sample; urban association not established",null,"anaerobic digestate","anaerobic digester effluent","digested material",null,"coordinate","PL",null,"unresolved",null,null,"Poland",2021],["SAMN30948436","digestate grass thermophilic 30 days","2021-09","Poland",null,null,51.0,20.0,"uncertain",null,"environmental sample; urban association not establish