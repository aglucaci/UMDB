{"v":"3.0.0","project":{"accession":"PRJNA1515406","title":"Elucidating the Potential Driving Mechanisms of Distinct Algal-Bacterial Granulation Pathways under Low-C/N Conditions: Insights from EPS-Mediated Interfacial Interactions and Community Metabolic Traits","description":"To track the dynamics of the algal-bacterial community, sludge samples were collected on days 30, 60, 90, and 120 for amplicon sequencing. Three subsamples were randomly collected from different locations within each PSBR and pooled to reduce spatial heterogeneity; each pooled sample was analyzed in triplicate. Amplicon sequencing was performed by Majorbio Co., Ltd. (Shanghai, China) on the Illumina NextSeq 2000 platform. The bacterial 16S rRNA gene and the algal chloroplast 23S rRNA gene were amplified using the primer pairs 338F/806R and p23SrV_f1/p23SrV_r1, respectively. On day 120, samples from the three ABGS groups underwent paired-end metagenomic sequencing on the DNBSEQ-T7 platform (Majorbio Bio-pharm Technology Co., Ltd., Shanghai, China).","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2026/08/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62582407","Metagenome or environmental sample from sludge metagenome","2025-03-28","China","Beijing","Beijing",39.54,116.25,"uncertain",null,"conflicting evidence: environmental and host/clinical","Reactor",null,null,null,"Microalgae","coordinate","CN",1816670,"verified","text+coordinates",null,"China:Beijing",2025],["SAMN62582408","Metagenome or environmental sample from sludge metagenome","2025-03-28","China","Beijing","Beijing",39.5