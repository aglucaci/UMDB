{"v":"3.0.0","project":{"accession":"PRJNA1462786","title":"Archaea and bacterial communities from sewage sludge used as inoculants and digestates from biogas production from filter cake and vinasse","description":"This project comprises ten metagenomic libraries of 16S rRNA gene amplicons (V3-V4 region) generated using the 27F (5'-AGAGTTTGATCCTGGCTCAG-3') and 1492R (5'-GGTTACCTTGTTACGACTT-3') primers. The data includes sequences from six activated sludge samples and four digestate samples derived from vinasse and sugarcane bagasse, sourced from the agro-industrial sector in the Cauca River Valley, Colombia. Activated sludge serves as the primary inoculum for the anaerobic digestion of bagasse and vinasse to produce methane and biogas. The objective of this study was to characterize the archaeal and bacterial community compositions within both the inocula and the digestates, providing insights into the microbial dynamics of waste treatment in the regional sugarcane industry.","organism":null,"data_type":"Raw sequence reads","center_name":"Colombian sugarcane research center CENICANA","submission_date":"2026/05/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN59033566","Activate sludge from WWTP1","2024-05-01","Colombia","Valle del Cauca Department","Cali",3.3826,-76.3344,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","activated sludge tank WWTP1, replicate 1","wastewater treatment plant [ENVO:01000002]","activated sludge [ENVO:01000624]","sludge [ENVO:00002011]",null,"coordinate","CO",3687925,"verified","text+coordinates",null,"Colombia: Cali, Valle del Cauca",2024],["SAMN59033567","Ac