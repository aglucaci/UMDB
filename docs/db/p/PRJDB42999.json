{"v":"3.0.0","project":{"accession":"PRJDB42999","title":"Quantitative and Viability-Based Detection of Pathogenic Bacteria in Environmental Waters by Full-Length 16S rRNA Sequencing","description":"The project aimed to simultaneously detect and quantify pathogenic bacterial species in environmental waters based on full-length 16S rRNA gene sequencing. To achieve this, a quantitative sequencing (qSeq) method using internal standard DNA spiking was developed. In addition, cis-dichlorodiammine platinum (CDDP), a membrane integrity-based viability dye, was evaluated for the selective detection of viable bacteria. Specific experiments were conducted to: (1) Compare the responses of bacterial communities in environmental waters to two viability dyes, PMAxx and cis-dichlorodiammine platinum (CDDP). (2) Optimize qSeq analytical conditions using the NBRC Microbial DNA Cocktail and ZymoBIOMICS Microbial Community DNA Standard II (Log Distribution). (3) Apply CDDP-qSeq and qSeq to river waters, including those receiving minimally treated WWTP discharges, for the simultaneous detection and quantification of multiple viable pathogenic bacterial species.","organism":"riverine metagenome","data_type":"Targeted Locus (Loci)","center_name":"Urban Sanitary Department of Environmental Engineering Graduate School of Engineering, Kyoto University","submission_date":"2026/08/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD01958793","viability dye comparison FY2023_07","2023-12-19","Japan","Kyoto","Kyoto",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"freshwater biome [ENVO:0000087