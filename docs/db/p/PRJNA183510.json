{"v":"3.0.0","project":{"accession":"PRJNA183510","title":"Hydrocarbon Metagenome","description":"Develop a database to describe and harness the genetic potential of the microorganisms, genes and biological processes that exist naturally in microbial communities in our oil sands and coal beds. By identifying the genes, bioprocesses and bacteria in the old sands and coal beds, we will improve our understanding of how methane in hydrocarbon resources is generated and identify the enzymes involved in the natural cracking of hydrocarbons that produce methane and carbon dioxide.","organism":"hydrocarbon metagenome","data_type":"Genome sequencing and assembly","center_name":"University of Calgary","submission_date":"2016/08/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN01828240","SyncrudeMLSB2011: syncurde West In-Pit metagenome","2011-04","Canada","Alberta",null,57.02,-111.55,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CA",null,"unresolved",null,null,"Canada: Syncrude, Ft. McMurray, Alberta",2011],["SAMN01828241","PDSYNTPWS: WIP-PD_SYN_TP_WS_002_003_071511 WIP surface sample","2011-09-01","Canada",null,null,57.02,-111.55,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CA",null,"unresolved",null,null,"Canada: Near Fort McMurray in northeastern Alberta",2011],["SAMN01828448","San Juan basin coal bed production water","2011-01-09","United States",null,null,37.0,-108.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null