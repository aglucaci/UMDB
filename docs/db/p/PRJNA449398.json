{"v":"3.0.0","project":{"accession":"PRJNA449398","title":"Finding the source: towards quantitative methods for microbial sourcing tracking","description":"In this study, amplicon sequencing (emerging technique not fully adapted for source tracking) is applied for microbial source tracking of spiked samples (mixtures of surface water and known quantities of horse, goose, and dog fecal matter, and wastewater) as well as field samples of impacted surface water. Results will be evaluated to identify microbial community fingerprints associated with different fecal sources within the samples. The goal is to verify/demonstrate amplicon sequencing as an effective fingerprinting method with great potential for future use in source tracking.","organism":null,"data_type":"Raw sequence reads","center_name":"Rutgers University","submission_date":"2018/04/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN08902890","SW","2017-07-12","United States","New York","Staten Island",40.35428,-74.0724,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Surface Water- Navesink River, Wastewater treatment plant influent",null,null,null,null,"coordinate","US",5139568,"probable","coordinates",null,"USA: New Jersey",2017],["SAMN08902891","Swdup","2017-07-12","United States","New York","Staten Island",40.35428,-74.0724,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Surface Water- Navesink River, Wastewater treatment plant influent",null,null,null,null,"coordinate","US",5139568,"probable","coordinates",null,"USA: New Jersey",2017],["SAMN08902892","SWG","2017-07-12","United States"