{"v":"3.0.0","project":{"accession":"PRJNA1252096","title":"16S rRNA amplicon sequencing data from lab scale Upflow Anaerobic Sludge Blanket (UASB) reactors","description":"The sequencing data were collected from lab scale UASB reactors with different configurations of the reactors (e.g., reactor type, ratio of height to diameter), the operational parameters (e.g., substrate, feeding strategy, organic loading rate, concentration of different types of COD, amendment of granular activated carbon, VSS, etc.) and resulted parameters (e.g., hydrolysis efficiency, specific methanogenic activity, etc.). The microbial profile gained from the amplicon sequencing data was incorporated with the configurational and operational parameters to test a importance-driven feature reduction strategy.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Alberta","submission_date":"2025/04/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48033057","MIMS Environmental/Metagenome sample from anaerobic digester metagenome","2019-11-07","Canada","Alberta","Edmonton",53.53,-113.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater biome","UASB anaerobic digester","blackwater",null,"coordinate","CA",5946768,"verified","text+coordinates",null,"Canada: Edmonton",2019],["SAMN48033058","MIMS Environmental/Metagenome sample from anaerobic digester metagenome","2019-11-07","Canada","Alberta","Edmonton",53.53,-113.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater biome","UASB anaerobic digester","blackwater",