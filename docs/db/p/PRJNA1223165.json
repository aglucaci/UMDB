{"v":"3.0.0","project":{"accession":"PRJNA1223165","title":"Metagenomic analysis of coral-pyrite substrate electroactive constructed wetland","description":"We developed a coral sand-pyrite substrate E-CW system that accomplished simultaneous pollutants removal and OM sequestration. This system primarily harnessed the superior adsorption capabilities of coral sand, along with the iron redox cycling driven by associated microorganisms facilitated by pyrite, to enhance OM sequestration. Furthermore, the incorporation of the BES fostered the enrichment of EAB, which also constituted the main body of DIRB. This process promoted the degradation of OM and the biochemical transformation of iron oxides, thereby amplifying the effectiveness of OM sequestration.","organism":null,"data_type":"Raw sequence reads","center_name":"Chongqing University","submission_date":"2025/02/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46800171","control1","2024-09-06",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN46800173","control2","2024-09-06",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN46800175","control3","2024-09-06",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN46800177","test1","2024-09-06