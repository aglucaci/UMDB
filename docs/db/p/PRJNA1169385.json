{"v":"3.0.0","project":{"accession":"PRJNA1169385","title":"Whole genome sequencing of bacteria isolates collected in medical intensive care unit (MICU) environments","description":"We conducted a field survey of environmental locations in an MICU in Chicago, USA. We collected 219 swab samples from seven environmental locations (e.g., bedrails, nurse calls, doorsills, keyboards, light switches, proximal sink drains) over two sampling events (February and July, 2018). Among the environments, sink drains were identified as critical hotspots. The samples were cultivated, and the isolates were screened for chlorhexidine tolerance. A subset of 63 isolates were selected for whole-genome sequencing. Additionally, three whole-pipeline negative controls were sequenced alongside the isolate samples.","organism":null,"data_type":"Raw sequence reads","center_name":"Northwestern University","submission_date":"2024/10/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44073448","Negative control","2018-02-20","United States","Illinois","Chicago",41.87,-87.67,"confirmed_urban","built_environment","explicit urban setting at sample level",null,"urban biome [ENVO:01000249]|healthcare environment [ENVO:03501331]","intensive care unit facility [ENVO:03501152]","building material [EUPATH:0000001]",null,"coordinate","US",4887398,"verified","text+coordinates",null,"USA: Chicago",2018],["SAMN44073449","Negative control","2018-07-23","United States","Illinois","Chicago",41.87,-87.67,"confirmed_urban","built_environment","explicit urban setting at sample level",null,"urban biome [ENVO:01000249]|healthcare environment [ENVO:03501331]","intensive care u