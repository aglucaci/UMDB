{"v":"3.0.0","project":{"accession":"PRJNA1100746","title":"16S profiles from Constructed Wetlands and a T-WWTP in North-Eastern Spain","description":"Illumina reads of 16S rRNA gene amplicons generated from samples from nature-based solutions for the removal of antibiotics and antibiotic resistance genes from wastewater. Specifically, samples were from full-scale horizontal flow constructed wetlands in the Besos River (BESCW), surface flow constructed wetland at Can Cabanyes (CCABCW), and a disinfection unit of conventional treatment plant (LLOWWTP), all located in NE Spain. Samples were taken during summer, autumn, and winter of 2022/2023.","organism":null,"data_type":"Raw sequence reads","center_name":"Karlsruhe Institute of Technology","submission_date":"2024/04/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40978475","Metagenome or environmental sample from wastewater metagenome","2022-06-15","Spain","Catalonia","Lloret de Mar",41.715,2.8226,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Grab samples fromwastewater treatment plant in Lloret de Mar",null,null,null,null,"coordinate","ES",3118212,"verified","text+coordinates",null,"Spain: Lloret de Mar",2022],["SAMN40978476","Metagenome or environmental sample from wastewater metagenome","2023-02-24","Spain","Catalonia","Lloret de Mar",41.715,2.8226,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Grab samples fromwastewater treatment plant in Lloret de Mar",null,null,null,null,"coordinate","ES",3118212,"verified","text+coordinates",null,"Spain: Lloret de Mar",2023],["SAMN409