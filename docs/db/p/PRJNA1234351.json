{"v":"3.0.0","project":{"accession":"PRJNA1234351","title":"Study on microbial community diversity composition profile","description":"Sludge samples were collected at 0 d, 20 d, and 90 d to analyze microbial community structure changes in different reactors over time. This analysis aimed to further investigate the effects of zero-valent iron (ZVI) and tetracyclines (TCs) on potential hosts of ARGs in wastewater treatment. High-throughput sequencing was used to examine microbial community composition. Specifically, zd, C20d, Fe20d, TC20d, and TCFe20d represent the initial sludge, the control group, Fe group, TCs group, and TCs+Fe group at 20 d, respectively. Similarly, C90d, Fe90d, TC90d, and TCFe90d correspond to the control group, Fe group, TCs group, and TCs+Fe group at 90 d.","organism":null,"data_type":"Raw sequence reads","center_name":"no","submission_date":"2025/03/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47295961","MIMARKS Survey related sample from sludge metagenome","2024-05","China","Shanghai","Shanghai",31.2304,121.4737,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"sludge","Active sludge","Active sludge","sludge","coordinate","CN",1796236,"verified","text+coordinates",null,"China:Shanghai",2024],["SAMN47295962","MIMARKS Survey related sample from sludge metagenome","2024-05","China","Shanghai","Shanghai",31.2304,121.4737,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"sludge","Active sludge","Active sludge","sludge","coordinate","CN",1796236,"verified","text+coordinates",null,"China:Shanghai",2024