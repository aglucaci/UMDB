{"v":"3.0.0","project":{"accession":"PRJNA362697","title":"WWTP_virome","description":"Sludge bulking is notorious in activated sludge processes, always coupled with dramatic changes in bacterial community compositions and functions. Despite a huge number of bacteriophages present in sludge systems, the response of viral communities to sludge bulking is unknown. In this study, the viral communities in an activated sludge plant under different sludge conditions were examined by high-throughput sequencing of viral metagenomes.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Chinese Academy of Sciences","submission_date":"2017/01/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN06246245","MIMS Environmental/Metagenome sample from wastewater metagenome","2012-03-01","China","Beijing","Beijing",39.9,116.33,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"freshwater biome","wastewater treatment plant","sludge",null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2012],["SAMN06246246","MIMS Environmental/Metagenome sample from wastewater metagenome","2011-05-01","China","Beijing","Beijing",39.9,116.33,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"freshwater biome","wastewater treatment plant","sludge",null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2011],["SAMN06246247","MIMS Environmental/Metagenome sample from wastewater metagenome","2011-09-01","China","Beijing","Beijing",39.9,116.33,"confirmed_urban","municipal_wastewater","named urban infrastru