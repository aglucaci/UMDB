{"v":"3.0.0","project":{"accession":"PRJNA1263049","title":"SGV &  IFAS","description":"Integrated fixed-film activated sludge (IFAS) systems provide an energy-efficient method for nitrogen removal in aniline wastewater treatment. To further improve energy and carbon efficiency, low superficial gas velocity (SGV) is recommended to optimize biofilm-sludge interactions and regulate electron transfer. However, the effects of low SGV on microbial community dynamics and electron transfer under aniline stress in continuous-flow IFAS systems remain insufficiently understood. Herein, IFAS in continuous-flow mode under different SGVs (0.15, 0.10, and 0.04 cm/s) were set up to investigate it.","organism":null,"data_type":"Raw sequence reads","center_name":"China Institute of Water Resources and Hydropower Research","submission_date":"2025/05/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48509215","sludge","2023",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN48509216","sludge","2023",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN48509217","sludge","2023",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN48509219","sludge","2023",null,null,null,null,null,"uncertain",null,"environmental sample