{"v":"3.0.0","project":{"accession":"PRJNA810512","title":"Metagenome Sequencing Reveals the Microbiome of Aedes albopictus and its Possible Relationship with Dengue Virus Susceptibility","description":"We performed metagenomic sequencing to detect microbiome variation in Aedes albopictus after exposure to DENV blood meal to compare the bacterial microbiomes of Aedes albopictus with different susceptibilities to DENV. The results were as followed: The dominant phyla in the Aedes albopictus microbiome were Proteobacteria and Ascomycota, and the dominant genera were Aspergillus and Metarhizium. Gammaproteobacteria bacterium,Lactobacillus harbinensis and Neurospora crassa differed significantly after DENV infection. 15 different microorganisms were found to be involved in mosquito immunity and metabolism, including Alphaproteobacteria bacterium, Methyloglobulus morosus and Shigella sonnei, which might have an impact on the DENV susceptibility of Aedes albopictus.","organism":null,"data_type":"Raw sequence reads","center_name":"State Key Laboratory of Pathogen and Biosecurity, Beijin","submission_date":"2022/02/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN26264640","DENV infected","2019-09","China","Guangdong","Guangzhou",23.05,113.41,"non_environmental",null,"host-derived or clinical material","wastewater",null,null,null,"Aedes albopictus","coordinate","CN",1809858,"verified","text+coordinates",null,"China:Guangzhou",2019],["SAMN26264641","DENV infected","2019-09","China","Guangdong","Guangzhou",23.05,113.41,"non_environmental",null,"host-derived or clinical material","wastewater",null,null,null,"Aedes albopictus","coordin