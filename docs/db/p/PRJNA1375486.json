{"v":"3.0.0","project":{"accession":"PRJNA1375486","title":"Engineered carbon-depleted zone in Anaerobic/Aerobic/Anoxic process as a key in-situ anammox incubation hub for mainstream municipal wastewater treatment","description":"Competitive nitrite consumption by heterotrophic organisms and the carbon sensitivity of anammox bacteria limit mainstream anammox performance. This study demonstrates that deliberately established carbon-depleted zones within anaerobic/aerobic/anoxic (AOA) processes served as in-situ anammox incubation hubs by regulating endogenous and exogenous carbon metabolism, achieving 92.3% nitrogen removal with 59.4% via anammox and effluent total inorganic nitrogen of 5.1 mg/L at C/N 3.2.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2025/12/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN53686882","Metagenome or environmental sample from sludge metagenome","2024-09","China",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,"sludge","country","CN",null,"unresolved",null,null,"China",2024],["SAMN53686883","Metagenome or environmental sample from sludge metagenome","2024-09","China",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,"sludge","country","CN",null,"unresolved",null,null,"China",2024],["SAMN53686884","Metagenome or environmental sample from sludge metagenome","2024-09","China",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject 