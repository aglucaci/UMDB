{"v":"3.0.0","project":{"accession":"PRJNA796317","title":"Pond B (Savannah River Site) Microbial Community of the Water Column and Sediment","description":"Pond B at Savannah River Site (SRS; South Carolina, USA) is a man-made, warm monomictic pond that received nuclear reactor cooling water between 1961-1964. The pond is contaminated with trace amounts of Cs-137, Sr-90, Am-241, Cm-244, and Pu-238,239,240. Since 1964, Pond B has remained relatively isolated except for a few radiological and macro ecological research studies, which demonstrated Pu redox cycling with seasonal anoxia. However, the microbial mechanism(s) involved in Pu cycling remains unknown. The objective of this study was to evaluate the biogeochemical factors that influence Pu redox cycling in Pond B, including identifying the bacterial and archaeal community through 16S rRNA amplicon sequencing.","organism":null,"data_type":"Raw sequence reads","center_name":"Lawrence Livermore National Lab","submission_date":"2022/01/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN24846776","Site_Air_Control","2019-06-25","United States","South Carolina",null,33.29717,-81.54335,"probable_urban","air_dust","city-level location without sample-site confirmation",null,"ENVO:00002005",null,"ENVO:00002005",null,"coordinate","US",null,"unresolved",null,null,"USA: Savannah River Site, South Carolina",2019],["SAMN24846777","Biosafety Cabinet Batch 1","2019-10-24","United States","California","Livermore",37.6875,-121.7065,"probable_urban","air_dust","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","US",5367440,"verified","text+coordinat