{"v":"3.0.0","project":{"accession":"PRJNA1424920","title":"Anaerobic digestibility of waste microalgal-bacterial aerobic granular sludge","description":"This project reports shotgun metagenomic sequencing of biomass from anaerobic digestion systems treating waste microalgal bacterial aerobic granular sludge (WMB-AGS) and waste activated sludge (WAS) to evaluate microbial community shifts and functional potential under ciprofloxacin exposure. Samples were collected from a controlled experimental framework including biochemical methane potential (BMP) tests, short-term hydrolysis-acidogenesis test, and long-term semi-continuous anaerobic digesters operated with and without ciprofloxacin. The multi-omics data were generated to link digestion performance and ciprofloxacin fate with shifts in bacterial and archaeal taxa and with changes in transcriptional activity of pathways related to hydrolysis, methanogenesis, stress response, detoxification, and electron-transfer processes.","organism":null,"data_type":"Raw sequence reads","center_name":"Ghent University","submission_date":"2026/02/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN55401060","Anaerobic digester biomass (AD1), day 50","2024-12-26","South Korea","Incheon","Incheon",37.4752,126.6313,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Wastewater","Lab-scale anaerobic digester (semi-continuous)","Anaerobic digester sludge",null,"coordinate","KR",1843564,"verified","text+coordinates",null,"South Korea: Incheon",2024],["SAMN55401061","Anaerobic digester biomass (AD1), day 70","2025-01-15","South Korea","Incheon","Inc