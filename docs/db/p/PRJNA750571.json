{"v":"3.0.0","project":{"accession":"PRJNA750571","title":"Resistome in sewage surviellance","description":"Sewage-based surveillance is widely employed to understand the occurrence and distribution of antimicrobial resistance (AMR), with a focus mainly on wastewater treatment plants. However, limited information is available on the various sewage types upstream, which is essential for an understanding of AMR in the community. The present study used metagenomics to decipher the AMR profiles in five sewage effluent types that were obtained from different sources: high density residential buildings (local healthy population), a large-scale pet centre housing many pet shops (animal source), a workers dormitory (foreign workers), hospitals (clinical waste), and an urban wastewater treatment plant (aggregated urban waste).","organism":null,"data_type":"Raw sequence reads","center_name":"National University of Singapore","submission_date":"2021/07/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN20464146","Metagenome or environmental sample from metagenome","2019-05","Singapore",null,"Singapore",1.35,103.82,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","Sewage",null,null,null,null,"coordinate","SG",1880252,"probable","city-state",null,"Singapore",2019],["SAMN20464147","Metagenome or environmental sample from metagenome","2019-05","Singapore",null,"Singapore",1.36,103.83,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","Sewage",null,null,null,null,"coordinate","SG",1880252,"probable","city-state",null,"Singapore",2019],["SAMN20464148","Metagenome or e