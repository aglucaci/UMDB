{"v":"3.0.0","project":{"accession":"PRJNA314977","title":"Design and Evaluation of Illumina MiSeq compatible 18S rRNA Primers for Improved Characterization of Mixed Phototrophic Communities.","description":"A systematic analysis of the most commonly amplified 18S rRNA hypervariable regions and the effect that PCR/sequencing bias has on community representation. The V4 and V8-V9 hypervariable regions were amplified for seven mock communities and for freshwater, marine, and wastewater samples to compare the sequenced community structure to theoretical communities and validate these results with environmental samples.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Illinois at Urbana Champaign","submission_date":"2016/03/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN04546408","Metagenome or environmental sample from wastewater metagenome","2014-09-17","United States","Kansas","Lawrence",38.968,-95.2207,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Lawrence, KS primary wastewater",null,null,null,null,"coordinate","US",4274277,"verified","text+coordinates",null,"USA: Lawrence, Kansas",2014],["SAMN04546409","Metagenome or environmental sample from wastewater metagenome","2014-09-23","United States","Illinois","Charleston",39.4944,-88.2003,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","algaewheel for wastewater treatment",null,null,null,null,"coordinate","US",4235668,"verified","text+coordinates",null,"USA: Charleston, Illinois",2014],["SAMN04546410","Metagenome or environmental sample from wastewat