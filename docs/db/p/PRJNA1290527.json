{"v":"3.0.0","project":{"accession":"PRJNA1290527","title":"Biofilter packing material","description":"This study evaluates a novel combined process, iron-carbon micro-electrolysis (IC-ME) coupled with a deepbed denitrification filter (DBDF), for the advanced treatment of secondary effluent from a sewage treatmentplant. The core objective is to achieve efficient and simultaneous removal of total nitrogen (TN), nitrate(NO3--N), total phosphorus (TP), and chemical oxygen demand (COD) to meet stringent discharge standards. The significance of this research lies in offering a promising and effective tertiary treatment technology to address the critical issue of eutrophication caused by nutrient-rich effluent.","organism":null,"data_type":"Raw sequence reads","center_name":"NUIST","submission_date":"2025/07/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49922881","biofilter metagenome","2021-03-31","China","Jiangsu","Nanjing",32.06167,118.77778,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"wastewater treatment plant biome [ENVO:01001407]","iron-containing material [ENVO:00002134], waste water [ENVO:00002001]","treated waste water [ENVO:00002018]",null,"coordinate","CN",1799962,"verified","text+coordinates",null,"China:Nanjing",2021],["SAMN49922882","biofilter metagenome","2021-03-31","China","Jiangsu","Nanjing",32.06167,118.77779,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"wastewater treatment plant biome [ENVO:01001407]","iron-containing material [ENVO:00002134], waste water [ENVO:00002001]","treated waste water [ENVO:00002018]",null