{"v":"3.0.0","project":{"accession":"PRJNA1146552","title":"Anode Potential Regulates the Gas Composition and Microbiome in Anaerobic Electrochemical Digestion","description":"Anaerobic electrochemical digestion (AED) is an effective system for recovering biogas from organic wastes. However, it is unclear how anode potentials affect the gas production in anaerobic activated sludge. Here, we conducted the research to explore how the anode potential affects the microbiome and gas composition. This study provides insights into the regulatory strategies of MEC technology during anaerobic digestion, which plays a decisive role in determining the composition of biogas.","organism":null,"data_type":"Raw sequence reads","center_name":"Nankai University","submission_date":"2024/08/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43104350","sludge","2023-12-20","China","Tianjin","Tianjin",39.08,117.2,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor sample_1",null,null,null,null,"coordinate","CN",1792947,"verified","text+coordinates",null,"China: Tianjin",2023],["SAMN43104351","sludge","2023-12-20","China","Tianjin","Tianjin",39.08,117.2,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor sample_2",null,null,null,null,"coordinate","CN",1792947,"verified","text+coordinates",null,"China: Tianjin",2023],["SAMN43104352","sludge","2023-12-20","China","Tianjin","Tianjin",39.08,117.2,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor sample_3",null,null,null,null,"coordinate","CN",179