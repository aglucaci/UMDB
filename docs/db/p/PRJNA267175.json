{"v":"3.0.0","project":{"accession":"PRJNA267175","title":"Biowaste Metagenome","description":"The study aimed at the microbial production of lactic acid as an additional step within current biowaste treatment technology. Prior to fermentation the biowaste was separated into a liquid and a solid fraction following a biorefinery concept. The liquid fraction was fermented to lactic acid under different conditions employing only the biowaste`s indigenous microbiota. Fermentation was evaluated regarding physicochemical and especially microbial characteristics. Its residues and the solid fraction of biowaste can be treated in anaerobic digestion as usual. This implementation could increase the exploitation of the waste potential providing a cheap and efficient possibility of lactic acid production without forcing major changes in the current waste treatment technology.","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"University of Innsbruck","submission_date":"2014/11/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN03178172","MIMS Environmental/Metagenome sample from wastewater metagenome","2012-11-15","Austria",null,null,null,null,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"municipal biowaste","waste treatment plant","organic waste",null,"city","AT",null,"unresolved",null,null,"Austria: Tirol",2012],["SAMN03178173","MIMS Environmental/Metagenome sample from wastewater metagenome","2012-11-15","Austria",null,null,null,null,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"municipal biowaste","waste treatment plant","orga