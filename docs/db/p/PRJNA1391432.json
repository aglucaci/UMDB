{"v":"3.0.0","project":{"accession":"PRJNA1391432","title":"Overlooked roles of pharmaceutical metabolic products in stimulating microbial metabolism and antibiotic resistance gene dissemination of anaerobic sludge","description":"Despite the widespread environmental occurrence of non-antibiotic pharmaceuticals, their roles in shaping the dissemination behaviors of antibiotic resistance genes (ARGs) in wastewater treatment systems remain poorly understood. In particular, focus of the previous studies have been mainly on the original pollutants while overlooking their transformation products, possibly resulting in underestimation of their true ecological risks. Here, we unveiled more profound impacts of the biotransformation product of metformin (MET, a non-antibiotic pharmaceutical) than itself on the microbial community structure and ARG propagation of wastewater anaerobic sludge.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Science & Technology of China","submission_date":"2025/12/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54220305","Metagenome or environmental sample from sludge metagenome","2023","China","Anhui","Hefei",31.84,117.27,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge",null,null,null,null,"coordinate","CN",1808722,"verified","text+coordinates",null,"China: Hefei",2023],["SAMN54220306","Metagenome or environmental sample from sludge metagenome","2023","China","Anhui","Hefei",31.84,117.27,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge",null,null,null,null,"coord