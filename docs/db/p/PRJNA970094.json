{"v":"3.0.0","project":{"accession":"PRJNA970094","title":"Study on temporal and spatial succession and driving factors of bacterial community in different culture modes of Litopenaeus vannamei","description":"With the rapid development of China's shrimp aquaculture industry, the aquaculture environment is deteriorating, and the disease caused by pathogens has a high incidence, rapid spread, and high mortality, which has brought a great impact on China 's shrimp aquaculture industry. Microorganisms in the water environment are crucial to the health and water quality of cultured animals in aquaculture ecosystems. The monitoring of microbial communities in aquaculture water also provides the possibility of early warning of bacterial diseases in shrimp. However, there are few studies comparing the spatial and temporal succession and driving factors of bacterial communities in the flow aquaculture model and the recirculating aquaculture model.","organism":null,"data_type":"Raw sequence reads","center_name":"Dalian Ocean University","submission_date":"2023/05/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN34993974","16s rDNA of wastewater","2022-05-25","China",null,null,40.69,121.18,"non_urban",null,"BioProject indicates an agricultural or industrial source","water",null,null,null,"wastewater","coordinate","CN",null,"conflicting","text","'Yingkou' is 89 km from the reported coordinates","China:Yingkou",2022],["SAMN34993975","16s rDNA of wastewater","2022-05-26","China",null,null,40.69,121.18,"non_urban",null,"BioProject indicates an agricultural or industrial source","water",null,null,null,"wastewater","coordinate","CN",null,"