{"v":"3.0.0","project":{"accession":"PRJNA1241478","title":"Anaerobic digestion sludge metagenome","description":"In this study, two anaerobic membrane bioreactors were operated in parallel: one conventional (R1) and one integrated electrochemical components (R2). Both bioreactor systems featured a submerged membrane unit within a cylindrical anaerobic digester. The biofilm cake layer samples of the bioreactor membranes were gathered and freeze-dried for 48 h for metagenomic analysis from the viewpoint of microorganisms and genes. The abundance of genes was summed to calculate the abundance of functional categories.","organism":"biofilm metagenome","data_type":"Metagenome","center_name":"Tongji University","submission_date":"2025/03/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47543396","Microbe sample from Methanobacteriaceae archaeon","2024-08-08","China","Shanghai","Shanghai",31.28,121.5,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater treatment process",null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2024],["SAMN47543397","Microbe sample from archaeon","2024-08-08","China","Shanghai","Shanghai",31.28,121.5,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater treatment process",null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2024],["SAMN47543398","Microbe sample from Methanothrix sp.","2024-08-08","China","Shanghai","Shanghai",31.28,121.5,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater treatment process",null,null