{"v":"3.0.0","project":{"accession":"PRJNA1457535","title":"Dynamics of Enterobacteriaceae reservoirs harboring blaCTX-M group 1 in community wastewater systems","description":"The rising prevalence of clinically significant blaCTX-M group 1 resistance genes in human populations underscores the need for further investigation, particularly to elucidate the establishment and dynamics of environmental reservoirs. In this study, we combined molecular and culture-based approaches to examine the potential origins, abundance, and temporal dynamics of blaCTX-M group 1 genes in wastewater systems. We sequenced blaCTX-M amplicons from 14 wastewater raw influent samples to identify abundant variants and their enzyme groups in wastewater. We performed whole-genome sequencing for 24 selectively isolated Escherichia coli strains to assess their antibiotic resistance, particularly the presence of the blaCTX-M gene, and virulence gene profiles. Our results revealed a high prevalence of blaCTX-M group 1 genes among wastewater E. coli, with resistance and virulence profiles closely resembling those observed in clinical isolates, highlighting the importance of monitoring antibiotic resistance in wastewater systems.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Wisconsin-Milwaukee","submission_date":"2026/04/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57465268","MIGS Cultured Bacterial/Archaeal sample from Escherichia coli","2020-03","United States","Wisconsin","Milwaukee",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"wastewater","Jones Island and South Shore","ra