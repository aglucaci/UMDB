{"v":"3.0.0","project":{"accession":"PRJNA1307243","title":"Microbial community in dye wastewater treatment with different cosubstrates","description":"This dataset contains microbial community data obtained from a batch-scale anaerobic system treating the azo dye Reactive Black 5. The experiments were conducted with five different cosubstrates (starch, glucose, ethanol, propionate, and acetate) under two lines of vials (with dye and without dye) and two operational phases (with and without magnetite).To further investigate the long-term microbial community dynamics in ethanol-fed systems, a continuous-scale experiment was carried out for 250 days using ethanol as the primary cosubstrate. Microbial samples were collected from three distinct phases: ethanol only, ethanol with dye, and ethanol with dye supplemented with magnetite.","organism":null,"data_type":"Raw sequence reads","center_name":"Kyoto University","submission_date":"2025/08/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50657276","Metagenome or environmental sample from metagenome","2023-11","Japan","Niigata","Nagaoka",37.446,138.85,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anaerobic dye wastewater batch reactor with ethanol",null,null,null,null,"coordinate","JP",1856199,"verified","text+coordinates",null,"Japan:Nagaoka",2023],["SAMN50657277","Metagenome or environmental sample from metagenome","2023-12","Japan","Niigata","Nagaoka",37.446,138.85,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anaerobic dye wastewater batch reactor with ethanol and magnetite",