{"v":"3.0.0","project":{"accession":"PRJNA1274666","title":"Transcriptomic profiling of Aeromonas hydrophila under nanoplastic and shear stress exposure","description":"For transcriptomic analysis, Aeromonas hydrophila cells from each treatment group were collected from three biological replicates. Cells were harvested by centrifugation, washed, and total RNA was extracted following the Majorbio protocol. After DNase I treatment, RNA purity was assessed using NanoDrop 2000. Strand-specific cDNA libraries were prepared using the TruSeq RNA Sample Prep Kit (Illumina). Briefly, mRNA was fragmented, cDNA synthesized using random hexamers, and dUTP was incorporated during second-strand synthesis. After adapter ligation, uracil-N-glycosylase was used to remove the second strand, followed by PCR amplification. Sequencing was conducted on the Illumina NovaSeq 6000 platform with paired-end reads. Differential expression analysis was performed using DESeq2, and KEGG pathway enrichment was conducted via the Majorbio Cloud Platform.","organism":null,"data_type":"Raw sequence reads","center_name":"guangzhou university","submission_date":"2025/06/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48957398","MIGS Cultured Bacterial/Archaeal sample from Aeromonas hydrophila","2024-04-30","China","Guangdong","Guangzhou",23.12,113.22,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"aquatic biome","municipal wastewater treatment plant","wastewater",null,"coordinate","CN",1809858,"verified","text+coordinates",null,"China: Guangzhou, Datansha Wastewater Treatment Plant",2024],["SAMN48957399","MIGS Cultured Bacterial/