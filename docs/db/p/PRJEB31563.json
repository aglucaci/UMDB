{"v":"3.0.0","project":{"accession":"PRJEB31563","title":"Functional metagenomic analysis of airborne samples collected near Red Sea.","description":"Airborne dust samples collected at the coastal and offshore regions of the Red Sea during December 2015 to November 2016 were all sequenced through Shotgun illumina sequencing. Individual samples were assembled using metaSpades and protein coding ORF genes predicted using MetaGeneMark. A non redundant gene catalog was developed through clustering of gene across samples. Protein sequence based taxonomic and functional assignments were summarized in a Gene Information Table (GIT) using Annotation Module in Dragon Metagenomic Analysis Platform (DMAP) at KAUST. Individual sample were mapped onto the common reference gene catalogue in order to find abundance of genes and corresponding GITs were indexed for easy online access and comparisons in DMAP Compare Module.","organism":null,"data_type":"Other","center_name":"CBRC, Computational Bioscience Research Center, KAUST","submission_date":"2019/05/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA5425552","KAUST_013","2015-12-06","Saudi Arabia",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","SA",null,"unresolved",null,null,"Saudi Arabia",2015],["SAMEA5425553","Thuwal_001","2016-02-19","Saudi Arabia",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","SA",null,"unresolved",null,null,"Saudi Arabia",2016],["SAMEA5425554","KAUST_024","2016-02-28","Saudi Arabia",null,null,null,nu