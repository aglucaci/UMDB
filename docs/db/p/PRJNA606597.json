{"v":"3.0.0","project":{"accession":"PRJNA606597","title":"Effect of chlorate on perchlorate and sulfate reducing bacteria","description":"Perchlorate is a ubiquitous water contaminant, and biological reduction is a promising treatment strategy. However, it is difficult to remove perchlorate to low ug/L levels via biological reduction. Also, nitrate must be reduced prior to or concurrently with perchlorate reduction, and low nitrate typical leads to sulfate reduction. Addition of chlorate, an intermediate in the perchlorate reduction pathway, may help enrich for perchlorate-reducing bacteria (PRB) and suppress sulfate-reducing bacteria (SRB). We explored the effect of chlorate addition on a hydrogen-based membrane biofilm reactor (H2-MBfRs).","organism":null,"data_type":"Raw sequence reads","center_name":"Univeristy of Notre Dame","submission_date":"2020/02/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN14100527","Microbe sample from mixed culture","2017-09-08","United States","Indiana","South Bend",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","Enrichment of activated sludge from the South Bend Wastewater treatment plant",null,null,null,null,"city","US",4926563,"verified","text",null,"USA: South Bend, Indiana",2017],["SAMN14100528","Microbe sample from mixed culture","2017-09-08","United States","Indiana","South Bend",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","Enrichment of activated sludge from the South Bend Wastewater treatment plant",null,null,null,null,"city","US",4926563,"verified","text",null,"USA: South Bend, Indiana",2017],["SAMN141005