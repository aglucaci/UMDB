{"v":"3.0.0","project":{"accession":"PRJNA1542253","title":"Bacterial community succession and metagenomic profiles during aerobic granular sludge formation under polystyrene microplastic and nanoplastic exposure","description":"This project investigates the effects of polystyrene microplastics and nanoplastics on microbial community succession and metabolic potential during aerobic granular sludge formation for nitrogen and phosphorus removal. Five laboratory-scale sequencing batch reactors were operated for 280 days under anaerobic-aerobic-anoxic conditions, including a plastic-free control and four exposure treatments. The treatments comprised polystyrene microplastics with a particle size of 200 micrometers at 0.5 and 10 mg/L and polystyrene nanoplastics with a particle size of 300 nm at 0.05 and 5 mg/L. The dataset comprises 25 bacterial 16S rRNA gene amplicon libraries targeting the V3-V4 region from sludge sampled on days 43, 68, 121, 225, and 280, and 15 shotgun metagenomic libraries from day 280. All libraries were sequenced on an Illumina NovaSeq 6000 platform using paired-end sequencing. These data support analyses of bacterial community dynamics and the genetic potential for carbon, nitrogen, and phosphorus metabolism under microplastic and nanoplastic exposure.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2026/10/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64116871","Metagenome or environmental sample from sludge metagenome","2024-02-04T13:30:35Z","China","Beijing","Beijing",39.875357,116.480595,"probable_urban","municipal_wastewater"