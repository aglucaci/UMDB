{"v":"3.0.0","project":{"accession":"PRJEB43576","title":"Sinking particle eukaryotes in sediment trap samples in Fram Strait (Arctic Ocean)","description":"The data set comprise 25 archived sinking particle samples from moored sediment traps deployed between ~ 80 – 280 m water depth in Fram Strait (Arctic Ocean), which were obtained in the framework of the Long-Term Ecological Research Site HAUSGARTEN and the Helmholtz infrastructure program FRAM. The samples correspond to those obtained during the highest particulate organic carbon (POC) flux in spring and summer, we used the data to investigate variations in eukaryotic community structure over a period of 12 years (2000 – 2012).","organism":null,"data_type":"Other","center_name":"German Federation for Biological Data","submission_date":"2022/07/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA8224414","FEVI_24_Oben_14","2012-04-30/2012-05-10",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Arctic Ocean",2012],["SAMEA8224415","FEVI_24_Oben_3","2011-08-31/2011-09-10",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Arctic Ocean",2011],["SAMEA8224416","FEVI_22_Oben_16","2011-04-30/2011-05-10",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Arctic Ocean",2011],["SAMEA8224417","FEVI_20_Oben_19","2010-06-15/2010-06-30",null,null,null,null,null,"non_urban",nul