{"v":"3.0.0","project":{"accession":"PRJNA1243375","title":"Dissolved oxygen control in photosynthetic-oxygen supported algal-bacterial granule","description":"Algal-bacterial granule (ABG) process is a promising biotechnology for carbon emission reduction, especially for photosynthetic O2-supported ABG (POS-ABG) systems without mechanical aeration. However, the roles of dissolved oxygen (DO) generated by coexisting algae remain unclear in this POS-ABG system. This study aimed to explore the effects of different DO control levels (0.5-1.0, 1.0-1.5, 2.0-2.5 mg/L) on POS-ABG system performance, in which DO levels were automatically controlled via a feedback control unit between DO concentration and light duration.","organism":null,"data_type":"Raw sequence reads","center_name":"Shanghai Academy of Environmental Sciences","submission_date":"2025/03/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47619291","Sludge","2023-03-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47619292","Sludge","2023-03-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47619293","Sludge","2023-03-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47619294","Sludge","2023-03-20",null,null,null,null,null,