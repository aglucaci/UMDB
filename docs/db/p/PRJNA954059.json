{"v":"3.0.0","project":{"accession":"PRJNA954059","title":"Information storage across a microbial community using universal RNA barcoding","description":"A synthetic catalytic RNA was used to write information in conserved 16S ribosomal RNA (rRNA) sequences about gene transfer host range. By reading out native and modified rRNA using amplicon sequencing, we were able to simultaneously determine the composition of a microbial community, identify the members that participate in conjugation, and observe differences in information storage across amplicon sequence variants. This sensitive, autonomous, and reversible RNA-addressable memory (RAM) will enable cellular programming and biosurveillance across communities within diverse ecological settings and fundamental studies that examine the environmental controls on conjugation, transduction, and transformation.","organism":null,"data_type":"Raw sequence reads","center_name":"Rice University","submission_date":"2023/04/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN34133563","Barcoded 16S rRNA","2022-03-08","United States","Texas","Houston",29.7,-95.42,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"Wastewater Treatment Plant [ENVO:00002043]","Wastewater Treatment Plant [ENVO:00002043]","Mixed Liquor [ENVO:00002043]",null,"coordinate","US",4699066,"verified","text+coordinates",null,"USA: Houston, West University Wastewater Treatment Plant",2022],["SAMN34133564","Barcoded 16S rRNA","2022-03-08","United States","Texas","Houston",29.7,-95.42,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"Waste