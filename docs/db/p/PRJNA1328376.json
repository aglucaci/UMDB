{"v":"3.0.0","project":{"accession":"PRJNA1328376","title":"Tracking viral diversity in urban rivers: what environmental surveillance reveals about public health","description":"Environmental surveillance is the process of continuous monitoring and analysis of environmental factors that may affect human health and the ecosystem. Monitoring pathogenic microorganisms through environmental surveillance provides data indicating the circulation of diseases in near real time and serves as a complementary tool to epidemiological studies based on clinical tests. The objective of this study was to collect representative samples of the viral community from impacted urban rivers in the Sao Paulo Metropolitan Region, Brazil and use shotgun sequencing to provide a broad view of virome diversity, microbiological quality, and the spread of viral diseases in the community.","organism":null,"data_type":"Genome sequencing","center_name":"Universidade de Sao Paulo","submission_date":"2025/09/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51332181","sewage","2022-08","Brazil","São Paulo","São Paulo",-23.70298597,-46.67436572,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"sewage treatment plant1","Barueri Sewage Treatment Plant, Pomar Traio Power Plant","sewage treatment plant",null,"coordinate","BR",3448439,"verified","text+coordinates",null,"Brazil: Sao Paulo",2022],["SAMN51332182","sewage","2023-05","Brazil","São Paulo","São Paulo",-23.70298597,-46.67436572,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"sewage treatment plant2","Barueri Sewage Treatme