{"v":"3.0.0","project":{"accession":"PRJNA1222598","title":"Shotgun metagenome sequencing of human fecal","description":"This study focuses on the Shotgun metagenome sequencing of human fecal samples. The samples were collected from both Attention Deficit Hyperactivity Disorder (ADHD) patients and healthy controls. The main aim is to comprehensively analyze the microbial communities within these fecal samples.By conducting metagenome sequencing, we intend to identify characteristic bacteria at various taxonomic levels in ADHD patients. Specifically, we are particularly interested in uncovering the characteristic bacteria at the species level. Understanding the unique bacterial signatures associated with ADHD at the species level can potentially provide valuable insights into the complex relationship between the gut microbiota and ADHD. This knowledge may contribute to the development of novel diagnostic markers and therapeutic strategies for ADHD.","organism":null,"data_type":"Raw sequence reads","center_name":"Hangzhou Medical College","submission_date":"2025/02/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46785179","Healthy Control","2020","China","Zhejiang","Hangzhou",null,null,"non_environmental",null,"host-derived or clinical material","feces",null,null,null,"Homo sapiens","city","CN",1808926,"verified","text",null,"China: Hangzhou",2020],["SAMN46785180","Healthy Control","2020","China","Zhejiang","Hangzhou",null,null,"non_environmental",null,"host-derived or clinical material","feces",null,null,null,"Homo sapiens","city","CN",1808926,"verified","text",null,"China: Hangzhou",2020],["SAMN46785181","Healthy Control",