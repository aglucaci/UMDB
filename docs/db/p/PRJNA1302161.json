{"v":"3.0.0","project":{"accession":"PRJNA1302161","title":"PRJNA20250806","description":"Sludge samples were taken for Illumina sequencing at 7 and 30 d, respectively, and there was a difference in the MNZ concentrations taken for MD (0, 10, 100 mg/L) and TD (0, 50, 100 mg/L). DNA fragments of the communities were quantified using Nanodrop and then paired-end sequenced using Illumina. Primers 338F (ACTCCTACGGGAGGCAGCAG) and 806R (GGACTACHVGGGTWTCTAAT) targeting the V3-V4 regions (468 bp) of the bacterial 16S rRNA gene were used. Sequence denoising or OTU clustering was performed according to the Quantitative Insights Into Microbial Ecology 2 (QIIME2) dada2 analysis process.","organism":null,"data_type":"Raw sequence reads","center_name":"shandong university","submission_date":"2025/08/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50464232","Metagenome or environmental sample from sludge metagenome","2024-06-08","China","Shandong","Qingdao",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","anaerobic sludge",null,null,null,null,"city","CN",1797929,"verified","text",null,"China:Qingdao",2024],["SAMN50464233","Metagenome or environmental sample from sludge metagenome","2024-06-09","China","Shandong","Qingdao",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","anaerobic sludge",null,null,null,null,"city","CN",1797929,"verified","text",null,"China:Qingdao",2024],["SAMN50464234","Metagenome or environmental sample from sludge metagenome","2024-06-10","China","Shandong","Qingdao",null,null,"probable_urban","municipal_w