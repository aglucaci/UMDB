{"v":"3.0.0","project":{"accession":"PRJNA1491491","title":"Microbial community dynamics in anaerobic digesters treating food waste and sewage sludge","description":"This study investigated bacterial and archaeal community dynamics in food waste and sewage sludge anaerobic digesters operated at 35 C and 45 C. The goal was to evaluate how feedstock type, operating temperature, inoculum source, and operational transitions affected anaerobic digestion performance and microbial community development from start-up to long-term operation. Microbial communities were analyzed using Illumina MiSeq sequencing of the 16S rRNA gene V3-V4 region. The study provides insight into feedstock-dependent process stability and microbial responses associated with reactor resilience or instability.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Southampton","submission_date":"2026/07/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61462996","MIMARKS Survey related sample from anaerobic digester metagenome","2024-05-22","United Kingdom","England","Southampton",50.91,-1.4,"non_environmental",null,"laboratory or culture material",null,"anthropogenic terrestrial biome [ENVO:01000219]","anaerobic bioreactor [ENVO:00002124]","anaerobic digester sludge [ENVO:00003965]",null,"coordinate","GB",2637487,"verified","text+coordinates",null,"United Kingdom: Southampton",2024],["SAMN61462997","MIMARKS Survey related sample from anaerobic digester metagenome","2024-05-22","United Kingdom","England","Southampton",50.91,-1.4,"non_environmental",null,"laboratory or culture material",null,"anthropogenic terrestrial biome [ENVO:010002