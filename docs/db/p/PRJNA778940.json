{"v":"3.0.0","project":{"accession":"PRJNA778940","title":"Bioaugmentation denitrification","description":"The community structure of the two reactors changed after the addition of compound bacteria in SBR1 reactor. Alcaligenes, Pseudomonas and Paracoccus in SBR1 are the dominant species, with higher abundance than that in SBR2 reactor. The addition of compound bacteria changed the bacterial structure, and the aerobic denitrifying bacteria gradually increased, At the same time, combined with the changes of ammonia nitrogen concentration and COD concentration in the effluent of SBR1 reactor, it is speculated that the addition of compound denitrification bacteria is conducive to the adjustment of sludge bacteria structure and the completion of bioaugmentation denitrification.","organism":null,"data_type":"Raw sequence reads","center_name":"Shandong University","submission_date":"2021/11/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN23005649","A1","2020-11-18","China","Shandong","Qingdao",36.36,120.68,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","SBR",null,null,null,null,"coordinate","CN",1797929,"verified","text+coordinates",null,"China: Qingdao",2020],["SAMN23005650","A2","2020-11-18","China","Shandong","Qingdao",36.36,120.68,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","SBR",null,null,null,null,"coordinate","CN",1797929,"verified","text+coordinates",null,"China: Qingdao",2020],["SAMN23005651","B1","2020-11-18","China","Shandong","Qingdao",36.36,120.68,"probable_urban","municipal_wastewater","city-level location without sam