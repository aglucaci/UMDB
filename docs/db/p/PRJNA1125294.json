{"v":"3.0.0","project":{"accession":"PRJNA1125294","title":"Microbial dynamics during aerobic granulation under different phosphate concentration","description":"The structure of the microbial community was followed during the formation of aerobic granule in a sequencing batch reactor. The influence of the phosphate concentration, from high to low, on the microbial community composition and the granule shape was studied. In the first part of the experiment, high concentration of phosphate, the biomass aggregated to form round shape granules along side with the enrichment of Candidatus Accumulibacter. In the second part of the experiment, when reducing the phosphate concentration, Propionivibrio became the most abundant microorganism and the granule remained round and bigger than 1000um.","organism":null,"data_type":"Raw sequence reads","center_name":"EPFL","submission_date":"2024/06/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41886360","Granulation_day_0","2022-09-28","Switzerland","Vaud","Lausanne",46.5201,6.5705,"uncertain",null,"environmental sample; urban association not established","sequencing batch reactor",null,null,null,null,"coordinate","CH",2659994,"probable","coordinates",null,"Switzerland",2022],["SAMN41886361","Granulation_day_5","2022-10-03","Switzerland","Vaud","Lausanne",46.5201,6.5705,"uncertain",null,"environmental sample; urban association not established","sequencing batch reactor",null,null,null,null,"coordinate","CH",2659994,"probable","coordinates",null,"Switzerland",2022],["SAMN41886362","Granulation_day_8","2022-10-06","Switzerland","Vaud","Lausanne",46.5201,6.5705,"uncertain",null,"environmen