{"v":"3.0.0","project":{"accession":"PRJNA1533152","title":"EPS remodeling links carbon conversion and phosphorus mobilization during anaerobic co-fermentation of waste activated sludge and ensiled straw","description":"This project investigates the effects of co-fermentation of waste activated sludge (WAS) and ensiled straw (ES) on carboxylate production and phosphorus release during anaerobic fermentation. Metagenomic sequencing was performed to characterize microbial community composition and functional potential under different WAS-to-ES mixing ratios. The resulting datasets provide insights into microbial community dynamics and metabolic pathways associated with organic matter degradation, carboxylate production, and phosphorus transformation during anaerobic co-fermentation.","organism":null,"data_type":"Raw sequence reads","center_name":"Harbin Institute of Technology, School of Environment","submission_date":"2026/09/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN63301791","Anaerobic fermentation of waste activated sludge (C1)","2025-09-09","China","Heilongjiang","Harbin",45.743215,126.632628,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered wastewater treatment system","laboratory-scale anaerobic fermentation reactor","anaerobic fermentation slurry",null,"coordinate","CN",2037013,"verified","text+coordinates",null,"China: Harbin",2025],["SAMN63301792","Anaerobic co-fermentation of WAS and ES at a 3:1 ratio (C2)","2025-09-09","China","Heilongjiang","Harbin",45.743215,126.632628,"probable_urban","municipal_wastewater","city-level location without sample-