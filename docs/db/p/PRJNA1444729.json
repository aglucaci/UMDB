{"v":"3.0.0","project":{"accession":"PRJNA1444729","title":"Metagenomic analysis of an upflow hydrolysis-acidification reactor treating BTEX-containing cabin-washing wastewater","description":"This project provides metagenomic sequencing data from an upflow hydrolysis-acidification reactor (UHAR) treating simulated cabin-washing wastewater containing refractory benzene, toluene, ethylbenzene, and xylenes (BTEX). The study aimed to evaluate a coupling strategy integrating iron-carbon (Fe-C) composite addition with Computational Fluid Dynamics (CFD) guided flow field optimization. Genomic DNA was extracted from sludge samples across different operational stages -- including seed sludge, blank control, Fe-C addition, and Fe-C with optimized flow -- and sequenced on the Illumina NovaSeq platform (150 bp paired-end). The metagenomic data aims to reveal the underlying microbial mechanisms, focusing on how the synergistic system reshapes the metabolic network, enriches electroactive Geobacter and aromatic-degrading Acinetobacter, and stimulates Direct Interspecies Electron Transfer (DIET).","organism":null,"data_type":"Raw sequence reads","center_name":"Zhejiang University","submission_date":"2026/03/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56767034","Metagenome or environmental sample from sludge metagenome","2025-09-24T15:17:47Z","China","Zhejiang","Hangzhou",30.3061,120.0813,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge",null,null,null,null,"coordinate","CN",1808926,"verified","text+coordinates",null,"China:Hangzhou",2025],["SAMN56767035","Metagenome or environmen