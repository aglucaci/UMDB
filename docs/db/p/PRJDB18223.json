{"v":"3.0.0","project":{"accession":"PRJDB18223","title":"Green Infrastructure Enhances Microbial Communities in the Built Environment","description":"High microbial diversity offers extensive benefits to both the environment and human health, contributing to ecosystem stability, nutrient cycling, and pathogen suppression. In built environments, factors such as building design, human activity, and cleaning protocols influence microbial communities. This study investigates the impact of landscape design on microbial diversity and function within the \"Visionary Lab\" exhibition at the National Museum of Emerging Science and Innovation (Miraikan) in Tokyo, Japan, using 16s rRNA amplicon sequencing and shallow shotgun sequencing.","organism":"soil metagenome","data_type":"Metagenome","center_name":"BIOTA inc.","submission_date":"2026/06/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00790909","amplicon-1","2023-08-03","Japan","Tokyo","Tokyo",null,null,"probable_urban","built_environment","city-level location without sample-site confirmation",null,null,null,null,null,"city","JP",1850147,"probable","text","region's main city","Japan:Tokyo",2023],["SAMD00790911","shotgun-1","2023-08-03","Japan","Tokyo","Tokyo",null,null,"probable_urban","built_environment","city-level location without sample-site confirmation",null,null,null,null,null,"city","JP",1850147,"probable","text","region's main city","Japan:Tokyo",2023],["SAMD00790913","shotgun-3","2023-08-03","Japan","Tokyo","Tokyo",null,null,"probable_urban","built_environment","city-level location without sample-site confirmation",null,null,null,null,null,"city","JP",1850147,"probab