{"v":"3.0.0","project":{"accession":"PRJNA832086","title":"Mesocosm sludge bioreactors for microbial protein production from soybean processing wastewater, 16S rRNA gene amplicons Metagenome","description":"In this study, single cell protein (SCP) production from soybean processing wastewaters was evaluated, through controlled bioconversion conditions to upcycle nutrients using the microbial communities already present in these wastewaters. Six sequencing batch reactors of 4.5-L working volume were operated for 34 d, in 3 h anaerobic and 9 h aerobic phases at 30 Celsius degrees. Four reactors started without microbial inoculum, while the remaining two started with a 1.5-L inoculum from prior SCP production. Microbial characterization was done via 16S rRNA gene amplicon sequencing. Influent wastewater batches had variable chemical characteristics, but similar microbial composition. We showed that soybean wastewater can be upcycled into SCP through microbial community-based bioconversion, highlighting the effect of variable influent wastewater composition on SCP production.","organism":"bioreactor metagenome","data_type":"Metagenome","center_name":"Nanyang Technological University","submission_date":"2022/04/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN28180426","FWB1d01a","2020-01-13","Singapore",null,"Singapore",1.3451,103.6798,"non_environmental",null,"laboratory or culture material",null,"anthropogenic environmental material","activated sludge","waste material",null,"coordinate","SG",1880252,"probable","city-state",null,"Singapore",2020],["SAMN28180427","FWB1d09b","2020-01-21","Singapore",null,"Singapore",1.3451,103.6