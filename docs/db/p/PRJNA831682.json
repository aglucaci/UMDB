{"v":"3.0.0","project":{"accession":"PRJNA831682","title":"Feast famine enrichment on octanoate with activated sludge - Genome sequencing and assembly","description":"The aim of this research is to study which enrichment strategies result in a community with a high mcl-PHA storage capacity.To this end, sequencing batch reactors (SBRs) were operated with octanoate as substrate. Analysis of the PHA metabolic pathways revealed that the production of mcl-PHA requires less oxygen respiration than scl-PHA production. This resulted in the hypothesis that mcl-PHA production has a competitive advantage in an oxygen limited environment. Therefore, the dissolved oxygen concentration was varied to understand and modify the enrichment process in terms of PHA content and composition. In addition, the pH of the SBRs was varied to study the effect of the toxicity of undissociated octanoic acid. For every operational steady state, the performance of the enrichments was characterized, including the maximum PHA storage capacity by means of accumulation experiments.","organism":null,"data_type":"Raw sequence reads","center_name":"Delft University of Technology","submission_date":"2022/04/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN27760685","MIMARKS Survey related sample from wastewater metagenome","2020-09-15","The Netherlands","South Holland","Delft",51.98979617,4.37966422,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Oct.S7_Enrichment1","Oct.S7_Enrichment1","Synthetic growth medium with isobutyrate",null,"coordinate","NL",2757345,"verified","text+coordinates",null,"Netherlands: Del