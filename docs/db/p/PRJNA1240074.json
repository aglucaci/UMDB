{"v":"3.0.0","project":{"accession":"PRJNA1240074","title":"Rethinking tertiary clarifiers: untapped potential for microbial and genetic pollution control in wastewater treatment","description":"This study proposes an overlooked yet promising alternative to classical disinfection used in wastewater treatment plants (WWTPs) to control fecal bacteria and, indirectly, antibiotic resistance genes (ARGs): tertiary clarifiers. Applying 16S amplicon and shotgun sequencing to samples from three WWTPs with varying inflow characteristics, we demonstrated that tertiary clarifiers actively shape microbial communities, reducing bacterial abundance while maintaining community richness. Tertiary treatment also decreased total ARG abundance.","organism":null,"data_type":"Raw sequence reads","center_name":"CNR","submission_date":"2025/03/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47501268","Metagenome or environmental sample from metagenome","2022-02-16","Italy","Piedmont","Verbania",45.9361,8.5595,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"coordinate","IT",6457398,"verified","text+coordinates",null,"Italy: Verbania",2022],["SAMN47501269","Metagenome or environmental sample from metagenome","2022-02-16","Italy","Piedmont","Verbania",45.9361,8.5595,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"coordinate","IT",6457398,"verified","text+coordinates",null,"Italy: Verbania",2022],["SAMN47501270","Metagenome or environmental sample from metagenome","2022-02-16","Italy","Pied