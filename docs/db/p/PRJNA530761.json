{"v":"3.0.0","project":{"accession":"PRJNA530761","title":"ITS Region Indoor Samples","description":"Dampness and fungal (mold) growth in buildings is a persistent environmental health problem. This study sought to determine the extent to which fungi grown on damp materials are distributed throughout a single family home. Samples were collected from fungi growing directly on building materials in the basement of a single family house, and settled dust was collected from door frames (basement, first, and second floor, building exterior) as a proxy for indoor and outdoor air. Direct mold in the basement influenced both the fungal richness and ecology of air throughout the building. Through intense spatial characterization of the fungal community of a single house, this study illustrates that fungal growth in a single location can significantly influence the fungal communities and human fungal exposure throughout the house.","organism":null,"data_type":"Raw sequence reads","center_name":"Yale University","submission_date":"2019/04/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN11334078","Metagenome or environmental sample from indoor metagenome","2018-12","United States","Connecticut","New Haven",41.38,-72.9,"uncertain",null,"environmental sample; urban association not established","direct mold, basement",null,null,null,null,"coordinate","US",4839366,"probable","coordinates",null,"USA: Connecticut",2018],["SAMN11334079","Metagenome or environmental sample from indoor metagenome","2018-12","United States","Connecticut","New Haven",41.38,-72.9,"uncertain",null,"environmental sample; urban association not established","direct m