{"v":"3.0.0","project":{"accession":"PRJNA884487","title":"Wastewater Metagenome","description":"This research aimed to characterize the microbial community from biofouled microplastics (MPs), loaded and non-loaded with triclosan (TCS). To achieve this goal, polyethylene MPs (PE-MPs) were exposed to the influent and the effluent from a wastewater treatment plant (WWTP) close to Madrid (Spain) to promote biofouling. The biofouling time frame was four weeks. The resulting biofouled-MPs were put in contact with TCS for four h. Complementarily, samples from wastewater at the beginning and the end of the biofouling period were collected to evaluate possible differences between microbial communities attached to MPs and the free-living organisms in the surrounding media. We applied Illumina sequencing of the V3 and V4 region of the 16S rRNA gene.","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"Universidad Autonoma de Madrid","submission_date":"2022/09/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN31601656","e1-MGP8","2020-02-12","Spain","Castille-La Mancha","Guadalajara",40.621389,-3.189722,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","effluent-TCS",null,null,null,null,"coordinate","ES",3121070,"verified","text+coordinates",null,"Spain: Guadalajara)",2020],["SAMN31601657","e2-MGP8","2020-02-12","Spain","Castille-La Mancha","Guadalajara",40.621389,-3.189723,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","effluent-TCS",null,null,null,null,"coordinate","ES",3121070,"verified","text+coordinates",null,"Spain: