{"v":"3.0.0","project":{"accession":"PRJNA1331858","title":"Airborne eDNA plant and arthropod communities in west Michigan eastern hemlock forests","description":"Hemlock woolly adelgid (Adelges tsugae) is an invasive insect causing the widespread decline and death of eastern hemlock (Tsuga canadensis). We sampled airborne eDNA in 15 eastern hemlock forests in west Michigan during the summer of 2023. Sites included eastern hemlock stands that had no known infestation and varying levels of infestation. We targeted plant and arthropod communities and sequenced the ITS2 and CO1 regions to compare the taxa detected in uninfested forests with those in infested forests. The goal was to determine if we could use airborne eDNA to characterize these communities and evaluate whether hemlock woolly adelgid has impacted the communities.","organism":null,"data_type":"Raw sequence reads","center_name":"Annis Water Resources Institute","submission_date":"2025/09/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51696166","BBAP-P108","2022","United States","West Virginia","Oceana",null,null,"probable_urban","air_dust","city-level location without sample-site confirmation","air",null,null,null,null,"city","US",4817070,"probable","text","region did not contain the place","USA: Michigan, Oceana County, Benona Township",2022],["SAMN51696167","BBAP-P109","2022","United States","West Virginia","Oceana",null,null,"probable_urban","air_dust","city-level location without sample-site confirmation","air",null,null,null,null,"city","US",4817070,"probable","text","region did not contain the place","USA: Michigan, Oceana County, Benona Township",2022],["