{"v":"3.0.0","project":{"accession":"PRJNA1520008","title":"Valorization of Waste Activated Sludge from Municipal Wastewater Treatment Plants: Microbial Fuel Cell-Driven Low-Temperature Degradation and Bioelectricity Generation","description":"This project performed both 16S rRNA gene and ITS amplicon high-throughput sequencing to investigate the bacterial and fungal community structure and succession in SMFC. The reactors were fed with raw waste activated sludge (WAS) and operated under unheated low-temperature winter conditions. This study aims to reveal the key electroactive microorganisms, fungal-bacterial interactions, and microbial mechanisms related to bioelectricity generation and pollutant removal in liter-scale sediment microbial fuel cell systems.","organism":null,"data_type":"Raw sequence reads","center_name":"Taiyuan University of Technology","submission_date":"2026/08/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62754197","Metagenome or environmental sample from activated sludge metagenome","2025-12-10","China","Shanxi","Linfen",36.0885,111.513,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Biofilm on carbon felt anode of sediment microbial fuel cell fed with waste activated sludge",null,null,null,null,"coordinate","CN",1803567,"verified","text+coordinates",null,"China: Shanxi, Linfen",2025],["SAMN62754198","Metagenome or environmental sample from activated sludge metagenome","2025-12-10","China","Shanxi","Linfen",36.0885,111.5131,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anodic biofilm of sediment microb