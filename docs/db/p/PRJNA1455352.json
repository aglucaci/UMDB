{"v":"3.0.0","project":{"accession":"PRJNA1455352","title":"Ecological fate of influent-derived microorganisms in MBR systems","description":"This project aims to compare influent-derived microorganisms with activated sludge microorganisms in a low-temperature membrane bioreactor (MBR) treating municipal wastewater.Samples were collected from influent wastewater (Inf) , activated sludge (AS), and membrane biofilms (BF) under a range of operational and environmental conditions. In addition to 16S rRNA gene (DNA-based) sequencing, complementary DNA (cDNA) was synthesized and 16S rRNA (RNA-based) sequencing was performed.This dataset enables comparative analyses of microbial community structure, activity, and growth dynamics across sample types (Inf, AS , BF), operational conditions, and nucleic acid types (DNA and RNA).","organism":null,"data_type":"Raw sequence reads","center_name":"Nagaoka university of Technology","submission_date":"2026/04/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57362809","MIMS Environmental/Metagenome sample from wastewater metagenome","2023-11-03","Japan","Niigata","Nagaoka",37.48,138.85,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater","activated_sludge","sludge",null,"coordinate","JP",1856199,"verified","text+coordinates",null,"Japan:Nagaoka",2023],["SAMN57362810","MIMS Environmental/Metagenome sample from wastewater metagenome","2023-12-13","Japan","Niigata","Nagaoka",37.48,138.85,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater","activated_sludge","sludge",null,"coor