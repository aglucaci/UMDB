{"v":"3.0.0","project":{"accession":"PRJEB37686","title":"Impact of synthetic silver nanoparticles on microbial community structure and function of vertical and horizontal subsurface flow wastewater treatment system","description":"The impact of synthetic silver nanoparticles on microbial community of mesocosm scale experimental wastewater treatment system was studied using Illumina based sequencing. Wastewater (mixture of domestic, municipal and industrial) from the inlet of the activated sludge wastewater treatment plant was pumped into the six parallel hybrid filter systems each consisting of a vertical subsurface flow filter (VF) followed by a horizontal subsurface flow filter (HF). During the 35-day long experiment, AgNP and AgNO3 solutions each were dosed into two corresponding VF mesocosms influents (0.1 mg Ag/L in influent), while two parallel subsystems were used as controls. Water samples from influent and effluent of VF were collected on day 35 and filter material samples from VF and HF mesocosms were collected on day 0 and 35. Microbial community profiling was performed using shotgun metagenomics (Illumina NextSeq 500 system).","organism":null,"data_type":"Other","center_name":"UNIVERSITY OF TARTU","submission_date":"2020/05/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA6655418","day35 VF IN","2014-06-10","Estonia",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","EE",null,"unresolved",null,null,"Estonia",2014],["SAMEA6655419","day35 VF E1","2014-06-10","Estonia",null,null,null,null,"probable_urban","municipal_wastewa