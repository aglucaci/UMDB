{"v":"3.0.0","project":{"accession":"PRJNA1232257","title":"food watse","description":"In this study, a comprehensive survey of the microbial community in the food waste treatment park was carried out using high-throughput sequencing of 16S rRNA genes. A series of key microorganisms were successfully screened by analysing the microbial diversity of key facilities such as biofilter beds, deodorisation towers and anaerobic fermentation tanks. These microorganisms play an important role in the waste treatment process and are expected to provide technical support at the microbiological level for improving the quality and efficiency of the park. At present, we have accumulated 40 amplicon sequencing data from the above facilities, which lays a solid foundation for further optimising the microbial treatment process in the park.","organism":null,"data_type":"Raw sequence reads","center_name":"central south university","submission_date":"2025/03/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47223449","Metagenome or environmental sample from wastewater metagenome","2024-07-30T10:00:00Z","China","Hunan",null,28.13,112.57,"uncertain",null,"environmental sample; urban association not established","wastewater",null,null,null,"environmental","coordinate","CN",null,"unresolved",null,null,"China:Hunan",2024],["SAMN47223450","Metagenome or environmental sample from wastewater metagenome","2024-07-30T10:00:01Z","China","Hunan",null,28.13,112.57,"uncertain",null,"environmental sample; urban association not established","wastewater",null,null,null,"environmental","coordinate","CN",null,"unresolved",null,null,"China:Hunan",2024],["SAMN472234