{"v":"3.0.0","project":{"accession":"PRJNA598812","title":"Effect of salt and metal accumulation on performance of membrane distillation system and microbial community succession in membrane biofilms","description":"Membrane distillation (MD) works as a promising alternative of conventional membrane separation technologies like RO to desalinate hypersaline water owing to its high concentration brine tolerance and 100% theoretical solute rejection. However, membrane fouling is a big issue impeding its development and industrialization. The continuous accumulation of salts and metals in MD system during the treatment of hypersaline water inevitably posed an impact on the biofilm formation as well as the MD system performance. Hence, we reported the biofouling mechanism of MD system during the desalination of hypersaline water, emphasizing on the effects of salt-stress (NaCl) and metal-stress (Zn and Fe) on microbial community structure in biofilms.","organism":null,"data_type":"Raw sequence reads","center_name":"Hohai University","submission_date":"2020/01/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN13716543","surface water",null,"China","Chongqing","Nanjin",32.0,118.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge sample",null,null,null,null,"coordinate","CN",8417607,"verified","text",null,"China: Nanjin",null],["SAMN13716544","sludge","2018-07-25","China","Chongqing","Nanjin",32.0,118.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge sample",null,null,null,null,"coordinate","CN",8417607,"verified","text",null,