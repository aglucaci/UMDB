{"v":"3.0.0","project":{"accession":"PRJNA563090","title":"HUDIARA DRAIN wastewater Raw sequence reads","description":"Hudiara Drain is one of the largest storm water drains in Pakistan and has now become the second largest source of water pollution due to unmonitored disposal of toxic industrial waste, seepage of chemical fertilizers and dumping of poultry or animal waste. The aim of this study was to analyze the microbial diversity of Hudiara Drain wastewater by using culture-independent as well as culture-dependent techniques. For culture-independent analysis, metagenomic technique was utilized, based on 16S rRNA gene sequencing using Illumina®. Metagenomic sequence analysis revealed that a total of 20 different phyla were identified in this study. Sequences related to Proteobacteria, Actinobacteria, Firmicutes and Bacteriodetes were more dominant as compared to Chlorofelxi, Planctomycetes and Thaumarchaeota in all wastewater samples.","organism":"wastewater metagenome","data_type":"Raw sequence reads","center_name":"Forman Christian College, Lahore","submission_date":"2019/08/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN17316245","HD2D1","2018-09-13","Pakistan","Punjab","Lahore",31.45,74.39,"uncertain",null,"conflicting evidence: environmental and host/clinical","waste water1",null,null,null,"Not cpllected","coordinate","PK",1172451,"verified","text+coordinates",null,"Pakistan: Lahore",2018],["SAMN17316246","HD7D2","2018-09-13","Pakistan","Punjab","Lahore",31.45,74.39,"uncertain",null,"conflicting evidence: environmental and host/clinical","waste water2",null,null,null,"Not cpllected","coordinate","PK",1172451,"veri