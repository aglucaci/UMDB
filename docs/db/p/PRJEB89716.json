{"v":"3.0.0","project":{"accession":"PRJEB89716","title":"High versus low organic loading impact on gypsum converting communities grown on sewage","description":"By comparing this enrichment to sewage sludge across a gradient of organic loading, we show that microbial origin, syntrophic structure, and organic availability collectively determine methane suppression and sulfate reduction efficiency. We further examined whether the balance between methanogenesis and sulfate reduction is governed by community composition, syntrophic structure, or initial inoculum biomass selected during enrichment. These results show that enrichment history, community structure, and organic availability together determine the balance of sulfate reduction and methane production during phosphogypsum treatment.","organism":null,"data_type":"Other","center_name":"MIT","submission_date":"2025/05/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA118336856","LOW_COD_PLUM_1D17","2024-09-23","United States",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","US",null,"unresolved",null,null,"USA",2024],["SAMEA118336857","LOW_COD_PLUM_2D17","2024-09-23","United States",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","US",null,"unresolved",null,null,"USA",2024],["SAMEA118336858","LOW_COD_PLUM_3D17","2024-09-23","United States",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","US",null,"unresolved",null,null,"USA",2024]