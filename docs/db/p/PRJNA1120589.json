{"v":"3.0.0","project":{"accession":"PRJNA1120589","title":"Microbial community of dyeing wastewater treatment process","description":"The study investigated the microbial community in an Upflow Anaerobic Sludge Blanket (UASB) system coupled with a biocarrier named PVA/Fe/Starch gel bead treating azo dye Reactive Black 5. The PVA/Fe/Starch gel bead is a spherical mixed gel bead created by combining polyvinyl alcohol (PVA) gel with magnetite and starch. The microbial community groups were measured according to the height of the UASB system and in the forms of gel bead-attached and suspended sludge.","organism":null,"data_type":"Raw sequence reads","center_name":"Nagaoka University of Technology","submission_date":"2024/06/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41704378","Metagenome or environmental sample from sludge metagenome","2022-08-22","Japan","Niigata","Nagaoka",37.4453,138.8575,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge",null,null,null,null,"coordinate","JP",1856199,"verified","text+coordinates",null,"Japan: Nagaoka, Niigata",2022],["SAMN41704379","Metagenome or environmental sample from sludge metagenome","2022-08-22","Japan","Niigata","Nagaoka",37.4453,138.8575,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge",null,null,null,null,"coordinate","JP",1856199,"verified","text+coordinates",null,"Japan: Nagaoka, Niigata",2022],["SAMN41704380","Metagenome or environmental sample from sludge metagenome","2022-08-22","Japan","Niigata","Nagaoka",37.4453,138.8575,"uncertain",null,"environmental sample; urban association not