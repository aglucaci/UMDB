{"v":"3.0.0","project":{"accession":"PRJNA1513043","title":"Bottlenose dolphins (Tursiops truncatus) blow microbiome profiling","description":"This study aimed to characterize the blow-associated microbiome of free-ranging bottlenose dolphins (Tursiops truncatus) inhabiting the Gulf of Ambracia, Greece, using non-invasive unmanned aerial vehicle (UAV)-based sampling. Exhaled breath condensate was collected from wild dolphin groups using different sampling and preservation matrices, together with seawater and air controls, to evaluate methodological reliability and reduce environmental microbial signatures. The study compared the performance of DNA/RNA Shield, QIAcard FTA cards and dry sponge matrices, and then focused on the most reliable approaches to describe the total and core blow microbiomes of this resident dolphin population.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Padova","submission_date":"2026/08/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62403343","Metagenome or environmental sample from air metagenome","2024-06-11","Greece",null,null,null,null,"probable_urban","air_dust","city-level location without sample-site confirmation",null,null,null,null,null,"city","GR",null,"unresolved",null,null,"Greece: Ambracian Gulf",2024],["SAMN62403344","Metagenome or environmental sample from air metagenome","2024-06-11","Greece",null,null,null,null,"probable_urban","air_dust","city-level location without sample-site confirmation",null,null,null,null,null,"city","GR",null,"unresolved",null,null,"Greece: Ambracian Gulf",2024],["SAMN62403345","Metagenome or environmental sample from air 