{"v":"3.0.0","project":{"accession":"PRJNA1404909","title":"Metagenomic insights into mechanisms of nitrogen removal by heterotrophic nitrification-aerobic denitrification process under high ammonia stress Raw sequence reads","description":"Heterotrophic nitrification-aerobic denitrification (HN-AD) process demonstrates strong potential for treating ammonia nitrogen (NH4+-N) wastewater. Nonetheless, the effect of high ammonia stress on the HN-AD process remains unclear, which restricts its engineering application. Herein, the HN-AD process was operated at different influent NH4+-N concentrations. HN-AD bacteria may enhance the removal of NH4+-N, total nitrogen, and chemical oxygen demand in the reactor by efficiently utilizing organic carbon sources for ammonia assimilation. Metagenomic analysis revealed that abundant taxa such as Pseudomonas and Halopseudomonas were highly tolerant to the high NH4+-N environment and formed a dense collaborative-competitive network within the reactor, which enhanced and maintained efficient NH4+-N removal.","organism":"bioreactor metagenome","data_type":"Raw sequence reads","center_name":"Wuhan Institute of Technology","submission_date":"2026/01/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54727797","L","2024-11-15","China","Hubei","Wuhan",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"city","CN",1791247,"verified","text",null,"China: Wuhan",2024],["SAMN54727798","L","2024-11-15","China","Hubei","Wuhan",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmatio