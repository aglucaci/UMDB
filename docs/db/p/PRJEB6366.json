{"v":"3.0.0","project":{"accession":"PRJEB6366","title":"Age-related microRNAs profiling in rat brains using deep sequencing","description":"This study has identified 171 novel miRNA candidates in rat brains, making evaluation of the full regulating mechanism for age-related genes or pathways feasible. This study has also revealed that age is a critical regulator for miRNA expression, and the age-related decline of miRNA expression is not a progressive process, but rather a biphasic one. Age-regulated miRNAs are predicted to target genes involving in nodes of signalling pathways relevant to brain aging and neurodegenerative diseases.","organism":"Rattus norvegicus","data_type":"Other","center_name":"HUNAN NORMAL UNIVERSITY","submission_date":"2014/07/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA2547925","DNA sample from Saliva of a human male participant in the dbGaP study \"Resource for Genetic Epidemiology Research on Aging (GERA)\"",null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA2547926","DNA sample from Saliva of a human male participant in the dbGaP study \"Resource for Genetic Epidemiology Research on Aging (GERA)\"",null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA2547927","DNA sample from Saliva of a human female participant in the dbGaP study \"Resource for Genetic Epidemiology Research on Aging (GERA)\"",null,null,null,null,null,null,"non_environmental",nu