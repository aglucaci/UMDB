{"v":"3.0.0","project":{"accession":"PRJNA1338611","title":"Nature based solution for secondary wastewater treatment","description":"The goal of this project is to asses if a nature-based solution called Daphnia filter is able to produce reclaimed water before discharged into the river and for agricultural irrigation. We tested two different hydraulic retention times (1.5 and 2 days) in different seasons. We analysed the microbiome of the inlet (secondary wastwater) and outlet water from the demonstration plant. We also analysed the microbial community of the biofilm attached to the walls of the demonstration plant","organism":null,"data_type":"Raw sequence reads","center_name":"IDAEA-CSIC","submission_date":"2025/10/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN52482165","Metagenome or environmental sample from wastewater metagenome","2024-05-21","Spain","Catalonia","Girona",41.96,2.84,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reclaimed wastewater",null,null,null,null,"coordinate","ES",3121456,"verified","text+coordinates",null,"Spain: Girona",2024],["SAMN52482166","Metagenome or environmental sample from wastewater metagenome","2024-05-21","Spain","Catalonia","Girona",41.96,2.84,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reclaimed wastewater",null,null,null,null,"coordinate","ES",3121456,"verified","text+coordinates",null,"Spain: Girona",2024],["SAMN52482167","Metagenome or environmental sample from wastewater metagenome","2024-05-21","Spain","Catalonia","Girona",41.96,2.84,"probable_urban","municipal_wastewater",