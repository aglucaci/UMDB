{"v":"3.0.0","project":{"accession":"PRJNA261489","title":"Municipal wastewater treatment plants Targeted Locus (Loci)","description":"Three undefined mixed cultures (activated sludge) from different municipal wastewater treatment plants were used as seed cultures in a novel lactic acid fermentation process fed with potato peel waste (PPW). Anaerobic sequencing batch fermenters were run under near identical conditions to produce predominantly lactic acid. Illumina sequencing was used to examine the 16S rRNA genes of bacteria in the three seed cultures and fermenters. Results showed that the structure of microbial communities of three seed cultures were different. All three fermentation products had unique community structures that were dominated (96%) by species of the genus Lactobacillus, while members of this genus constituted <0.1% in seed cultures. The species of Lactobacillus sp. differed between the three fermentations. Results of this study suggest the structure of microbial communities in lactic acid fermentation of PPW with undefined mixed cultures were robust and resilient, which opens the door to engineering processes for the microbial utilization of carbohydrate waste streams to produce lactic acid.","organism":"activated sludge metagenome","data_type":"Targeted Locus (Loci)","center_name":"University of Idaho","submission_date":"2014/09/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN03074541","M0","2014-01-01","United States","Idaho","Moscow",46.73,-117.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Sludge","aeration tank","Activated sludge",null,"coordi