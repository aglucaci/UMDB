{"v":"3.0.0","project":{"accession":"PRJNA1037120","title":"Archaeological Dental Calculus Shotgun Data from 18th Century African Descended Individuals in South Carolina","description":"As part of the Anson Street African Burial Ground Project, we characterized the oral microbiomes of twelve 18th century African descended individuals from Charleston, South Carolina, USA. Dental Calculus was removed from the individuals and extracted at the Laboratories of Molecular Anthropology and Microbiome Research at the University of Oklahoma. Double stranded libraries were UDG treated, and shotgun sequenced on on land of a Illumina HiSeq X (2x150bp). All human genomic DNA has been filtered from this dataset. The goals of this project were to understand oral microbiome diversity and health of the Anson Street Ancestors.","organism":null,"data_type":"Raw sequence reads","center_name":"Dartmouth College","submission_date":"2023/11/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38163707","Metagenome or environmental sample from human oral metagenome","2019","United States","South Carolina","Charleston",32.78,-79.93,"non_environmental",null,"host-derived or clinical material","Dental Calculus",null,null,null,null,"coordinate","US",4574324,"probable","coordinates",null,"USA: South Carolina",2019],["SAMN38163708","Metagenome or environmental sample from human oral metagenome","2019","United States","South Carolina","Charleston",32.78,-79.93,"non_environmental",null,"host-derived or clinical material","Dental Calculus",null,null,null,null,"coordinate","US",4574324,"probable","coordinates",null,"USA: South Carolina",2019],["SAMN38163709","Me