{"v":"3.0.0","project":{"accession":"PRJNA1026824","title":"Intracellular and Extracellular Sequenced DNA from Urban Stormwater","description":"Stormwater grab samples were collected at four locations: a stormwater inlet, stormwater outfall, a river, and lake. Each site was sampled on three instances, corresponding to the fall, winter, and spring seasons. In addition, triplicate baseline grab samples were collected at the outfall, river, and lake prior to each storm event. iDNA was extracted via MP Biomedicals FastDNA Spin Kit and eDNA was extracted by a previously published protocol (DOI: https://doi.org/10.1061/(ASCE)EE.1943-7870.0001993). A composite sample of the extracts was prepared for each site and sampling event by combining the triplicate samples by an equal DNA mass. Metagenomic sequencing completed on Illumina NextSeq 2000 platform (151 bp paired end) at a sequencing depth of 650 Mbp. Deposited sequences are full-length, untrimmed reads.","organism":null,"data_type":"Raw sequence reads","center_name":"Marquette University","submission_date":"2023/10/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37764633","FBOI","2020-11-05","United States","Wisconsin","Milwaukee",43.04355,-87.98876,"probable_urban","water_drainage","urban context stated at BioProject level only","stormwater outfall",null,null,null,null,"coordinate","US",5263045,"probable","coordinates",null,"USA:Wisconsin",2020],["SAMN37764634","FBRI","2020-11-05","United States","Wisconsin","Milwaukee",43.042248,-87.987843,"probable_urban","water_drainage","urban context stated at BioProject level only","river",null,null,null,null,"coordinate","US",5263045,"