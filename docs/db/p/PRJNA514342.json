{"v":"3.0.0","project":{"accession":"PRJNA514342","title":"Characteristics of sulfur-based aautotrophic denitrification and denitrifiers for waste water treatment under acidic conditions","description":"The objectives of this study were to investigate the performances of autotrophic denitrification with different sulfur species (S0, S2O32-, and S2-) as electron donors, and with NO3- or NO2- as electron acceptors. We also analyzed and compared the changes of the microbial community and various denitrifying genes under different conditions through 16S metagenomics sequencing. Base on the results, discussion on how to optimize the autotrophic denitrification under acidic condition are presented.","organism":null,"data_type":"Raw sequence reads","center_name":"PRINCETON UNIVERSITY","submission_date":"2019/01/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN10723522","16s RNA gene of bacteria:sludge","2018-10-20","United States","New Jersey","Princeton",40.35,-74.6512,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","batch cluture (S1a_4) with S0 and Nitrate at pH4",null,null,null,null,"coordinate","US",5102922,"probable","coordinates",null,"USA:Princeton University",2018],["SAMN10723523","16s RNA gene of bacteria:sludge","2018-10-20","United States","New Jersey","Princeton",40.35,-74.6512,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","batch cluture (S1a_5) with S0 and Nitrate at pH5",null,null,null,null,"coordinate","US",5102922,"probable","coordinates",null,"USA:Princeton University",2018],["SAMN10723524","16s RNA gene of bacteria:sl