{"v":"3.0.0","project":{"accession":"PRJDB15143","title":"Use of microbial fuel cells for the treatment of residue effluents discharged from an anaerobic digester treating food wastes","description":"One of practical challenges in the anaerobic-digestion (AD) technology would be cost-effective treatment of residue effluents containing high concentrations of organics, nitrogen and phosphorus (CNP). In order to evaluate the utility of microbial fuel cells (MFCs) for treating anaerobic-digester effluents (ADEs) and generating power from them, laboratory-scale single-chamber MFCs were filled with ADE obtained from a commercial AD plant treating food wastes and thereafter operated by routinely supplying ADE at different hydraulic residence times (HRTs, 5 to 20 days).","organism":"microbial fuel cell metagenome","data_type":"Targeted Locus (Loci)","center_name":"Tokyo University of Pharmacy and Life Sciences","submission_date":"2023/01/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00574215","ADE","2022","Japan","Tokyo","Hachiōji",35.6693,139.4257,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"biome","wastewater treatment plant","industrial wastewater",null,"coordinate","JP",1863440,"verified","text+coordinates",null,"Japan:Tokyo, Hachioji",2022],["SAMD00574216","AB5","2022","Japan","Tokyo","Hachiōji",35.6693,139.4257,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"biome","wastewater treatment plant","industrial wastewater",null,"coordinate","JP",1863440,"verified","text+coordinates",null,"Japan:Tokyo, Hachioji",2022],["SAMD00574217","AB10"