{"v":"3.0.0","project":{"accession":"PRJNA1549350","title":"Assessment of Antibiotic Resistant Bacterial Isolates in Wastewater from Informal Settlements at Ilala District, Dar Es Salaam, Tanzania.","description":"Antimicrobial resistance (AMR) has emerged as a major global public health threat, with wastewater increasingly recognized as an important environmental reservoir for antibiotic-resistant bacteria and antimicrobial resistance genes. Informal settlements in developing countries are particularly vulnerable due to inadequate sanitation, poor wastewater management, and uncontrolled discharge of domestic waste, which facilitate the persistence and dissemination of resistant microorganisms. This study assessed antibiotic-resistant bacteria isolated from wastewater in informal settlements at Ilala District, Dar es Salaam, Tanzania.","organism":null,"data_type":"Raw sequence reads","center_name":"Nationla public Health Laboratory","submission_date":"2026/10/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64388431","Proteus mirabilis 1-MCA-A3 from wastewater, Dar es Salaam, Tanzania","2026-01-23","Tanzania","Dar es Salaam Region","Dar es Salaam",-6.8842,39.1567,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"urban biome [ENVO:01000249]","open drainage channel","wastewater [ENVO:00002001]",null,"coordinate","TZ",160263,"verified","text+coordinates",null,"Tanzania: Dar es Salaam, Ilala, Gongo la Mboto",2026],["SAMN64388432","Proteus mirabilis 5-BA-A from wastewater, Dar es Salaam, Tanzania","2026-01-26","Tanzania","Dar es Salaam Region","Dar es Salaam",-6.82,39.27,"uncertain",null,"conflicting