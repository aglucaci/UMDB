{"v":"3.0.0","project":{"accession":"PRJNA1298225","title":"Activated sludge sequencing data related to different virus extraction methods","description":"This study investigates the efficiency of different phage recovery methods from activated sludge collected at the end of the aerobic stage in a wastewater treatment plant in Beijing, China. Two experimental groups were designed: a Basic Group and an Enhanced Group. The Basic Group evaluated three phage extraction methods - Direct Extraction (DE), Concentration-Based (CB), and Surfactant-Assisted Extraction (SF). The Enhanced Group focused on the effect of DNase treatment on surfactant-based extraction, comparing Surfactant Treatment without DNase (SF-Non) and with DNase (SF-DNase). All methods were performed in triplicate. An internal T7 phage standard was spiked into each sample to allow for recovery assessment. DNA extraction was performed using either the FastDNA SPIN Kit for Soil or the Maxwell RSC PureFood GMO and Authentication Kit, depending on the method. DNase treatment was applied to selected groups to remove free DNA prior to viral nucleic acid extraction. This dataset provides metagenomic insights into phage recovery efficiency and the impact of physical and chemical treatments on viral enrichment from complex environmental matrices.","organism":null,"data_type":"Raw sequence reads","center_name":"Delft University of Technology","submission_date":"2025/07/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50261026","CB1","2024-08-20","China","Beijing","Beijing",39.8797,116.75192,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",nu