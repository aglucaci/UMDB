{"v":"3.0.0","project":{"accession":"PRJNA1186561","title":"Airborne Microbial Diversity and Distribution at Different Altitudes of Lotus Tower Colombo, Sri Lanka: A Metagenomic Study","description":"The current research on the diversity and distribution of airborne microorganisms in the vicinity of the Lotus Tower Colombo, Sri Lanka, focuses on expanding knowledge of microbial communities (Bacteria) at various altitudes. Air samples were collected from three distinct heights: the ground level (1 meter), the mid-level (257.2 meters), and the highest point of the tower (264.6 meters). This study aims to assess the variations in microbial diversity and community composition across these different heights using culture-independent metagenomic techniques.","organism":"air metagenome","data_type":"Metagenome","center_name":"National Institute of Fundamental Studies","submission_date":"2024/11/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44769434","Air Sample from  Ground level of Lotus Tower (CLB1)","2024-03-29T09:00:00Z","Sri Lanka","Western Province","Colombo",6.92,79.85,"probable_urban","air_dust","city-level location without sample-site confirmation","air","ENVO:00000428","[ENVO:00000428]|Troposphere[ENVO:00000429]","[ENVO:00000050]",null,"coordinate","LK",1248991,"verified","text+coordinates",null,"Sri Lanka: Colombo",2024],["SAMN44769435","Air Sample from  Ground level  of Lotus Tower (CLB2)","2024-03-29T13:30:00Z","Sri Lanka","Western Province","Colombo",6.92,79.85,"probable_urban","air_dust","city-level location without sample-site confirmation","air","ENVO:00000428","[ENVO:00000428]|Troposphere[ENVO:00000429]","[ENV