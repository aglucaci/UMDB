{"v":"2.0.0","project":{"accession":"PRJNA264547","title":"Laundry Machine Microbiome Targeted Locus (Loci)","description":"Household washing machines launder soiled clothes and textiles, but do not sterilize them. We investigated the microbial exchange streams occurring in five different household washing machines. Samples from a new cotton T-shirt were laundered together with a normal laundry load. Analysis was performed on the influent water and the ingoing cotton samples, as well as the greywater and the washed cotton samples.","organism":"indoor metagenome","data_type":"Targeted Locus (Loci)","center_name":"Helmholtz Zentrum Muenchen","submission_date":"2014/10/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution"],"samples":[["SAMN03135295","M2M7","2012-09-27","Belgium",null,"Gent",null,null,"probable_urban","built_environment","city-level location without sample-site confirmation","Washing machine grey water","Laundry machine biome","Household","Greywater",null,"city"],["SAMN03135296","M3M5","2012-09-27","Belgium",null,"Westrozebeke",null,null,"probable_urban","built_environment","city-level location without sample-site confirmation","Washing machine grey water","Laundry machine biome","Household","Greywater",null,"city"],["SAMN03135297","M3M18","2012-09-27","Belgium",null,"Sijsele",null,null,"probable_urban","built_environment","city-level location without sample-site confirmation","Washing machine grey water","Laundry machine biome","Household","Greywater",null,"city"],["SAMN03135298","M2M6","2012-09-27","Belgium",null,"Gent",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Influent water","Laundry machine biome","Household","Water",null,"city"],["SAMN03135299","M3M2","2012-09-27","Belgium