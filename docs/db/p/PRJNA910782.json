{"v":"3.0.0","project":{"accession":"PRJNA910782","title":"Micorbial composition and activity in oil reservoirs during air drive","description":"Oilfields contain diverse microorganisms with unique functions. Some specific functions such as oil degradation, gas production and surfactant production have the potential to enhance oil recovery. Gas injection is a common reservoir development method, which inevitably disturbed the microbial biotope of oil reservoirs. In this study, the effect of air injection on the microbial composition and transcriptional activity is investigated through 16S rRNA gene amplicon sequencing, metagenomic and meta-transcriptomic analysis.","organism":null,"data_type":"Raw sequence reads","center_name":"East China University of Science and Technology","submission_date":"2022/12/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN32144735","MIMS Environmental/Metagenome sample from oil production facility metagenome","2020-07-22","China","Heilongjiang","Daqing",46.36,125.01,"uncertain",null,"no environmental-sample evidence",null,"oil reservoir biome","production well","production water",null,"coordinate","CN",2037860,"verified","text+coordinates",null,"China:Daqing",2020],["SAMN32144736","MIMS Environmental/Metagenome sample from oil production facility metagenome","2020-12-25","China","Heilongjiang","Daqing",46.36,125.01,"uncertain",null,"no environmental-sample evidence",null,"oil reservoir biome","injection well","production water",null,"coordinate","CN",2037860,"verified","text+coordinates",null,"China:Daqing",2020],["SAMN32144737","MIMS Environmental/Metagenome sample from oil production facility 