{"v":"3.0.0","project":{"accession":"PRJNA1309581","title":"Mixotrophic Nitrogen Removal in Low C/N Wastewater Using TBER","description":"This study aims to develop and evaluate a novel multiple Ti-basalt fiber (Ti-BF) bioelectrode reactor (TBER) for efficient mixotrophic nitrogen removal from mainstream municipal wastewater under low C/N conditions. Traditional biological nitrogen removal processes often struggle with limited carbon sources in such settings, leading to incomplete denitrification and nitrate accumulation. By integrating conductive titanium mesh and high-surface-area basalt fiber into a multi-site electrode architecture, this reactor enables spatially resolved microbial colonization and enhanced extracellular electron transfer (EET). Through integrated electrochemical, proteomic, and EPS composition analyses, the study reveals how electrical stimulation and material properties synergistically shape microbial redox activity, driving simultaneous heterotrophic denitrification, autotrophic anammox, and partial nitrification. The findings provide a mechanistic basis for advancing low-carbon wastewater treatment technologies, contributing to the development of sustainable and energy-efficient nitrogen removal strategies.","organism":null,"data_type":"Raw sequence reads","center_name":"Donghua University","submission_date":"2025/08/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50746594","sequences of bacteria","2024-07-01","China","Shanghai","Shanghai",31.06,121.21,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anode titanium mesh layer (Sample 1-1)",null,null,nu