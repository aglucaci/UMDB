{"v":"3.0.0","project":{"accession":"PRJNA635011","title":"An electrochemical membrane biofilm reactor for removing sulfonamides from wastewater","description":"Sulfonamides, such as sulfadiazine (SDZ), are frequently detected in water and wastewater, and their toxicity and persistence nature arouses much concern. In this study, a novel electrochemical membrane biofilm reactor (EMBfR) was developed for removing SDZ and suppressing the production of antibiotic resistance genes (ARGs). The presence of electric field significantly affected the microbial community, leading to the enrichment of potential aromatic-degrading microorganism (e.g., Rhodococcus accounting for 51.0% in EMBfR compared 10.0% in MBfR).","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2020/05/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN15015156","Metagenome or environmental sample from activated sludge metagenome","2019-10-06","China","Shanghai","Shanghai",31.28,121.5,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","pilot-scale membrane bio-reactor",null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2019],["SAMN15015157","Metagenome or environmental sample from activated sludge metagenome","2019-10-06","China","Shanghai","Shanghai",31.28,121.5,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","pilot-scale membrane bio-reactor",null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2019],["SAMN15015158","Metagenome or 