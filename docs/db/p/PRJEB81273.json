{"v":"3.0.0","project":{"accession":"PRJEB81273","title":"Sea bream samples for microbiome and resistome studies from the CIRCLES project","description":"The data in this project is part of CIRCLES: Controlling mIcRobiomes CircuLations for bEtter food Systems. CIRCLES is a European Union Horizon 2020 research and innovation programme-funded project. It aims to unlock the potential of natural microbiomes for the sustainable production of high-quality food, with the ultimate objective of delivering new and healthier food applications.  The data in this project was collected from sea bream, both farmed and wild, across different tissues and developmental stages. The microbiomes and resistomes from the samples have been used as a reference for interpreting microbiome data from farmed specimens, as well as for developing microbiome-tailored “circular” actions.  CIRCLES has modeled the link between fish production in open-sea cages and marine environmental quality, with a focus on the marine microbiome and resistome.","organism":null,"data_type":"Other","center_name":"Centre for Genomic Epidemiology, National Food Institute, Technical University of Denmark (DTU), Denmark","submission_date":"2024/11/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA116283710","CIRCLES-SEQ-16S-C0-5S-GR01-WasteWater-01-20191129-DTU-22-21_S21","2019-11-29","Greece",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","GR",null,"unresolved",null,null,"Greece",2019],["SAMEA116283711","CIRCLES-SEQ-16S-C0-5S-GR01-WasteWater-01-20191203-DTU-22-27_S27","2019-12-03","Greece",null,n