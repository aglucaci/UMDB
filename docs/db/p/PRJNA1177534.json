{"v":"3.0.0","project":{"accession":"PRJNA1177534","title":"Efficient implementation of anammox in an ultra-short hydraulic retention time anaerobic/oxic process for nutrient removal and resource recovery from sewage","description":"Autotrophic nitrogen removal from municipal wastewater by anaerobic ammonium oxidation (anammox) has great potential for application in sustainable pollution control and resource recovery. This study presents an innovative anammox-based hybrid biofilm continuous flow process with an ultra-short hydraulic retention time (HRT) of 3 h for the highly efficient nitrogen and phosphorus removal from municipal wastewater. Under the anaerobic/oxic operation, the system influent and effluent total inorganic nitrogen (TIN) were 79.3 mg/L and 6.7 mg/L, respectively (i.e., 72.6 mg/L TIN was removed at an HRT of 3 h).","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2024/10/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44443200","Metagenome or environmental sample from sludge metagenome","2023-11-04",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN44443201","Metagenome or environmental sample from sludge metagenome","2023-12-09",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN44443202","Metagenome or environmental sample from sludge met