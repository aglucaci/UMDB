{"v":"3.0.0","project":{"accession":"PRJNA1079228","title":"Characterisation of bioaerosols in transportation microenvironments","description":"Currently, there is limited information on commuter exposure to the microbial fraction of airborne particles (i.e. bioaerosols) in different types of transport. To address this, a comparative investigation was conducted in two different types of micro-environments (i.e. train and private vehicle), covering similar commuter transport routes. This study provides important insights into the aerosol microbiome in transportation environments, which is crucial for the evaluation of commuter exposure to potential health risks.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Essex","submission_date":"2024/02/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40033887","MIMARKS Survey related sample from aerosol metagenome","2017-02-11","United Kingdom","England","Bexley",51.42,0.3045,"probable_urban","air_dust","city-level location without sample-site confirmation",null,"air [ENVO:00002005]|aerosol [ENVO:00010505]","vehicle [ENVO:01000604]|usage of an environment for transportation [ENVO:01001444]","particulate matter [ENVO:01000060]",null,"coordinate","GB",2655775,"probable","coordinates",null,"United Kingdom: Essex",2017],["SAMN40033888","MIMARKS Survey related sample from aerosol metagenome","2017-02-19","United Kingdom","England","Bexley",51.42,0.3045,"probable_urban","air_dust","city-level location without sample-site confirmation",null,"air [ENVO:00002005]|aerosol [ENVO:00010505]","vehicle [ENVO:01000604]|usage of an environment for transportation [ENVO:01