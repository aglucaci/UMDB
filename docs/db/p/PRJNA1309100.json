{"v":"3.0.0","project":{"accession":"PRJNA1309100","title":"Temporal variations of resistomes in wastewater and river water","description":"Antimicrobial resistance (AMR) poses an urgent global challenge, with wastewater treatment plants (WWTPs) acting as key hotspots where antimicrobial resistance genes (ARGs) accumulate, persist, and spread into the environment. While long-term ARG trends in WWTPs are increasingly documented, the role of short-term fluctuations, such as daily (diurnal) cycles linked to human activity, remains underexplored.To address this gap, we performed high-resolution temporal monitoring of microbial communities, ARGs, and mobile genetic elements (MGEs) across a WWTP-river system in South Africa. Samples were collected every 6 hours over 7 days and analysed using shotgun metagenomic sequencing and 16S rRNA gene profiling. These datasets provide a resource for studying the temporal dynamics of microbial communities and resistomes in wastewater environments, with implications for public health and water quality management.","organism":null,"data_type":"Raw sequence reads","center_name":"Stellenbosch University","submission_date":"2025/08/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50733880","MIMS Environmental/Metagenome sample from wastewater metagenome","2023-05-22","South Africa","Gauteng","Pretoria",-25.73340199,28.17867726,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater biome","river downstream","river water",null,"coordinate","ZA",964137,"verified","text+coordinates",null,"South Africa: Tshwane",2023],["SAMN50733881","MIMS Enviro