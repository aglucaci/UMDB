{"v":"3.0.0","project":{"accession":"PRJEB20771","title":"Ultrasonic treatment was used treat the CEPT sludge. Metatranscriptomic analysis was used to characterize the microbial community of anaerobic digestion of Ultrasonic-treated CEPT sludge","description":"Hong Kong has the world's largest scale application of Chemical Enhanced Primary Treatment process. The CEPT sludge was collected from local treatment facility. Ultrasonic treatment was applied to enhance the hydrolysis of the CEPT sludge before anaerobic digestion. In order to investigate the effect of ultrasonic treatment on the digestibility of CEPT sludge and corresponding microbial community, anaerobic digestion of ultrasound-treated CEPT sludge was carried out in lab-scale sequential batch reactors. Metatranscriptomes and metagenomes were constructed for the community in the batch reactor at three independent cycles.","organism":null,"data_type":"Other","center_name":"shuixia100","submission_date":"2018/07/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA104055885","metatranscriptome of CEPT sludge digestion","2014-03-01","Hong Kong",null,"Hong Kong",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"country","HK",1819729,"probable","city-state",null,"Hong Kong",2014],["SAMEA104055886","metatranscriptome of CEPT sludge digestion","2014-03-01","Hong Kong",null,"Hong Kong",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"country","HK",1819729,"probable","city-state",null,"Hong Kong",2014],["SAMEA104055887","metatranscriptome of CEPT sludge digesti