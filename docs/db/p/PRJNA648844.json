{"v":"3.0.0","project":{"accession":"PRJNA648844","title":"Whole microbial community viability is not quantitatively reflected by propidium monoazide sequencing approach","description":"Propidium monoazide (PMA) treatment coupled with downstream molecular profiling (e.g. qPCR or DNA sequencing) is an approach to quantify the viable components of microbial communities. Here, we present our work on rigorously benchmarking PMA-seq (PMA treatment followed by 16S rRNA gene amplicon sequencing) as a screen and a quantitative approach for microbial viability in both synthetic and realistic microbial communities.","organism":null,"data_type":"Raw sequence reads","center_name":"Harvard University","submission_date":"2020/07/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN15649690","Metagenome or environmental sample from metagenome","2019-08-19","United States","Massachusetts","Boston",42.34,-71.1,"probable_urban",null,"city-level location without sample-site confirmation","MBTA touchscreen",null,null,null,null,"coordinate","US",4930956,"verified","text+coordinates",null,"USA:Boston",2019],["SAMN15649691","Metagenome or environmental sample from metagenome","2019-08-19","United States","Massachusetts","Boston",42.34,-71.1,"probable_urban",null,"city-level location without sample-site confirmation","MBTA touchscreen",null,null,null,null,"coordinate","US",4930956,"verified","text+coordinates",null,"USA:Boston",2019],["SAMN15649692","Metagenome or environmental sample from metagenome","2019-08-19","United States","Massachusetts","Boston",42.34,-71.1,"probable_urban",null,"city-level location without sample-site confirmation","MBTA tou