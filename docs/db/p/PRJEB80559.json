{"v":"3.0.0","project":{"accession":"PRJEB80559","title":"Shotgun metagenomes of dried animal feces.","description":"Within the HUNT one health project over 3000 dried fecal samples were sequenced from canine, sheep, equine, bovine, and pig. These samples were collected by the human participants from their own animals as part of their participation in the HUNT 4 project (https://www.ntnu.edu/hunt) . Here we analyzed 5 randomly selected samples from the five animal species with the addition of 5 blank samples and 5 mock community samples. The samples were sequenced on an Illumina Novaseq to a depth of 20 million paired-end reads. The goal of this analysis was to determine the limits of the sequencing depth of these datasets that is needed for different metagenomic analysis, e.g. Taxonomic and Functional classification. The data uploaded here are the cleaned fastq  files, after they have been processed by the BGI sequencing centre in-house pipeline.    You can contact the HUNT One health project if you would like to analyze any of the 3000 metagenomic datasets. See: https://www.nmbu.no/en/research/projects/hunt-one-health","organism":null,"data_type":"Other","center_name":"NORWEGIAN VETERINARY INSTITUTE","submission_date":"2024/10/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA116144783",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA116144784",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",