{"v":"3.0.0","project":{"accession":"PRJNA1292405","title":"Metagenomic profiling of raw wastewater: tool box for microbial evolution","description":"Over a period of one year, from November 2022 to October 2023, wastewater samples were collected in the district of Giessen (Germany, Biebertal Wastewater Treatment Plant). Sampling was done once a week, and a composite sample was taken every Monday over a period of 24 hours. A total of 52 samples were collected, four of which were combined from one month. This resulted in 12 samples that underwent metagenomic analysis. Authors: Silke Zechel-Gran, Benedikt Luecker, Jane Falgenhauer, Eugen Domann","organism":null,"data_type":"Raw sequence reads","center_name":"Justus Liebig University Giessen","submission_date":"2025/07/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49999798","wastewater_01","2022-11","Germany",null,null,50.38,8.35,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Wastewater treatment plant",null,null,null,null,"coordinate","DE",null,"unresolved",null,null,"Germany: Biebertal",2022],["SAMN49999799","wastewater_02","2022-12","Germany",null,null,50.38,8.35,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Wastewater treatment plant",null,null,null,null,"coordinate","DE",null,"unresolved",null,null,"Germany: Biebertal",2022],["SAMN49999800","wastewater_03","2023-01","Germany",null,null,50.38,8.35,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Wastewater treatment plant",null,null,null,null,"coordinate","DE",null,"unresolved",null,null,"Germany: Biebe