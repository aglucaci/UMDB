{"v":"3.0.0","project":{"accession":"PRJNA1044270","title":"Effect of different operating stages of dry continuous anaerobic digestion on microbial community mechanisms","description":"In this study, the vertical continuous push-flow dry anaerobic digestion reactor was developed independently. Typical agricultural organic waste straw and cow dung were used as raw materials in this paper to carry out long-term continuous mixed dry anaerobic digestion experiments on a controlled laboratory scale. The system performance at this stage was in the best condition in the whole set of experiments. The study of microbial community succession and metabolic mechanisms showed that the increased abundance and dominance of hydrogen methanogens implies that methane is produced via the hydrogen methanogenic pathway under high organic loading conditions.","organism":null,"data_type":"Raw sequence reads","center_name":"Chinese Academy of Sciences","submission_date":"2023/11/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38378235","anaerobic sludge Z1228_1","2021-12-28","China","Guangdong","Guangzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor saample",null,null,null,null,"city","CN",1809858,"verified","text",null,"China: Guangzhou",2021],["SAMN38378236","anaerobic sludge Z1228_2","2021-12-28","China","Guangdong","Guangzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor saample",null,null,null,null,"city","CN",1809858,"verified","text",null,"China: Guangzhou",2021],["SAMN38378237","anaerobic sludge Z1228_