{"v":"3.0.0","project":{"accession":"PRJNA1491653","title":"Microbial community dynamics during anaerobic digestion of high-ammonia livestock wastewater under different aeration pretreatments","description":"This BioProject contains Illumina 16S rRNA gene amplicon sequencing data generated to characterize bacterial and archaeal community dynamics during anaerobic digestion of high-ammonia livestock wastewater.Three pretreatment strategies were investigated, including nanobubble aeration pretreatment, conventional aeration pretreatment, and non-aerated control. Samples were collected from anaerobic digestion systems at different incubation stages.The V3-V4 region of bacterial 16S rRNA genes and archaeal 16S rRNA genes were amplified and sequenced separately. Sequencing data were used to investigate microbial succession, nitrogen transformation-related microorganisms, methanogenic archaea, and their relationships with methane production performance during anaerobic digestion.This dataset provides raw sequencing reads for studying microbial mechanisms involved in anaerobic treatment of livestock wastewater under different aeration strategies.","organism":null,"data_type":"Raw sequence reads","center_name":"Henan Agricultural University","submission_date":"2026/07/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61468779","Anaerobic digestion environmental sample N1",null,"China",null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","anaerobic digestion sludge and wastewater",null,null,null,null,"country","CN",null,"unresolved",null,null,"China",null],["SAMN61468780","Anaerobic digesti