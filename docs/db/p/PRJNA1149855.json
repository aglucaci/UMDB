{"v":"3.0.0","project":{"accession":"PRJNA1149855","title":"Wastewater based surveillance revealed temporal dynamics of gut microbiota and virome during the COVID-19 pandemic","description":"Wastewater microbiome surveillance was used to characterize the temporal dynamics of the gut microbiota during the COVID-19 pandemic. The virome, dominated by temperate bacteriophages, showed high sensitivity to SARS-CoV-2, whereas the bacterial community exhibited greater adaptability and stability. The abundance of antimicrobial resistance genes (ARGs) was significantly and positively correlated with SARS-CoV-2 concentrations. These findings reveal, for the first time, the interaction network among gut bacteria, viruses, and ARGs, underscoring the unique value of wastewater microbiome surveillance in reflecting population health status.","organism":null,"data_type":"Raw sequence reads","center_name":"Chinese Academy of Sciences","submission_date":"2024/08/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43264761","SARS-CoV-2: wastewater surveillance sample from wastewater metagenome","2022-12-08","China",null,null,null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"city","CN",null,"unresolved",null,null,"China: Bishui WWTP",2022],["SAMN43264762","SARS-CoV-2: wastewater surveillance sample from wastewater metagenome","2022-12-09","China",null,null,null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"city","CN",null,"unresolved",null,null,"China: Bishui WWTP",2022],[