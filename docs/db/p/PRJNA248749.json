{"v":"3.0.0","project":{"accession":"PRJNA248749","title":"Soudan Mine Borehole communities Targeted Locus (Loci)","description":"The Soudan Iron Mine is located on the Vermillion Iron Range in Northern Minnesota, just 20 miles west of Ely, MN. We have used a combination of 454 pyrotag sequencing and illumina to sequence the V4 region of the 16SrRNA gene from borehole microbial community DNA retrieved from a Banded Iron Formation at the Soudan Iron Mine, Minnesota (USA). The mine offers unique access to subsurface microbial communities across a wide range of geological, geochemical and hydrological conditions, including access to a deep subsurface, anoxic, iron-­‐rich, CaCl2 brine located beneath the lowest level of the mine (713.5 m / 2341 feet). The brine seeps into the bottom level of the mine from a number of boreholes drilled just prior to its closing in the early 1960’s.","organism":"mine drainage metagenome","data_type":"Genome sequencing and assembly","center_name":"University of Michigan","submission_date":"2020/12/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN35806084","MIMS Environmental/Metagenome sample from mine drainage metagenome","2019-02-22","United States","Minnesota",null,47.82333,-92.23722,"probable_urban","water_drainage","city-level location without sample-site confirmation",null,"terrestrial","outflow","brine",null,"coordinate","US",null,"unresolved",null,null,"USA: Soudan Iron Mine, Minnesota",2019],["SAMN35806085","MIMS Environmental/Metagenome sample from mine drainage metagenome","2019-02-22","United States","Minnesota",null,47.82333,-92.23722,"probable_urban","water_drainage","city-level loca