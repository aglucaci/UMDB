{"v":"3.0.0","project":{"accession":"PRJNA1057040","title":"Microbial community and metabolic regulation response mechanism of anammox system under the interference of environmental concentration level artificial sweeteners","description":"This study selected cyclamate and acesulfame as the research objects, and designed an 86 days continuous flow test to verify the effect of ASs on the performance of anammox process, aiming to reveal the microbial regulation mechanism in anammox system and the fate of ASs. Among them, high-throughput sequencing was used to explore the diversity and abundance changes of microbial communities, clarify the potential microbial evolution mechanism induced by ASs, and use metabolomics to evaluate the metabolic response mechanism of anammox sludge under ASs interference. Finally, this work will improve the understanding of the anammox process in the treatment of ASs wastewater and promote its wider application in the actual wastewater treatment process.","organism":null,"data_type":"Raw sequence reads","center_name":"Hangzhou Normal University","submission_date":"2023/12/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN39117314","R0-I","2023-04-16",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN39117315","R0-III","2023-06-18",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN39117316","R1-I","2023-04-16",null,null,null