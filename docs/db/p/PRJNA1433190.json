{"v":"3.0.0","project":{"accession":"PRJNA1433190","title":"Single-cell transcriptomics of bacterial and microalgal functional heterogeneity in driving wastewater treatment","description":"Single-cell transcriptomic data were generated from wastewater samples collected from a representative recirculating aquaculture treatment system (three ponds and two dams, 3P-2D). Microbial cells, including bacteria and microalgae, were profiled using a droplet-based single-cell RNA sequencing workflow. Libraries were prepared with the VITApilote PFT1200 kit (M20 Genomics) and sequenced on an Illumina NovaSeq 6000 platform with 150-bp paired-end reads, generating approximately 1.8 Tb of raw data from nine samples. Raw reads were processed using VITAbasic (v1.4) to remove adaptor and dA-tailing sequences, followed by extraction of cell barcodes (20 bp) and unique molecular identifiers (8 bp) for downstream analysis.","organism":null,"data_type":"Raw sequence reads","center_name":"Liangzhu Laboratory","submission_date":"2026/03/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56357988","Sedimentation pond wastewater sample","2025-03-07","China","Zhejiang","Ninghai",29.151,121.519,"non_urban",null,"BioProject indicates an agricultural or industrial source","Sedimentation pond aquaculture wastewater",null,null,null,null,"coordinate","CN",1799384,"verified","text+coordinates",null,"China: Ninghai County, Zhejiang Province",2025],["SAMN56357989","Aeration pond wastewater sample","2025-03-07","China","Zhejiang","Ninghai",29.151,121.519,"non_urban",null,"BioProject indicates an agricultural or industrial source","Aeration pond aquaculture wastew