{"v":"3.0.0","project":{"accession":"PRJNA1467208","title":"A sustainable biohybrid strategy: Maintaining efficient nitrogen removal over long-term operation via EPS-induced biocompatibility in nZVI-amended sludge","description":"This study aims to evaluate the long-term operational stability and mechanistic adaptation of an EPS@nZVI-amended sludge system for advanced nitrogen removal. We hypothesize that the EPS-derived interface provides sustainable biocompatibility by guiding the transformation of nZVI into an electroactive mineral network while simultaneously shielding the microbial consortium from chronic oxidative stress. Through long-term reactor monitoring, multi-spectroscopic analysis of interface aging, and meta-omics including metagenome and metabolome, this work explores the transition from a \"toxicity-dominated\" initial stage to a \"synergy-dominated\" stable stage. This work seeks to provide a sustainable framework for the application of biohybrid nanomaterials in continuous wastewater purification.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2026/05/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60210716","MIMS Environmental/Metagenome sample from activated sludge metagenome","2025-12-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,"activated sludge",null,null,null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN60210717","MIMS Environmental/Metagenome sample from activated sludge metagenome","2025-12-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban 