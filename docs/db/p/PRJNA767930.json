{"v":"3.0.0","project":{"accession":"PRJNA767930","title":"Study of symbiotic gut bacteria across life stages and castes from 13 species of Cephalotes turtle ants","description":"We perform amplicon sequencing to study symbiotic gut bacteria across life stages and castes from 13 species of Cephalotes turtle ants. We aim to provide some of the first evidence for the importance of distinct mechanisms in the maintenance of stage-specific gut symbioses in ants, and other insects, providing insights with relevance for understanding microbiomes of insects with complete metamorphosis.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing Normal University","submission_date":"2021/10/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN21985613","MIMARKS Survey related sample from ant metagenome","2012-10-02","United States","Florida","Key West",24.559,-81.761,"non_environmental",null,"host-derived or clinical material",null,"tropical forest","hollow twigs","whole body","Cephalotes varians","coordinate","US",4160812,"verified","text+coordinates",null,"USA: Florida, Key West, Little Hamaca City Park",2012],["SAMN21985614","MIMARKS Survey related sample from ant metagenome","2012-10-02","United States","Florida","Key West",24.559,-81.761,"non_environmental",null,"host-derived or clinical material",null,"tropical forest","hollow twigs","whole body","Cephalotes varians","coordinate","US",4160812,"verified","text+coordinates",null,"USA: Florida, Key West, Little Hamaca City Park",2012],["SAMN21985615","MIMARKS Survey related sample from ant metagenome","2012-10-02","United States","Florida","Key West",24.559,-81.761,"non_