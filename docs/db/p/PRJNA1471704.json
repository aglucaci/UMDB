{"v":"3.0.0","project":{"accession":"PRJNA1471704","title":"Microbial community dynamics and metabolic mechanisms in pyrite-based mixotrophic bioretention systems for stormwater treatment","description":"This project aims to investigate the microbial community structure, functional profiles, and metabolic pathways within pyrite-based mixotrophic bioretention systems designed for advanced stormwater runoff treatment. By incorporating dual electron donors (pyrite combined with agricultural waste such as woodchips and corncobs), the system achieves enhanced nitrogen and phosphorus removal through coupled heterotrophic and autotrophic denitrification. High-throughput sequencing was performed on microbial samples collected from different bioretention configurations (including P, WP, CP, and WCP systems) across various operational stages. The objective is to elucidate the synergetic mechanisms among heterotrophic denitrifiers (HD), autotrophic denitrifiers (AD), and sulfate-reducing bacteria (SRB) during the long-term running period. The findings provide critical insights into the biological iron-sulfur-carbon-nitrogen coupling processes and offer a theoretical foundation for sustainable eco-engineered water treatment technologies.","organism":null,"data_type":"Raw sequence reads","center_name":"Chongqing University","submission_date":"2026/05/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60463903","WPtest1","2024-07-05",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN60463904","