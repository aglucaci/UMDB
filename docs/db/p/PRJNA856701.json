{"v":"3.0.0","project":{"accession":"PRJNA856701","title":"Skin microbiome of forehead in children with and without acne","description":"Whole genome sequencing of 48 volunteers, males and females, ages 7-17 years of age with and without acne. Tanner staging was used to assess pubertal development, IGA score assessed acne severity. A 7cm2 area of the forehead was scrubbed with a pre-moistened sterile, synthetic fiber swab for 30 seconds. Positive and negative sampling controls also included. Sequencing was performed by Illumina NextSeq sequencing (2x150 paired end reads).","organism":null,"data_type":"Raw sequence reads","center_name":"Penn State College of Medicine","submission_date":"2022/07/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN29584297","049_NegCtrl_1","2018-04-03","United States","Pennsylvania","Hershey",40.28,-76.65,"uncertain",null,"conflicting evidence: environmental and host/clinical","air",null,null,null,"isolation control","coordinate","US",5193342,"verified","text+coordinates",null,"USA: Hershey, PA",2018],["SAMN29584298","050_NegCtrl_2","2019-03-08","United States","Pennsylvania","Hershey",40.28,-76.65,"uncertain",null,"conflicting evidence: environmental and host/clinical","air",null,null,null,"isolation control","coordinate","US",5193342,"verified","text+coordinates",null,"USA: Hershey, PA",2019],["SAMN29584299","051_NegCtrl_3","2018-08-27","United States","Pennsylvania","Hershey",40.28,-76.65,"uncertain",null,"conflicting evidence: environmental and host/clinical","air",null,null,null,"isolation control","coordinate","US",5193342,"verified","text+coordinates",null,"USA: Hershey, PA",2018],["SAMN29