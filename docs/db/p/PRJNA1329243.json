{"v":"3.0.0","project":{"accession":"PRJNA1329243","title":"Metagenomic assessment of full-scale wastewater treatment plants identifies sentinel antibiotic resistance genes for monitoring reclaimed wastewater and sludge.","description":"The new European (EU) regulation on water reuse explicitly incorporates antimicrobial resistance (AMR) into routine monitoring and risk management, creating an urgent need to define target antibiotic resistance genes (ARGs) for reclaimed irrigation water and agricultural biosolids. However, existing global data largely focus on secondary effluents, providing little actionable evidence for reuse-oriented systems. Here, we present the first integrated framework combining targeted antibiotic residue analysis with shotgun metagenomics of the resistome, mobilome, and microbiome across full-scale reuse oriented wastewater treatment plants (WWTPs) in Southern Europe to identify sentinel ARGs for monitoring.","organism":null,"data_type":"Raw sequence reads","center_name":"IDAEA_CSIC","submission_date":"2025/09/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51396414","Influent metagenome, Sant Feliu de Llobregat, week 1","2024-02-01","Spain","Catalonia","Barcelona",41.381378,2.031021,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"fluid environmental material [ENVO:02000140]","sewage treatment plant [ENVO:00002272]","treated wastewater [ENVO:06105268]",null,"coordinate","ES",3128760,"verified","text+coordinates",null,"Spain: Barcelona",2024],["SAMN51396415","Influent metagenome, Sant Feliu de Llobregat, week 2","2024-02-08","Spain","Catalonia","Barcelona"