{"v":"3.0.0","project":{"accession":"PRJNA1191065","title":"Resistance of alfalfa rhizosphere soil microbial structure and functions to temperature changes","description":"This study revealed the changes in the rhizosphere soil microbial community, physicochemical properties, and enzyme activity of alfalfa under temperature fluctuations, providing new insights into the impact of temperature fluctuations on plant rhizosphere soil micro-ecology and their effects on plant growth. Exploring the changes in the rhizosphere soil micro-ecology of alfalfa under temperature fluctuations is of great practical significance for the overwintering process of alfalfa fields and the development and utilization of cold resistant microbial resources in the rhizosphere soil.","organism":null,"data_type":"Raw sequence reads","center_name":"Harbin Normal university","submission_date":"2024/11/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN45068558","Metagenome or environmental sample from sludge metagenome","2021-04-13","China","Heilongjiang","Harbin",45.8674,126.5569,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor sample",null,null,null,null,"coordinate","CN",2037013,"verified","text+coordinates",null,"China: Harbin",2021],["SAMN45068559","Metagenome or environmental sample from sludge metagenome","2021-04-13","China","Heilongjiang","Harbin",45.8674,126.5569,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor sample",null,null,null,null,"coordinate","CN",2037013,"verified","text+coordinates",null,"China: Harbin",2021],["SAMN45068560","M