{"v":"3.0.0","project":{"accession":"PRJNA1499387","title":"Long-term humic substances exposure favoring chain elongation rather than methanogenesis during anaerobic digestion","description":"This project investigates the effects of fulvic acid (FA) and humic acid (HA) on anaerobic digestion using a lab-scale IC reactor. Results show that FA/HA exposure redirects carbon flow from methanogenesis to chain elongation, promoting caproic acid production while suppressing methane yield. Microbial community and metagenomic analyses reveal enrichment of chain-elongating bacteria and suppression of methanogenesis pathways. These findings provide insights into resource recovery from humic-rich landfill leachate. 16S rRNA data are included.","organism":null,"data_type":"Raw sequence reads","center_name":"Jiangnan University","submission_date":"2026/07/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61877904","sludge","2023-09-01",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN61877905","sludge","2023-10-01",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN61877906","sludge","2013-11-01",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2013],["SAMN61877907","sludge","2023-12-01",null,null,null,null,null