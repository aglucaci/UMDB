{"v":"3.0.0","project":{"accession":"PRJNA1538632","title":"Signaling molecule chain elongation","description":"The term \"signal molecule chain elongation\" refers to the enzymatic or biosynthetic extension of the carbon backbone of a signaling molecule, most commonly a lipid mediator, resulting in a longer acyl or sphingoid chain. It can also describe the extension of peptide chains during translation or the addition of repeating units (e.g., ubiquitin, glycosaminoglycans) to signaling proteins. This section focuses on lipid-derived signaling molecules, because chain elongation is a central determinant of their physicochemical and biological properties.","organism":null,"data_type":"Raw sequence reads","center_name":"Taiyuan University of Technology","submission_date":"2026/10/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN63859267","con320","2026-10-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"sludge","unknown",null,null,"unresolved",null,null,null,2026],["SAMN63859268","con321","2026-10-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"sludge","unknown",null,null,"unresolved",null,null,null,2026],["SAMN63859269","con322","2026-10-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"sludge","unknown",null,null,"unresolved",null,null,null,2026],["SAMN63859270","con323","2026-10-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,nu