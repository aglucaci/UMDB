{"v":"3.0.0","project":{"accession":"PRJEB42480","title":"Effect of the effluent originating from small-scale conventional wastewater treatment plant treating municipal wastewater on the composition and abundance of the microbial community, antibiotic resistome and pathogens in the sediment and water of receiving stream.","description":"The effect of wastewater treatment plant (WWTP) effluent on the composition and abundance of the microbial community as well as antibiotic resistome and pathogens in the sediment and water of the receiving stream were studied using metagenome sequencing and quantitative (qPCR) approach. Heightened Bacteroidetes proportions, up to three orders of magnitude increase in sulfonamide resistance gene abundances, and heightened proportions of regulatory and inactivation mechanisms in antibiotic resistome were recorded in stream water and sediment straight after the WWTP discharge point. Despite the decrease in ARG abundances further downstream, the proportions of ARGs as well as pathogens in stream sediment microbial community were highest further downstream (2,7 and 3,2 km) indicating pronounced effect of long-term purified wastewater discharge influence on the receiving ecosystem.","organism":null,"data_type":"Other","center_name":"UNIVERSITY OF TARTU","submission_date":"2021/02/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA7817161","SSU","2013","Estonia",null,null,null,null,"probable_urban","water_drainage","urban context stated at BioProject level only",null,null,null,null,null,"country","EE",null,"unresolved",null,null,"Estonia",2013],["SAMEA7817162","SS03","2013","Estonia",null,null,null,