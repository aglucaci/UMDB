{"v":"3.0.0","project":{"accession":"PRJNA757592","title":"Global airborne bacterial community","description":"We established an atlas of global airborne bacteria, revealing the similar latitudinal diversity pattern of microorganisms and dynamically complex airborne bacterial community structure. The importance of airborne bacteria in the whole Earth microbial world was demonstrated by 46.25% source contributions from surrounding environments and significant interactions with other 23 habitats. We further showed the impacts of environmental filtering and human imprints on airborne bacteria.","organism":null,"data_type":"Raw sequence reads","center_name":"the Hong Kong Polytechnic University","submission_date":"2021/08/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN20968735","MIMS Environmental/Metagenome sample from air metagenome","2013-09/2013-11","China",null,null,42.4,128.1,"probable_urban","air_dust","city-level location without sample-site confirmation",null,"biome","mountain","environmental material",null,"coordinate","CN",null,"unresolved",null,null,"China: Mt. Changbai",2013],["SAMN20968736","MIMS Environmental/Metagenome sample from air metagenome","2013-12/2014-02","China",null,null,42.4,128.1,"probable_urban","air_dust","city-level location without sample-site confirmation",null,"biome","mountain","environmental material",null,"coordinate","CN",null,"unresolved",null,null,"China: Mt. Changbai",2013],["SAMN20968737","MIMS Environmental/Metagenome sample from air metagenome","2014-03/2014-05","China",null,null,42.4,128.1,"probable_urban","air_dust","city-level location without sample-site confirmation",null,"bio