{"v":"3.0.0","project":{"accession":"PRJNA1475169","title":"Microbial community diversity before and after starvation in partial nitritation reactors operated at different MLSS levels","description":"This BioProject includes raw sequencing data from partial nitritation reactors operated under different biomass-retention states to examine microbial community responses to starvation. Three laboratory-scale reactors were maintained at different mixed liquor suspended solids (MLSS) concentrations, representing low, medium, and high biomass retention. Sludge samples were collected before and after starvation to compare microbial diversity and community composition across MLSS conditions. The dataset was generated to support the assessment of how biomass retention affects microbial community stability and starvation response in high-ammonium partial nitritation systems.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2026/06/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60631136","Metagenome or environmental sample from sludge metagenome","2025-05-16","China","Shanghai","Shanghai",31.26,121.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2025],["SAMN60631137","Metagenome or environmental sample from sludge metagenome","2025-05-16","China","Shanghai","Shanghai",31.26,121.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1796236,"veri