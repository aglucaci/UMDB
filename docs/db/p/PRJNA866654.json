{"v":"3.0.0","project":{"accession":"PRJNA866654","title":"Exploring gut microbiome in predicting efficacy of immuno-therapy in non-small cell lung cancer","description":"Despite the emerging success of immunotherapy in non-small-cell lung cancer (NSCLC), it re-mains clinically important to better identify patients who are likely to respond to treatment, espe-cially considering the existence of immune-related adverse events (irAEs). In recent years, the gut microbiome has been correlated with treatment response, but no predictive models relating the two have been developed. Findings from our current study showed that a functional profile of the human gut microbiome outperformed taxonomical results across different studies and can be uti-lized to establish a model with good predictive value in lung cancer immunotherapy.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Kansas Medical Center","submission_date":"2022/08/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN30170361","Metagenome or environmental sample from gut metagenome","2018-10-24","United States","Iowa","Iowa City",41.65966,-91.54766,"non_environmental",null,"host-derived or clinical material","stool",null,null,null,"Homo sapiens","coordinate","US",4862034,"verified","text+coordinates",null,"USA: Iowa City",2018],["SAMN30170362","Metagenome or environmental sample from gut metagenome","2018-11-20","United States","Iowa","Iowa City",41.65966,-91.54766,"non_environmental",null,"host-derived or clinical material","stool",null,null,null,"Homo sapiens","coordinate","US",4862034,"verified","text+coordinates",null,"USA: Iowa City",2018],["