{"v":"3.0.0","project":{"accession":"PRJNA1180282","title":"Sludge raw sequence reads","description":"This data contains microbial community composition data from six lab-scale batch reactors simulating textile printing wastewater treatment under varying salinity levels across anoxic-oxic-anoxic (AOA) stages. The data highlight microbial shifts, urea hydrolysis, and total nitrogen (TN) and COD removal efficiencies under salinity stress. The goal is to analyze the simultaneous impact of sodium dithionite on urea hydrolysis and total nitrogen removal under sodium dithionite salinity stress.","organism":null,"data_type":"Raw sequence reads","center_name":"Donghua University","submission_date":"2024/10/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44517708","Seed","2024-10-31","China","Shanghai","Shanghai",31.06,121.21,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China:Shanghai",2024],["SAMN44517709","Aa1","2024-10-31","China","Shanghai","Shanghai",31.07,121.21,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China:Shanghai",2024],["SAMN44517710","O1","2024-10-31","China","Shanghai","Shanghai",31.08,121.21,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China:Shanghai",2024],["SAMN44517711","Ab1","2024-10-31","China","Shanghai","Shanghai",31.09,121.21,"non_urban",null,"BioProject i