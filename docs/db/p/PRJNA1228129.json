{"v":"3.0.0","project":{"accession":"PRJNA1228129","title":"Metagenomic Profiling of Airborne Microbial Communities from Aircraft Filters and Face Masks","description":"Airborne microbial communities, though challenging to study due to low biomass, play a critical role in public health, antimicrobial resistance, and pathogen transmission. This project aims to characterize the microbial diversity and functional potential of airborne microbiomes in high-occupancy environments, such as hospitals and airplanes, using shotgun metagenomics. By leveraging non-invasive air sampling from face masks and aircraft cabin filters, we developed an optimized workflow incorporating environmental and enrichment protocols to enhance microbial DNA recovery and diversity profiling.","organism":null,"data_type":"Raw sequence reads","center_name":"NORTHWESTERN UNIVERSITY","submission_date":"2025/02/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47007089","Aircraft Filter Metganome 1","2021-04-01",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,"built environment","aircraft cabin air","air filter",null,"unknown",null,null,"unresolved",null,null,null,2021],["SAMN47007090","Aircraft Filter Metganome 2","2021-04-01",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,"built environment","aircraft cabin air","air filter",null,"unknown",null,null,"unresolved",null,null,null,2021],["SAMN47007091","Aircraft Filter Metganome 3","2021-04-01",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,"