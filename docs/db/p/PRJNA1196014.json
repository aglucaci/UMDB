{"v":"3.0.0","project":{"accession":"PRJNA1196014","title":"activated sludge","description":"Functional bacterial genus analyses showed that the heterotrophic nitrifying bacteria, denitrifying bacteria and perchlorate reduction bacteria were enriched and coexisted stably in a single reactor. Functional genes analysis further suggested that the removal of nitrogen and perchlorate was mainly accomplished by heterotrophic nitrification, anoxic denitrification coupling perchlorate reduction and other secondary reaction pathways. The study provided an efficient and economical approach for the simultaneous removal of ammonium and perchlorate wastewater.","organism":null,"data_type":"Raw sequence reads","center_name":"Qingdao University of Science and Technology","submission_date":"2024/12/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN45291581","Metagenome or environmental sample from activated sludge metagenome","2023-11","China",null,null,35.2102,119.1123,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",null,"conflicting","text","'Tsingtao' is 149 km from the reported coordinates","China:Tsingtao",2023],["SAMN46232046","Metagenome or environmental sample from activated sludge metagenome","2023-11-20","China","Shandong","Qingdao",35.5,119.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1797929,"verified","text",null,"China:QingDao",2023],["SAMN46232047","Metagenome or environmental sample from activated sludge metagenome","2023-11-20","China","Shand