{"v":"3.0.0","project":{"accession":"PRJNA1274428","title":"Transcriptomic profiling of Pseudomonas mendocina under nanoplastic and shear stress exposure","description":"This project investigates the transcriptomic responses of Pseudomonas mendocina under environmental exposure to nanoplastics (15 mg/L) and fluid shear stress (50-160 rpm). Samples were collected under static and dynamic culture conditions to assess gene expression profiles associated with plastic-induced stress and mechanical disturbance. The data support understanding of bacterial adaptation mechanisms in wastewater environments.","organism":null,"data_type":"Raw sequence reads","center_name":"guangzhou university","submission_date":"2025/06/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48957378","MIGS Cultured Bacterial/Archaeal sample from Ectopseudomonas mendocina","2024-04-30","China","Guangdong","Guangzhou",23.12,113.22,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"aquatic biome","municipal wastewater treatment plant","wastewater",null,"coordinate","CN",1809858,"verified","text+coordinates",null,"China: Guangzhou, Datansha Wastewater Treatment Plant",2024],["SAMN48957379","MIGS Cultured Bacterial/Archaeal sample from Ectopseudomonas mendocina","2024-04-30","China","Guangdong","Guangzhou",23.12,113.22,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"aquatic biome","municipal wastewater treatment plant","wastewater",null,"coordinate","CN",1809858,"verified","text+coordinates",null,"China: Guangzhou, Datansha Wastewater Treatment Plant",2024],["SAMN48957380","MIGS Cultured Bacterial/Archae