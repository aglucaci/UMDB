{"v":"3.0.0","project":{"accession":"PRJNA879773","title":"Improved CH4 production from solid waste under zero valent metal amendments (16S)","description":"Landfills are understudied stocks of carbon. This work details the amendment of zero valent metals to solid waste material excavated from regional landfills and assesses their impact on methane biostimulation under a gas production and microbial lens. Summaries of elusive microbial developments putatively involved in MSW biostabilization are also described.Included in this bioproject are 16S sequences only. The same samples were amplified for mcrA and are included in a separate bioproject.","organism":null,"data_type":"Raw sequence reads","center_name":"Arizona State University","submission_date":"2022/09/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN30814460","MIMARKS Survey related sample from aquatic metagenome","2020-03-20","United States","Arizona","Mesa",33.50680741,-111.78764352,"uncertain",null,"no environmental-sample evidence",null,"anthropogenic terrestrial_1","landfill_1","anthropogenic environmental_1",null,"coordinate","US",5304391,"probable","coordinates",null,"USA: Arizona",2020],["SAMN30814461","MIMARKS Survey related sample from aquatic metagenome","2020-03-20","United States","Arizona","Mesa",33.50680741,-111.78764352,"uncertain",null,"no environmental-sample evidence",null,"anthropogenic terrestrial_2","landfill_2","anthropogenic environmental_2",null,"coordinate","US",5304391,"probable","coordinates",null,"USA: Arizona",2020],["SAMN30814462","MIMARKS Survey related sample from aquatic metagenome","2020-03-20","United States","Arizona","Mesa",33.5