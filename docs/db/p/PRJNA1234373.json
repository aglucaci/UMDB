{"v":"3.0.0","project":{"accession":"PRJNA1234373","title":"16S rRNA gene amplicon sequencing of simplified methanotrophic consortium and its initial consortium","description":"Samples for enrichment were collected from rice rhizosphere soil (Shanghai, China), sludge from a wastewater treatment plant (Shanghai Chengtou Sewage Treatment, China), and coalmine soil (0-2 m depth, Liangshuijing Coal Mine, Sichuan, China). Primary enrichment was conducted using CH4 as the sole carbon source in NMS medium to obtain initial methanotrophic consortia (RF, ST, CM). Dilution-to-extinction culturing yielded simplified consortia (SRF, SST, SCM). One replicate of each simplified methanotrophic consortium and its initial consortium collected after 6 days of cultivation under enrichment conditions, was used for 16S rRNA gene amplicon sequencing. Moreover, Six cell suspension samples of SRF and SST consortia (24, 72, 144 h) and SCM (24, 48, 144 h) under typical terrestrial CH4 hotspot concentrations were used for Illumina MiSeq sequencing of 16S rRNA.","organism":null,"data_type":"Raw sequence reads","center_name":"Shanghai Jiao Tong University","submission_date":"2025/03/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47296165","Metagenome or environmental sample from sludge metagenome","2022-09-30","China","Shanghai","Shanghai",31.221471,121.612021,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Wastewater treatment plant",null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2022],["SAMN47296168","Metagenome or environmental sample from sludge metagenome"