{"v":"3.0.0","project":{"accession":"PRJDB19636","title":"Comparative analysis of aerosol bacterial communities before and after dental treatment","description":"It is well known that aerosols are generated during dental procedures. However, there are few studies that have comparatively analyzed changes in aerosol bacterial communities in dental clinics before and after treatment. In this study, samples were collected on gelatin filters using an air sampler in the clinic. DNA was then extracted from the samples, and the bacterial communities were analyzed using next-generation sequencing. A total of 10 pre-treatment and 10 post-treatment samples were analyzed for alpha diversity, beta diversity, and using LEfSe. As a result, alpha diversity was found to increase in samples collected during treatment, and characteristic bacterial groups of oral origin were detected. On the other hand, no significant changes in beta diversity were observed.","organism":"medicine metagenome","data_type":"Targeted Locus (Loci)","center_name":"Osaka Dental University","submission_date":"2025/05/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00847838","before_5A_R1","2023","Japan","Osaka","Osaka",34.69,135.51,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"hospital","field hospital","air",null,"coordinate","JP",1853909,"verified","text+coordinates",null,"Japan:Osaka",2023],["SAMD00847840","after_5P_R1","2023","Japan","Osaka","Osaka",34.69,135.51,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"hospital","field hospital","air",null,"coordinate","JP",1853909,"verified","text+coordinates