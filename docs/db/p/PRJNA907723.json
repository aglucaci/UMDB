{"v":"3.0.0","project":{"accession":"PRJNA907723","title":"16SrRNA amplicon sequeces of wastewater that treated by PFA, UV and chlorine","description":"This study provides a systematic overview of the PFA effect and that of chlorine and UV, two commonly used disinfectants, on microbial community diversity and structure. The study focuses on disinfection of pathogenic microorganisms, identifying sensitive and resistant bacteria to disinfectants that can serve as biomarkers for evaluating the disinfectant performances. As well, we investigated the modifications of microbial functions after treatment by functional predictive analysis. Wastewaters from three municipal wastewater treatment plants (WWTPs) processed by activated sludge, lagoon and reed beds, and biofilter, were investigated.","organism":null,"data_type":"Raw sequence reads","center_name":"Guangdong Academy of Sciences","submission_date":"2022/12/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN31988979","Metagenome or environmental sample from wastewater metagenome","2020-07","France","New Aquitaine","Assat",43.25,-0.29,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"coordinate","FR",3036522,"verified","text+coordinates",null,"France:Assat",2020],["SAMN31988980","Metagenome or environmental sample from wastewater metagenome","2020-07","France","New Aquitaine","Assat",43.25,-0.29,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"coordinate","FR",3036522,"verified","text+coordinates",null,"France:Assat",2020]