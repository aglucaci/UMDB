{"v":"3.0.0","project":{"accession":"PRJNA846349","title":"Diversity of comammox bacteria in wastewater.","description":"The overall objective of this study was to test the hypothesis that the widespread distribution and persistence of nearly identical comammox bacterial population in multiple secondary wastewater treatment systems was due to the presence of large number of co-existing strains (i.e., high microdiversity). To accomplish this, we used a combination of full-length 16S rRNA gene sequencing and hybrid metagenome assembly and binning approach to systematically explore the population and strain level diversity of nitrifiers in three full-scale nitrogen removal systems with different process configurations. In doing so, we also aimed to assess factors that may influence the population and intra-population diversity of co-existing nitrifiers.","organism":"activated sludge metagenome","data_type":"Genome sequencing and assembly","center_name":"Northeastern University","submission_date":"2022/07/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN28887174","Metagenome or environmental sample from activated sludge metagenome","2018-02","United States","Pennsylvania",null,null,null,"uncertain",null,"environmental sample; urban association not established","wastewater",null,null,null,null,"region","US",null,"unresolved",null,null,"USA: Pennsylvania",2018],["SAMN28887175","Metagenome or environmental sample from activated sludge metagenome","2018-03","United States","Pennsylvania",null,null,null,"uncertain",null,"environmental sample; urban association not established","wastewater",null,null,null,null,"region","US",null,"unr