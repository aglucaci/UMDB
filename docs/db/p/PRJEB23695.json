{"v":"3.0.0","project":{"accession":"PRJEB23695","title":"Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","description":"We utilized epicPCR to detect the bacterial hosts of antibiotic resistance genes in two WWTPs. We identified the host distribution of four resistance-associated genes (tetM, int1, qacE∆1, blaOXA-58) in influent and effluent. The bacterial hosts of these resistance genes varied between the WWTP influent and effluent, with a generally decreasing host range in the effluent. Through 16S rRNA gene sequencing it was determined that the resistance gene-carrying bacteria include both abundant and rare taxa.","organism":null,"data_type":"Other","center_name":"University of Helsinki","submission_date":"2018/03/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA104680254","Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","2016-09","Finland",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"country","FI",null,"unresolved",null,null,"Finland",2016],["SAMEA104680255","Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","2016-09","Finland",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"country","FI",null,"unresolved",null,null,"Finland",2016],["SAMEA104680256","Host range of antibiotic resistance genes in wastewater treatment plant influent and effluent","2016-09","Finland",null,null,null,null,"uncertain",null,"conflicting evidence: environmental an