{"v":"3.0.0","project":{"accession":"PRJEB104033","title":"Effect of the hydrothermal carbonization temperature on the conversion of process water produced from food waste in a mesophilic UASB digester","description":"The conversion of process water (PW) produced during the hydrothermal carbonization (HTC) of organic waste by anaerobic digestion (AD) offers the opportunity to reduce the organic load of this aqueous phase and increase the overall energy yield of the process. The AD of PW produced at two different temperatures (180°C and 240°C) in up-flow anaerobic sludge blanket digesters was carried out to determine the effect of HTC temperature on AD performance and the associated microbial communities.","organism":null,"data_type":"Other","center_name":"National Research Council Canada, Clean Energy Innovation Research Centre","submission_date":"2025/11/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA120574830",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA120574831",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA120574832",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA120574833",null,null,null,null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"unknown",null,null,"unresolved",n