{"v":"3.0.0","project":{"accession":"PRJEB103008","title":"Iron regulation of sulfur-mediated autotrophic denitrification: denitrification efficiency, microbial dynamics, and metabolic pathways","description":"The application of iron sulfide-mediated, autotrophic denitrification is promising for nitrate reduction in carbon (organics)-deficient wastewater and polluted groundwater. Previous research shows that different iron sulfide lead to distinct functional microbial communities, obscuring how iron modulates their composition and activity. In this study, different iron levels were applied to isolate the effects of S and Fe and investigated iron-modulated denitrification efficiency, microbial succession, and key pathways.","organism":null,"data_type":"Other","center_name":"University of Galway","submission_date":"2025/11/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA120538701","Sulfur AD","2024-03-10","Ireland",null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"country","IE",null,"unresolved",null,null,"Ireland",2024],["SAMEA120538702","Sulfur AD","2024-04-10","Ireland",null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"country","IE",null,"unresolved",null,null,"Ireland",2024],["SAMEA120538703","Sulfur AD","2024-05-10","Ireland",null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"country","IE",null,"unresolved",null,null,"Ireland",2024],["SAMEA120538704","S/Fe mixed","2024-03-10","Ireland",null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,nu