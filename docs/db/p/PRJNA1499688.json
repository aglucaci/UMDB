{"v":"3.0.0","project":{"accession":"PRJNA1499688","title":"aerobic granular sludge sequencing","description":"We demonstrate that retained centrate solids can serve as a slow-release internal carbon pool. During 120 days of granular sludge reactor operation, influent solids increased from 1.0 to 3.0 g/L while the C/N ratio decreased from 2.8 to 1.5. The reactor nevertheless maintained greater than 99% ammonia removal and greater than 95% total inorganic nitrogen removal at a hydraulic retention time of only 6 h.","organism":null,"data_type":"Raw sequence reads","center_name":"QUT","submission_date":"2026/07/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61886272","Granular sludge at the end of Stage I 16s","2025-06-10","Australia","Queensland","Brisbane",-27.4772,153.0281,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","REACTOR",null,null,null,null,"coordinate","AU",2174003,"probable","coordinates",null,"Australia: Queensland",2025],["SAMN61886273","Granular sludge at the end of Stage I 16s","2025-06-10","Australia","Queensland","Brisbane",-27.4772,153.0281,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","REACTOR",null,null,null,null,"coordinate","AU",2174003,"probable","coordinates",null,"Australia: Queensland",2025],["SAMN61886274","Granular sludge at the end of Stage II 16s","2025-07-20","Australia","Queensland","Brisbane",-27.4772,153.0281,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","REACTOR",null,null,null,null,"coordinate","AU",2174003,"probable","coordinates",null,"Austra