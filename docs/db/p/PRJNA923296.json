{"v":"3.0.0","project":{"accession":"PRJNA923296","title":"Farm contribution to the swine value chain microbiome","description":"A thorough understanding of the microbial ecology of the swine value chain is essential to develop new strategies to optimize the microbiological quality of pork products. To our knowledge, no study to date has been performed following farm animals to the meat obtained from these animals. The objective of this study is to evaluate how the microbiota of pigs, originating from two farms with different sanitary status, and their environment influence the microbial composition of the value chain, the contamination of the slaughterhouse and meat microbiological quality.","organism":null,"data_type":"Raw sequence reads","center_name":"Universite Laval","submission_date":"2023/01/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN32710735","Metagenome or environmental sample from air metagenome","2019","Canada","Quebec","Québec",null,null,"non_urban",null,"environmental sample from a non-urban site","Housing barn air",null,null,null,null,"region","CA",6325494,"probable","text","region's main city","Canada: Quebec",2019],["SAMN32710736","Metagenome or environmental sample from air metagenome","2019","Canada","Quebec","Québec",null,null,"non_urban",null,"environmental sample from a non-urban site","Housing barn air",null,null,null,null,"region","CA",6325494,"probable","text","region's main city","Canada: Quebec",2019],["SAMN32710737","Metagenome or environmental sample from air metagenome","2019","Canada","Quebec","Québec",null,null,"non_urban",null,"environmental sample from a non-urban site","Housing barn 