{"v":"3.0.0","project":{"accession":"PRJNA1328428","title":"Microbial community in anaerobic wastewater treatment with electrogenerated iron carbonate","description":"This project investigates microbial community composition in upflow anaerobic sludge blanket (UASB) reactors treating domestic wastewater with and without electrogenerated iron carbonate (FeCO3). Using 16S rRNA sequencing, we profiled microbial dynamics under different FeCO3 doses to understand how sulfide and phosphate removal strategies influence anaerobic digestion performance and biogas quality.","organism":null,"data_type":"Raw sequence reads","center_name":"The University of Queensland","submission_date":"2025/09/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51335504","CUASB 40 dose 1","2023-12","Australia","Queensland","Brisbane",-27.4977,153.0129,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP and domestic wastewater",null,null,null,"laboratory UASB reactors","coordinate","AU",2174003,"verified","text+coordinates",null,"Australia: Brisbane",2023],["SAMN51335505","CUASB 40 dose 2","2023-12","Australia","Queensland","Brisbane",-27.4977,153.0129,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP and domestic wastewater",null,null,null,"laboratory UASB reactors","coordinate","AU",2174003,"verified","text+coordinates",null,"Australia: Brisbane",2023],["SAMN51335506","CUASB 40 dose 3","2023-12","Australia","Queensland","Brisbane",-27.4977,153.0129,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP and domestic wastewater",null,null,null,"laboratory UASB reactors","coord