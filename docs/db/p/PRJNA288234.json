{"v":"3.0.0","project":{"accession":"PRJNA288234","title":"\"Metagenomic analysis of a wastewater recycling consortia\"","description":"To determine the optimum conditions to establish a nitrification in a biological water processor. These sequences were obtained through a time-course sampling of six subscale, batch water reclamation reactors. Inoculated with a urine-fed, nitrifying inoculum, two groups of reactors (triplicate) were fed either urine or wastewater (consisting of urine, humidity condensate, laundry, shower, shave, oral hygiene and handwash water) and observed to determine which feed water conditions cultivated a nitrifying consortia.","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"University of Houston","submission_date":"2015/06/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN03800326","8-30I","2013-08-30","United States","Texas","League City",29.563,-95.091,"uncertain",null,"environmental sample; urban association not established",null,"urine","urine","urine",null,"coordinate","US",4705692,"probable","coordinates",null,"USA: Texas",2013],["SAMN03800327","9-2A1-1","2013-09-02","United States","Texas","League City",29.563,-95.091,"uncertain",null,"environmental sample; urban association not established",null,"urine","urine","urine",null,"coordinate","US",4705692,"probable","coordinates",null,"USA: Texas",2013],["SAMN03800328","9-2A2-1","2013-09-02","United States","Texas","League City",29.563,-95.091,"uncertain",null,"environmental sample; urban association not established",null,"urine","urine","urine",null,"coordinate","US",4705692,"probable","coordinates",null,"USA: Texas",2013]