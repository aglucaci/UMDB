{"v":"3.0.0","project":{"accession":"PRJNA1295377","title":"Deciphering the Metabolisms of Nitrogen and Carbon Driven by Alkaline Sludge Fermentation Liquor: Insights into Physiological Responses and Functional Genes","description":"In response to the global demand for carbon-neutral and energy-efficient wastewater treatment, this study explores the application of alkaline sludge fermentation liquor as a sustainable carbon and nitrogen source to drive partial nitrification-denitrification-anammox processes in real low C/N municipal sewage. The proposed strategy achieves ultra-high nitrogen removal efficiency (98.0%) in a single-stage sequencing batch reactor, addressing critical challenges in conventional biological nitrogen removal.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2025/07/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50168165","Metagenome or environmental sample from wastewater metagenome","2024-05-16","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor",null,null,null,null,"city","CN",1816670,"probable","text","region's main city","China: Beijing",2024],["SAMN50168166","Metagenome or environmental sample from wastewater metagenome","2024-08-16","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor",null,null,null,null,"city","CN",1816670,"probable","text","region's main city","China: Beijing",2024],["SAMN50168167","Metagenome or environmental sample from waste