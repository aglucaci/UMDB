{"v":"3.0.0","project":{"accession":"PRJNA1314953","title":"CPE from wastewater","description":"The CPE have been isolated from hospital wastewater, sewers and wastewater treatment plants. The goal of the study was to determine the origin of CPE at municipal WWTP and the contribution of hospitals and households to the CPE load in WWTP influents. Measurements in WWTP influents are used for wastrewater-based surveillance of CPE, which is based on the assumption that the enterobacterial content in wastewater reflects human carriage. Influence of hospital wastewater could disrupt this association.","organism":null,"data_type":"Raw sequence reads","center_name":"RIVM","submission_date":"2025/09/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51025488","Pathogen: environmental/food/other sample from Escherichia coli","2017-09-26","The Netherlands",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP influent",null,null,null,null,"country","NL",null,"unresolved",null,null,"Netherlands",2017],["SAMN51025489","Pathogen: environmental/food/other sample from Escherichia coli","2017-09-26","The Netherlands",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP influent",null,null,null,null,"country","NL",null,"unresolved",null,null,"Netherlands",2017],["SAMN51025491","Pathogen: environmental/food/other sample from Escherichia coli","2017-10-10","The Netherlands",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","WWTP influent",null,null,null,null,"country","NL",null,"unresolved",null,null,"Netherlands",