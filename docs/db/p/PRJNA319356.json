{"v":"3.0.0","project":{"accession":"PRJNA319356","title":"International Space Station Microbial Observatory - Antimicrobial Resistance Study","description":"The environmental samples were collected with the polyester wipes from eight different locations in the International Space Station (ISS) during two consecutive sampling sessions (two months apart) within the ISS Microbial Observatory Experiment. DNA extracted from each of the samples was used to create amplicon libraries based on customized panel of 500 antimicrobial resistance genes followed by next-generation sequencing. This is the first study of that shows the reservoir of antimicrobial genes in the ISS.","organism":"indoor metagenome","data_type":"Raw sequence reads","center_name":"Jet Propulsion Laboratory, California Institute of Technology","submission_date":"2016/04/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN05581696","Flight 1, location 1","2015-03-05","United States",null,null,null,null,"non_urban",null,"environmental sample from a non-urban site","International Space Station, environmental surface",null,null,null,null,"city","US",null,"unresolved",null,null,"USA: International Space Station",2015],["SAMN05581697","Flight 1, location 2","2015-03-05","United States",null,null,null,null,"non_urban",null,"environmental sample from a non-urban site","Waste and hygiene compartment Node 3 'F4'",null,null,null,null,"city","US",null,"unresolved",null,null,"USA: International Space Station",2015],["SAMN05581698","Flight 1, location 3","2015-03-05",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site","International Space Statio