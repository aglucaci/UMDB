{"v":"3.0.0","project":{"accession":"PRJNA1333395","title":"The Influence of Irisin on Gut Microbiota in Septic Mice","description":"The protective effects of irisin against lipopolysaccharide (LPS)-induced septic intestinal injury and its impact on gut microbiota in mice were investigated. The study demonstrated that irisin treatment significantly alleviated intestinal damage caused by LPS, including reduced inflammatory markers, improved intestinal permeability, and enhanced gut barrier function. Additionally, irisin was found to modulate the composition of the gut microbiota, promoting the growth of beneficial microbial populations while suppressing the expansion of harmful bacteria. These findings suggest that irisin may offer a therapeutic strategy for managing septic intestinal injury by targeting both the inflammatory response and gut microbiota.","organism":null,"data_type":"Raw sequence reads","center_name":"The Affiliated Hospital, Southwest Medical University","submission_date":"2025/09/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51795117","1Contrl","2024-03-16",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN51795118","2Contrl","2024-03-16",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN51795119","3Contrl","2024-03-16",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not establi