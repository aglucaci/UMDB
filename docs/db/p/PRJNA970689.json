{"v":"3.0.0","project":{"accession":"PRJNA970689","title":"Response of nitrite accumulation to elevated C/NO- 3 ratio during partial denitrification process: Insights of extracellular polymeric substance, microbial community and metabolic function","description":"This study investigated firstly the response of nitrite accumulation to elevated C/N ratios by analyzing nitrite accumulation performance and accumulation behavior. Then, the response of the EPS content, microbial community and metabolic function to elevated C/N ratios were simultaneously explored and potential correlation was established between them with nitrite accumulation, respectively. Based on above results, the underlying mechanism responsible for nitrite accumulation driven by C/N ratios was elucidated comprehensively. The obtained results could provide valuable insights for PD coupling with anammox in the practical application.","organism":null,"data_type":"Raw sequence reads","center_name":"Harbin Institution of Technology Shenzhen","submission_date":"2023/05/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN35006957","raw sludge","2022-12-09","China","Guangdong","Zhuhai",22.35,113.57,"uncertain",null,"conflicting evidence: environmental and host/clinical","Synthetic municipal sewage soil 0",null,null,null,"Poplar","coordinate","CN",1790437,"probable","coordinates",null,"China: Guangdong",2022],["SAMN35006958","C/N=1.5","2022-12-09","China","Guangdong","Zhuhai",22.35,113.57,"uncertain",null,"conflicting evidence: environmental and host/clinical","Synthetic municipal sewage soil 1",null,null,null,"Poplar","coordinate","CN",1790437,"probable","coordinates",