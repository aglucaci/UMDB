{"v":"3.0.0","project":{"accession":"PRJNA484334","title":"Highly urbanized water microbiomes - sewage water inflow and effluent differ in their seasonal bacterial community profile","description":"Waste water treatment is crucial to environmental hygiene in urbanized environments. However, the treatment process may concentrate chemicals, organic matter, and microorganisms including pathogens and multi-resistant bacteria which may potentially contaminate the environment via the effluent. Moreover, while waste water treatment plants (WWTP) may substantially reduce harmful bacteria, their effluent discharge into the environment is continuous and enables non-native, potentially detrimental microorganisms to colonize the environment. To better understand effects of WWTP on microbial dynamics in the urban environment, we conducted a seasonal study of the bacterial community of the inflow and effluent of a WWTP in Berlin, Germany, using full length 16S rRNA gene information obtained by PacBio® Sequel sequencing.","organism":"wastewater metagenome","data_type":"Raw sequence reads","center_name":"IZW - Leibniz Institute for Zoo and Wildlife Research","submission_date":"2018/08/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN09764281","influent winter","2016-02-11","Germany","State of Berlin","Berlin",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater","influent","water",null,"city","DE",2950159,"probable","text","region's main city","Germany: Berlin",2016],["SAMN09764282","influent spring","2016-04-15","Germany","State of Berlin","Berlin",null,null,"probable_ur