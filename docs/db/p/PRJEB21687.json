{"v":"3.0.0","project":{"accession":"PRJEB21687","title":"Microbial community structure and functions in ethanol-fed sulphate removal bioreactors for treatment of mine water","description":"The microbial community of bacteria, archaea and fungi in three laboratory-scale bioreactors for biological sulphate removal from mine water was characterized by high throughput Iontorrent PGM amplicon sequencing targeting the 16S rRNA gene of the archaea and bacteria and the ITS1 fragment of the fungi. Anaerobic granular sludge from an industrial wastewater treatment plant was used as inoculum and charaterized in the same way as the bioreactor samples.","organism":null,"data_type":"Other","center_name":"VTT Technical Research Centre of Finland","submission_date":"2018/04/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA104153822","Microbial community structure and functions in ethanol-fed sulphate removal bioreactors for treatment of mine water","2015-08-27","Finland",null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"country","FI",null,"unresolved",null,null,"Finland",2015],["SAMEA104153823","Microbial community structure and functions in ethanol-fed sulphate removal bioreactors for treatment of mine water","2015-08-27","Finland",null,null,null,null,"non_environmental",null,"laboratory or culture material",null,null,null,null,null,"country","FI",null,"unresolved",null,null,"Finland",2015],["SAMEA104153824","Microbial community structure and functions in ethanol-fed sulphate removal bioreactors for treatment of mine water","2015-08-27","Finland",null,null,null,null,"non_environmental