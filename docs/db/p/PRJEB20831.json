{"v":"3.0.0","project":{"accession":"PRJEB20831","title":"Prokaryotic communities and potential pathogens in sewage sludge: response to wastewater origin, loading rate and sludge treatment","description":"We examined the effects of the wastewater origin, loading rate, and the slugde treatment technology on the structure and composition of bacterial and archaeal communities8in sewage sludge. To do so, we collected sewage sludge in 28 wastewater treatment plants in Spain, and separately pyrosequenced the 16S rRNA gene of bacteria and archaea yielding a total 386,693  and 211,665 sequences, respectively. Raw sequences were quality filtered, chimera checked and respectively grouped into 8030 and 391 bacterial and archaeal operational taxonomic units.","organism":null,"data_type":"Other","center_name":"Centro de Investigaciones Sobre Desertificaci..n (Consejo Superior de Investigaciones Cient..ficas)","submission_date":"2017/10/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA104069779","Sewage sludge SE Spain",null,null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA104069780","Sewage sludge SE Spain",null,null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA104069781","Sewage sludge SE Spain",null,null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"unkn