{"v":"3.0.0","project":{"accession":"PRJNA1414260","title":"Influence of inocula microbial composition on bioplastic degradation","description":"n order to gain deeper insight into the biodegradation mechanisms, the microbial composition of the different inocula was characterized to identify the bacterial taxa potentially involved in the degradation processes. High-throughput sequencing analyses allowed the assessment of microbial diversity and relative abundance, enabling the identification of specific bacterial groups associated with the biodegradation of the tested microplastics. This characterization provided valuable information on how differences in microbial community structure may influence biodegradation performance, supporting the role of inoculum composition as a key factor driving variability in biodegradation assays.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Vigo","submission_date":"2026/01/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54898697","1",null,"Spain","Galicia","Tui",42.056661,-8.630162,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"environmental sample","activated sludge","aqueous",null,"coordinate","ES",3107364,"verified","text+coordinates",null,"Spain: Tui",null],["SAMN54898698","2",null,"Spain","Galicia","Tui",42.056661,-8.630162,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"environmental sample","activated sludge","aqueous",null,"coordinate","ES",3107364,"verified","text+coordinates",null,"Spain: Tui",null],["SAMN54898699","3",null,"Spain","Galicia"