{"v":"3.0.0","project":{"accession":"PRJEB121258","title":"Oral Microbiome Responses to Simulated Microgravity","description":"The study investigated changes to the oral microbiome of healthy participants who underwent 60 days of head-down tilt bed rest. The study phases included baseline data collection (BDC), the head-down tilt bedrest phase (HDT), and the recovery phase (R). Throughout the study, samples were taken from plaque, and the mucosa and dorsal tongue were sampled using swabs. Samples were analysed using 16S rRNA amplicon sequencing with primers 341F (5′-CCTACGGGNGGCWGCAG-3′) and 785R (5′-GACTACHVGGGTATCTAATCC-3′) targeting the V3–V4 region.","organism":null,"data_type":"Other","center_name":"German Aerospace Center","submission_date":"2026/08/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA123124080","NTC-A-BDC7","2024","Germany",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2024],["SAMEA123124081","NTC-A-HDT31","2024","Germany",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2024],["SAMEA123124082","NTC-A-HDT57","2024","Germany",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2024],["SAMEA123124083","NTC-A-R6","2024","Germany",null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"