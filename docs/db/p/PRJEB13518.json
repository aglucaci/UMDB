{"v":"3.0.0","project":{"accession":"PRJEB13518","title":"Analysis of Bacterial Communities Present on Fermented Foods: From Raw Sample to Analyzed Multi-Omics Data in Less than 48 Hours","description":"In this pilot study, seven individuals contributed samples of their fermented foods and the surfaces coming into contact with those foods (i.e. fermentors, countertops, cutting boards, etc.). The same individuals also contributed samples collected from their own bodies, which are part of the American Gut Project (Qiita Study ID 10317). The purpose of this study was two-fold: first, we sought to identify and characterize the bacterial diversity associated fermented foods and how this diversity affects the microbiomes of the people in contact with those foods; second, this study was used as a platform for rapid response sample processing and analysis. Metabolomics analyses via mass spec were also performed on all samples.","organism":null,"data_type":"Other","center_name":"University of California San Diego Microbiome Initiative","submission_date":"2016/04/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA3930392","American Gut Project; 10395.000041054","1/26/16",null,null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA3930393","American Gut Project; 10395.000041056","1/26/16",null,null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA3930394","American Gut Project; 10395.0000410