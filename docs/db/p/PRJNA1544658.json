{"v":"3.0.0","project":{"accession":"PRJNA1544658","title":"Metagenomic responses of activated sludge to dissolved oxygen and emerging contaminant stress","description":"This project investigates the metagenomic responses of activated sludge microbial communities to different dissolved oxygen (DO) conditions during stepwise exposure to emerging contaminants. Two laboratory-scale sequencing batch reactors were operated at conventional (3.5 mg/L) and elevated (5.5 mg/L) DO concentrations for 40 days using synthetic wastewater. Ofloxacin, demeclocycline, and sulfamethoxazole were introduced first, followed by acetaminophen and benzalkonium chloride. Shotgun metagenomic sequencing was performed on initial sludge and sludge samples collected at successive operational stages to characterize changes in microbial functional potential and metabolic pathway profiles.","organism":null,"data_type":"Raw sequence reads","center_name":"Liaoning University","submission_date":"2026/10/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64234647","Initial activated sludge, subsample 1","2025-07-18","China","Guangdong","Shenzhen",null,null,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level","municipal wastewater treatment plant activated sludge","wastewater treatment plant","aeration tank","activated sludge",null,"city","CN",1795565,"probable","text-population","largest of 2 places named 'Shenzhen'","China: Guangdong, Shenzhen",2025],["SAMN64234648","Initial activated sludge, subsample 2","2025-07-18","China","Guangdong","Shenzhen",null,null,"confirmed_urban","municipal_wastewater","explicit urban setting at sample 