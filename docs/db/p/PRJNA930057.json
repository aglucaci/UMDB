{"v":"3.0.0","project":{"accession":"PRJNA930057","title":"Medium-chain fatty acid production from thermal hydrolysed sludge without external electron donor supplementation","description":"medium-chain fatty acid (MCFA) generation from mixed sludge (including primary sludge and waste activated sludge) was investigated without additional electron donors (EDs). Thermal hydrolysis process (THP) as sludge pretreatment increased the MCFA yield by ca. 128% in the anaerobic fermentation. During 102 days of operation, the fermentation of THP pre-treated mixed sludge stably generated 2.87 g COD/L MCFAs. Ethanol addition improved MCFA yield, suggesting that the self-generated EDs were not sufficient for MCFA production. Caproiciproducens was the dominant chain-elongating bacteria. Accordingly, THP-assisted sludge fermentation could be a promising external ED-free biotechnology to recover valuable MCFAs.","organism":null,"data_type":"Raw sequence reads","center_name":"Nanyang Technological University","submission_date":"2023/01/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN32983069","Sludge","2022-07-27",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN32983070","Sludge","2022-08-02",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN32983071","Sludge","2022-08-08",null,null,null,null,null,"uncertain",null,"environmental sample; urban associat