{"v":"3.0.0","project":{"accession":"PRJNA395239","title":"Indoor air viral diversity","description":"Diverse microbial communities inhabit human-occupied buildings and circulate in indoor air; however, little is known about viral diversity in these environments. Here we investigated DNA and RNA viruses circulating in the air of university dormitory rooms (n = 12) by analyzing dust accumulated over a one-year period on heating, ventilation, and air conditioning (HVAC) filters through viral metagenomics. This study significantly expands the known airborne viral diversity found indoors, enabling the design of sensitive and quantitative assays to further investigate specific viruses of interest.","organism":null,"data_type":"Raw sequence reads","center_name":"University of South Florida","submission_date":"2017/07/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN07373705","M1_DNA","2015-06","United States","Colorado","Boulder",40.02,-105.26,"uncertain",null,"environmental sample; urban association not established","HVAC filters",null,null,null,null,"coordinate","US",5574991,"probable","coordinates",null,"USA: Colorado",2015],["SAMN07373706","NegativeControl_DNA","2015-06","United States","Colorado","Boulder",40.02,-105.26,"uncertain",null,"environmental sample; urban association not established","HVAC filters",null,null,null,null,"coordinate","US",5574991,"probable","coordinates",null,"USA: Colorado",2015],["SAMN07373707","M2_DNA","2015-06","United States","Colorado","Boulder",40.02,-105.26,"uncertain",null,"environmental sample; urban association not established","HVAC filters",null,null,null,null,"coordinate","US",5574991,"p