{"v":"3.0.0","project":{"accession":"PRJNA553511","title":"Effects by increasing loading rate on microbial community, the methanogenic pathway and process performance in anaerobic digestion of chicken manure","description":"The anaerobic digestion process is a promising technology for the treatment of chicken manure. However, anaerobic digestion of this protein-rich materials faces process instability issues at high feeding solid concentration due to ammonium accumulation and subsequent inhibition to methanogens, especially acetoclastic methanogens. The uniqueness of our research was to enhance methanogenic performance and metabolic pathways of anaerobic digestion of chicken manure by moderate in situ ammonia stripping through 560 days continuous experiment.","organism":null,"data_type":"Raw sequence reads","center_name":"China Agricultural University","submission_date":"2019/07/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN12236716","Metagenome or environmental sample from sludge metagenome",null,"China","Beijing","Beijing",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","a digester anaerobic treating chicken manure at TS 5%",null,null,null,"Chicken manure digestate","city","CN",1816670,"probable","text","region's main city","China: Beijing",null],["SAMN12236717","Metagenome or environmental sample from sludge metagenome",null,"China","Beijing","Beijing",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","a digester anaerobic treating chicken manure at TS 7.5%",null,null,null,"Chicken manure digestate","city","CN",1816670,"probable","text","region's main