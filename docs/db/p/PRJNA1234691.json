{"v":"3.0.0","project":{"accession":"PRJNA1234691","title":"Kitchen waste composting leachate stimulate endogenous simultaneous nitrifying and denitrifying pathways in WWTP","description":"Kitchen waste composting leachate (CL) is rich in organics with high potential of external carbon source for wastewater treatment plant (WWTP). This study investigated the effect of CL on simultaneous nitrifying and denitrifying accoupling with external carbon source by using sequencing batch reactors (SBRs). It shows that CL greatly promoted the removal rates of N and increased the relative abundance of the denitrification pathway with mixing ratio of no more than 1.5%.","organism":null,"data_type":"Raw sequence reads","center_name":"China Jiliang University","submission_date":"2025/03/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47307605","Metagenome or environmental sample from sludge metagenome","2023-07-12",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","CK SBR_1",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47307606","Metagenome or environmental sample from sludge metagenome","2023-07-12",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","CK SBR_2",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47307607","Metagenome or environmental sample from sludge metagenome","2023-07-26",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","CK SBR_3",null,null,null,null,"unknown",null,nul