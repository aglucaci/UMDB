{"v":"3.0.0","project":{"accession":"PRJNA1236925","title":"Regulation of waste activated sludge fermentation directed towards product spectrum via tailored blending of incompletely oxidizing sulfate-reducing bacteria","description":"The recovery of resources and energy via anaerobic treatment was a key approach for utilizing carbonaceous organics in waste activated sludge (WAS). The employment of incomplete oxidative sulfate-reducing bacteria (io-SRB) could alleviate the thermodynamic constraints of the hydrogen-producing acetogenesis process and enhance WAS fermentation. The impact of various blending strategies of io-SRB on anaerobic fermentation performance, however, remained poorly understood. This study investigated the effects of different blending ratios of io-SRB on the anaerobic fermentation performance of sludge.","organism":null,"data_type":"Raw sequence reads","center_name":"Taiyuan University of Technology","submission_date":"2025/03/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47409363","F_111","2023-01-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Waste activated sludge","unknown",null,null,"unresolved",null,null,null,2023],["SAMN47409365","F_114","2023-01-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Waste activated sludge","unknown",null,null,"unresolved",null,null,null,2023],["SAMN47409367","F_141","2023-01-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,"Waste activated 