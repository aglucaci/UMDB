{"v":"3.0.0","project":{"accession":"PRJNA1114903","title":"Bio-removal of combined pollution of V(V) and Cr(VI) in a continuous flow reactor with straw","description":"Vanadium (V) and chromium (Cr) are the key resources widely used in industrial production, but the mining process may cause V (V) and Cr (VI) pollution in groundwater, seriously endangering human health and ecological environment. Straw is an important by-product in the process of agricultural production. It is considered as waste in China, but it is also a solid carbon source. Therefore, this study used straw as carbon source to explore the feasibility of bioremediation of V (V) and Cr (VI) compound pollution in groundwater.Microbial analysis showed that Bacillus and pseudobacteroides had the ability to reduce V (V) and Cr (VI), Cellulomonas is related to the decomposition of cellulose in straw.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Civil Engineering and Architecture","submission_date":"2024/05/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41502597","I0","2023-07-07",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN41502598","A1-1","2023-07-07",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","reactor samples",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN41502599","A1-2","2023-07-07",null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or indust