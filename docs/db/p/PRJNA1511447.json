{"v":"3.0.0","project":{"accession":"PRJNA1511447","title":"Prokaryotic communities in a two-stage EGSB system treating pig slurry under increasing upflow velocity","description":"This study investigated the effect of upflow velocity on the performance and microbial community dynamics of a pilot-scale two-stage expanded granular sludge bed (EGSB) system treating real pig slurry. Different hydrodynamic conditions were applied while maintaining constant hydraulic retention times to evaluate their influence on reactor performance, biomass retention, granulation, and microbial community structure. Bacterial and archaeal communities were characterized by 16S rRNA gene amplicon sequencing at different operational stages to assess their temporal response to changes in upflow velocity and their differentiation between the hydrolytic/acidogenic and methanogenic reactors.","organism":null,"data_type":"Raw sequence reads","center_name":"Univeristy of Granada","submission_date":"2026/08/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62355527","anaerobic sludge metganome","2025-04-29","Spain","Andalusia","Granada",37.13,-3.76,"uncertain",null,"environmental sample; urban association not established","anaerobic granular sludge from EGSB reactor treating pig slurry",null,null,null,null,"coordinate","ES",2517117,"verified","text+coordinates",null,"Spain: Granada, Chimeneas",2025],["SAMN62355528","anaerobic sludge metganome","2025-04-29","Spain","Andalusia","Granada",37.13,-3.76,"uncertain",null,"environmental sample; urban association not established","anaerobic granular sludge from EGSB reactor treating pig slurry",null,null,null,null,"