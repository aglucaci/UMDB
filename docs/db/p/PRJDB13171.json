{"v":"3.0.0","project":{"accession":"PRJDB13171","title":"Pathogenic bacterial community in a municipal wastewater treatment plant","description":"In this study, we focused on tracking quantitative fluctuation of bacterial pathogens in a municipal wastewater treatment plant. Pathogenic microbes were identified according to their risk level (Biosafety level) based on 16S rRNA gene amplicon sequencing with reference to a novel constructed database. Absolute quantities of pathogenic and non-pathogenic bacteria were obtained incorporating internal standards in gene sequencing. Even though the pathogenic bacteria were gradually decreased along the wastewater treatment process, some moderately risk pathogens (Biosafety level 2) were reluctant to removal at effluent. Hence, tracking of pathogenic microbes in wastewater treatment plant contribute to optimization of treatment process and risk assessment of effluent reuse and discharge. This will provide insights into pathogen dynamics and ecology in the environment.","organism":"wastewater metagenome","data_type":"Other","center_name":"Faculty of Geosciences and Civil Engineering, Kanazawa university","submission_date":"2023/03/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00446197","INF_1","2019-12-04","Japan",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,"Wastewater","Influent_1","wastewater",null,"country","JP",null,"unresolved",null,null,"Japan",2019],["SAMD00446198","PST_1","2019-12-04","Japan",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,"Wa