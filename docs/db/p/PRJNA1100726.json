{"v":"3.0.0","project":{"accession":"PRJNA1100726","title":"Insight into the Impact of Air Flow Rate on Algal-Bacterial Granules","description":"Algal-bacterial granules have been drawing attention in wastewater treatment due to their rapid settling ability and efficient nutrient removal performance. This study evaluated the impact of air flow rates on nitrogen removal and the formation of algal-bacterial granules in domestic wastewater treatment. The findings suggest that the lower air flow rate is the optimal choice, as it resulted in similar nutrient removal performance and granular properties, while significantly reducing energy costs. Moreover, the study highlights the importance of understanding the interplay between operational conditions, microbial community dynamics, and granular properties to optimize these systems' performance and stability.","organism":null,"data_type":"Raw sequence reads","center_name":"Penn State University","submission_date":"2024/04/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40976878","MIMS Environmental/Metagenome sample from wastewater metagenome","2021-09-25","United States",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,"ENVO:01000020","ENVO:00000468","ENVO:00002160",null,"country","US",null,"unresolved",null,null,"USA",2021],["SAMN40976879","MIMS Environmental/Metagenome sample from wastewater metagenome","2021-10-25","United States",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,"ENVO:01000020","ENVO:00000468","ENVO:00002160",null,"country","US",null,"unresolved",null,null,"U