{"v":"3.0.0","project":{"accession":"PRJNA1131961","title":"Microbial diveristy in microalgae bacteria consortia (MBC) and microalgae consortia (MC)","description":"The goal is to investigate the microbial diversity in MBC and MC. The MBC were cultivated with primary treated wastewater in an indoor reactor (reactor X). The MC were cultivated with final treated wastewater in an indoor reactor (reactor Y). The MBC and MC were cultivated with fluidised carrier (polyurethane foam). The MBC in the culture of reactor X and the MC in the culture of reactor Y are denoted as the suspended MBC (SMBC) and suspended MC (SMC), respectively. The MBC on the carrier of reactor X and MC on the carrier of reactor Y are denoted as the attached MBC (AMBC) and attached MC (AMC), respectively. The reactor X and Y had three runs, respectively (X1, X2 and X3 and Y1, Y2 and Y3). The carrier replacement ratio and culture replacement ratio in X1 and Y1 were 0.04 d-1 and 0.53 d-1, respectively. Those in X2 and Y2 were 0.1 d-1 and 0.53 d-1, respectively. Those in X3 and Y3 were 0.04 d-1 and 0.95 d-1, respectively.","organism":null,"data_type":"Raw sequence reads","center_name":"Tottori University","submission_date":"2024/07/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN42327714","Metagenome or environmental sample from wastewater metagenome","2022-09-03","Japan","Tottori","Tottori-shi",35.51,134.21,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","Domestic wastewater treatment plant",null,null,null,"Primary treated wastewater","coordinate","JP",1849892,"verified","text+coordinates",null,"Japan: Tottori",2022],["S