{"v":"3.0.0","project":{"accession":"PRJNA1045543","title":"Long-term Effects of Nickel Oxide Nanoparticles on the Physicochemical Properties and Microbial Metabolism of Activated Sludge","description":"In order to reveal the biotoxicity of nickel oxide nanoparticles in complex environmental systems, this study used activated sludge as the research target and investigated the long-term effects of NiO NPs on the operational efficacy of a sequencing batch reactor, sludge performance, and microbial metabolism. Results indicated that low concentrations of NiO NPs did not have significant effects on activated sludge operational efficacy, and high concentrations of NiO NPs significantly inhibited the removal of ammonia nitrogen and COD.","organism":null,"data_type":"Raw sequence reads","center_name":"Xi'an University of Architecture and Technology","submission_date":"2023/11/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38446833","Metagenome or environmental sample from sludge metagenome","2021-01-22","China","Shaanxi","Xi’an",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","avtive sludge",null,null,null,null,"city","CN",1790630,"probable","text-population","largest of 5 places named 'Xian'","China: Xian",2021],["SAMN38446834","Metagenome or environmental sample from sludge metagenome","2021-01-22","China","Shaanxi","Xi’an",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","avtive sludge",null,null,null,null,"city","CN",1790630,"probable","text-population","largest of 5 places named 'Xian'","China: Xian",2021],["SAMN