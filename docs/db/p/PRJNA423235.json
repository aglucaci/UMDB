{"v":"3.0.0","project":{"accession":"PRJNA423235","title":"Sand and wastewater samples Raw sequence reads","description":"The samples were collected from four rapid sand filters inside drinking water treatment plants used for biological filtration of groundwater in Denmark and from the nitrifying and annamox reactors of wastewater treatment plants in Denmark and southern Sweden.These samples were utilized for identifying AOB and Nitrospira using the amoA and nxrB genes and for the total bacterial community by universal 16S rRNA gene.The aim of the study was to assess if universal 16S rRNA gene-based amplicon sequencing of environmental communities provide an accurate description of nitrifying guilds?","organism":"uncultured prokaryote","data_type":"Raw sequence reads","center_name":"Technical University of Denmark","submission_date":"2017/12/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN08213475","Bacterial sample from rapid sand filter sand and wastewater samples","2015/2016","Denmark",null,null,null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Sand or activated sludge",null,null,null,null,"city","DK",null,"unresolved",null,null,"Denmark: Sweden",2015]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","release_date","spots","bases","avg_length","size_mb","scientific_name","urban_status","experiment_title"],"runs":[["SRR6399270",0,"SRX3492510","16S","AMPLICON","METAGENOMIC","PCR","PAIRED","ILLUMINA","Illumina MiSeq","2017-12-20 22:00:33",62314,37327459,5