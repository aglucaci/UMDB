{"v":"3.0.0","project":{"accession":"PRJNA687334","title":"Plant-parasitic nematode field sampling","description":"Plant-parasitic nematodes cause damage to agriculture occur in soils and roots globally. Several species possess microbial associations, including endosymbionts. This study examined symbionts in field-collected nematodes from several U.S. states. Nematodes were extracted from roots and soils as bulk communities and community DNA was sequenced with Illumina HiSeq/NovaSeq, and nematode and symbiont genomes were assembled and analyzed.","organism":null,"data_type":"Raw sequence reads","center_name":"Texas Tech University","submission_date":"2020/12/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN17141339","Metagenome or environmental sample from invertebrate metagenome","2018-05-25","United States","Texas","Sonora",30.566601,-100.6437,"uncertain",null,"conflicting evidence: environmental and host/clinical","roadside",null,null,null,"wild plants","coordinate","US",5531255,"verified","text+coordinates",null,"USA: Sonora, Texas",2018],["SAMN17141340","Metagenome or environmental sample from invertebrate metagenome","2018-05-25","United States","Texas","Los Fresnos",26.132554,-97.473898,"uncertain",null,"conflicting evidence: environmental and host/clinical","roadside",null,null,null,"wild plants","coordinate","US",4707932,"verified","text+coordinates",null,"USA: Los Fresnos, Texas",2018],["SAMN17141341","Metagenome or environmental sample from invertebrate metagenome","2018-05-25","United States","Texas","Houston",29.662474,-95.376874,"uncertain",null,"conflicting evidence: environmental and host/clinical","roadside