{"v":"3.0.0","project":{"accession":"PRJNA1378357","title":"A novel approach for achieving ultra-high enrichment of anaerobic ammonium oxidizing bacteria and nitrogen removal rate in municipal wastewater treatment: A pure biofilm process without suspended sludge","description":"This study aimed to assess the potential of the pure biofilm process without suspended sludge to achieve deep nitrogen removal and AnAOB enrichment in municipal wastewater; quantify the stability of the pure biofilm system under organic load shock and its N2O emission characteristics; explore mechanisms of AnAOB self-enrichment and microbial synergy in the pure biofilm system through FISH CLAM, 16S rRNA sequencing, and metagenomic sequencing analysis. Ultimately, this study offers valuable insights to guide the practical implementation of pure biofilm systems in wastewater treatment engineering.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2025/12/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN53833605","Metagenome or environmental sample from sludge metagenome","2024-03-10","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","active sludge",null,null,null,null,"city","CN",1816670,"probable","text","region's main city","China:Beijing",2024],["SAMN53833606","Metagenome or environmental sample from sludge metagenome","2024-04-11","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","active sludge",null,null,null,null,"ci