{"v":"3.0.0","project":{"accession":"PRJNA1541073","title":"Integrated domestic wastewater treatment and resource recovery using a microalgal-bacterial consortium in a membrane-assisted photobioreactor system","description":"This project evaluated an innovative membrane-assisted photobioreactor (MAPB) system inoculated with an enriched microalgal-bacterial consortium, achieving efficacious wastewater treatment and biomass generation. The harvested biomass was characterized to evaluate its lipid profile for biodiesel potential, extracellular polymeric substances (EPS) composition, and biostimulant properties. This BioProject provides whole-metagenome sequencing datasets collected at multiple treatment time-points to monitor the community dynamics of the microalgae-dominated consortium during the photobioreactor operation.","organism":null,"data_type":"Raw sequence reads","center_name":"Gujarat Biotechnology University","submission_date":"2026/10/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN64049186","Untreated domestic wastewater","2025-10-09","India","Gujarat","Gandhinagar",23.1684,72.6743,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"Wastewater treatment plant (ENVO:00002043)","Sewage (ENVO:00002018)","Sewage (ENVO:00002018)",null,"coordinate","IN",1271715,"verified","text+coordinates",null,"India: Gujarat, Gandinagar",2025],["SAMN64049188","Microalgal-bacterial community in photobioreactor (Day 5)","2025-10-15","India","Gujarat","Gandhinagar",23.1684,72.6743,"non_environmental",null,"laboratory or culture material",null,"Laboratory facility (ENVO:01001406)","Photobioreacto