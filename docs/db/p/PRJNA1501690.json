{"v":"3.0.0","project":{"accession":"PRJNA1501690","title":"A hybridization capture-based workflow for enhanced viral sequencing from wastewater","description":"Wastewater surveillance has become an essential approach for monitoring viruses in communities. Nevertheless, viral sequencing from wastewater remains challenging due to the low concentration and abundance of viruses, which constrains the performance of current methods. In this study, we developed a hybridization capture-based workflow to enhance viral sequencing from wastewater. By comparing different pretreatment strategies, we found that elevating viral abundance is critical for achieving sufficient coverage and depth. The optimized workflow effectively addresses low nucleic acid input and demonstrates reliable sequencing performance across a range of viruses. This work offers an efficient and robust technical solution to support genomic surveillance of viruses in wastewater.","organism":null,"data_type":"Raw sequence reads","center_name":"Tsinghua university","submission_date":"2026/07/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61955461","DC-Control","2024-02-07","China","Beijing","Beijing",39.91,116.39,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","influent wastewater",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2024],["SAMN61955462","DC-Dnase","2024-02-07","China","Beijing","Beijing",39.91,116.39,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","influent wastewater",null,null,null,null,"coordinate","CN",1816