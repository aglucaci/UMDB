{"v":"2.0.0","project":{"accession":"PRJNA1233187","title":"Wastewater Metagenome","description":"Monitoring antimicrobial resistance genes (ARGs) in wastewater influent (pre-treatment) and effluent (post-treatment) reveals their circulation in communities via wastewater surveillance (WS), possible amplification during treatment, and potential public health risks from gene releases into surface water. This study used Oxford Nanopore (ONP) metagenomic sequencing to track ARGs in wastewater treatment plants (WWTPs) influents and effluents in Mekjarvik (Norway), Reykjavik (Iceland), and Mariehamn (Aland-Finland).","organism":"wastewater metagenome","data_type":"Metagenome","center_name":"NORCE (Norwegian Research Centre )","submission_date":"2025/03/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution"],"samples":[["SAMN47450835","MIMS Environmental/Metagenome sample from metagenome","2023-05-30","Norway",null,"Mekjarvik",59.02025872,5.61757402,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Waste Water [ENVO:00002001]","Waste Water [ENVO:00002001]","Waste Water [ENVO:00002001]",null,"coordinate"],["SAMN47450836","MIMS Environmental/Metagenome sample from metagenome","2023-06-14","Norway",null,"Mekjarvik",59.02025872,5.61757402,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Waste Water [ENVO:00002001]","Waste Water [ENVO:00002001]","Waste Water [ENVO:00002001]",null,"coordinate"],["SAMN47450837","MIMS Environmental/Metagenome sample from metagenome","2024-07-13","Norway",null,"Mekjarvik",59.02025872,5.61757402,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"Waste Water [ENVO:00002001]","Waste Water [