{"v":"3.0.0","project":{"accession":"PRJNA1013332","title":"Scalp microbiome study","description":"Aim of the present study was to compare the scalp microbiomes of healthy volunteers with normal or oily scalp. In the context of this study, oily scalp was defined as a Sebumeter value higher than 120 micrograms per square centimeter, normal scalp was defined as a Sebumeter value between 60 and 120 micrograms per square centimeter. The study participants were 19-66 years old, male or female, healthy, and of different ethnic backgrounds. Recruitment and sampling of study participants were conducted in August 2018 by BASF at the Tarrytown Consumer Testing Center (Tarrytown, NY, U.S.A).","organism":null,"data_type":"Raw sequence reads","center_name":"BASF Metabolome Solutions GmbH","submission_date":"2023/09/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37295755","MIMS Environmental/Metagenome sample from human skin metagenome","2018-08","United States","New York","The Bronx",41.06,-73.84,"non_environmental",null,"host-derived or clinical material",null,"skin environment","scalp","skin swab","Homo sapiens","coordinate","US",5110266,"probable","coordinates",null,"USA: New York metropolitan area",2018],["SAMN37295756","MIMS Environmental/Metagenome sample from human skin metagenome","2018-08","United States","New York","The Bronx",41.06,-73.84,"non_environmental",null,"host-derived or clinical material",null,"skin environment","scalp","skin swab","Homo sapiens","coordinate","US",5110266,"probable","coordinates",null,"USA: New York metropolitan area",2018],["SAMN37295758","MIMS Environmental/Metagenome sample from human skin meta