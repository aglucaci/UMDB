{"v":"3.0.0","project":{"accession":"PRJNA407631","title":"16S Amplicon Analysis of Microbial Communities in Laboratory-Scale, Temperature-Phased Biogas Reactors","description":"This study examined the microbial communities in laboratory-scale biogas reactors digesting food waste in a temperature-phased digestion system consisting of a thermophilic, hydrolysis phase followed by a mesophilic, methanogenic phase. The effect of 2 factors were examined: 1) temperature (either 55 or 65°C) in the hydrolysis phase and 2) lowered hydraulic retention time in the methanogenic phase. This dataset consists of 16S amplicon data that was obtained at several timepoints during steady-state operation of the reactors, and it includes matched metadata such as pH, chemical oxygen demand, volatile fatty acid and ammonium concentrations, alkalinity, volatile solids, and biogas production.","organism":"biogas fermenter metagenome","data_type":"Targeted loci environmental","center_name":"NMBU","submission_date":"2017/09/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN07691008","Mesophilic Digestion System 1 Timepoint 1 (day 112)","2015-06-23","Norway","Akershus","Ås",59.66226,10.75111,"non_environmental",null,"laboratory or culture material",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge",null,"coordinate","NO",3162797,"verified","text+coordinates",null,"Norway: As",2015],["SAMN07691009","Mesophilic Digestion System 1 Timepoint 2 (day 116)","2015-06-27","Norway","Akershus","Ås",59.66226,10.75111,"non_environmental",null,"laboratory or culture material",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge"