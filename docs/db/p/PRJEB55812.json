{"v":"3.0.0","project":{"accession":"PRJEB55812","title":"Metagenomic shotgun sequencing of Exhaust Air Dust","description":"Metagenomic next-generation sequencing analysis was performed on nucleic acids isolated from EAD filters collecting air from: (1) cages with mice housed in a non-pathogen free facility; (2) cages with clean chow and bedding from the same facility; (3) cages housing mice from a specific-pathogen free (SPF) facility.  mNGS results revealed correspondence between microbiome composition from fecal pellets and filter, including pathogenic bacteria, intestinal protozoa, nematoda and eukaryotic parasites present in the colony. All filters revealed also the presence of plant microbiome due to dust derived from chow and bedding. Surprisingly, however, control filter exhibited the presence of mouse pathogens, despite the absence of mice, suggesting that contaminated connecting pipes could be responsible for this unexpected result. Conversely, the filter from SPF colony revealed the absence of pathogens.","organism":null,"data_type":"Other","center_name":"UNIVERSITA' DEGLI STUDI DI FERRARA","submission_date":"2022/12/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA111326210",null,null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA111326211",null,null,null,null,null,null,null,"non_environmental",null,"host-derived or clinical material",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA111326212",null,null,null,null,null,null,null,"non_environmental",nu