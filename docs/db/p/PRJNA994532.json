{"v":"3.0.0","project":{"accession":"PRJNA994532","title":"Interactive effects of herbivory, nutrient enrichment, and temperature on coral reefs and their microbiomes in Moorea, French Polynesia","description":"This is the public repository for any sequencing data generated under NSF award OCE-2023424 granted to Deron E. Burkepile, Rebecca Vega Thurber, and Thomas C. Adam. This project is a long term factorial time series experiment on the Moorea, French Polynesia north shore, ongoing since July 2018. The project investigates the interactive effects of nutrient enrichment, herbivore and corallivore exclusion, and temperature on coral holobionts and benthic communities for both intact and initially disturbed communities. The project also investigates a recovery period from nutrient enrichment, which started in July 2022.","organism":null,"data_type":"Raw sequence reads","center_name":"Oregon State University","submission_date":"2023/07/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN36436801","MIMARKS Survey related sample from indoor metagenome","2021-05","United States","Oregon","Corvallis",44.566306,-123.282944,"probable_urban","built_environment","city-level location without sample-site confirmation",null,"Research Laboratory","Reagent control","PCR water",null,"coordinate","US",5720727,"verified","text+coordinates",null,"USA: Oregon State University, Corvallis, Oregon",2021],["SAMN36436802","MIMARKS Survey related sample from indoor metagenome","2021-05","United States","Oregon","Corvallis",44.566306,-123.282944,"probable_urban","built_environment","city-level location without sample-site confirmation",null,"Research L