{"v":"3.0.0","project":{"accession":"PRJNA1370619","title":"Study on Full-Scale Anaerobic Ammonia Oxidation Biofilm Process for Treating Kitchen Wastewater from Biogas Digestion","description":"In this study, partial nitritation/anammox (PN/A) based on biofilm was implemented to treat 120 t/d of food waste biogas slurry (FWBS). We evaluated the nitrogen removal contributions of individual biochemical units and analyzed pollutant degradation dynamics along with microbial community structure in key reactor zones. These analyses illustrate how the pre-treatment stage and biofilm carriers jointly support the growth and retention of Anammox bacteria. The findings provide an engineering strategy for effective enrichment of Anammox bacteria in FWBS treatment.","organism":null,"data_type":"Raw sequence reads","center_name":"Research and Development Center of Beijing Drainage Group Ltd.","submission_date":"2025/11/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN53474070","sludge","2025-07-28","China","Sichuan","Chengdu",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anammox tank biofilm sample",null,null,null,null,"city","CN",1815286,"verified","text",null,"China: Chengdu",2025],["SAMN53474071","sludge","2025-07-28","China","Sichuan","Chengdu",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Anammox tank end suspended sample",null,null,null,null,"city","CN",1815286,"verified","text",null,"China: Chengdu",2025],["SAMN53474072","sludge","2025-07-28","China","Sichuan","Chengdu",null,null,"probable_urban","municipal_waste