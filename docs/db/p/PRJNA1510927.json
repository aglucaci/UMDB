{"v":"3.0.0","project":{"accession":"PRJNA1510927","title":"Differentiation of bacterial communities in shallow lake water and sediment during the frozen period: evidence from co-occurrence networks and community assembly","description":"This study focused on the water bodies and sediments of the frozen Yaluosui Lake. Based on 16S rRNA gene amplicon sequencing, combined with community diversity, co-occurrence networks, niche width, community assembly models, and environmental correlation analysis, it conducted an in-depth comparative analysis of the composition, diversity, network structure, assembly process, and environmental factor correlation mechanisms of the bacterial communities in these two habitats.","organism":null,"data_type":"Raw sequence reads","center_name":"Inner Mongolia Agricultural University","submission_date":"2026/08/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62343047","Metagenome or environmental sample from sludge metagenome","2024-01","China",null,null,40.0,108.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","surficial sludge",null,null,null,"sludge","coordinate","CN",null,"unresolved",null,null,"China: Wulianshui Lake",2024],["SAMN62343048","Metagenome or environmental sample from sludge metagenome","2024-01","China",null,null,40.0,108.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","surficial sludge",null,null,null,"sludge","coordinate","CN",null,"unresolved",null,null,"China: Wulianshui Lake",2024],["SAMN62343049","Metagenome or environmental sample from sludge metagenome","2024-01","China",null,