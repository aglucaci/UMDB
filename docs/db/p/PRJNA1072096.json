{"v":"3.0.0","project":{"accession":"PRJNA1072096","title":"Community Response to Hydrocarbon Pollution in Iron Oxide Mats: An Environmental Study","description":"Hydrocarbon pollution is a widespread issue in both groundwater and surface-water systems; however, research on remediation at the interface of these two systems is limited. This interface is the oxic-anoxic boundary, where hydrocarbon pollution from contaminated groundwaters flows into surface waters and where iron mats are formed by microaerophilic iron-oxidizing bacteria. Iron mats are highly chemically adsorptive and host a diverse community of microbes. They may be capable of remediating hydrocarbons before they disseminate. To elucidate whether the microbial community in iron mats has the potential to remove hydrocarbons and how the community responds to contaminant exposure, we sampled from both unexposed and exposed mats and conducted 16S amplicon sequencing of these samples. Ultimately, these results will help us better understand the impacts of hydrocarbon pollution on iron mat communities at the oxic-anoxic interface.","organism":null,"data_type":"Raw sequence reads","center_name":"East Carolina University","submission_date":"2024/02/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN39732271","Downstream_mat1_March1","2018-03-06","United States","North Carolina","Greenville",35.61402505,-77.36829212,"uncertain",null,"environmental sample; urban association not established","iron oxide mat",null,null,null,null,"coordinate","US",4469160,"verified","text+coordinates",null,"USA:North Carolina, Greenville, Town Creek",2018],["SAMN39732272","Downstream_mat2_Ma