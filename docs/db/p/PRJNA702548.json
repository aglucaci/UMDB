{"v":"3.0.0","project":{"accession":"PRJNA702548","title":"Enhanced pilot bioremediation of oily sludge from petroleum refinery disposal under hot-summer Mediterranean climate","description":"Bioremediation approaches were implemented for the treatments of oily sludge characterized by alkaline pH and high concentration of metals from a Tunisian petroleum refinery. The treatments included bioaugmentation and biostimulation approaches with autochthonous isolated bacterial strains and consortia. Chemical, microbial and toxicological analyses were performed during 180 days incubation. Total Petroleum Hydrocarbons ranging between and heavy metals were quantified, microbial communities characterized by 16S rRNA metabarcoding, and ecotoxicity assessed by the wheat germination index.","organism":null,"data_type":"Raw sequence reads","center_name":"Universite de Pau et des Pays de l'Adour","submission_date":"2021/02/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN17974998","Metagenome or environmental sample from sludge metagenome",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN17974999","Metagenome or environmental sample from sludge metagenome",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN17975000","Metagenome or environmental sample from sludge metagenome",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not