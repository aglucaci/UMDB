{"v":"3.0.0","project":{"accession":"PRJNA1482763","title":"Metagenomic and metatranscriptomic profiling of partial nitritation reactors under different ammonia-based F/M ratios","description":"This BioProject contains raw metagenomic and metatranscriptomic sequencing reads from sludge samples collected from partial nitritation reactors operated under different ammonia-based food-to-microorganism (F/M) ratios. The reactors were operated with comparable partial nitritation performance but different MLSS-normalized ammonium loading regimes. These raw sequencing data were generated to support microbial community, functional potential and transcriptional activity analyses associated with reactor-state differences under comparable partial nitritation performance.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2026/06/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61134638","Metagenome or environmental sample from sludge metagenome","2025-06-20","China","Shanghai","Shanghai",31.26,121.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2025],["SAMN61134639","Metagenome or environmental sample from sludge metagenome","2025-06-20","China","Shanghai","Shanghai",31.26,121.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2025],["SAMN61134640","Metagenome or environmental sample fr