{"v":"3.0.0","project":{"accession":"PRJNA745491","title":"The Occurrence and Diversity of Antibiotic Resistance and Virulence Factor Genes in Wastewater from Four North American Treatment Plants","description":"The spread of antibiotic resistance in aquatic environments is an emerging environmental issue due to potential threats to public health. Wastewater treatment plants (WWTPs) could serve as a sink for removal of antibiotic-resistant bacteria (ARB), antibiotic resistance genes (ARGs), and virulence factor genes (VFGs) from wastewater before discharge to the environment, or an amplifier because the stress conditions prevailing in sewage treatment processes may favor the proliferation of ARB, ARGs, and VFGs. In this study, we performed metagenomic sequencing and analyses to examine the diversity of microbial communities and the fate of ARGs, antibiotic biosynthesis genes (ABSGs) and VFGs in sixteen (16) sewage samples collected from four large WWTPs located at two major metropolitan centers on east and west coast of U.S.","organism":null,"data_type":"Raw sequence reads","center_name":"University of California, Irvine","submission_date":"2021/07/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN20086346","A1-1_Primary Effluent_OC","2018-05","United States","California","Orange",33.69,-117.94,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","wastewater",null,null,null,null,"coordinate","US",5379513,"verified","text+coordinates",null,"USA: California, Orange County",2018],["SAMN20086347","A1-2_Biofilm_OC","2018-05","United States","California","Orange",33.69,-117.94,"probable_urban","m