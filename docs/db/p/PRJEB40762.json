{"v":"3.0.0","project":{"accession":"PRJEB40762","title":"16S rRNA amplicon sequencing from the Ocean Sampling Day (OSD) campaign June 2019","description":"Ocean Sampling Day was initiated by the EU-funded Micro B3 (Marine Microbial Biodiversity, Bioinformatics, Biotechnology) project to obtain a snapshot of the marine microbial biodiversity and function of the world’s oceans. It is a simultaneous global mega-sequencing campaign aiming to generate the largest standardized microbial data set in a single day. This will be achievable only through the coordinated efforts of an Ocean Sampling Day Consortium, supportive partnerships and networks between sites. The OSD2019 event is a continuation of the successful OSD events of Micro B3 project (https://www.microb3.eu/osd.html).","organism":null,"data_type":"Other","center_name":"German Federation for Biological Data","submission_date":"2021/10/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA7422946","OSD223_2019-06_1_NPL022",null,null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA7422958","OSD159_2019-06_1_NPL022",null,null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA7422963","OSD99_2019-06_1_NPL022",null,null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA7422970","OSD70_2019-06_1_NPL022",null,null,null,null,null,nul