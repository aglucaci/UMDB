{"v":"3.0.0","project":{"accession":"PRJNA1081853","title":"Microbial community of freshwater crustacean when fed with wastewater algal consortium","description":"The goal of this study was to test the potential of feeding small freshwater crustaceans with algal consortium from wastewater. Freshwater crustaceans are the prey of fish in the natural environment, so they can potentially be an important gradient as sustainable fish feed to fulfill the increasing demand for aquacultural products. This project was to understand what types of algae were consumed by crustaceans in a lab condition using microbial community analysis.","organism":null,"data_type":"Raw sequence reads","center_name":"Auburn University","submission_date":"2024/02/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40189307","MIMARKS Survey related sample from freshwater metagenome","2023-08-14","United States","Alabama","Auburn",32.55,-85.45,"non_environmental",null,"laboratory or culture material",null,"Aquatic biome [ENVO:00002030]","Aerobic bioreactor [ENVO:00002126]","Freshwater Lake [ENVO 00000021]",null,"coordinate","US",4830796,"verified","text+coordinates",null,"USA: Alabama, Auburn",2023],["SAMN40189308","MIMARKS Survey related sample from freshwater metagenome","2023-08-14","United States","Alabama","Auburn",32.55,-85.45,"non_environmental",null,"laboratory or culture material",null,"Aquatic biome [ENVO:00002030]","Aerobic bioreactor [ENVO:00002126]","Freshwater Lake [ENVO 00000021]",null,"coordinate","US",4830796,"verified","text+coordinates",null,"USA: Alabama, Auburn",2023],["SAMN40189309","MIMARKS Survey related sample from freshwater metageno