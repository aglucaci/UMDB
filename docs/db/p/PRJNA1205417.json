{"v":"3.0.0","project":{"accession":"PRJNA1205417","title":"Enhancing Concurrent Production of Volatile Fatty Acids and Phosphorus Minerals from Waste Activated Sludge via Magnesium Ferrate Pre-Oxidation","description":"This study investigated the strategy of magnesium ferrate (MF) pre-oxidation to enhance acidogenic fermentation of waste activated sludge (WAS), targeting the simultaneous production of volatile fatty acids (VFAs) and phosphorus-minerals (struvite and vivianite). Investigation reveals that the MF pre-oxidation raised the pH, enhanced key hydrolases activity, enriched acidogens and iron-reducing bacteria for driving the concurrent production of VFAs and phosphorus-minerals (struvite and vivianite). A schematic illustration was proposed to reveal the underlying mechanisms related to biotransformation enhancement of VFAs and formations of struvite and vivianite via WAS acidogenic fermentation by MF pre-oxidation. This study provided an effective strategy for realizing concurrent production of high-purity VFAs along with struvite and vivianite from WAS.","organism":null,"data_type":"Raw sequence reads","center_name":"Dongguan University of Technology","submission_date":"2025/01/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46049089","Metagenome or environmental sample from sludge metagenome","2024-05-10","China","Guangdong","Dongguan",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"city","CN",1812545,"probable","text-population","largest of 6 places named 'Dongguan'","China:Dongguan",2024],["SAMN46049090","Metagenome or environ