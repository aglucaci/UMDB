{"v":"3.0.0","project":{"accession":"PRJNA1480072","title":"Seasonal microbial community and metagenomic functional potential in urban rivers of Changzhou, China","description":"This project investigated seasonal and habitat-related variations in microbial communities and metagenomic functional potential in urban river ecosystems in Zhonglou District, Changzhou, China. Water and sediment samples were collected from four urban river sites during winter and summer. Bacterial 16S rDNA amplicon sequencing, fungal ITS amplicon sequencing, and shotgun metagenomic sequencing were performed to characterize bacterial and fungal community composition and to explore functional genes associated with biogeochemical cycling and environmental adaptation in urban river environments.","organism":null,"data_type":"Raw sequence reads","center_name":"Jiangsu University of Technology","submission_date":"2026/06/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61011602","Urban river water sample HLBWA_Winter","2024-12","China","Jiangsu","Changzhou",31.760613,119.904164,"confirmed_urban","water_drainage","explicit urban setting at sample level","urban river water",null,null,null,null,"coordinate","CN",1815456,"verified","text+coordinates",null,"China: Jiangsu, Changzhou",2024],["SAMN61011603","Urban river water sample HLBWB_Winter","2024-12","China","Jiangsu","Changzhou",31.760613,119.904164,"confirmed_urban","water_drainage","explicit urban setting at sample level","urban river water",null,null,null,null,"coordinate","CN",1815456,"verified","text+coordinates",null,"China: Jiangsu, Changzhou",2024],["SAMN61011604","Urban river water sample HLBWC_