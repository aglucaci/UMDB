{"v":"3.0.0","project":{"accession":"PRJNA1302381","title":"Viral and Prokaryotic Communities under Stresses Raw sequence reads","description":"This study aims to explore the adaptive strategies of microbial and viral communities in real environmental samples under different environmental stressors. Representative environmental samples were selected and analyzed under various stress gradients. By extracting DNA and RNA from the samples, metagenomic and metatranscriptomic sequencing technologies were employed to comprehensively understand the genomic and transcriptomic dynamics of microbes and viruses under stress. The study also focuses on the interactions between microbial and viral communities, investigating how viruses influence host gene expression and participate in the adaptation of microbial communities under stress.","organism":"solid waste metagenome","data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2025/08/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50475656","Metagenome or environmental sample from solid waste metagenome","2024-01-05","China","Zhejiang",null,29.88,119.89,"confirmed_urban",null,"explicit urban setting at sample level","Municipal organic solid waste",null,null,null,"environment","coordinate","CN",null,"unresolved",null,null,"China:Zhejiang",2024],["SAMN50475657","Metagenome or environmental sample from solid waste metagenome","2024-01-05","China","Zhejiang",null,29.89,119.89,"confirmed_urban",null,"explicit urban setting at sample level","Municipal organic solid waste",null,null,null,"environment","coordinate","CN",null,"unresolved",null,null,"China:Zhejian