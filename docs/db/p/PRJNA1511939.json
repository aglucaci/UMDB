{"v":"3.0.0","project":{"accession":"PRJNA1511939","title":"Broiler barn dust metagenome","description":"This study investigated the microbial composition, functional potential, and antimicrobial resistance profiles of dust collected from commercial broiler chicken barns in Canada using shotgun metagenomic sequencing. Dust samples were collected from six commercial broiler farms located in Alberta and Quebec at multiple time points during the production cycle. Metagenomic sequencing was used to characterize bacterial, archaeal, fungal, viral, and bacteriophage communities and to examine antimicrobial resistance genes and microbial functional pathways. The study aimed to evaluate broiler barn dust as a non-invasive, population-level environmental sampling matrix for monitoring microbial communities and antimicrobial resistance within commercial poultry production systems. The resulting dataset provides information on the diversity and variation of the broiler barn dust microbiome across farms, provinces, and stages of production.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Calgary","submission_date":"2026/08/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62369934","Broiler barn dust metagenome F1W1D","2025-03-10","Canada","Alberta",null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source","broiler barn dust drinker line swab",null,null,null,null,"region","CA",null,"unresolved",null,null,"Canada: Alberta",2025],["SAMN62369935","Broiler barn dust metagenome F1W1F","2025-03-10","Canada","Alberta",null,null,null,"non_urban",null,"BioProject indicates an agric