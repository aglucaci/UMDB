{"v":"3.0.0","project":{"accession":"PRJNA1466314","title":"Laboratory scale studies of microbial diversity on anaerobic sludge","description":"This study investigated sulfur-driven dissimilatory nitrate reduction to ammonium in a continuous-flow reactor under different S/N ratios. Reactor performance, batch experiments, isotope tracing, and metagenomic analyses were used to characterize nitrogen and sulfur transformation pathways and microbial functional traits. The study focused on ammonium assimilation occurring simultaneously with nitrate reduction, which may underestimate ammonium production in sulfur-driven nitrate reduction systems. These findings improve understanding of microbial nitrogen retention and sulfur cycling in autotrophic wastewater treatment processes.","organism":null,"data_type":"Raw sequence reads","center_name":"Shandong University","submission_date":"2026/05/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60054094","Metagenome or environmental sample from wastewater metagenome","2022-03-14","China","Shandong","Qingdao",36.361416,120.688263,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sulfur-driven DNRA reactor sludge",null,null,null,null,"coordinate","CN",1797929,"verified","text+coordinates",null,"China: Shandong, Qingdao",2022],["SAMN60054095","Metagenome or environmental sample from wastewater metagenome","2022-04-28","China","Shandong","Qingdao",36.361416,120.688263,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sulfur-driven DNRA reactor sludge",null,null,null,null,"coordinate","CN",1797929,"ver