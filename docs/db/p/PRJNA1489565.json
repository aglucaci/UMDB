{"v":"3.0.0","project":{"accession":"PRJNA1489565","title":"Cultivation of Small Granular Flocs and formation of densified activated sludge in a Sequencing Batch Reactor","description":"Efficient simultaneous nitrification, denitrification, and phosphorus removal typically requires either separate tanks with oxic and anoxic conditions or aerobic granular sludge (AGS) with granules larger than 0.2 mm. This study shows that efficient simultaneous nutrient removal is not strictly dependent on large granular structures. Achieving DAS and HN-AD offer a scalable approach for intensifying biological nutrient removal while reducing reliance on distinct anoxic zones.","organism":null,"data_type":"Raw sequence reads","center_name":"Toronto Metropolitan University","submission_date":"2026/07/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61405664","Metagenome or environmental sample from wastewater metagenome","2025-01","Canada","Ontario","Toronto",43.65891,-79.38083,"non_environmental",null,"laboratory or culture material","Bioreactor",null,null,null,"Environmental","coordinate","CA",6167865,"verified","text+coordinates",null,"Canada: Toronto",2025],["SAMN61405665","Metagenome or environmental sample from wastewater metagenome","2025-04","Canada","Ontario","Toronto",43.65891,-79.38083,"non_environmental",null,"laboratory or culture material","Bioreactor",null,null,null,"Environmental","coordinate","CA",6167865,"verified","text+coordinates",null,"Canada: Toronto",2025]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","r