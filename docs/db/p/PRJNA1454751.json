{"v":"3.0.0","project":{"accession":"PRJNA1454751","title":"Metagenomic analysis of biomass-retention states in sidestream partial nitritation reactors","description":"This project contains metagenomic sequencing data from sidestream partial nitritation sequencing batch reactors operated under different biomass-retention states. Three reactors were maintained at approximately 2, 4, and 6 g L-1 mixed liquor suspended solids (MLSS) under stepwise ammonium loading. The data were generated to investigate how biomass-retention state affects partial nitritation performance, ammonia-oxidizing bacterial activity, nitrifying guild structure, and functional gene expression. The study focuses on the relationship between retained nitrifier-related potential and realized ammonia-oxidizing function during load escalation.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2026/04/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57320012","Metagenome or environmental sample from sludge metagenome","2025-06-20","China","Shanghai","Shanghai",31.26,121.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2025],["SAMN57320013","Metagenome or environmental sample from sludge metagenome","2025-06-20","China","Shanghai","Shanghai",31.26,121.53,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1796236,"verified","text+coordinates",null,"China: Shanghai",2025],["S