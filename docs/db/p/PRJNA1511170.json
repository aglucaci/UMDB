{"v":"3.0.0","project":{"accession":"PRJNA1511170","title":"Biofilm microbial community assembly and pollutant removal in stormwater storage systems: effects of substrate material, light condition, and rainfall frequency","description":"This study investigated how substrate materials (polyethylene, cast iron, and ceramic), light conditions (light/dark), and rainfall frequency affect biofilm community assembly and water purification performance in laboratory-scale stormwater storage reactors. Eighteen treatment combinations (3 materials x 2 light conditions x 3 renewal frequencies) were operated for 42 days using stormwater collected from the Shenzhen University campus. Biofilm microbial communities were characterized by 16S rRNA gene amplicon sequencing (V4 region, paired-end) on the Illumina platform. The dataset comprises 18 biofilm samples with associated water quality measurements (COD, NH3-N, TN, TP) and material/light/frequency metadata.","organism":null,"data_type":"Raw sequence reads","center_name":"Shenzhen University","submission_date":"2026/08/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62343516","Metagenome or environmental sample from biofilm metagenome","2025-08-11","China","Guangdong","Shenzhen",22.53,113.94,"probable_urban","water_drainage","city-level location without sample-site confirmation","stormwater storage reactor biofilm","anthropogenic environment [ENVO:01001117]","artificial water storage container","biofilm [ENVO:00002036]",null,"coordinate","CN",1795565,"verified","text+coordinates",null,"China: Shenzhen",2025],["SAMN62343517","Metagenome or environmental sample from biofilm metagenome","20