{"v":"3.0.0","project":{"accession":"PRJNA1118485","title":"Resource recovery and restoration mechanism of electrolytic manganese wastewater by functional microalgae-wood chips bioreactor","description":"Through the field investigation of an electrolytic manganese plant, it is found that the tail water discharged from it still contains high concentrations of Mn2+ and nitrogen, which will have adverse effects on the receiving river water and river sediments. This study found that the functional microalgae Desmodesmus sp.WR1 has good performance in promoting manganese oxidation and precipitation and improving water quality, and sawdust as a nitrogen removal substrate has the advantages of low cost, high efficiency and environmental protection. Respectively constructing sewage treatment reactors and sequentially treating electrolytic manganese tail water can give full play to the advantages of each device, so that Mn2+ and NH4+-N can be removed in the microalgae reactor with high pH and high DO environment, and NO3-N can be removed in the sawdust reactor with low DO and additional carbon source. 16S rRNA sequencing of the water in the device can analyze the diversity and changes of microorganisms in it.","organism":null,"data_type":"Raw sequence reads","center_name":"Sichuan Normal University","submission_date":"2024/05/31 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41611070","Control_A1","2022-12",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","wastewater",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN41611071","Control_A2","2022-12",null