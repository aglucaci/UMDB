{"v":"3.0.0","project":{"accession":"PRJNA511719","title":"selected nitrogen-heterocyclic in coal gasification wastewater","description":"Anaerobic bottle experiments were operated in parallel for 120 consecutive days for bioaugmentation hydrolysis of selected nitrogen-heterocyclic (NHCs) in coal gasification wastewater. With the enhancement of PAC and Fe(OH)3@PAC, quinoline, pyridine and indole was hydrolyzed more effectively. The addition of PAC and Fe(OH)3@PAC improved the coagulation capacity of microorganisms, which laid a solid foundation for the removal of selected NHCs and the adverse environmental conditions. Anaerobic degradation of the NHCs firstly was the function of hydrogenation, then was the opening of nitrogen heterocyclic, followed by the release of ammonia nitrogen and finally was the opening of benzene ring. Furthermore, the enriched Acinetobacter, Levilinea, Comamonas, and Longilinea were main function groups responsible for anaerobic biodegradation of selected NHCs.","organism":null,"data_type":"Raw sequence reads","center_name":"Harbin Institute of Technology","submission_date":"2018/12/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN10642656","1Rawsludge","2018-08-03","China","Heilongjiang","Harbin",45.75,126.63333,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",2037013,"verified","text+coordinates",null,"China:Harbin",2018],["SAMN10642657","2Quinoline","2018-08-03","China","Heilongjiang","Harbin",45.75,126.63333,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,