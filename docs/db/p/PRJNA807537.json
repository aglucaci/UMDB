{"v":"3.0.0","project":{"accession":"PRJNA807537","title":"shotgun sequencing for UASB reactor operated under different temperatures","description":"The sequencing results were from UASB reactors operated under room temperature(20 celsius), mesophilic (35 celsius) and thermophilic conditions (52 celsius). Under room temperature and mesophilic condition. One reactor was amened with granular activated carbon (GAC), and another was not and served as a control. The sequencing data sets were used to examine the dominant methanogens and fermenters under different temperatures. DNA were also extracted from GAC to differentiated the presence of biofilm formation related genes on GAC and suspended sludge.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Alberta","submission_date":"2022/02/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN25995536","No-GAC sludge","2020-05","Canada","Alberta","Edmonton",53.52,-113.52,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater biome","wastewater UASB reactor No GAC","suspended sludge",null,"coordinate","CA",5946768,"verified","text+coordinates",null,"Canada: Edmonton",2020],["SAMN25995537","GAC sludge","2020-05","Canada","Alberta","Edmonton",53.52,-113.52,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater biome","wastewater UASB reactor with GAC","suspended sludge",null,"coordinate","CA",5946768,"verified","text+coordinates",null,"Canada: Edmonton",2020],["SAMN25995538","GAC biofilm","2020-05","Canada","Alberta","Edmonton",53.52,-113.52,"probabl