{"v":"3.0.0","project":{"accession":"PRJNA1228313","title":"Bacterial community in the soybean rhizosphere soil","description":"Additionally, microbial inoculum and chlorothalonil application exerted substantial effects on the composition of the bacterial community. Specifically, co-inoculation with Rhizophagus intraradices and Acinetobacter calcoaceticus led to an increase in the relative abundance of Acidobacteriota and Patescibacteria in the rhizosphere soil. Conversely, chlorothalonil application resulted in a reduction in the relative abundance of these bacterial taxa.","organism":null,"data_type":"Raw sequence reads","center_name":"Heilongjiang University","submission_date":"2025/02/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47034532","Metagenome or environmental sample from sludge metagenome","2023-10-11",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","soil sampies",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47034533","Metagenome or environmental sample from sludge metagenome","2023-10-11",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","soil sampies",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47034534","Metagenome or environmental sample from sludge metagenome","2023-10-11",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","soil sampies",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN47034535","Metagenome or environmental sample from sludge metagenome",