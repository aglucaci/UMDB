{"v":"3.0.0","project":{"accession":"PRJNA942990","title":"UASB sludge Raw sequence reads","description":"This study was to elucidate the multiple strategies employed by microbes, especially the AHL-mediated QS, to form anaerobic granular sludge. To this end, a laboratory UASB reactor was operated with synthetic feed to allow the formation of granular sludge; AHLs and EPS concentrations, granule sizes, and microbial community structure in the UASB were continuously monitored to reveal the correlation between AHL and anaerobic sludge granulation. This study sheds new light in the mechanism of anaerobic sludge granulation, and opens up new operating strategies for fast and stable bioprocesses engaging granular sludge.","organism":"bioreactor sludge metagenome","data_type":"Raw sequence reads","center_name":"Shantou University","submission_date":"2023/03/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN33707185","D0A","2019-01-01T17:01:01Z",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2019],["SAMN33707186","D0B","2019-01-01T17:01:02Z",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2019],["SAMN33707187","D0C","2019-01-01T17:01:03Z",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","anaerobic sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2019],["SAMN33707188","D1A","2019-01