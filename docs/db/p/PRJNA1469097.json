{"v":"3.0.0","project":{"accession":"PRJNA1469097","title":"Biological additives enhancing PPCPs degradationduring sewage sludge composting","description":"The persistence of pharmaceutical and personal care products (PPCPs) during sewage sludge composting poses environmental challenges and constrains the safe reuse of compost. This study systematically evaluated the efficacy of four bio additives cellulase (CL), protease (PR), sludge-fermenting bacteria (SF), and an effective microorganism inoculant (EM) in enhancing PPCPs removal and reducing ecological risks. under the assumed land application scenario, thereby potentially improving the overall safety of land use.","organism":null,"data_type":"Raw sequence reads","center_name":"Henan Normal University","submission_date":"2026/05/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60340640","CK-0","2024-05-13",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN60340641","CK-4","2024-05-17",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN60340642","CK-8","2024-05-21",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","sludge",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN60340643","CK-18","2024-05-31",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","sludge",null,null,nu