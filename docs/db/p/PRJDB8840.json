{"v":"3.0.0","project":{"accession":"PRJDB8840","title":"Microbial community in the anodic biofilms on a bioelectrochemical system-based trickling filter reactor","description":"The bacterial community structures of the biofilms adhering to the anodes of the two reactors were analyzed by amplifying the 16S rRNA genes of the microbial assemblage using the Illumina high throughput sequencing system. Total 18 samples was extracted. Bacteria obtained in the precipitate of the wastewater in the BES-TF reactor were considered to be samples of the planktonic cell (PC) fraction. The upper and lower anodes were scraped using disinfected spoons, and the biofilm samples obtained were considered as the outer biofilm from the upper (Up-Upper part-Outer; Up-Lower part-Outer) and lower (Low-Outer) anodes. The biofilms in the middle were also extracted from the upper (Up-Upper part-Middle; Up-Lower part-Middle) anodes. The part of the biofilm adhering tightly to the anodes were now considered as the inner layers of the upper (Up-Upper part-Inner; Up-Lower part-Inner) and lower (Inner-Low) anodes.","organism":"biofilm metagenome","data_type":"Other","center_name":"Graduate School of Natural Science & Technology, Kanazawa University","submission_date":"2021/10/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00189325","biofilms for the planktonic-cell fraction in the solution of the reactor 1","2019","Japan","Ishikawa",null,null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,"biofilm",null,"city","JP",null,"unresolved",null,null,"Japan:Ishikawa",2019],["SAMD00189326","biofil