{"v":"3.0.0","project":{"accession":"PRJNA699581","title":"Full-Scale Low-temperature Anaerobic Wastewater Treatment","description":"Here, we demonstrate for the first time, direct, high-rate, low-temperature AD of low-strength municipal wastewater at full-scale. An 88 m3 hybrid EGSB reactor equipped with a pumice-stone fixed-film filter was installed at the municipal wastewater treatment plant in Builth Wells, UK and operated for 290 days. Ambient temperatures ranged from 2-18C, but remained below 15C for >100 days. Influent BOD fluctuated between 2-200 mg L-1. Regardless of these extreme conditions, we report successful, robust treatment of BOD with removal often reaching >90%. 16S rRNA sequencing of DNA from the biomass revealed a highly adaptable core microbiome supporting the process.","organism":null,"data_type":"Raw sequence reads","center_name":"National University of Ireland Galway","submission_date":"2021/02/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN17799085","Aug19_1","2019-08-01","United Kingdom","Wales","Builth Wells",52.15,-3.4,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","anaerobic biofilms",null,null,null,null,"coordinate","GB",2654359,"probable","coordinates",null,"United Kingdom: Wales",2019],["SAMN17799086","Aug19_2","2019-08-01","United Kingdom","Wales","Builth Wells",52.15,-3.4,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","anaerobic biofilms",null,null,null,null,"coordinate","GB",2654359,"probable","coordinates",null,"United Kingdom: Wales",2019],["SAMN17799087","Aug19_3","2019-08-01","United Kingd