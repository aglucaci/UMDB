{"v":"3.0.0","project":{"accession":"PRJNA991631","title":"The structure of biodegradable surfactants shaped the microbial community, antimicrobial resistance, and potential for horizontal gene transfer","description":"Surfactants can be cationic, anionic, or zwitterionic, and these different classes may have different effects on the proliferation ARG. Cationic hexadecyltrimethylammonium CTAB, anionic sodium dodecyl sulfate SDS, and zwitterionic 3decyldimethylammoniopropanesulfonate inner salt DAPS were used to represent the three classes of surfactants. The metagenomic results reveal that the presence and biodegradation for each surfactant uniquely shaped the biofilms microbial communities and the presence of ARG. The metagenomic result also provide details of functional genes that enriched with the presence of these three surfactants.","organism":null,"data_type":"Raw sequence reads","center_name":"Arizona State University","submission_date":"2023/07/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN36315997","CTAB Biofilm","2019-06-16","United States","Arizona","Tempe",33.42,-111.93,"uncertain",null,"conflicting evidence: environmental and host/clinical","Wastewater treatment plant",null,null,null,"Bacteria","coordinate","US",5317058,"verified","text+coordinates",null,"USA: Tempe",2019],["SAMN36315998","CTAB Suspension","2019-06-16","United States","Arizona","Tempe",33.42,-111.93,"uncertain",null,"conflicting evidence: environmental and host/clinical","Wastewater treatment plant",null,null,null,"Bacteria","coordinate","US",5317058,"verified","text+coordinates",null,"USA: Tempe",2019],["SAMN36315999","SDS Biofilm","2019-06