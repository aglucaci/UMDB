{"v":"3.0.0","project":{"accession":"PRJNA1264682","title":"Evolution of Plasmid-Harboring E. coli under Ciprofloxacin Stress","description":"This project contains genomic and transcriptomic data from Escherichia coli clones. The original E. coli strain was isolated from the environment and introduced with a plasmid. It was evolved under IC50 ciprofloxacin stress for 60 days. At the endpoint, highly resistant clones - either plasmid-harboring or plasmid-free - were randomly selected and subjected to whole-genome resequencing. Additionally, transcriptomic data were generated from two highly resistant clones after short-term exposure to IC50 ciprofloxacin.","organism":null,"data_type":"Raw sequence reads","center_name":"Zhejiang University","submission_date":"2025/05/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN53716723","metagenome of CIP1","2025-01","China","Zhejiang","Hangzhou",30.2489634,120.2052342,"non_environmental",null,"laboratory or culture material","Activated sludge under CIP stress in bioreactor CIP1",null,null,null,null,"coordinate","CN",1808926,"verified","text+coordinates",null,"China:Hangzhou",2025],["SAMN53716724","metagenome of CIP2","2025-01","China","Zhejiang","Hangzhou",30.2489634,120.2052342,"non_environmental",null,"laboratory or culture material","Activated sludge under CIP stress in bioreactor CIP2",null,null,null,null,"coordinate","CN",1808926,"verified","text+coordinates",null,"China:Hangzhou",2025],["SAMN53716725","metagenome of CIP3","2025-01","China","Zhejiang","Hangzhou",30.2489634,120.2052342,"non_environmental",null,"laboratory or culture material","Activated sludge under CIP stress in bi