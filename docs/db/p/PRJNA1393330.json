{"v":"3.0.0","project":{"accession":"PRJNA1393330","title":"Hospital surface microbiome","description":"Hospital surfaces serve as persistent reservoirs for clinically relevant pathogens and contribute to ongoing infection risks. While disinfection is routinely applied to reduce microbial burden, its long-term ecological effects on antimicrobial resistance dynamics remains underexplored. Here, we conducted year-long metagenomic surveillance of nearly 200 in situ hospital surface samples under sustained chlorine-based disinfection to investigate temporal changes in bacterial and viral communities, the resistome, and phage-host interactions.","organism":null,"data_type":"Raw sequence reads","center_name":"City University of Hong Kong","submission_date":"2025/12/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54298364","Metagenome or environmental sample from metagenome","2020-04-07","Hong Kong",null,"Hong Kong",22.3,114.16,"probable_urban","surfaces_infrastructure","city-level location without sample-site confirmation","Handrail 2 (near entrance)",null,null,null,"Environmental","coordinate","HK",1819729,"probable","city-state",null,"China: Hong Kong",2020],["SAMN54298367","Metagenome or environmental sample from metagenome","2020-04-07","Hong Kong",null,"Hong Kong",22.3,114.16,"probable_urban","surfaces_infrastructure","city-level location without sample-site confirmation","Handrail 1 (near toilet)",null,null,null,"Environmental","coordinate","HK",1819729,"probable","city-state",null,"China: Hong Kong",2020],["SAMN54298383","Metagenome or environmental sample from metagenome","2020-05-05","Hong Kong",null,"Hong Kong",22.3,11