{"v":"3.0.0","project":{"accession":"PRJNA838018","title":"Rumen Nasal Uterine and Vaginal samples Targeted loci","description":"A growing number of studies have investigated the viability of feeding hemp by-products as livestock feedstuffs; however, their impact on livestock microbiomes remains unexplored. Here, we evaluated the effects of feeding hempseed cake (HSC) as a protein source on the gastrointestinal, respiratory, and reproductive microbiota in beef heifers. Angus-crossbred heifers (19-months old) were fed a corn-based finishing diet containing either 20% HSC (n = 15) or 20% corn distillers grains (Control, n = 16) for 111 days until slaughter. Rumen fluid and deep nasopharyngeal swabs (days 0 7, 42, 70 and 98), and vaginal and uterine swabs (at slaughter) were collected and the microbiota assessed using 16S rRNA gene sequencing.","organism":"bovine metagenome","data_type":"Targeted Locus (Loci)","center_name":"Agriculture and Agri-Food Canada","submission_date":"2022/05/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN29632666","A1","2020-11/2021-02","United States","North Dakota","Fargo",46.90296416,-96.84197983,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"coordinate","US",5059163,"verified","text+coordinates",null,"USA:Fargo",2020],["SAMN29632667","A2","2020-11/2021-02","United States","North Dakota","Fargo",46.90296416,-96.84197983,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"coordinate","US",5059163,"verified","text+coordinates",null,"USA:Fargo",2020],["SAMN29632668","A3","2020-11/2021-02","Uni