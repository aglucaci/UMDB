{"v":"3.0.0","project":{"accession":"PRJNA1308571","title":"Hybrid-capture enrichment of wastewater influent and settled solids from three California Central Valley facilities","description":"We compare two wastewater sample processing pipelines across two versions of a probe capture enrichment protocol. We applied a novel Illumina protocol that enables combined DNA and RNA nucleic acid library preparation to process samples from three wastewater treatment facilities located in Yolo, Merced, and Stanislaus Counties in California. For each facility, we collected wastewater influent samples at three timepoints, concentrating viruses in the whole influent samples by using nano-sized affinity particles and by collecting settled solids from the influent. We analyzed combined DNA and RNA sample extracts from each sample type in two batches, using Illumina Viral Surveillance Panel (VSP) versions 1 and 2, which enrich for 66 and 242 viruses within each batch, respectively. To account for the expanded target set in VSP v2, we increased the targeted sequencing output, yielding approximately 8.1M read pairs post-QC per sample for the v1 pipeline and approximately 75M read pairs post-QC per sample for the v2 pipeline.","organism":null,"data_type":"Raw sequence reads","center_name":"University of California, Davis","submission_date":"2025/08/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50701349","Metagenome or environmental sample from wastewater metagenome","2022-04-07","United States","California","Turlock",37.50650266,-120.8580302,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wast