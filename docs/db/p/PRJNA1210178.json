{"v":"3.0.0","project":{"accession":"PRJNA1210178","title":"Microbial community of FeCl3-modified zeolite biological trickling filter","description":"In recent years, the application of biological trickling filter (BTF) in the treatment of rural domestic wastewater has been widely concerned, which has the characteristics of simple structure and low sludge production. Zeolite is a commonly used filler for BTF, but the biological removal effect of phosphorus is poor, and it is greatly affected by temperature. In this study, FeCl3 solution of 0.8 mol/L and solid liquid ratio of 250 g/L were used to modify natural zeolite with FeCl3.Put them into the BTF to run and detect the surface biofilm.","organism":null,"data_type":"Raw sequence reads","center_name":"Bjut","submission_date":"2025/01/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46241508","Metagenome or environmental sample from biofilm metagenome","2024-07-17","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater biofilm",null,null,null,null,"city","CN",1816670,"probable","text","region's main city","China:Beijing",2024],["SAMN46241509","Metagenome or environmental sample from biofilm metagenome","2024-07-17","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"city","CN",1816670,"probable","text","region's main city","China:Beijing",2024],["SAMN46241510","Metagenome or environmental sample from biofilm metagenome","2024-01-17","China","Beijing","Beijing",null,null,"p