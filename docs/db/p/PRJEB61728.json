{"v":"3.0.0","project":{"accession":"PRJEB61728","title":"16S rRNA gene amplicon sequences from suspended particulate matter (central Baltic Sea)","description":"During expedition EMB201 in the Baltic Sea we investigated the local producers of glycerol dialkyl glycerol tetraethers (GDGT) and their thriving depth by a combined 16S rRNA gene amplicon sequencing/ CARD-FISH and lipidomic approach. Water samples were taken in December 2018 by a pump-CTD, a giant water sampler and with Niskin bottles at the surface, suboxic and sulfidic zones of the Landsort Deep, Fårö Basin and East Gotland Basin. This data set contains the 16S rRNA gene sequencing data, while the CARD-FISH and lipidomics data are available on Pangaea.","organism":null,"data_type":"Other","center_name":"German Federation for Biological Data","submission_date":"2023/09/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA112974003","EMB201_11_FSL_4","2018-09-12",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Baltic Sea",2018],["SAMEA112974004","EMB201_11-6_GWS_96","2018-09-12",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Baltic Sea",2018],["SAMEA112974005","EMB201_11-5_GWS_99","2018-09-12",null,null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,null,null,null,null,"country",null,null,"unresolved",null,null,"Baltic Sea",2018],["SAMEA112974006","EMB201_11-4_GWS_425","2018-09-12",null,null,null,null,null,"non_urban",n