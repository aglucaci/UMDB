{"v":"3.0.0","project":{"accession":"PRJNA633652","title":"Sludge from the Argentine Navy Icebreaker ship \"Almirante Irizar\" is adequate to produce through fermentation the ecological, renewable fuel, biohydrogen.","description":"Bacterial composition is of key importance to the optimization of the biological hydrogen production process. Therefore the bacterial communities present at different times into a bioreactor inoculated with sludge from the wastewater treatment plant of the Argentine Navy ship Icebreaker Admiral Irizar was assessed and compared through 16s rRNA next generation sequencing. Hydrogen content in the gas samples taken from the bioreactor throughout the fermentative process was in the range 59.2 to 70.0 percent. The predominant species found in the bioreactor were Clostridium sensu stricto and Sporolactobacillus sp. These results lead us to propose that the studied sludge is a good source of H2 producing bacteria and that it could be used to produce a renewable fuel onsite.","organism":null,"data_type":"Raw sequence reads","center_name":"IABiMo","submission_date":"2020/05/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN14967956","MIMARKS Survey related sample from sludge metagenome","2019",null,null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"wastewater treatment plant","Ship from Argentine Navy",null,null,"unknown",null,null,"unresolved",null,null,null,2019],["SAMN14967957","MIMARKS Survey related sample from sludge metagenome","2019",null,null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample le