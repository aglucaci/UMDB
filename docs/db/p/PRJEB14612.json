{"v":"3.0.0","project":{"accession":"PRJEB14612","title":"Molecular-based evaluation of the influent and effluent microbial communities of membrane bioreactor (MBR) systems treating municipal wastewater","description":"Given that the majority of pathogens in wastewater are not detectable by culture-based methods, a molecular-based approach would be necessary to understand the risks associated with the microbial communities of MBR effluents. The present study examines two MBR systems treating municipal wastewater, one a full-scale MBR plant and the other a lab-scale anaerobic MBR, by using high-throughput sequencing and PCR quantification. Results showed that each of the two MBR effluents’ microbial communities contained genera associated with opportunistic pathogens (e.g., Pseudomonas, Acinetobacter) with a wide-range of log reduction values.","organism":null,"data_type":"Other","center_name":"WDRC KAUST","submission_date":"2017/03/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA4051617","01-Influent-10Mar15","2015","Saudi Arabia",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","SA",null,"unresolved",null,null,"Saudi Arabia",2015],["SAMEA4051618","02-Influent-28Apr15","2015","Saudi Arabia",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","SA",null,"unresolved",null,null,"Saudi Arabia",2015],["SAMEA4051619","03-Influent-1Jul15","2015","Saudi Arabia",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioP