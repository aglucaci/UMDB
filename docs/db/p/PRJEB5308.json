{"v":"3.0.0","project":{"accession":"PRJEB5308","title":"Microbial at the roadside: factors affecting community structure and composition in anthrosols from road embankments","description":"Human- mediated changes in terrestrial ecosystems give rise to anthrosols as those present in road embankments. The interest in biological communities associated with these environments have increased in the last decades, however little is known about microbial community structure, that may have a key role in soil processes and plant community development. In the present study we aimed to analyze microbial community composition in anthrosols from road embankments, as well as the relevant scale for community self-organization.","organism":null,"data_type":"Other","center_name":"Netherlands Institute of Ecology (NIOO-KNAW)","submission_date":"2015/01/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA2342142","M1.2.0","2011-06-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2011],["SAMEA2342143","T1.8.0","2011-06-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2011],["SAMEA2342144","T1.3.0","2011-06-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2011],["SAMEA2342145","M2.3.0","2011-06-20",null,null,null,null,null,"uncertain",null,"environmental sample; urban a