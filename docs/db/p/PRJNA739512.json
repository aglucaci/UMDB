{"v":"3.0.0","project":{"accession":"PRJNA739512","title":"Mask spreads antibiotic resistance during COVID-19 pandemic (protistan)","description":"In the midst of the COVID-19 pandemic, the demand of facial mask remains high. However, little is known about the discarded mask as a potential refuge for contaminants that may shelter, enrich and spread antibiotic resistance genes (ARG) in marine systems. We address this subject by conducting an in-situ time-series experiment to investigate the dynamic change of ARGs, bacteria and protozoa in discarded masks.","organism":null,"data_type":"Raw sequence reads","center_name":"Chinese Academy of sciences","submission_date":"2021/06/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN19790830","A1","2021-03-03","China","Fujian","Xiamen",24.6,118.06,"uncertain",null,"no environmental-sample evidence","water",null,null,null,null,"coordinate","CN",1790645,"verified","text+coordinates",null,"China: Xiamen",2021],["SAMN19790831","A2","2021-03-03","China","Fujian","Xiamen",24.6,118.07,"uncertain",null,"no environmental-sample evidence","water",null,null,null,null,"coordinate","CN",1790645,"verified","text+coordinates",null,"China: Xiamen",2021],["SAMN19790832","A3","2021-03-03","China","Fujian","Xiamen",24.6,118.08,"uncertain",null,"no environmental-sample evidence","water",null,null,null,null,"coordinate","CN",1790645,"verified","text+coordinates",null,"China: Xiamen",2021],["SAMN19790833","A4","2021-03-03","China","Fujian","Xiamen",24.6,118.09,"uncertain",null,"no environmental-sample evidence","water",null,null,null,null,"coordinate","CN",1790645,"verified","text+coordinates",null,"China: 