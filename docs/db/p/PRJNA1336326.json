{"v":"3.0.0","project":{"accession":"PRJNA1336326","title":"Developing and Benchmarking One Health Genomic Surveillance  Tools for Influenza A Virus in Wastewater","description":"We benchmarked four targeted enrichment methods suited for sequencing-based surveillance of Influenza A Virus in wastewater: 1) a custom probe-capture enrichment panel, 2) a custom tiled-amplicon panel for the HA segment, 3) the Twist Comprehensive Viral Research probe-capture panel, 4) the universal amplicon method developed by Zhou et al 2009. We tested these 4 methods a) on direct mixtures of wastewater RNA and RNA from 4 strains of Influenza A virus, and b) on incubated mixtures of Influenza A Viruses spiked into wastewater and concentrated by either Promega Wizard Enviro TNA kit or Innovaprep CP Select + Qiagen AllPrep PowerViral extraction kit.","organism":null,"data_type":"Raw sequence reads","center_name":"University of California, Berkeley","submission_date":"2025/09/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN52066602","Direct mixture of wastewater RNA and RNA from 4 Influenza A Virus strains, low concentration","2024-10-08","United States","California",null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,"Wastewater [ENVO:00002001]",null,"region","US",null,"unresolved",null,null,"USA: California",2024],["SAMN52066603","Direct mixture of wastewater RNA and RNA from 4 Influenza A Virus strains, medium concentration","2024-10-08","United States","California",null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,"Wastewater [ENVO:00002