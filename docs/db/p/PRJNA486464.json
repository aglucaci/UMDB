{"v":"3.0.0","project":{"accession":"PRJNA486464","title":"Urine nitrification with a synthetic microbial community","description":"Microbial processes are at the core of nutrient recycling schemes. In certain applications, e.g. during space missions in regenerative life support systems, synthetic microbial communities are preferred due to their gnotobiotic, fully-known, and pathogen-free character. These life support systems comprise urine nitrification and enable in situ food production by generating a stable liquid nitrate fertilizer. Urine nitrification with a synthetic microbial community in a long-term operated reactor was established here for the first time. The gnotobiotic microbial community was followed over time with 16S rRNA illumina amplicon sequencing.","organism":"urine metagenome","data_type":"Raw sequence reads","center_name":"Ghent University","submission_date":"2018/08/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN09847871","Day076","2017-05-29","Belgium","Flanders","Gent",51.0527829,3.7067699,"non_environmental",null,"laboratory or culture material",null,"sewage","aerobic bioreactor","urine",null,"coordinate","BE",2797656,"verified","text+coordinates",null,"Belgium: Gent",2017],["SAMN09847872","Day213","2017-10-13","Belgium","Flanders","Gent",51.0527829,3.7067699,"non_environmental",null,"laboratory or culture material",null,"sewage","aerobic bioreactor","urine",null,"coordinate","BE",2797656,"verified","text+coordinates",null,"Belgium: Gent",2017],["SAMN09847873","Day090","2017-06-12","Belgium","Flanders","Gent",51.0527829,3.7067699,"non_environmental",null,"laboratory or culture material",null,"sewa