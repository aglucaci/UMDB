{"v":"3.0.0","project":{"accession":"PRJNA1456118","title":"activated sludge metagenome","description":"This study aims to characterize the activated sludge metagenome in wastewater treatment systems and to determine how light irradiation affects microbial community structure and nitrogen transformation functions involved in partial nitrification and denitrification. By examining wavelength-specific responses of key microorganisms, the study evaluates whether light can selectively promote stable nitrite accumulation and improve process control without chemical inhibitors. The findings are relevant for understanding the ecological and functional dynamics of activated sludge communities and for developing low-carbon, energy-efficient strategies for advanced biological nitrogen removal.","organism":null,"data_type":"Raw sequence reads","center_name":"Nanjing University of Science and Technology","submission_date":"2026/04/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57394199","Metagenome or environmental sample from activated sludge metagenome","2025-07-31T09:10:33Z","China","Jiangsu","Nanjing",32.0603,118.7969,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1799962,"verified","text+coordinates",null,"China: Nanjing",2025],["SAMN57394200","Metagenome or environmental sample from activated sludge metagenome","2025-07-31T09:15:43Z","China","Jiangsu","Nanjing",32.0603,118.7969,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"coordinate","CN",1799962,"verified","text+