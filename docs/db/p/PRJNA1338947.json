{"v":"3.0.0","project":{"accession":"PRJNA1338947","title":"Manganese Toxicity Impairs Soil Nitrification and Sugarcane Nitrogen Utilization by Inhibiting Rhizosphere Ammonia-Oxidizing Microorganisms","description":"Sugarcane (Saccharum spp.) is an economically vital crop cultivated primarily for sugar and bioethanol production. In southern China, sugarcane grown in acidic soils often exhibits severe leaf chlorosis due to excessive soil manganese (Mn) levels. However, the mechanisms by which Mn toxicity disrupts soil nitrogen (N) cycling, particularly the roles of ammonia-oxidizing bacteria (AOB) and archaea (AOA) in regulating nitrification and N availability for sugarcane remain underexplored.","organism":null,"data_type":"Raw sequence reads","center_name":"Guangxi University","submission_date":"2025/10/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN52588526","T1","2022-10-01",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN52588527","T2","2022-10-02",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN52588528","T3","2022-10-03",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN52588529","T4","2022-10-04",null,null,null,null,null,"uncertain",null,"environmental sample; urban association