{"v":"3.0.0","project":{"accession":"PRJNA745168","title":"Evaluating de novo assembly and binning strategies for time-series drinking water metagenomes","description":"Reconstructing microbial genomes from metagenomic short-read data can be challenging due to the unknown and uneven complexity of microbial communities. This complexity encompasses highly diverse populations which often includes strain variants. Reconstructing high-quality genomes is a crucial part of the metagenomic workflow as subsequent ecological and metabolic inferences depend on their accuracy, quality, and completeness. In contrast to microbial communities in other ecosystems, there has been no systematic assessment of genome-centric metagenomic workflows for drinking water microbiomes. In this study, we assessed the performance of a combination of assembly and binning strategies for time-series drinking water metagenomes that were collected over a period of 6 months. The goal of this study was to identify the combination of assembly and binning approaches that results in high quality and quantity metagenome-assembled genomes (MAGs), representing most of the sequenced metagenome.","organism":null,"data_type":"Raw sequence reads","center_name":"Northeastern University","submission_date":"2021/07/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN20148338","Bulk water_Run001_030119","2019-03-01","United States","Massachusetts","Boston",42.36,-71.06,"probable_urban","built_environment","city-level location without sample-site confirmation","Commercial building tap, chloraminated drinking water",null,null,null,null,"coordinate","US",4930956,"verified","text+