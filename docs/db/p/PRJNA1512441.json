{"v":"3.0.0","project":{"accession":"PRJNA1512441","title":"Kombucha Microbiome as a Potential Plant Architecture-Supporting Biostimulant: Metabarcoding Characterization of Its Bacterial and Fungal Community Structure","description":"This study characterizes the bacterial, eukaryotic, and fungal community structure of Kombucha using 16S rRNA, 18S rRNA, and ITS amplicon sequencing. Dried cellulosic pellicle (KP) and fermentation liquid (KS) fractions derived from three independent fermentations were analyzed as composite samples. The project aims to establish the taxonomic and phylogenetic structure of the Kombucha microbiome and to provide a microbiological basis for evaluating its potential as a plant architecture-supporting biostimulant.","organism":null,"data_type":"Raw sequence reads","center_name":"Erciyes University","submission_date":"2026/08/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN62382234","Kombucha dried cellulosic pellicle composite","2025-06-15","Turkey","Kayseri","Kayseri",38.7079,35.53,"non_environmental",null,"laboratory or culture material",null,"built environment","research laboratory","Kombucha cellulosic pellicle (biofilm)",null,"coordinate","TR",308464,"verified","text+coordinates",null,"Turkey: Kayseri",2025],["SAMN62382235","Kombucha fermentation liquid composite","2025-06-15","Turkey","Kayseri","Kayseri",38.7079,35.53,"non_environmental",null,"laboratory or culture material",null,"built environment","research laboratory","Kombucha fermentation liquid",null,"coordinate","TR",308464,"verified","text+coordinates",null,"Turkey: Kayseri",2025]],"run_cols":["accession","sample","experiment","assay_