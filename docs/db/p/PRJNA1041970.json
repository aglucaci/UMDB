{"v":"3.0.0","project":{"accession":"PRJNA1041970","title":"Metagenomic insights into the mechanism for the rapid enrichment and high stability of Candidatus Brocadia facilitated by ferric ion","description":"The rapid enrichment of anammox bacteria and its fragile resistance to environment changes are the critical problems facing of anammox processes. As an abundant component in anammox bacteria, iron has been proved to promote the activity and growth of anammox bacteria in the mature anammox systems, but the functional and metabolic profiles in Fe(III) enhanced emerging anammox systems have not been evaluated. Results indicated that the relative abundance of functional genes involved in oxidative phosphorylation and nitrogen metabolism, cofactors synthesis, and extracellular polymers synthesis pathways was significantly promoted in the system added with 5 mg/L Fe(III).These enhanced pathways were crucial to energy generation and nitrogen removal, cell activity and proliferation, and microbial self-defense, thereby accelerating the enrichment of anammox bacteria Candidatus Brocadia and facilitating their resistance to adverse environments.","organism":null,"data_type":"Raw sequence reads","center_name":"Wuhan University","submission_date":"2023/11/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38305544","sludge","2022-10-30",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample R0_45d_1",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN38305545","sludge","2022-10-30",null,null,null,null,null,"uncertain",null,"environmental sample