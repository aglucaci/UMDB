{"v":"3.0.0","project":{"accession":"PRJNA1309778","title":"Poultry farm environment Metagenome","description":"Antimicrobial use in poultry production is key in managing the AMR crisis. In the US, commercial production uses vertically integrated systems where flocks are moved to specific farms depending on production stage, creating a potential pathway for transmission of pathogens and AMR. Regulations and public pressure led to the restriction of antimicrobial use in poultry production, shifting the focus to better management for flock health. However, studies in commercial complexes are rare and preclude the understanding of AMR circulation and impact of management practices in these environments. This project investigates the dynamics of the microbiome and resistome of farms across all production stages of 2 vertically integrated broiler production complexes and following a flock to the processing plant (farm-to-fork).","organism":"farm metagenome","data_type":"Metagenome","center_name":"Auburn University","submission_date":"2025/08/22 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51798900","IlluminaShotgun_FN3_Breeder_Litter_A","2021-03-01","United States",null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,"farm[ENVO:00000078]","chicken house[ENVO:03501258]","animal litter [ENVO:00002191]|poultry litter[ENVO:00002192]",null,"country","US",null,"unresolved",null,null,"USA",2021],["SAMN51798901","IlluminaShotgun_FN3_Breeder_Soil_A","2021-03-01","United States",null,null,null,null,"non_urban",null,"environmental sample from a non-urban site",null,"farm[ENVO:00000078]","road[ENVO:0000006