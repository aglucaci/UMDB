{"v":"3.0.0","project":{"accession":"PRJNA1354877","title":"Waste water Raw sequence reads","description":"The present project includes sewage water samples collected from 16 wastewater treatment plants (WWTP) across Sweden at two timepoints: Week 3 (W3) and Week 21 (W21) in 2024. The study sites included Gaevle (WWTP: Duvbackens avloppsreningsverk), Goeteborg (Ryaverket), Kalmar (Kalmarsundsverket), Karlstad (Sjoestadsverket), Linkoeping (Nykvarnsverket), Luleaa (Uddebo reningsverk), Malmoe (Sjoelunda reningsverk), and four locations in Stockholm: Bromma (Bromma reningsverk), Groedinge (Himmerfjaerdsverket), Henriksdal (Henriksdals reningsverk), and Kaeppala (Kaeppalaverket). Additional sites were Umeaa (Oens reningsverk), Uppsala (Kungsaengsverket), Vaesteraas (Kungsaengsverket), Oestersund (Goevikens reningsverk), and Oesthammar (Alunda avloppsreningsverk).","organism":"wastewater metagenome","data_type":"Raw sequence reads","center_name":"Karolinska Institute","submission_date":"2025/10/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN52841078","Metagenome or environmental sample from wastewater metagenome","2024-05-01","Sweden","Gävleborg","Gävle",60.6788,17.1603,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","waste_water",null,null,null,null,"coordinate","SE",2712414,"verified","text+coordinates",null,"Sweden: Gaevle",2024],["SAMN52841079","Metagenome or environmental sample from wastewater metagenome","2024-01-01","Sweden","Gävleborg","Gävle",60.6788,17.1603,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","waste_water",null