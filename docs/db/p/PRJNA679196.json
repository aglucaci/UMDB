{"v":"3.0.0","project":{"accession":"PRJNA679196","title":"Quantifying the effects of hydrogen on carbon assimilation in a marine microbial community associated with ultramafic rocks","description":"The aerobic oxidation of molecular hydrogen (H2) is a thermodynamically favorable energy-yielding process for microbial communities, but how H2 oxidation is connected to anabolic processes in marine microbial communities is poorly understood. We quantified the effects of H2 on carbon utilization using quantitative DNA stable isotope probing (DNA-qSIP), which revealed that H2 utilization increased carbon assimilation by diverse microbial taxa synthesizing 13C-labeled DNA associated with ultramafic rocks at the Mid-Atlantic Ridge.","organism":"rock metagenome","data_type":"Genome sequencing and assembly","center_name":"Ludwig-Maximilian University","submission_date":"2021/04/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN16829313","qSIP from marine settings 388","2016","Brazil",null,null,0.55,-29.21,"non_urban",null,"environmental sample from a non-urban site","Laboratory dust",null,null,null,null,"coordinate","BR",null,"unresolved",null,null,"Brazil: Saint Peter and Saint Paul' Rocks",2016],["SAMN16829314","qSIP from marine settings 389","2016","Brazil",null,null,0.55,-29.21,"non_urban",null,"environmental sample from a non-urban site","Laboratory dust",null,null,null,null,"coordinate","BR",null,"unresolved",null,null,"Brazil: Saint Peter and Saint Paul' Rocks",2016],["SAMN16829315","qSIP from marine settings 390","2016","Brazil",null,null,0.55,-29.21,"non_urban",null,"environmental sample from a non-urban site","Laboratory dus