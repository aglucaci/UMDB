{"v":"3.0.0","project":{"accession":"PRJEB85785","title":"Seawater Metagenomes from a Wastewater Exposure Experiment","description":"A short-term microcosm experiment was conducted to assess the impact of wastewater discharge on coastal microbial communities. Coastal seawater was exposed to two types of treated wastewater: (i) unfiltered wastewater containing nutrients, pollutants, and allochthonous microbes, and (ii) filtered wastewater retaining only nutrients and pollutants. Metagenomic samples were collected from wastewater and coastal seawater before the experiment, and from each experimental flask at the late exponential growth phase. Shotgun metagenomic sequencing was performed using Illumina NovaSeq (2 × 150 bp).","organism":null,"data_type":"Other","center_name":"national institute of biology","submission_date":"2025/03/01 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA117689453",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA117689454",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA117689455",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA117689456",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA117689457",null,null,nul