{"v":"3.0.0","project":{"accession":"PRJNA664301","title":"Membrane performance in direct contact membrane distillation with a focus on the fouling characteristics at different temperature regions","description":"This study evaluated the fouling development of different temperature regions in direct contact membrane distillation (DCMD). Scanning electron microscopy with energy dispersive spectrometry (SEM-EDS) were implemented to find more crystal deposition on high temperature regions and identify the main composition of the crystal deposit was CaCO3. Confocal laser scanning microscope (CLSM) demonstrated that the middle temperature region had more biovolume and it was least in high temperature due to the limit of the growth of microorganisms. We apply the next-generation sequencing of 16S rRNA to characterise the composition and functional potential of the microbial community on the membrane at different stages.","organism":null,"data_type":"Raw sequence reads","center_name":"Hohai University","submission_date":"2020/09/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN16205225","sludge","2019-08-09","China","Chongqing","Nanjin",32.0,118.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge sample",null,null,null,null,"coordinate","CN",8417607,"verified","text",null,"China: Nanjin",2019],["SAMN16205226","sludge","2019-08-09","China","Chongqing","Nanjin",32.0,118.0,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge sample",null,null,null,null,"coordinate","CN",8417607,"verified","text",null,"China: Nanjin",2019],["SAMN1620