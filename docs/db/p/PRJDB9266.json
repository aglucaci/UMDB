{"v":"3.0.0","project":{"accession":"PRJDB9266","title":"Microbial community structure of mesh rotating biological reactor (MRBR) treating sewage","description":"Mesh rotating biological reactor (MRBR) is a new type of rotational biological contactor (RBC) reactor for wastewater treatment, which have advantages of compactness, easy operation, low excess sludge, and low energy consumption. Microbial community information is important basic data and relevant to treatment performance, however there is no microbial information regarding MRBR biofilms. In this study, microbial community structure of sludge on the mesh media was analyzed based on the 16S rRNA gene sequence.","organism":"biofilm metagenome","data_type":"Metagenome","center_name":"Department of Civil and Environmental Engineering, Nagaoka University of Technology","submission_date":"2020/06/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00202834","MRBR mesh influent side center sample, no.1 reactor","2018-11-06","Japan","Niigata","Nagaoka",null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,"sewage treatment plant","activated sludge biofilm",null,"city","JP",1856199,"probable","text-population","largest of 2 places named 'Nagaoka'","Japan:Nagaoka",2018],["SAMD00202835","MRBR mesh effluent side center sample, no.1 reactor","2018-11-06","Japan","Niigata","Nagaoka",null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,"sewage treatment plant","activated sludge biofilm",null,"city","JP",1856199,"probable","text-population","largest of 2 places named 'Nagaoka'","J