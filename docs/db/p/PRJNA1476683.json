{"v":"3.0.0","project":{"accession":"PRJNA1476683","title":"Microbial community analysis of anaerobic digestion under trace element supplementation","description":"This project investigates microbial community structures in anaerobic digestion systems using 16S rRNA gene amplicon sequencing. The study aims to evaluate the effects of trace element (Ni and Co) supplementation on microbial community composition, process stability, and methane production. High-throughput sequencing was applied to characterize bacterial and archaeal populations associated with different experimental conditions. The generated data provide insights into the microbial mechanisms underlying anaerobic digestion performance and support the reproducibility and transparency of the study.","organism":null,"data_type":"Raw sequence reads","center_name":"JEJU NATIONAL UNIVERSITY","submission_date":"2026/06/09 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60724631","MIMARKS Survey related sample from anaerobic digester metagenome","2025-05","South Korea","Jeju-do","Jeju City",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered environment","anaerobic digester","anaerobic sludge",null,"city","KR",1846266,"verified","text",null,"South Korea: Jeju",2025],["SAMN60724632","MIMARKS Survey related sample from anaerobic digester metagenome","2025-05","South Korea","Jeju-do","Jeju City",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered environment","anaerobic digester","anaerobic sludge",null,"city","KR",1846266,"verified","te