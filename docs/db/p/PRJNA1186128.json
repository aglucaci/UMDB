{"v":"3.0.0","project":{"accession":"PRJNA1186128","title":"Metagenomic Analysis of Airborne Microbial Communities across Altitudinal Gradients in the Piduruthalagala Mountain Region, Sri Lanka","description":"The study investigates airborne microbial diversity in the Piduruthalagala Mountain region, Sri Lanka, by analyzing air samples collected from two altitudes: 1868 m (bottom level) and 2524 m (highest point). The research uses culture-independent metagenomic techniques to identify bacterial communities and assess how altitude influences their composition and ecological roles. This work enhances the understanding of microbial biodiversity in tropical montane ecosystems and its potential environmental implications.","organism":"air metagenome","data_type":"Metagenome","center_name":"National Institute of Fundamental Studies","submission_date":"2024/11/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44768584","Air Sample from Bottom Level of Piduruthalagala Mountatin (PB1)","2023-11-27T09:00:00Z","Sri Lanka","Central Province","Nuwara Eliya",7.0,80.77,"probable_urban","air_dust","city-level location without sample-site confirmation","air","ENVO:00000428","[ENVO:00000428]|Troposphere[ENVO:00000429]","[ENVO:00000050]",null,"coordinate","LK",1232783,"verified","text",null,"Sri Lanka:Nuwara Eliya",2023],["SAMN44768585","Air Sample from Bottom Level of Piduruthalagala Mountatin (PB2)","2023-11-27T13:30:00Z","Sri Lanka","Central Province","Nuwara Eliya",7.0,80.77,"probable_urban","air_dust","city-level location without sample-site confirmation","air","ENVO:00000428","[ENVO:00000428]|Troposphere[ENVO:00000429]","[ENVO:00000050]