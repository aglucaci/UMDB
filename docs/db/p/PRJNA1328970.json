{"v":"3.0.0","project":{"accession":"PRJNA1328970","title":"anaerobic sludge Metagenome","description":"This project investigates microbial community dynamics and the generation and dissemination of resistance genes in anaerobic sludge treating pretreated, resource-recovered, and non-pretreated pharmaceutical wastewater. Anaerobic reactors were operated with different wastewater types (including pretreatment-resource recovery and non-pretreated groups), each with biological triplicates. After a defined incubation period, sludge samples were collected, centrifuged, frozen, lyophilized, and stored for downstream omics analysis.","organism":"anaerobic digester metagenome","data_type":"Metagenome","center_name":"Zhejiang University","submission_date":"2025/09/16 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN51366268","MIMARKS Survey related sample from metagenome","2025-03-10","China","Zhejiang",null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,"pharmaceutical wastewater treatment system","anaerobic reactor treating pharmaceutical wastewater","sludge",null,"region","CN",null,"unresolved",null,null,"China: Zhejiang",2025],["SAMN51366269","MIMARKS Survey related sample from metagenome","2025-03-10","China","Zhejiang",null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,"pharmaceutical wastewater treatment system","anaerobic reactor treating pharmaceutical wastewater","sludge",null,"region","CN",null,"unresolved",null,null,"China: Zhejiang",2025],["SAMN51366270","MIMARKS Survey related sample from metagenome","2025-03-10","China","Zhejiang",