{"v":"3.0.0","project":{"accession":"PRJNA434071","title":"Plasmid transfer in wastewater treatment plant microbial community","description":"Wastewater treatment plant as interfaces between different environmental compartments, such as hospital/residential sewage and surface waters, has long been proposed as significant environmental reservoir of antibiotic resistance genes (ARGs). The anthropogenic ecosystem directly exposes the mixture of human gut microbiota and environmental bacteria to pharmaceutical residues, favoring the emergence and dissemination of ARGs. However, contribution of microbial communities in WWTP to current ARG proliferation remains poorly understood. Here, we examined for the first time plasmid permissiveness in activated sludge microbial communities by utilizing the well-established fluorescent reporter platform – solid surface filter mating assay.","organism":null,"data_type":"Raw sequence reads","center_name":"Technical University of Denmark","submission_date":"2018/02/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN08535664","MIMS Environmental/Metagenome sample from activated sludge metagenome","2017-05-10","Denmark","Capital Region","Copenhagen",55.8,12.53,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"activated sludge","wastewater treatment plant","activated sludge",null,"coordinate","DK",2618425,"probable","coordinates",null,"Denmark",2017],["SAMN08535665","MIMS Environmental/Metagenome sample from activated sludge metagenome","2017-05-10","Denmark","Capital Region","Copenhagen",55.8,12.53,"confirmed_urban","municipal_wastewater","named urban infr