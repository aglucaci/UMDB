{"v":"3.0.0","project":{"accession":"PRJNA720235","title":"Bacterial community analysis in mixed culture of  Chlorella pyrenoidosa and enriched nitrobacteria","description":"Ammonium sulfate wastewater can cause eutrophication and black odor of water body. Although ammonia nitrogen can be used as nutrient of microalgae, high ammonia nitrogen levels could inhibit the growth of microalgae. Nitrobacteria can transform ammonia nitrogen into nitrate nitrogen. Mono Chlorella pyrenoidosa culture, synchronous mixed culture (mixed-a), and asynchronous mixed culture (mixed-b) systems were examined for their ability to treat ammonium sulfate wastewater. Higher total suspended solid concentration, crude protein yield and heating value yield were obtained in mixed-b, meanwhile with excellent settlement performance. Mechanism analysis of settlement showed that the relative abundance of floc-forming related bacteria Sphingopyxis and Acidovorax were increased generally, while nitrification-denitrifying members were decreased in mixed-b along with the culture proceeding.","organism":null,"data_type":"Raw sequence reads","center_name":"Chinese Academy of Sciences","submission_date":"2021/04/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN18642741","Mixed-a-1d","2020-01-02","China","Guangdong","Guangzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","synchronous mixed culture system",null,null,null,null,"city","CN",1809858,"verified","text",null,"China: Guangzhou",2020],["SAMN18642742","Mixed-a-3d","2020-01-04","China","Guangdong","Guangzhou",null,null,"probable_urban","municipal_wa