{"v":"3.0.0","project":{"accession":"PRJNA681008","title":"Metagenome of the built environment: Cleanrooms and spacecraft assembly facilities at the Jet Propulsion Laboratory","description":"The Jet Propulsion Laboratory (JPL) Biotechnology and Planetary Protection Group has been monitoring the microbial burden of spacecraft since the Viking mission. Originally, culture-based techniques were used. More recently, amplicon-based and metagenomics approaches are being applied to increase the sensitivity of surveillance. We applied whole metagenomic sequencing to a variety of ISO cleanroom samples at the JPL, including the spacecraft assembly facility (SAF). These included samples from HEPA and ULPA filters and surface wipe samples.","organism":null,"data_type":"Raw sequence reads","center_name":"Translational Genomics","submission_date":"2020/11/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN16929104","Metagenome or environmental sample from indoor metagenome","2019-04-02","United States","California","Los Angeles",34.2,-118.17,"non_urban",null,"environmental sample from a non-urban site","Cleanroom 170_213",null,null,null,null,"coordinate","US",5368361,"probable","coordinates",null,"USA",2019],["SAMN16929105","Metagenome or environmental sample from indoor metagenome","2019-04-02","United States","California","Los Angeles",34.2,-118.17,"non_urban",null,"environmental sample from a non-urban site","Facility Control",null,null,null,null,"coordinate","US",5368361,"probable","coordinates",null,"USA",2019],["SAMN16929106","Metagenome or environmental sample from indoor metagenome","2019-04-01","United States","California","Los An