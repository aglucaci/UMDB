{"v":"3.0.0","project":{"accession":"PRJNA1218774","title":"Algae-bacterial consortium","description":"Algae-bacterial consortia in granular form represent an emerging biotechnology for sustainable wastewater treatment, integrating microbial granulation with biological nutrient removal (BNR). These self-aggregating microbial structures combine phototrophic algae with heterotrophic and autotrophic bacteria, facilitating efficient carbon, nitrogen, and phosphorus removal. The synergistic interactions within the granules enhance pollutant degradation through mechanisms such as oxygenic photosynthesis, nitrification-denitrification, and enhanced biological phosphorus removal (EBPR). Additionally, the granular morphology provides high biomass retention, improved settleability, and resilience to environmental fluctuations. This approach offers a promising alternative to conventional wastewater treatment processes, reducing aeration costs and enabling resource recovery.","organism":null,"data_type":"Raw sequence reads","center_name":"King Abdullah University of Science and Technology","submission_date":"2025/02/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN46533216","1","2023","Saudi Arabia","Mecca Region","Thuwal",22.3095,39.1047,"uncertain",null,"environmental sample; urban association not established","environmental",null,null,null,"Granular sludge","coordinate","SA",409682,"probable","coordinates",null,"Saudi Arabia",2023],["SAMN46533217","2","2023","Saudi Arabia","Mecca Region","Thuwal",22.3095,39.1047,"uncertain",null,"environmental sample; urban association not established","environmental",null,null,null,"Granular sludge