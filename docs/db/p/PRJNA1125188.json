{"v":"3.0.0","project":{"accession":"PRJNA1125188","title":"Communities in domestic sewage","description":"This project describes the structure of microbial communities nurtured by domestic sewage in Beijing, China. The project is mediated by a sequencing batch bioreactor with an anaerobic-aerobic-anoxic mode of operation. The microorganisms perform carbon, nitrogen nutrient removal in an activated sludge state. The aim of the project is to investigate the metabolic correlation between glycogen-accumulating microorganisms and anammox bacteria in the SBR system.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2024/06/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN41885159","Metagenome or environmental sample from activated sludge metagenome","2022-12-21","China","Beijing","Beijing",39.52,116.28,"uncertain",null,"conflicting evidence: environmental and host/clinical","Activate sludge",null,null,null,"prokaryote","coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2022],["SAMN41885160","Metagenome or environmental sample from activated sludge metagenome","2023-03-03","China","Beijing","Beijing",39.52,116.28,"uncertain",null,"conflicting evidence: environmental and host/clinical","Activate sludge",null,null,null,"prokaryote","coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2023],["SAMN41885161","Metagenome or environmental sample from activated sludge metagenome","2023-05-06","China","Beijing","Beijing",39.52,116.28,"uncertain",null,"conflicting evidence: environmental and host/clinical","Activate sludg