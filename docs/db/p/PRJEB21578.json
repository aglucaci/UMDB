{"v":"3.0.0","project":{"accession":"PRJEB21578","title":"Influence of pig farming on the human's nasal microbiota: The key role of the airborne microbial communities","description":"We performed a study comparing the nasal microbiota of pigs with the air microbiota in pig-farmers and the nasal microbiota of individuals working in these pig farms in Switzerland. Pig farms (n=28) were visited in 2014 and 2015 and in total nasal swabs from 43 pig-farmers and 53 pigs were collected and air samples from 26 farms. As controls, nasal swabs from 16 cow-farmers and 26 individuals with no contact to farm animals were collected. Analysis of the microbiota was performed based on 16S rRNA high-throughput sequencing. Distinctly different bacterial communities were found in nasal samples from pig farmers compared to non-exposed individuals and cow farmers. Eighty-two Sequence Variants which predominantly occured in samples from pig farms were identified.","organism":null,"data_type":"Other","center_name":"Institute for Infectious Diseases of the University of Bern, Switzerland","submission_date":"2018/02/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA104144190","air sample from pig farm_10_0__",null,null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA104144196","air sample from pig farm_11_0__",null,null,null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMEA104144201","air s