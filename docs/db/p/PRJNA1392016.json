{"v":"3.0.0","project":{"accession":"PRJNA1392016","title":"self-driven bio-electrochemical system for efficient nitrogen and phosphorus removal of wastewater","description":"It was first discovered that connecting iron-carbon located in different functional areas of the sewage treatment process with wire could enable the flow of electrons across regions. Batch experiments demonstrated that an iron-carbon self-driven bio-electrochemical system (SD-BES) significantly enhances the denitrification rate of microbial community. Leveraging this finding, we designed a SD-BES trickling filter in which iron-carbon electrodes are spatially separated into an anoxic zone and a micro-oxic zone and connected by a single wire to enable cross-zone electron flow for treating real municipal sewage.","organism":null,"data_type":"Raw sequence reads","center_name":"Zhejiang University of Technology","submission_date":"2025/12/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54240263","L0","2025-05-03","China","Zhejiang","Hangzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"city","CN",1808926,"verified","text",null,"China:Hangzhou",2025],["SAMN54240264","L1","2025-05-03","China","Zhejiang","Hangzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","wastewater",null,null,null,null,"city","CN",1808926,"verified","text",null,"China:Hangzhou",2025],["SAMN54240265","L2","2025-05-03","China","Zhejiang","Hangzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-sit