{"v":"3.0.0","project":{"accession":"PRJNA1068586","title":"Waste activated sludge metagenome","description":"We studied the effects of humic substances combined with ofloxacin on microbial communities and functional genes during anaerobic digestion of waste activated sludge. We found that the coexistence of HS and OFL significantly affected the community abundance of hydrolytic, acidifying, and methanogenic microorganisms. At the same time, the coexistence of HS and OFL significantly changed the expression of genes related to hydrolysis, acidification and methanogenesis.","organism":null,"data_type":"Raw sequence reads","center_name":"Hunan University","submission_date":"2024/01/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN39596353","Waste activated sludge metagenome:HS0","2023-03-13","China","Hunan","Changsha",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Digested sludge",null,null,null,"Waste activated sludge","city","CN",1815577,"probable","text-population","largest of 7 places named 'Changsha'","China:Changsha",2023],["SAMN39596354","Waste activated sludge metagenome:HS1","2023-03-13","China","Hunan","Changsha",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","Digested sludge",null,null,null,"Waste activated sludge","city","CN",1815577,"probable","text-population","largest of 7 places named 'Changsha'","China:Changsha",2023],["SAMN39596355","Waste activated sludge metagenome:HS2","2023-03-13","China","Hunan","Changsha",null,null,"probable_urban","municipal_wastewater","city-level location without samp