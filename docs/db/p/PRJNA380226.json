{"v":"3.0.0","project":{"accession":"PRJNA380226","title":"Microbial diversity (16S rRNA gene) at different stages of a wastewater treatment plant","description":"Unveiling the relationships between bacterial populations and ARGs variations over wastewater treatment may contribute to improve the processes and, therefore, ARG control. In this study, conducted at a full-scale UWTP, the bacterial community and ARGs variations as well as the associations between both were characterized over treatment. Bacterial community composition (16S rRNA Illumina sequencing) and ARGs abundance (real-time PCR) were characterized in raw wastewater, secondary effluent and after UV disinfection samples.","organism":"wastewater metagenome","data_type":"Targeted loci environmental","center_name":"ESB-UCP","submission_date":"2017/03/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN06640824","Metagenome or environmental sample from wastewater metagenome","2015-06-16","Portugal","Porto","Porto",41.1746,-8.6115,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","wastewater treatment plant",null,null,null,null,"coordinate","PT",2735943,"verified","text+coordinates",null,"Portugal: Porto",2015],["SAMN06640825","Metagenome or environmental sample from wastewater metagenome","2015-07-14","Portugal","Porto","Porto",41.1746,-8.6115,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","wastewater treatment plant",null,null,null,null,"coordinate","PT",2735943,"verified","text+coordinates",null,"Portugal: Porto",2015],["SAMN06640826","Metagenome or environmental sample from wastewater metage