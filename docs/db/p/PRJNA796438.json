{"v":"3.0.0","project":{"accession":"PRJNA796438","title":"Bacterial Community Structure in the Main City Section of Chongqing","description":"In order to understand the diversity and influencing factors of microbial community in watershed that heavily affected by anthropogenic activities, Chongqing's central urban area in the upper section of the Three Gorges Reservoir were selected to be the study area in this research. High-throughput sequencing technology were used to measure statistical analysis of biological information; Student's T-test were used to test the difference of diversity index and correlation analysis was used to study influencing factors. We hope it could provide referencefor a influence mechanism of Bacteria Community changes in water.","organism":null,"data_type":"Raw sequence reads","center_name":"Chongqing Jiaotong Universaty","submission_date":"2022/01/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN24857021","Metagenome or environmental sample from urban metagenome","2020-06-23","China","Chongqing","Chongqing",29.28,106.32,"confirmed_urban",null,"explicit urban setting at sample level","water environmental sample",null,null,null,null,"coordinate","CN",1814906,"verified","text+coordinates",null,"China:Chongqing",2020],["SAMN24857022","Metagenome or environmental sample from urban metagenome","2020-09-15","China","Chongqing","Chongqing",29.28,106.32,"confirmed_urban",null,"explicit urban setting at sample level","water environmental sample",null,null,null,null,"coordinate","CN",1814906,"verified","text+coordinates",null,"China:Chongqing",2020],["SAMN24857023","Metagenome or environmental sample from 