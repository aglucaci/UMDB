{"v":"3.0.0","project":{"accession":"PRJNA389500","title":"The Influence of Geosmin and 2-Methylisoborneol on the Microbial Community Structure in a Recirculating Aquaculture System","description":"The secondary metabolites, geosmin and 2-methylisoborneol (MIB) are known to taint fish with an undesirable, earthy-muddy taste and odor. Also in recirculating aquaculture systems (RAS) the problem of off-flavored fish is increasingly reported. In an earlier study on a zero-discharge recirculating system, we showed that geosmin and MIB are removed by microbial communities residing in the treatment compartments of the system. In the present study, the microbial community structure and its change as a result of geosmin and MIB enrichment, was examined in the nitrifying trickling filter and in the digestion basin of this zero-discharge system.","organism":"aquatic metagenome","data_type":"Raw sequence reads","center_name":"Hebrew University","submission_date":"2017/06/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN07200917","MIMARKS Survey related sample from aquatic metagenome","2016-06-01","Israel","Central District","Reẖovot",31.9048,34.8046,"uncertain",null,"no environmental-sample evidence",null,"aquaculture biome","aquaculture","water",null,"coordinate","IL",293725,"verified","text+coordinates",null,"Israel: Rehovot",2016],["SAMN07200919","MIMARKS Survey related sample from aquatic metagenome","2016-06-01","Israel","Central District","Reẖovot",31.9048,34.8046,"uncertain",null,"no environmental-sample evidence",null,"aquaculture biome","aquaculture","water",null,"coordinate","IL",293725,"verified","text+coordinates",null,"Isr