{"v":"3.0.0","project":{"accession":"PRJNA1490251","title":"Microalgal-bacterial granular sludge (MBGS) under different light/dark cycles","description":"This dataset provides metagenomic sequencing information from microalgal-bacterial granular sludge (MBGS) systems operated under different light/dark cycles (LDCs) (12 h/12 h, 4 h/4 h, and 2 h/2 h). It was generated to elucidate LDC-driven microbial selection, functional differentiation, and nitrogen transformation pathways in algal-bacterial wastewater treatment systems. This dataset may facilitate further studies on microbial ecology and metabolic regulation in light-driven biological wastewater treatment processes.","organism":null,"data_type":"Raw sequence reads","center_name":"chongqing university","submission_date":"2026/07/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61419146","Y1_2.R1","2024-12","China","Chongqing","Chongqing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor samples",null,null,null,null,"city","CN",1814906,"probable","text","region's main city","China: Chongqing",2024],["SAMN61419148","Y1_3.R1","2025-02","China","Chongqing","Chongqing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor samples",null,null,null,null,"city","CN",1814906,"probable","text","region's main city","China: Chongqing",2025],["SAMN61419150","Y2_2.R1","2024-12","China","Chongqing","Chongqing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor samples",null,null,null,null,"city","CN",181