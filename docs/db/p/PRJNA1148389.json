{"v":"3.0.0","project":{"accession":"PRJNA1148389","title":"Dynamics of Bacterial Communities in Constructed Wetlands: Investigating the Impact of Electroconductive Materials in Laboratory-Scale Rhizosphere Reactors","description":"This study investigates the efficiency of three Planted Fixed Bed Reactors (PFRs) within Constructed Wetlands (CWs), which are engineered systems designed to mimic the natural self-purification processes of aquatic environments. The PFRs were tested with conductive materials, specifically graphite and biochar, to assess their impact on treatment efficiency, compared to a control reactor filled with gravel. Molecular analysis based on qPCR and metagenomic sequencing revealed an increased presence of the electroactive Geobacteraceae family in reactors with conductive materials, particularly on their surfaces. This suggests that conductive materials may affect the microbial community structure within these systems.","organism":null,"data_type":"Raw sequence reads","center_name":"Helmholtz Centre for Environmental Research","submission_date":"2024/08/15 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43199539","MIMARKS Survey related sample from wastewater metagenome","2020-06-01","Germany","Saxony-Anhalt","Halle (Saale)",51.49605958,11.93817738,"non_environmental",null,"laboratory or culture material",null,"wastewater","bioreactor","graphite",null,"coordinate","DE",2911522,"probable","coordinates",null,"Germany",2020],["SAMN43199540","MIMARKS Survey related sample from wastewater metagenome","2020-06-01","Germany","Saxony-Anhalt","Halle (Saale)",51.49605958,11.93817738,"non_environmental",null,"labora