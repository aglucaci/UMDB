{"v":"3.0.0","project":{"accession":"PRJNA630810","title":"Bacterial contributions to triclosan degradation in actual domestic wastewater denitrification system revealed by oligotyping, metagenomic and DNA-based stable isotope probing","description":"The extensive use of triclosan (TCS) leads to the discharge of TCS into wastewater treatment plants, and TCS are subject to microbial transformations during biological wastewater treatment. However, relatively little is known about the identity of organisms capable of assimilating emerging contaminants. In this study, DNA-based stable isotope probing (DNA-SIP) was used to investigate biodegradation and assimilation of TCS by mixed microbial communities collected from a full-scale wastewater treatment plant bioreactors in Beijing City.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2020/05/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN14845396","Metagenome or environmental sample from activated sludge metagenome","2019-10-09","China","Beijing","Beijing",39.87,116.47,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","activated sludge",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2019],["SAMN14845397","Metagenome or environmental sample from activated sludge metagenome","2019-10-10","China","Beijing","Beijing",39.87,116.47,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","activated sludge",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",nu