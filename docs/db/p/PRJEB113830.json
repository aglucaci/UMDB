{"v":"3.0.0","project":{"accession":"PRJEB113830","title":"Metagenomic investigation of side-stream PN/A disturbance in a full-scale wastewater treatment plant","description":"This study investigated the impacts of stable and disturbed side-stream partial nitritation–anammox (PN/A) operation on nitrogen removal performance, greenhouse gas emissions, and microbial community dynamics in a full-scale municipal wastewater treatment plant in the United Kingdom. The plant employed an integrated Anoxic–Aerobic–Anaerobic Digestion (AD)–PN/A configuration, and disturbance of the PN/A process was associated with increased organic loading from AD dewatering liquor. Shotgun metagenomic sequencing was performed on samples collected from the AD unit, PN/A reactor, Anoxic tank, and Aerobic tank during both operational phases. The dataset was generated to characterize microbial community composition, functional gene profiles, and putative nitrogen- and methane-cycling pathways associated with process deterioration and greenhouse gas emission potential. These data support analyses of microbial ecology and process performance in full-scale wastewater treatment systems under changing operational conditions.","organism":null,"data_type":"Other","center_name":"University of Surrey","submission_date":"2026/09/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA122737190","TW01","2023-03-07","United Kingdom",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","GB",null,"unresolved",null,null,"United Kingdom",2023],["SAMEA122737191","TW02","2023-03-07","United