{"v":"3.0.0","project":{"accession":"PRJNA1438615","title":"Auto-floating microalgal granule","description":"Enrichment of auto-floating microalgal granules. This study presents a simple and effective approach to improve microalgae-based wastewater treatment by enabling microalgae to naturally float and aggregate, making them easier to collect. The process works reliably under practical, non-sterile conditions and leads to the formation of stable structures that enhance both separation and treatment performance. Overall, it offers a low-cost and efficient solution for nutrient removal and biomass recovery.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Galway","submission_date":"2026/03/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56542514","MIMARKS Survey related sample from wastewater metagenome","2023-12-10","Ireland","Connacht","Galway",53.27,-9.05,"uncertain",null,"environmental sample; urban association not established",null,"aquatic biome","wastewater treatment","wastewater",null,"coordinate","IE",2964180,"probable","coordinates",null,"Ireland",2023],["SAMN56542515","MIMARKS Survey related sample from wastewater metagenome","2024-02-06","Ireland","Connacht","Galway",53.27,-9.05,"uncertain",null,"environmental sample; urban association not established",null,"aquatic biome","wastewater treatment","wastewater",null,"coordinate","IE",2964180,"probable","coordinates",null,"Ireland",2024],["SAMN56542516","MIMARKS Survey related sample from wastewater metagenome","2024-03-11","Ireland","Connacht","Galway",53.27,-9.05,"uncertain",null,"environmental sample; urban association not establishe