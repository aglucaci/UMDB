{"v":"3.0.0","project":{"accession":"PRJNA344832","title":"Bacterial 16S rRNA gene diversity of wastewater used in microbial fuel cell","description":"This study evaluates the microbial community and bioelectrochemical activities in microbial fuel cell (MFC) using industrial petrochemical and domestic microbial consortia. The investigation of the microbial consortia aimed at degrading 2,4-dichlorophenol (2,4-DCP) and generating electricity. Community wide bacterial 16S rRNA gene diversity was employed for identifying taxa involved in the MFC bioelectrochemical activities and phenolic degradation. The industrial microbial consortium (IMC) performed relatively well in generating the voltage outputs of 360 mV with 40% phenolic degradation as compared to domestic microbial consortium (DMC) with voltage output of 220 mV and 60% phenolic degradation. Arcobacter and Cloacibacterium in DMC was found to be important genera for the 2,4-DCP degradation while Bacillus dominated IMC contributing in electricity generation and the 2,4-DCP degradation in the MFC. These results have provided new insights about phenolics fed MFC.","organism":"wastewater metagenome","data_type":"Targeted loci environmental","center_name":"University of South Australia","submission_date":"2016/09/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN05846327","MIMS Environmental/Metagenome sample from wastewater metagenome","2015-08","Australia","South Australia","Adelaide",-34.920622,138.605879,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"wastewater in microbial fuel cell","domestic wastewater replicate 1","b