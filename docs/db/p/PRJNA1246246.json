{"v":"3.0.0","project":{"accession":"PRJNA1246246","title":"Deciphering microbial responses to H2S inhibition of typical functional microorganisms in anaerobic digestion ecosystems","description":"This project explores how typical functional microbial groups, such as sulfate-reducing bacteria (SRB), methanogens, and syntrophic bacteria respond to hydrogen sulfide (H2S) stress during anaerobic digestion of sulfate-rich wastewater. By comparing sequencing batch reactors (SBRs) and continuous flow reactors (CFRs) under different COD/sulfate ratios, the study provides insights into microbial degradation performance, community dynamics, and detoxification mechanisms under sulfide inhibition.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Galway","submission_date":"2025/04/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN47771444","Wastewater sludge from SBR reactor with COD/Sulfate=2:1","2024-01-09","Ireland","Connacht","Galway",53.2784,-9.0622,"non_environmental",null,"laboratory or culture material",null,"wastewater treatment plant [ENVO:00002043]","anaerobic bioreactor [ENVO:00002124]","anaerobic sludge [ENVO:00002129]",null,"coordinate","IE",2964180,"verified","text+coordinates",null,"Ireland: University of Galway, Galway",2024],["SAMN47771445","Wastewater sludge from SBR reactor with COD/Sulfate=1:1","2024-01-09","Ireland","Connacht","Galway",53.2784,-9.0622,"non_environmental",null,"laboratory or culture material",null,"wastewater treatment plant [ENVO:00002043]","anaerobic bioreactor [ENVO:00002124]","anaerobic sludge [ENVO:00002129]",null,"coordinate","IE",2964180,"verified","text+coordina