{"v":"3.0.0","project":{"accession":"PRJNA1456810","title":"Dosage and timing both matter: promoting synergism in carrier enhanced microalgal-bacterial granules by external bicarbonate","description":"Microalgal-bacterial biofilm formed on small-sized carriers could develop carrier-enhanced microalgal-bacterial granules (CEMBGs) and overcome the long establishment obstacle in conventional microalgal bacterial granular sludge (MBGS) systems. To unveil the importance of fine-tuning external IC application, this study investigated the influence of both external bicarbonate dosage and addition timing on CEMBGs growth characteristics, microalgal photosynthesis properties, microalgal-bacterial interactions, pollutants removal performances, community shifts, and C/P/N metabolism pathways.","organism":null,"data_type":"Raw sequence reads","center_name":"Dalian University of Technology","submission_date":"2026/04/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57424882","Metagenome or environmental sample from sludge metagenome",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","activated sludge from a sewage treatment works",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN57424883","Metagenome or environmental sample from sludge metagenome",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","carrier-enhanced microalgal-bacterial granules",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN57424884","Metagenome or environmental sample from sludge metagenome",null,n