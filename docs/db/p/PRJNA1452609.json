{"v":"3.0.0","project":{"accession":"PRJNA1452609","title":"Marine, terrestrial, and atmospheric microbial diversity in a coastal Arctic environment","description":"Our study aims at providing data on Arctic Ocean waters as sources of atmospheric biogenic INP by disentangling the relative roles of indigenous microbial activity and terrestrial runoff. Identifying the dominant drivers of coastal marine INP concentrations is essential for predicting how Arctic INP sources may evolve under a warming climate. To address this, we studied temporal and spatial variations in INP concentrations in coastal waters off Disko Island, Western Greenland. Bacterial and microalgal communities were analysed to identify correlations with biogenic INP abundance, and meteoric water fractions were used to quantify the contribution of terrestrial runoff. In addition, we examined ambient aerosol samples collected from a nearby foreland to characterise and quantify airborne bacterial cells and biogenic INP concentrations in this Arctic coastal environment.","organism":null,"data_type":"Raw sequence reads","center_name":"Aarhus University","submission_date":"2026/04/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57239397","NC-01","2024","Greenland",null,null,null,null,"probable_urban","air_dust","city-level location without sample-site confirmation",null,"Air microbiome","Control NC1 air","Control NC1 air",null,"city","GL",null,"unresolved",null,null,"Greenland: Disko Island",2024],["SAMN57239398","Air-S03","2023-05-20","Greenland","Qeqertalik","Qeqertarsuaq",69.231783,-53.555278,"probable_urban","air_dust","city-level location without sample-site 