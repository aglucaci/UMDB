{"v":"3.0.0","project":{"accession":"PRJNA957578","title":"Motivation of reactive species by coupling calcium peroxide and peroxydisulfate for synergistic removal of sulfamethoxazole and hydrocortisone in waste activated sludge","description":"In this study, two typical pharmaceuticals and personal care products (PPCPs), sulfamethoxazole and hydrocortisone, were selected as the target pollutants. The synergic effects of calcium peroxide coupled with peroxydisulfate on the removal of PPCPs from municipal sludge was explored, and the synergic mechanism of calcium peroxide coupled with peroxydisulfate in the removal of sulfamethoxazole and hydrocortisone was further analyzed. On this basis, the effect of calcium peroxide coupled with peroxydisulfate as sludge pretreatment technology on sludge post-treatment was evaluated.","organism":null,"data_type":"Raw sequence reads","center_name":"Donghua University","submission_date":"2023/04/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN34257921","Control-0d","2022-12-19",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN34257922","CaO2-0d","2022-12-19",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN34257923","PDS-0d","2022-12-19",null,null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only","reactor sample",null,nul