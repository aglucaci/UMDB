{"v":"3.0.0","project":{"accession":"PRJNA1460336","title":"Solar panel surface metagenome Metagenome","description":"This project characterizes fungal communities colonizing solar panel surfaces using long read metagenomic sequencing. Samples were collected from three solar panel installations in North Carolina, USA, representing a gradient of surrounding agricultural land use (25.74 percent, 39.66 percent, and 95.60 percent cultivated land). At each site, microbial material was collected by swabbing a defined 5 x 5 cm area of panel surface using sterile swabs pre-moistened with phosphate-buffered saline (PBS). The resulting metagenomic data were used to assess fungal community composition and functional potential across sites with differing environmental context.","organism":"surface metagenome","data_type":"Metagenome","center_name":"Duke University","submission_date":"2026/04/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN57592070","MIMS Environmental/Metagenome sample from metagenome","2024-03-24","United States","North Carolina","Clinton",35.04224,-78.33136,"uncertain",null,"environmental sample; urban association not established",null,"built environment","Hope Mills Panel 1 Sample 1","biofilm",null,"coordinate","US",4461101,"probable","coordinates",null,"USA: North Carolina",2024],["SAMN57592071","MIMS Environmental/Metagenome sample from metagenome","2024-03-24","United States","North Carolina","Clinton",35.04224,-78.33136,"uncertain",null,"environmental sample; urban association not established",null,"built environment","Hope Mills Panel 1 Sample 2","biofilm",null,"coordinate","US",4461101,"probable","coordinates