{"v":"3.0.0","project":{"accession":"PRJNA1045004","title":"Profiling of microbial communities of wastewater-driven microalgal biofilms grown with ATS-systems","description":"Solar-driven ATS (algal turf scrubber) system may remediate wastewater by supporting the development and growth of periphytic microbiomes that function and interact in a highly dynamic manner through symbiotic interactions. Applying ITS and 16S rRNA gene amplicon sequencing, we profiled the microbial communities of microbial biofilms from ATS-systems operated with municipal wastewater (mWW), diluted cattle and pig manure (CattleM and PigM) and bio-gas plant effluent supernatant (BGE) in comparison to the initial inocula and the respective wastewater substrates.The obtained informations should expand our understanding of the microbiome structure and functioning within the ATS-based wastewater treatment process.","organism":null,"data_type":"Raw sequence reads","center_name":"Bielefeld University","submission_date":"2023/11/25 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN38415413","16S rRNA amplicon","2021-09-23","Germany","North Rhine-Westphalia","Lichtenau",51.634,8.875,"non_urban",null,"environmental sample from a non-urban site","cattle manure 1",null,null,null,null,"coordinate","DE",2878133,"verified","text+coordinates",null,"Germany: Farm, Lichtenau",2021],["SAMN38415414","16S rRNA amplicon","2021-09-23","Germany","North Rhine-Westphalia","Lichtenau",51.634,8.875,"non_urban",null,"environmental sample from a non-urban site","cattle manure 2",null,null,null,null,"coordinate","DE",2878133,"verified","text+coordinates",null,"Germany: Farm, Lichtenau"