{"v":"3.0.0","project":{"accession":"PRJNA874871","title":"prokaryote sequencing in a wastewater treatment plant of Ria de Vigo","description":"DNA metabarcoding technique was used to explore the prokaryote diversity and community structure in wastewater and mussel samples collected in spring and winter 2020-2021 as well as the efficiency of the treatment in a wastewater treatment plant (WWTP) in Ria de Vigo (NW, Spain). Samplings included raw wastewater from the inlet stream (M1), the discharge water after the disinfection treatment (M3) and mussels used as bioindicators of possible contamination of the marine environment.Our results showed the potential of the DNA metabarcoding technique for monitoring studies and confirm the application in Wastewater-Based Epidemiology (WBE) and environmental contamination studies to detect multiple pathogens that are circulating thorough the population and also to detect release of pathogens after the depuration treatment that can directly affect the aquaculture sector and even human and veterinary health.","organism":null,"data_type":"Raw sequence reads","center_name":"IIM-CSIC","submission_date":"2022/08/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN30593218","M1.13.May.20","2020-05-13","Spain","Galicia","Baiona",42.0,-8.0,"non_urban",null,"BioProject indicates an agricultural or industrial source","raw wastewater1",null,null,null,null,"coordinate","ES",3128462,"verified","text",null,"Spain:Baiona, Ria de Vigo",2020],["SAMN30593219","M1.20.May.20","2020-05-20","Spain","Galicia","Baiona",42.0,-8.0,"non_urban",null,"BioProject indicates an agricultural or industrial source","raw wast