{"v":"3.0.0","project":{"accession":"PRJNA1285338","title":"DPAO-anammox coupling in A2/O system with sidestream phosphorus release for nutrient removal","description":"Microbial community analysis of a modified A2/O wastewater treatment system implementing sidestream phosphorus release to enable simultaneous DPAO-anammox coupling. The system maintained ultra-long SRT (180 days) for anammox while achieving >99% phosphorus removal through metabolic rejuvenation of DPAOs. 16S rRNA and metagenomic sequencing revealed Dechloromonas enrichment and its synergistic interaction with Candidatus Brocadia, enabling efficient nutrient removal under carbon-limited conditions (COD/N=2.5) with 90% phosphorus recovery as vivianite.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2025/07/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49762074","1","2024-01-01","China","Beijing","Beijing",39.92,116.43,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","1",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China:Beijing",2024],["SAMN49762075","2","2024-04-10","China","Beijing","Beijing",39.92,116.43,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","2",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China:Beijing",2024],["SAMN49762076","3","2024-07-19","China","Beijing","Beijing",39.92,116.43,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","3",null,null,null,null,"coordinate