{"v":"3.0.0","project":{"accession":"PRJNA1429842","title":"Elevated suspended particulate matter reorganises carbon fraction in mangrove ecosystems","description":"Mangrove wetlands are a core component of blue carbon ecosystems worldwide. Elevated suspended particulate matter (SPM) in natural waters is a ubiquitous environmental stressor, yet its effects on the carbon cycling of mangroves remain poorly unelucidated. Here, we conducted a 90-day microcosm experiment using Kandelia obovata, a representative mangrove species, and integrated high-resolution chemical and biological profiling to systematically elucidate how SPM loading affects mangrove carbon-cycling processes.","organism":null,"data_type":"Raw sequence reads","center_name":"CHONGQINGJIAOTONGUNIVERSITY","submission_date":"2026/02/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56256273","W1-0","2024-10-24",null,null,null,null,null,"uncertain",null,"no environmental-sample evidence","water samles",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN56256274","W2-0","2024-10-24",null,null,null,null,null,"uncertain",null,"no environmental-sample evidence","water samles",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN56256275","W3-0","2024-10-24",null,null,null,null,null,"uncertain",null,"no environmental-sample evidence","water samles",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2024],["SAMN56256276","W4-30","2024-10-24",null,null,null,null,null,"uncertain",null,"no environmental-sample evidence","water samles",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,20