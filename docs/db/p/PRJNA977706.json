{"v":"3.0.0","project":{"accession":"PRJNA977706","title":"Eukaryotic biodiversity in surface waters of the eastern North Pacific","description":"An uncrewed surface vessel, USV Surveyor, and an automated eDNA sample collection device, the Environmental Sample Processor, were used to obtain eDNA samples autonomously over a 4,200 km, 29 day voyage in the eastern North Pacific Ocean. We used DNA metabarcoding (Illumina MiSeq) of cytochrome c oxidase subunit 1 (COI) to investigate the eukaryotic diversity across the transect. Also included in the data set are control samples including positive and negative controls collected by the autonomous sampler, positive controls samples collected by standard laboratory methods, extraction blanks, and no template controls from PCR amplification.","organism":null,"data_type":"Raw sequence reads","center_name":"Monterey Bay Aquarium Research Institute","submission_date":"2023/05/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN35531458","Surveyor2021_SFtoHI_SC60_A98_archive_bac_prePositive_04jun21","2021-06-04T23:30Z/2021-06-05T06:30Z","United States",null,null,36.80792,-121.824,"non_urban",null,"environmental sample from a non-urban site","Montery Bay","ocean biome [ENVO_01000048]|marine biome [ENVO:00000447]","sea water environment ENVO_01000321","waterborne particulate matter (ENVO:01000436)",null,"coordinate","US",null,"unresolved","coordinates",null,"Pacific Ocean: Monterey Bay",2021],["SAMN35531459","Surveyor2021_SFtoHI_SC59_A88_archive_bac_prePositive_04jun21","2021-06-05T01:29Z/2021-06-05T08:29Z","United States",null,null,36.80792,-121.824,"non_urban",null,"environmental sample fro