{"v":"3.0.0","project":{"accession":"PRJNA1152766","title":"Large-scale swine wastewater Raw sequence reads","description":"This study adopts high-throughput sequencing technology to characterize the structure of microbial community water samples from various treatment processes in a stably operating swine wastewater treatment system (SWTS) to determine the main functional bacteria and their changing rules in each treatment process. Furthermore, the correlation analysis between environmental factors and microbial communities is used (1) to determine functional microorganisms that play essential roles in pollutant degradation and (2) to search for environmental factors that drive variations in microbial community structure and abundance to lay a theoretical foundation for subsequent microbial community regulation.","organism":"wastewater metagenome","data_type":"Raw sequence reads","center_name":"Fujian Academy of Agricultural Sciences","submission_date":"2024/08/27 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43387862","CK_1","2024-04-15","China","Fujian","Jian’ou",27.02,118.3,"uncertain",null,"conflicting evidence: environmental and host/clinical","swine wastewater",null,null,null,"natural / free-living","coordinate","CN",1806167,"probable","coordinates",null,"China: Fujian",2024],["SAMN43387863","CK_2","2024-04-15","China","Fujian","Jian’ou",27.02,118.3,"uncertain",null,"conflicting evidence: environmental and host/clinical","swine wastewater",null,null,null,"natural / free-living","coordinate","CN",1806167,"probable","coordinates",null,"China: Fujian",2024],["SAMN43387864","CK_3","2024-04-15","China","Fujian","Jian’ou",