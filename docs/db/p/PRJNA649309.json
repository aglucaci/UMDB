{"v":"3.0.0","project":{"accession":"PRJNA649309","title":"Phages associated with dominant functional bacteria in activated sludge plants","description":"In the activated sludge process, many functional populations have been recognized to be vital for wastewater treatment performance. However, scientific information on phages associated with the important functional populations is rather scarce. In this study, phage sequences (vOTUs) were retrieved from the metagenomic data generated from the activated sludges in four full-scale activated sludge plants. Using the prediction methods based on oligonucleotide frequency, we linked many vOTUs to the dominant functional bacteria.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Chinese Academy of Sciences","submission_date":"2020/07/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN15663114","Metagenome or environmental sample from activated sludge metagenome","2017-12","China","Beijing","Beijing",39.96,116.51,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","wastewater treatment plant A",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2017],["SAMN15663115","Metagenome or environmental sample from activated sludge metagenome","2017-12","China","Beijing","Beijing",39.96,116.51,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","wastewater treatment plant A",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2017],["SAMN15663116","Metagenome or environmental sample from activated sludge 