{"v":"3.0.0","project":{"accession":"PRJNA1427215","title":"Metagenomic and metatranscriptomic insights into microbial community and nitrogen metabolism in an Anammox-dominated biofilm reactor","description":"This project aims to: (1) investigate the microbial community succession during the enrichment process; (2) reconstruct high-quality metagenome-assembled genomes (MAGs) of key functional populations, including AnAOB, ammonia-oxidizing bacteria (AOB), and denitrifiers; (3) elucidate the metabolic pathways responsible for nitrogen removal, with a focus on the coupling between partial nitrification, endogenous denitratation, and Anammox; and (4) link gene expression patterns to reactor performance via metatranscriptomic analysis. This dataset provides valuable genomic resources for understanding AnAOB ecology and the metabolic interactions within a self-sustaining nitrogen-removing consortium. It supports the development of simplified, energy-saving wastewater treatment processes.","organism":null,"data_type":"Raw sequence reads","center_name":"Hainan University","submission_date":"2026/02/23 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN55907234","MIMARKS Survey related sample from wastewater metagenome","2025-08-21","China","Hainan","Haikou",20.04,110.19,"non_environmental",null,"laboratory or culture material",null,"Aquatic","Laboratory bioreactor","Activated sludge",null,"coordinate","CN",1809078,"probable","coordinates",null,"China: Hainan",2025],["SAMN55907235","MIMARKS Survey related sample from wastewater metagenome","2025-09-14","China","Hainan","Haikou",20.04,110.19,"non_environmental",null,"laboratory or cultur