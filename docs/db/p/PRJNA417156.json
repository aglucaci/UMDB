{"v":"3.0.0","project":{"accession":"PRJNA417156","title":"Air microbiome raw sequence reads","description":"Bacteria are highly abundant in airborne samples and vary substantially above different terrestrial land use sources. Several studies suggest that the air serves not only as a conduit for dispersing terrestrially-sourced microorganisms, but also as a microbial ecosystem harboring metabolically active bacterial communities. This study was designed to examine how a gradient of impervious surface area located in Kalamazoo County in southwest Michigan influenced airborne bacterial community structure and microbial community function. The results indicate that impervious surface area was not the main land use feature contributing to airborne microbial community variation. Instead, the relative abundance of Ruminococcaceae, related to a proximity to grasslands, best explained variation in bacterial community structure.","organism":null,"data_type":"Raw sequence reads","center_name":"Western Michigan University","submission_date":"2017/11/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN07977738","airBow_GTACATACCGGT_L001_merge","2015-04-11","United States","Michigan","Kalamazoo",42.3245,-85.53825,"uncertain",null,"environmental sample; urban association not established","air",null,null,null,"Air Microbiome","coordinate","US",4997787,"probable","coordinates",null,"USA: Michigan",2015],["SAMN07977739","airFtCuster_GGAGACAAGGGA_L001_merge","2015-04-11","United States","Michigan","Augusta",42.325617,-85.3525,"uncertain",null,"environmental sample; urban association not established","air",null,null,null,"Air Microbiome","coordi