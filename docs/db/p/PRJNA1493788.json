{"v":"3.0.0","project":{"accession":"PRJNA1493788","title":"Examining the Ice-Nucleating Particles from the Gruvebadet Observatory (ExINP-GVB)","description":"This project investigates the sources, abundance, composition, and ice-nucleating properties of atmospheric aerosols in the Atlantic Arctic to improve understanding of cloud feedbacks contributing to Arctic amplification. Using complementary online and offline ice-nucleating particle (INP) measurement techniques at the Gruvebadet Observatory, the international research team will characterize natural and anthropogenic INPs, including biological aerosols and marine-derived compounds, across multiple ice nucleation pathways. The resulting observations will be integrated with atmospheric model simulations to develop improved Arctic ice nucleation parameterizations, enabling more accurate representation of mixed-phase cloud processes and aerosols - cloud interactions in regional and global climate models.","organism":null,"data_type":"Raw sequence reads","center_name":"Agricultural University of Athens","submission_date":"2026/07/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61572271","ExINP.GVB.8","2023-03-25","Svalbard and Jan Mayen",null,null,78.9167,11.9333,"probable_urban","air_dust","city-level location without sample-site confirmation","Ambient atmospheric aerosol",null,null,null,null,"coordinate","SJ",null,"unresolved",null,null,"Svalbard:Gruvebadet",2023],["SAMN61572272","ExINP.GVB.10","2023-03-28","Svalbard and Jan Mayen",null,null,78.9167,11.9333,"probable_urban","air_dust","city-level location without sample-site confirmation","Ambient atmospheric aerosol",n