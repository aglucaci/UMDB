{"v":"3.0.0","project":{"accession":"PRJNA1290913","title":"Seasonal dynamics of bacterial communities in activated sludge and treated wastewater from a full-scale WWTP Raw sequence reads","description":"This project contains 16S rRNA gene amplicon sequencing data from 12 environmental samples collected from a full-scale wastewater treatment plant (WWTP) located in Poland. Samples were obtained from activated sludge (AS) and treated wastewater (TW) during different seasons (December, February, April, June, July, October) to investigate temporal variations in microbial community composition. The study aims to evaluate the seasonal dynamics of bacteria in both stages of the treatment process, providing insights into microbiome stability and performance in engineered ecosystems. The data include DNA and cDNA sequence reads obtained by the 16S rRNA method, diversity of microflora composition, and metadata on dates and sample type and information on nitrfication related genes described as KO (KEGG Orthology) number. The dataset can be used for analysis of microbiome dynamics in wastewater treatment processes, seasonality analysis and comparative microbial characterization. This dataset supports a research publication currently in preparation. License: Attribution 4.0 International (CC BY 4.0) DOI: 10.57755/ch3h-7g44","organism":null,"data_type":"Raw sequence reads","center_name":"Institute of Biochemistry and Biophysics Polish Academy of Sciences","submission_date":"2025/07/14 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49973840","Activated sludge sample","2022-12-18","Poland","Lower Silesia","Wrocław",51.16,17.17,"probable_ur