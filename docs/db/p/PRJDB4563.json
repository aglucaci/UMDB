{"v":"3.0.0","project":{"accession":"PRJDB4563","title":"Microbial community structure of enriched cultures fed with nitrous oxide as an electron acceptor","description":"This project focused on nitrous oxide reducing bacteria, which contribute to mitigation of nitrous oxide in natural environments and engineered systems. We developed a special enrichment device, termed a Gas Permeable Membrane Device, continuously supplying nitrous oxide as an electron acceptor. This device allows enrichment of N2O reducing bacteria to be grown on the membrane surface. The device was inoculated with activated sludge from a municipal wastewater treatment plant in Tokyo, Japan. The microbial community structure of the enriched culture was investigated using V4 region of 16S rRNA gene.","organism":"bioreactor sludge metagenome","data_type":"Other","center_name":"Hosomi and Terada Laboratory, Chemical Engineering, Depertment of Technology, Tokyo University of Agriculture and Technology","submission_date":"2018/02/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00046845","Enriched cultures fed with nitrous oxide_Inoculum_activated sludge","2013-11-20","Japan","Tokyo","Tokyo",35.655,139.508,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,"wasetewater treatment plant","activated sludge",null,"coordinate","JP",1850147,"verified","text+coordinates",null,"Japan:Tokyo, Kitatama-ichigo municipal wastewater treatment plant",2013],["SAMD00046846","Enriched cultures fed with nitrous oxide_GPMD1_day12","2013-12-02","Japan","Tokyo","Tokyo",35.698,139.518,"non_environmental",null,"laboratory or culture mate