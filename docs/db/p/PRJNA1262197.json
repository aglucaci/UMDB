{"v":"3.0.0","project":{"accession":"PRJNA1262197","title":"Anammox sludge sequencing","description":"The objectives of this study are to demonstrate the phenomenon during anammox recovery with mixed inactive-active sludge, to determine whether growth promotion of anammox bacteria from active sludge, activity recovery of anammox bacteria from inactive sludge, or a combination of both mechanisms explains the phenomenon, and to elucidate how growth of anammox bacteria from active sludge is promoted and why anammox bacteria from inactive sludge may fail to recover. By proposing a low-cost strategy, this study highlights the potential of reusing inactive sludge to achieve rapid anammox process recovery.","organism":null,"data_type":"Raw sequence reads","center_name":"Tongji University","submission_date":"2025/05/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN48451327","Metagenome or environmental sample from sludge metagenome","2021-07-21","China","Shanghai","Shanghai",31.28,121.49,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,"laboratory","coordinate","CN",1796236,"probable","coordinates",null,"China:laboratory",2021],["SAMN48451329","Metagenome or environmental sample from sludge metagenome","2021-07-21","China","Shanghai","Shanghai",31.28,121.51,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,null,null,null,"laboratory","coordinate","CN",1796236,"probable","coordinates",null,"China:laboratory",2021],["SAMN48451331","Metagenome or environmental sample from sludge metagenome","2021-07-21","China","Shanghai","Shanghai",31.28,121.53,"uncertain",null,"