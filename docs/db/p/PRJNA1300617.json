{"v":"3.0.0","project":{"accession":"PRJNA1300617","title":"Microbial diversity in A/O MBBR using methanol and food waste condensate","description":"This study investigates the microbial community structures in both suspended sludge and biofilm attached to carriers in an anaerobic/oxic moving bed biofilm reactor (A/O MBBR) treating synthetic wastewater. Two external carbon sources, methanol and food waste condensate (FWC), were applied to assess their influence on microbial diversity. High-throughput 16S rRNA gene sequencing was conducted to compare the bacterial communities in different carbon source conditions and biomass types, and to evaluate the resulting denitrification performance.","organism":null,"data_type":"Raw sequence reads","center_name":"Sungkyunkwan University","submission_date":"2025/08/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN50420657","MIMS Environmental/Metagenome sample from wastewater metagenome","2024-10-21","South Korea","Gyeonggi-do","Suwon",37.2931,126.9744,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"Urban wastewater treatment ecosystem","Lab-scale A/O MBBR reactor","Nitrified anaerobic digestion effluent with methanol",null,"coordinate","KR",1835553,"verified","text+coordinates",null,"South Korea: Suwon",2024],["SAMN50420658","MIMS Environmental/Metagenome sample from wastewater metagenome","2024-10-21","South Korea","Gyeonggi-do","Suwon",37.2931,126.9745,"confirmed_urban","municipal_wastewater","explicit urban setting at sample level",null,"Urban wastewater treatment ecosystem","Lab-scale A/O MBBR reactor","Nitrified anaerobic digestion effluent