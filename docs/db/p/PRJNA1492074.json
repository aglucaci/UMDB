{"v":"3.0.0","project":{"accession":"PRJNA1492074","title":"Mixed microbial community composition for PHA synthesis under different biomass densities.","description":"We constructed mixed microbial consortia capable of PHA production at different biomass densities and examined their community composition as a function of biomass density, with the aim of determining whether PHA synthesis is feasible under high-density conditions. This work offers microbiological insights that can inform future process development for PHA production from high-density biomass, while also underscoring the potential for significant improvements in process productivity.","organism":null,"data_type":"Raw sequence reads","center_name":"Tsinghua university","submission_date":"2026/07/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61474755","Metagenome or environmental sample from bioreactor metagenome","2023-05-14","China","Beijing","Beijing",39.9,116.4,"non_environmental",null,"laboratory or culture material","activated sludge from a wastewater treatment plant",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2023],["SAMN61474756","Metagenome or environmental sample from bioreactor metagenome","2023-05-20","China","Beijing","Beijing",39.9,116.4,"non_environmental",null,"laboratory or culture material","activated sludge from a wastewater treatment plant",null,null,null,null,"coordinate","CN",1816670,"verified","text+coordinates",null,"China: Beijing",2023],["SAMN61474757","Metagenome or environmental sample from bioreactor metagenome","2023-05-26","China","Beijing","Beijing",39.9,116.4,"non_environm