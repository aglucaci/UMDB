{"v":"3.0.0","project":{"accession":"PRJNA727685","title":"Mobile phones as Fomites_ Community derived","description":"A study was undertaken to profile 5 phones swabbed through shotgun metagenome sequencing runs. Of note, the 5 phone swabs were each plated into three different agar media plates (Horse blood agar plate, MacConkey agar plate, Nutrient agar plate ; Therefore 15 plates in total were grown. All colonies from each type of plates (HBA or MAC or NA), were pooled together and therefore resulted into three pools (HBA pooled colonies, MAC pooled colonies and NA pooled colonies). These three pools were subject to individual metagenome shotgun sequencing on Illumina NEXT SEQ 550 platform.","organism":null,"data_type":"Raw sequence reads","center_name":"BOND UNIVERSITY","submission_date":"2021/05/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN19030067","HBA Pooled_R1","2020-09-26","Australia","Queensland","Gold Coast",-28.016666,153.399994,"uncertain",null,"no environmental-sample evidence","Community-HBA-1",null,null,null,"MOBILE PHONE surface-HBA-1","coordinate","AU",2165087,"verified","text+coordinates",null,"Australia: Gold Coast",2020],["SAMN19030069","MAC Pooled_R1","2020-09-26","Australia","Queensland","Gold Coast",-28.016666,153.399994,"uncertain",null,"no environmental-sample evidence","Community-MAC-1",null,null,null,"MOBILE PHONE surface-MAC-1","coordinate","AU",2165087,"verified","text+coordinates",null,"Australia: Gold Coast",2020],["SAMN19030071","NUT Pooled_R1","2020-09-26","Australia","Queensland","Gold Coast",-28.016666,153.399994,"uncertain",null,"no environmental-sample evidence","Community-NUT-1",n