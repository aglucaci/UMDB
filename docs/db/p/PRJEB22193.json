{"v":"3.0.0","project":{"accession":"PRJEB22193","title":"Microbial communities in drinking water systems","description":"This study contains five samples from different drinking water microbial communities. Each sample is an aggregate sample of several biological replicates. Three samples are bulk water samples (one cold-water and two warm-water communities) and two are biofilms samples.The goal of this study was to complement a 16S marker-gene based study. In this study we have investigated the differences in microbial community between hot and cold water systems and between two buildings receiving the same incoming water.","organism":null,"data_type":"Other","center_name":"NORWEGIAN INSTITUTE OF PUBLIC HEALTH","submission_date":"2019/09/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA104228697","Shower hose biofilm metagenomics","2015-11","Norway",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","NO",null,"unresolved",null,null,"Norway",2015],["SAMEA104228698","Shower hose biofilm metagenomics","2015-11","Norway",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","NO",null,"unresolved",null,null,"Norway",2015]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","release_date","spots","bases","avg_length","size_mb","scientific_name","urban_status","experiment_title"],"runs":[["ERR2105756",0,"ERX2163034","WGS","WGS","METAGENOMIC","RANDOM","PAIRED","ILLUM