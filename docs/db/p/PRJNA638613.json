{"v":"3.0.0","project":{"accession":"PRJNA638613","title":"Wastewater microplastic microbiome characterization","description":"The goal of the study was to quantify and characterize microplastics in three critical stages of wastewater treatment, and to analyze bacterial assemblages attached to microplastics to determine if the composition of these assemblages changes during transport through domestic WWTPs. We sampled two activated sludge WWTPs in Illinois that are point sources of microplastics to their receiving streams. For each plant we characterized microplastics and associated bacterial assemblages in raw sewage, effluent water, and sludge.","organism":"wastewater metagenome","data_type":"Targeted loci environmental","center_name":"Loyola University Chicago","submission_date":"2020/06/10 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN15214591","Bartlett Sludge Microplastic Biofilm","2014-11-21","United States","Illinois","Elgin",41.96835,-88.16514,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","sewage sludge","Wastewater Treatment Plant","Sludge","Microplastic",null,"coordinate","US",4890864,"probable","coordinates",null,"USA: Illinois",2014],["SAMN15214592","Bartlett Sludge Microplastic Biofilm","2014-11-21","United States","Illinois","Elgin",41.96835,-88.16514,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","sewage sludge","Wastewater Treatment Plant","Sludge","Microplastic",null,"coordinate","US",4890864,"probable","coordinates",null,"USA: Illinois",2014],["SAMN15214593","Bartlett Sludge Microplastic Biofilm","2014-11-21","United States","I