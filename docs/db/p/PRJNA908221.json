{"v":"3.0.0","project":{"accession":"PRJNA908221","title":"Co-occurrence and cooperation between comammox and anammox bacteria in full scale municipal wastewater treatment system.","description":"Cooperation between comammox and anammox bacteria for wastewater treatment has been recently reported in lab-scale systems including synthetic community constructs. However, there are no reports of full-scale municipal wastewater treatment systems with co-occurrence and co-operation between comammox and anammox bacteria. Here, we report intrinsic and extant kinetics as well as genome-resolved microbial community characterization of a full-scale integrated fixed film activated sludge (IFAS) system where comammox and anammox bacteria co-occur and appear to drive nitrogen removal and loss.","organism":"activated sludge metagenome","data_type":"Genome sequencing and assembly","center_name":"Northeastern University","submission_date":"2023/01/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN32031799","IFA1","2021-12","United States","Virginia",null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","wastewater treatment plant",null,null,null,null,"region","US",null,"unresolved",null,null,"USA: Virginia",2021],["SAMN32031800","IFA2","2021-12","United States","Virginia",null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","JAMMSM wastewater treatment plant",null,null,null,null,"region","US",null,"unresolved",null,null,"USA: Virginia",2021],["SAMN32031801","IFA3","2021-12","United States","Virginia",null,null,null,"confirmed_urban","municipal_waste