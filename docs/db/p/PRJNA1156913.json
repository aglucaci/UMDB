{"v":"3.0.0","project":{"accession":"PRJNA1156913","title":"The effects of different doses of compound enzyme preparations on the production performance, meat quality and rumen microorganisms of yak were studied by metagenomics and transcriptomics","description":"In this paper, we mainly investigated the effects of different dosages of enzyme complexes on the performance, meat quality and rumen microorganisms of yaks through macrogenomics and transcriptomics, and found that the levels of dietary enzyme complexes significantly affected the growth performance, rumen fluid PH and serum biochemical indexes. Moreover, the differences of dominant strains and CAZymes among different groups were found by macrogenomics, and the differential genes among different groups and those differential genes were significantly enriched in those receptor pathways were found by transcriptomics. Finally, the correlation of microorganisms with genes of growth and metabolism was analyzed by combined macrogenomics and transcriptomics.","organism":null,"data_type":"Raw sequence reads","center_name":"Lanzhou Institute of Husbandry and Pharmaceutical Sciences of Chinese Academy of Agricultural Scienc","submission_date":"2024/09/04 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN43503021","LE1","2023","China","Gansu",null,null,null,"non_environmental",null,"host-derived or clinical material","rumen",null,null,null,"yak","city","CN",null,"unresolved",null,null,"China: Qinghai City, Gansu Province",2023],["SAMN43503022","LE2","2023","China","Gansu",null,null,null,"non_environmental",null,"host-derived or clinical material","rumen",null,null,null,"yak","city