{"v":"3.0.0","project":{"accession":"PRJDB3078","title":"Community composition of known and uncultured archaeal lineages in anaerobic wastewater treatment sludge","description":"It has long been thought that Archaea play a crucial role in biological wastewater treatment systems. In order to investigate known and uncultured archaeal community composition existed in anaerobic wastewater treatment sludges, we performed 16S rRNA gene sequencing by using Archaea-specific primer set. Phylotypes belonging to phylum Euryarchaeota were the most predominant in methanogenic, denitrifying and nitrogen-/phosphate-removing wastewater treatment sludge. Besides, Deep Sea Hydrothermal Vent Group 6 (DHVEG-6), Terrestrial Miscellaneous Euryarchaeotal Group, WSA2 and Miscellaneous Crenarchaeotic Group were detected in each sludge sample. This project can provide a archaeal diversity in various sludges.","organism":"uncultured archaeon","data_type":"Targeted Locus (Loci)","center_name":"Nagaoka University of Technology","submission_date":"2015/01/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00019277","MIMARKS Survey related sample from uncultured archaeon","2012-09","Japan","Niigata","Nagaoka",37.423109,138.778282,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"wastewater treatment plant","anaerobic sludge","water",null,"coordinate","JP",1856199,"probable","coordinates",null,"Japan",2012],["SAMD00019278","MIMARKS Survey related sample from uncultured archaeon","2013-09","Japan","Niigata","Nagaoka",37.423109,138.778282,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"wastewater tre