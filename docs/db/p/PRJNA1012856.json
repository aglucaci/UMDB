{"v":"3.0.0","project":{"accession":"PRJNA1012856","title":"Host range of antibiotic resistance genes in Croatian wastewater","description":"Influent and effluent from two wastewater treatment plants (WWTPs) in Croatia were studied to identify bacterial hosts of clinically important beta-lactamase genes (blaTEM, blaVIM, blaOXA-48-like) and observe how their composition changes during the treatment process. EpicPCR was used to identify the hosts of antibiotic resistance genes , and 16S rRNA amplicon sequencing to study the entire bacterial community. Different wastewater sources contributed to the significant differences in bacterial composition of the wastewater between the two WWTPs studied. The number of hosts carrying investigated antibiotic resistance genes was reduced by wastewater treatment.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Helsinki","submission_date":"2023/09/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37277959","Metagenome or environmental sample from wastewater metagenome","2021-09","Croatia","Zagreb","Zagreb",45.7897,16.089,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","raw wastewater",null,null,null,null,"coordinate","HR",3186886,"probable","coordinates",null,"Croatia: Zagreb",2021],["SAMN37277960","Metagenome or environmental sample from wastewater metagenome","2021-09","Croatia","Zagreb","Zagreb",45.7897,16.089,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","raw wastewater",null,null,null,null,"coordinate","HR",3186886,"probable","coordinates",null,"Croatia: Zagreb"