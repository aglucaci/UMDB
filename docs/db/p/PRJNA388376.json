{"v":"2.0.0","project":{"accession":"PRJNA388376","title":"Toxicity assessment of pharmaceutical compounds on mixed microbial culture using respirometric technique:  the role of microbial community structure","description":"The toxicity of three pharmaceutical compounds (caffeine, sulfamethoxazole and carbamazepine) commonly found in municipal wastewater was evaluated by a simple respirometric procedure using mixed microbial culture enriched from activated sludge. Three (SP1, SP2, VM2) microbial cultures were used to assess whether or not the long term exposure to a toxicant could affect microbial resistance. The composition and diversity of bacterial communities were determined by targeting the hypervariable V6–V8 regions of the 16S ribosomal RNA gene using bar-coded pyrosequencing.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Patras","submission_date":"2017/05/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution"],"samples":[["SAMN07176093","Sample Control culture",null,"Spain",null,"Madrid",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","activated sludge","WWTPs",null,"activated sludge",null,"city"],["SAMN07176094","Sample Acclimated culture",null,"Spain",null,"Madrid",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","activated sludge","WWTPs",null,"activated sludge",null,"city"],["SAMN07176095","Sample Reactor",null,"Spain",null,"Madrid",null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical","activated sludge","WWTPs",null,"activated sludge",null,"city"]],"run_cols":["accession","sample","experiment","assay_class","library_strategy","library_source","library_selection","library_layout","platform","instrument_model","rele