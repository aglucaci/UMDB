{"v":"3.0.0","project":{"accession":"PRJEB7129","title":"Diversity of Clostridium cluster I community in a biogas plant","description":"A two stage biogas production plant was analyzed for the diversity of bacteria from Clostridium cluster I and presence of its pathogenic members. A group specific approach was used to amplify 16S rRNA genes of Clostridium cluster I. Amplicons were sequences by 454 technology. Samples include substrates used for anaerobe digestion, i.e. maize silage, whole plant silage and cattle manure, and material from main and secondary digester. The biogas plant consisted of two parallel digesters one operated with cattle manure, the other without.","organism":null,"data_type":"Other","center_name":"Johann Heinrich von Thunen-Institut, Federal Research Institute for Rural Areas, Forestry and Fisheries","submission_date":"2014/11/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA2738240","MD I (a)","2012-06-05","Germany",null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2012],["SAMEA2738241","MD I (b)","2012-06-05","Germany",null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2012],["SAMEA2738242","MD II (a)","2012-06-05","Germany",null,null,null,null,"non_urban",null,"BioProject indicates an agricultural or industrial source",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2012],["SAMEA2738243","MD II (b)","2012-06-05","Germany",n