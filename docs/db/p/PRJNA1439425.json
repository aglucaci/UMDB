{"v":"3.0.0","project":{"accession":"PRJNA1439425","title":"Metagenomic characterization of wastewater-derived microalgal consortia and associated bacterial communities","description":"This study investigates the taxonomic composition and functional potential of microalgal consortia derived from wastewater environments. Shotgun metagenomic sequencing was used to characterize microbial communities associated with multiple consortia and to identify genes related to photosynthesis, central carbon metabolism, stress response, and nutrient transport. The analysis aimed to better understand microbial interactions within microalgae bacteria systems and to identify bacterial taxa that may influence algal growth dynamics. These data provide insights into the ecological structure and metabolic capabilities of wastewater derived algal consortia and contribute to ongoing efforts to develop stable and productive algal bacterial systems for applications in biofuel production, wastewater treatment, and environmental biotechnology.","organism":null,"data_type":"Raw sequence reads","center_name":"FLORIDA A AND M UNIVERSITY","submission_date":"2026/03/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN56580005","Wastewater microalgal consortium S3G1","2022","United States","Florida","Tallahassee",30.4383,-84.2807,"uncertain",null,"environmental sample; urban association not established","waste water treatment facility",null,null,null,"Environment (water)","coordinate","US",4174715,"probable","coordinates",null,"USA: Florida",2022],["SAMN56580006","Wastewater microalgal consortium S3G2","2022","United States","Florida","Tallahassee",30.4383,-84