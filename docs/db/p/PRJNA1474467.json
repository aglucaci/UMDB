{"v":"3.0.0","project":{"accession":"PRJNA1474467","title":"Metagenomes from Aerobic Granular Sludge sampled at different reactor depths","description":"Aerobic Granular Sludge (AGS) biomass samples were collected from a full-scale AGS wastewater treatment plant (WWTP) in Utrecht, The Netherlands. Sampling was conducted at depths of 0.5 m (Bottom) and 4.5 m (Top) from reactor bottom, with triplicates taken for each depth during both anaerobic and aerobic phases. Each sample was further sieved into four microbial aggregate size fractions: flocs (0-200 um), small granules (200-500 um), medium granules (500-1000 um), and large granules (>1000 um), resulting in 48 final samples.","organism":null,"data_type":"Raw sequence reads","center_name":"King Abdullah University of Science and Technology (KAUST)","submission_date":"2026/06/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60597925","AGS from full-scale WWTP Utrecht_AN_LG_1","2023-11-22","The Netherlands","Utrecht","Utrecht",52.0907,5.1214,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","aerobic granular sludge from full-scale wastewater treatment plant",null,null,null,null,"coordinate","NL",2745912,"verified","text+coordinates",null,"Netherlands: Utrecht",2023],["SAMN60597926","AGS from full-scale WWTP Utrecht_AN_MG_1","2023-11-22","The Netherlands","Utrecht","Utrecht",52.0907,5.1214,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","aerobic granular sludge from full-scale wastewater treatment plant",null,null,null,null,"coordinate","NL",2745912,"verified","text+coordinates",null,"Netherlands: Utrecht