{"v":"3.0.0","project":{"accession":"PRJEB111196","title":"Improvement of machine learning models on wastewater data","description":"In this research an improved machine learning model for bacterial community time-series prediction and outlier detection is presented that allows stronger seasonality modeling and generalizability. The proposed architecture combines temporal convolutional networks and recurrent layers with a dedicated metadata branch, decoupling environmental variables from microbial trajectories. An attention mechanism captures long-range temporal dependencies, while a gating strategy adaptively integrates microbial and metadata representations. This design increases sensitivity to temperature-driven and seasonal effects while maintaining robustness across datasets with varying metadata availability. Empirical evaluation demonstrates improved predictive performance and more reliable anomaly detection compared to baseline approaches.","organism":null,"data_type":"Other","center_name":"Institute for Artificial Intelligence in Medicine, University Hospital Essen","submission_date":"2026/07/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA122710368","WWKL2403","2024-04-11","Germany",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2024],["SAMEA122710369","WWKL2404","2024-04-16","Germany",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","DE",null,"unresolved",null,null,"Germany",2024],["SAMEA122710370","WWKL2405