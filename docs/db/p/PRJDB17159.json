{"v":"3.0.0","project":{"accession":"PRJDB17159","title":"Isolation and characterization of electrochemically active bacteria from an anaerobic digester treating food wastes","description":"Studies have used anaerobic-digester sludge as inoculum for bioelectrochemical systems, such as microbial fuel cells, while limited studies have identified electrochemically active bacteria thriving in anaerobic digesters. In the present work, single-chamber MFCs were operated using anaerobic-digester effluents as the sole source of organics and microbes, and attempts were made to isolate EAB from anode biofilms.","organism":"microbial fuel cell metagenome","data_type":"Targeted Locus (Loci)","center_name":"Tokyo University of Pharmacy and Life Sciences","submission_date":"2024/04/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00662117","AB5","2023","Japan","Tokyo","Hachiōji",35.6693,139.4257,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"biome","wastewater treatment plant","industrial wastewater",null,"coordinate","JP",1863440,"verified","text+coordinates",null,"Japan:Tokyo, Hachioji",2023],["SAMD00662118","AB40","2022","Japan","Tokyo","Hachiōji",35.6693,139.4257,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"biome","wastewater treatment plant","industrial wastewater",null,"coordinate","JP",1863440,"verified","text+coordinates",null,"Japan:Tokyo, Hachioji",2022],["SAMD00662119","PM5","2023","Japan","Tokyo","Hachiōji",35.6693,139.4257,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,"biome","wastewater tre