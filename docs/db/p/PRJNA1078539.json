{"v":"3.0.0","project":{"accession":"PRJNA1078539","title":"Distinct microbial communities enriched in water-saturated and unsaturated reactors influence the performance of integrated Hydroponics-Microbial Electrochemical Technology","description":"The goal is to understand the microbial communities involved in the wastewater treatment andelectricity generation performance of the integrated Hydroponics-Microbial ElectrochemicalTechnology (iHydroMET), which is an emerging decentralized domestic wastewatermanagement solution for point sources. After 4 months of system operation with clarifiedsewage, the microbial communities enriched in different zones of the reactors of iHydroMETsystem operated in water-saturated (i.e., water-logged) and unsaturated (i.e., free-drained)conditions were assessed. Samples were taken from five places of both conditions, which areanodic (Graphite + granular activated carbon) zone, bottom cocopeat, top cocopeat, cathodicgraphite, and influent sewage.","organism":null,"data_type":"Raw sequence reads","center_name":"Indian Institute of Science Education and Research Mohali","submission_date":"2024/02/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40005178","Anodic zone of water-unsaturated reactor","2021-06-10","India","Chandigarh","Chandigarh",30.665,76.73,"uncertain",null,"environmental sample; urban association not established","iHydroMET reactor",null,null,null,null,"coordinate","IN",1274746,"probable","coordinates",null,"India: IISER Mohali, Punjab",2021],["SAMN40005179","Bottom cocopeat of water-unsaturated reactor","2021-06-10","India","Chandigarh","Chandigarh",30.665,76.73,"uncertain",null