{"v":"3.0.0","project":{"accession":"PRJNA1399719","title":"Metagenomic Analysis of Microbial Communities in Rhizosphere Soil of Cruciferous Crops under Different Treatment Strategies for Root Disease Management","description":"This study aims to investigate the effects of various treatment strategies-including resistant/susceptible cultivars, slow/quick-release agents, and soil amendments (lime, Yuhuang-san, and their combinations)-on the rhizosphere microbial community structure and function in cruciferous crops affected by root disease. Using metagenomic sequencing, we compare the taxonomic and functional profiles of microbial communities across different experimental groups to identify key microbes and pathways associated with disease suppression or progression. The findings may contribute to the development of sustainable strategies for root disease control in cruciferous crops through microbiome modulation.","organism":null,"data_type":"Raw sequence reads","center_name":"Guizhou University","submission_date":"2026/01/08 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54504974","Ljw1-1",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN54504975","Ljw1-2",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor sample",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN54504976","Ljw1-3",null,null,null,null,null,null,"uncertain",null,"environmental sample; urban association not establishe