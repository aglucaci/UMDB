{"v":"3.0.0","project":{"accession":"PRJEB90827","title":"Organic structure impact on gypsum converting communities grown on sewage","description":"In order to assess a viable carbon source for the bioconversion of waste gypsum, we examined if the organic makeup of municipal sewage sludge affects sulfate reduction and methanogenesis. We compared an environmental microbial community (EMC) from an abandoned sulfur mine in Sicily, Italy, and an indigenous sewage microbial community (ISMC), in two sludge mixes: effluent amended with partially digested or undigested sludge. All reactors showed comparable rates of sulfate reduction ($\\sim$10-15 mM sulfide by day 32), gypsum dissolution, alkalinity generation and chemical oxygen demand (COD) removal. However, CH$_4$ production was significantly suppressed in treatments combining enriched microbial communities with partially digested sludge, with an 88.9\\% reduction compared to all other groups.","organism":null,"data_type":"Other","center_name":"MIT","submission_date":"2025/06/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA118581364","ID10_BEFORE_GRW","2023-06-04","Italy",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","IT",null,"unresolved",null,null,"Italy",2023],["SAMEA118581365","ID11_BEFORE_GRW","2023-06-04","Italy",null,null,null,null,"probable_urban","municipal_wastewater","urban context stated at BioProject level only",null,null,null,null,null,"country","IT",null,"unresolved",null,null,"Italy",2023],["SAMEA118581366","ID17_BEFORE_GRW","2023-06-04","Italy",null,null,null,null