{"v":"3.0.0","project":{"accession":"PRJNA1474244","title":"Disintegrated halophilic aerobic granular sludge restoration using zinc oxide nanoparticles: Synergistic effects of fungal toxicity inhibition and extracellular polymeric substances production","description":"Halophilic aerobic granular sludge (HAGS) buking caused by filamentous fungal overgrowth limits its engineering application. This study applied zinc oxide nanoparticles (ZnO NPs) to recover disintegrated HAGS. This study showed that 1 and 10 mg/L of ZnO NPs could effectively inhibit the filamentous fungal overgrowth (the population size decreasing by 66.42% and 89.78% respectively), and successfully restored HAGS structure.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing University of Technology","submission_date":"2026/06/03 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60588741","sludge","2025-03-01","China","Beijing","Beijing",39.87,116.48,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",1816670,"probable","coordinates",null,null,2025],["SAMN60588742","sludge","2025-03-01","China","Beijing","Beijing",39.87,116.48,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",1816670,"probable","coordinates",null,null,2025],["SAMN60588743","sludge","2025-03-01","China","Beijing","Beijing",39.87,116.48,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"coordinate","CN",1816670,"probable","coordinates",null,null,2025],["SAMN60588744","sludge","2025-03-01","China","