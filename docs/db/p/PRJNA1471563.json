{"v":"3.0.0","project":{"accession":"PRJNA1471563","title":"Microbial community dynamics in WY-4 bioaugmented UASB reactors under complex shock","description":"This project investigates the effects of homoacetogenic bioaugmentation on microbial community dynamics, process stability, and recovery performance in UASB reactors subjected to short-term complex shock conditions. High-throughput sequencing of bacterial and archaeal 16S rRNA genes was performed to characterize microbial communities in control and WY-4-amended reactors. Bacterial communities were analyzed using the V3-V4 region amplified with primers 341F/806R, while archaeal communities were analyzed using the V4-V5 region amplified with primers 524F/958R. Amplicon sequencing was conducted on the Illumina NovaSeq platform. The study aims to reveal how homoacetogenic strain WY-4 influences anaerobic microbial ecology and contributes to improved reactor resilience and recovery after environmental disturbances.","organism":null,"data_type":"Raw sequence reads","center_name":"Harbin Institute of Technology","submission_date":"2026/05/28 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN60456651","MIMARKS Survey related sample from anaerobic digester metagenome","2025-06-15","China","Heilongjiang","Harbin",45.757054,126.681183,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,"engineered wastewater treatment system biome","upflow anaerobic sludge blanket reactor","anaerobic sludge",null,"coordinate","CN",2037013,"verified","text+coordinates",null,"China: Harbin",2025],["SAMN60456652","MIMARKS Survey related sample from anaer