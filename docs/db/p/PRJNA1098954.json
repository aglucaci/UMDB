{"v":"3.0.0","project":{"accession":"PRJNA1098954","title":"Danish study on Aeromonas spp. from WWTP inlet to river outflow.","description":"Investigating the abundance, diversity, and antimicrobial resistance (AMR) profile of Aeromonas isolates in wastewater and receiving water bodies of Danish treatment plants, this study aims to evaluate the efficacy of culture-based methods in capturing their role in AMR dissemination. By comparing cultivation results with community-wide 16S RNA gene amplicon sequencing, we seek to determine the utility of Aeromonas-targeted cultivation in assessing AMR fluxes at wastewater/environment interfaces. Understanding the contribution of treatment plant discharges to the dissemination of antibiotic-resistant aeromonads into river water is important for assessing and mitigating AMR risks in aquatic environments","organism":null,"data_type":"Raw sequence reads","center_name":"University of Copenhagen","submission_date":"2024/04/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN40925300","Ejby Moelle WWTP inlet","2022-06-08","Denmark",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","water",null,null,null,null,"country","DK",null,"unresolved",null,null,"Denmark",2022],["SAMN40925301","Ejby Moelle WWTP outlet","2022-06-09","Denmark",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level","water",null,null,null,null,"country","DK",null,"unresolved",null,null,"Denmark",2022],["SAMN40925302","Upstream discharge point Ejby Moelle WWTP","2022-06-10","Denmark",null,null,null,null,"confirmed_urban","