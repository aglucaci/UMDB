{"v":"3.0.0","project":{"accession":"PRJNA1479945","title":"Sulfur metabolism shapes AOM efficiency in different media","description":"Anaerobic oxidation of methane (AOM) is a key process mitigating methane emissions. This study compares two long-term enrichment cultures derived from distinct environmental samples: landfill cover soil (reactor P) and reservoir sediment (reactor J). The data include 16S rRNA amplicon sequences (V3-V4 region, bacteria and archaea) and metagenomic sequences from both reactors. These datasets were used to investigate how microbial sulfur metabolic strategies (sulfur recycling vs. sulfur storage) shape AOM efficiency. Raw data are provided for community analysis, metagenome assembly, and functional gene annotation.","organism":null,"data_type":"Raw sequence reads","center_name":"jinan university","submission_date":"2026/06/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61000736","Metagenome or environmental sample from activated sludge metagenome","2022-12","China","Guangdong","Guangzhou",23.01,113.41,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor",null,null,null,"environment","coordinate","CN",1809858,"verified","text+coordinates",null,"China: Guangzhou",2022],["SAMN61000737","Metagenome or environmental sample from activated sludge metagenome","2022-12","China","Guangdong","Guangzhou",23.01,113.41,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","reactor",null,null,null,"environment","coordinate","CN",1809858,"verified","text+coordinates",null,"China: Guangzhou",2022],["SAMN61000738","Meta