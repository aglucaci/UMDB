{"v":"3.0.0","project":{"accession":"PRJNA1185162","title":"Dynamics of Reactive Oxygen Species and Nitrogen Cycling in Soils as a Mechanism for Volatile Reactive Nitrogen Oxide Production","description":"Metagenomic (DNA) and metatranscriptomic (RNA) Illumina NovaSeq sequencing of soil samples to determine a potential microbial mechanism involving reactive oxygen species that could influence the production of volatile reactive nitrogen species from soil. Soil was sampled in October 2022. Soil was sampled from two locations, University of Warwick Stratford Innovation Campus, and Coventry City, corresponding to low (around 1000 residents), and high (around 400,000 residents) human population. Within these locations, samples were taken from three land-use types: agricultural, woodland, and built. Here, we define built soil as that found within one metre of human made structure such as buildings and car parks.There were three replicates of each land-use type and each location.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Warwick","submission_date":"2024/11/12 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN44694585","Metagenome or environmental sample from soil metagenome","2021","United Kingdom","England","Banbury",52.12,-1.36,"probable_urban","soil_greenspace","city-level location without sample-site confirmation","U.K. Soil",null,null,null,"Soil","coordinate","GB",2656406,"probable","coordinates",null,"United Kingdom: Wellesbourne B1 DNA",2021],["SAMN44694586","Metagenome or environmental sample from soil metagenome","2021","United Kingdom","England","Banbury",52.12,-1.36,"probable_urban","so