{"v":"3.0.0","project":{"accession":"PRJNA1135454","title":"Microbial diversity in dental unit waterlines and generated dental bioaerosols affected by waterline disinfection","description":"The effectiveness of dental unit waterline (DUWL) disinfection techniques on bacterial diversity in both dental unit water and dental bioaerosols was assessed. Two DUWL disinfection techniques (iodine-releasing cartridge and plasma sterilization system) were installed in different dental chair units. Dental procedures were conducted, and dental unit water samples and air samples were collected before and after the procedures. These samples were assessed using a metagenomic workflow.","organism":null,"data_type":"Raw sequence reads","center_name":"Faculty of Dentistry, Chulalongkorn University","submission_date":"2024/07/13 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN42481115","BLCT","2023-03-15","Thailand","Bangkok","Bangkok",13.74364736,100.53374974,"uncertain",null,"no environmental-sample evidence","DNase/RNase-free distilled water",null,null,null,null,"coordinate","TH",1609350,"verified","text+coordinates",null,"Thailand: Bangkok",2023],["SAMN42481116","BLTX","2023-03-15","Thailand","Bangkok","Bangkok",13.74364736,100.53374974,"uncertain",null,"no environmental-sample evidence","DNase/RNase-free distilled water",null,null,null,null,"coordinate","TH",1609350,"verified","text+coordinates",null,"Thailand: Bangkok",2023],["SAMN42481117","SLCT","2023-03-15","Thailand","Bangkok","Bangkok",13.74364736,100.53374974,"non_environmental",null,"host-derived or clinical material",null,null,null,null,"Homo sapiens","coordinate","TH",1609350,"ver