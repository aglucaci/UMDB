{"v":"3.0.0","project":{"accession":"PRJNA430711","title":"Metagenome from mesophilic biogas fermenters digesting food waste at different feeding frequencies","description":"Two digesters (CSTRs) were fed the same amount of thermally hydrolyzed food waste each day, with different feeding frequency. Three more digesters treating conventionally hygienized food waste is included in the study. Digesters were operated at mesophilic conditions (37 C) and at 10-60 days HRT. Feeding frequency influenced microbial community structure. Microbial community structure was studied by sequencing of the V3-V4 hypervariable region of the 16S rRNA gene.","organism":"biogas fermenter metagenome","data_type":"Targeted loci environmental","center_name":"NIBIO","submission_date":"2018/01/18 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN08377138","Mesofilic Digestion System D0 timepoint 2 (day 0)","2016-08-25","Norway","Akershus","Ås",59.66226,10.75111,"non_environmental",null,"laboratory or culture material",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge",null,"coordinate","NO",3162797,"verified","text+coordinates",null,"Norway: As",2016],["SAMN08377139","Mesofilic Digestion System DFD timepoint 1 (day 38)","2016-10-02","Norway","Akershus","Ås",59.66226,10.75111,"non_environmental",null,"laboratory or culture material",null,"anthropogenic","anaerobic bioreactor","anaerobic digester sludge",null,"coordinate","NO",3162797,"verified","text+coordinates",null,"Norway: As",2016],["SAMN08377140","Mesofilic Digestion System DFD timepoint 2 (day 44)","2016-10-08","Norway","Akershus","Ås",59.66226,10.75111,"non_environmental",null,