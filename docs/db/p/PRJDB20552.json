{"v":"3.0.0","project":{"accession":"PRJDB20552","title":"Analysis of microbial community structure in a photosynthetic reactor used for secondary treatment in microbial fuel cells","description":"This project explore the microbial community in two photosynthesis reactors. Sampling sites were chosen to represent diverse areas where microbial presence could influence the performance of the photosynthetic process, including site B-F1-IN, B-F1-S, B-F1-FB, B-F1-W; B-F2-IN, B-F2-S, B-F2-FB, B-F2-W; A-F1-IN, A-F1-S, A-F1-FB, A-F1-W; and A-F2-IN, A-F2-S, A-F2-FB, A-F2-W. In this notation, B and A referred to samples taken Phase I and Phase II of reactors, respectively; F1 and F2 represented photosynthesis reactors 1 and 2; and IN, S, FB, and W indicated that the samples were collected from the influent, solution, fibers, and walls of the reactors, respectively. including","organism":"photosynthetic picoeukaryotic metagenome","data_type":"Targeted Locus (Loci)","center_name":"Nagoya Institute of Technology","submission_date":"2025/04/21 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00896959","Influence of reactor 1-before removing biomass 16S","2024-03-11","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample evidence",null,"aquatic biome","seawage","seawage",null,"coordinate","JP",1856057,"verified","text+coordinates",null,"Japan:Aichi, Nagoya",2024],["SAMD00896960","In sollution of reactor 1-before removing biomass 16S","2024-03-11","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample evidence",null,"aquatic biome","seawage","seawage",null,"coordinate","JP",185605