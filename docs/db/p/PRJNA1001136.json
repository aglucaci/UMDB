{"v":"3.0.0","project":{"accession":"PRJNA1001136","title":"archaea in anaerobic digestion of sewage sludge and organic waste","description":"The study aims to investigate the effects and underlying mechanisms of organic ratios in feedstocks on the stability and CH4 production of SSAD. Organic ratios were determined by mixing sewage sludge, pig manure, food waste, and cornstalk based on their contents of carbohydrates, protein, fat, and lignocellulose. Dynamics of bacteria and archaea in response to different ratios of organic components were tracked. Microbial interplay and its correlation with digestate characteristics were deciphered by modular network and Mantel test. Furthermore, key genes involved in organic biodegradation and methane production were predicted to elucidate the underlying mechanisms of organic regulation for advanced SSAD performance.","organism":null,"data_type":"Raw sequence reads","center_name":"China Agricultural University","submission_date":"2023/08/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN36795685","AD0.T1","2021-04-24","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"city","CN",1816670,"probable","text","region's main city","China: Beijing",2021],["SAMN36795686","AD0.T6","2021-04-24","China","Beijing","Beijing",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation",null,null,null,null,null,"city","CN",1816670,"probable","text","region's main city","China: Beijing",2021],["SAMN36795687","AD0.T8","2021-04-24","China","Beijing","Bei