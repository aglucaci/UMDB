{"v":"3.0.0","project":{"accession":"PRJNA380961","title":"Fungal Microbiomes Associated with Green and Non-Green Building Materials","description":"Water-damaged buildings can lead to fungal growth and occupant health problems. Green building materials, derived from renewable sources, are increasingly utilized in construction and renovations. However, the question as to what fungi will grow on these green compared to non-green materials, after they get wet, has not been adequately studied. In this study, we inoculated green and non-green pieces of ceiling tile, composite board, drywall, and flooring with indoor dust containing a complex mixture of naturally occurring fungi. The materials were saturated with water and incubated for two months in a controlled environment. The resulting fungal microbiomes were evaluated using ITS amplicon sequencing.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Cincinnati","submission_date":"2017/03/29 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN06657553","green ceiling tile","2014","United States","Ohio","Cincinnati",39.13,-84.51,"probable_urban","air_dust","city-level location without sample-site confirmation","vacuum dust plus building material form harware store",null,null,null,"house dust","coordinate","US",4508722,"verified","text+coordinates",null,"USA: Cincinnati",2014],["SAMN06657554","green gypsum board","2014","United States","Ohio","Cincinnati",39.13,-84.51,"probable_urban","air_dust","city-level location without sample-site confirmation","vacuum dust plus building material form harware store",null,null,null,"house dust","coordinate","US",450872