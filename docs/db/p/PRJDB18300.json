{"v":"3.0.0","project":{"accession":"PRJDB18300","title":"Microbial community structure analysis in a photosynthesis reactor used for sub-treatment of microbial fuel cells.","description":"This project explore the microbial community in the photosynthesis reactor. The sampling sites were selected to represent diverse are as where the presence of microorganisms could impact the performance of photosynthesis process, including the zeolite on reactor (Zeo-S), those attached to plates submerged in the reactor (Zeo-P), zeolite material (Zeo-Z), and influent the zeolite reactor (referred to as Zeo-in).  Afterward, we determine the function of each microorganism for NH4+ and organic matter removal from sewage.","organism":"photosynthetic picoeukaryotic metagenome","data_type":"Targeted Locus (Loci)","center_name":"Nagoya Institute of Technology","submission_date":"2024/06/24 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMD00794389","zeolite on reactor","2023-06-09","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample evidence",null,"aquatic biome","seawage","seawage",null,"coordinate","JP",1856057,"verified","text+coordinates",null,"Japan:Aichi, Nagoya",2023],["SAMD00794390","attached to plates submerged in the reactor","2023-06-09","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample evidence",null,"aquatic biome","seawage","seawage",null,"coordinate","JP",1856057,"verified","text+coordinates",null,"Japan:Aichi, Nagoya",2023],["SAMD00794391","zeolite material","2023-06-09","Japan","Aichi","Nagoya",35.126765,136.97865,"uncertain",null,"no environmental-sample eviden