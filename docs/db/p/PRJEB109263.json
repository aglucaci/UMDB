{"v":"3.0.0","project":{"accession":"PRJEB109263","title":"Micro and nanoplastics on synthetic wastewater treatment","description":"This study evaluates the long-term accumulation impact of a mixture of micro and nanoplastics (MNPs)—specifically polyethylene, polypropylene, and polystyrene—on a pilot-scale submerged membrane bioreactor (MBR). The results demonstrate high system resilience, maintaining 97% organic matter removal and achieving over 99.99% nanoplastic removal efficiency. MNPs exposure was found to mitigate membrane fouling, likely due to a mechanical scouring effect. While the microbial community structure and diversity experienced moderate shifts, the system showed gradual adaptation to the plastic-induced stress. These findings highlight the suitability of MBR systems for producing high-quality effluent for water reuse applications, even under prolonged MNP loads.","organism":null,"data_type":"Other","center_name":"Instituto IMDEA Agua","submission_date":"2026/07/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA121929605","barcode01","2024-06-25","Spain",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","ES",null,"unresolved",null,null,"Spain",2024],["SAMEA121929606","barcode03","2024-07-08","Spain",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,null,null,null,"country","ES",null,"unresolved",null,null,"Spain",2024],["SAMEA121929607","barcode05","2024-07-22","Spain",null,null,null,null,"uncertain",null,"environmental sample; urban association not established",null,null,nu