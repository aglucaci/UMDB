{"v":"3.0.0","project":{"accession":"PRJEB96189","title":"16S survey of AD inhibition by NaPr in semi-continuous reactors","description":"In this study, four 5-liter reactors (R1, R2, R3, and R4) were operated in semi-continuous mode using municipal sewage sludge. The reactors were semi-continuously fed with different levels of sodium propionate, NaPr (0, 1.95, 7.78, and 13 g.L-1, equivalent to 0, 1.5, 6, and 10 g HPr.L-1) after an acclimation period. The reactors operated for 81 days at 37°C, with a hydraulic retention time of 20 days.","organism":null,"data_type":"Other","center_name":"INRAE Ile de France Jouy en Josas - Antony","submission_date":"2026/07/02 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMEA119518306","NDS_D00_S1a","2023-05-30","France",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","FR",null,"unresolved",null,null,"France",2023],["SAMEA119518307","NDS_D00_S1b","2023-05-30","France",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","FR",null,"unresolved",null,null,"France",2023],["SAMEA119518308","NDS_D40_S2a","2023-07-07","France",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","FR",null,"unresolved",null,null,"France",2023],["SAMEA119518309","NDS_D40_S2b","2023-07-07","France",null,null,null,null,"confirmed_urban","municipal_wastewater","named urban infrastructure at sample level",null,null,null,null,null,"country","FR",null,"unresol