{"v":"3.0.0","project":{"accession":"PRJNA1391013","title":"A Novel Cylindrical Sulfur-Based Carrier (Kaldnes-S) Mediating Diverse S0/HS-/Sn2- Pathways for Enhanced Autotrophic Denitrification: From Lab-Scale Biofilters to Pilot-Scale Applications","description":"Sulfur autotrophic denitrification is a promising biotechnology, and the development of novel sulfur-based biofilm carriers is crucial for its integration into existing wastewater treatment processes. In this study, a novel sulfur carrier (Kaldnes-S) with a cylindrical, hollow structure was developed, and its performance was evaluated in laboratory-scale biofilters and pilot-scale anaerobic baffle biofilm reactors for treating low carbon-to-nitrogen ratio wastewater.","organism":null,"data_type":"Raw sequence reads","center_name":"Beijing Normal University","submission_date":"2025/12/19 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54210920","MIGS Cultured Bacterial/Archaeal sample from Anaerolineaceae","2025",null,null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"wastewater treatment plant","wastewater treatment plant","Secondary effluent from wastewater treatment plant",null,"unknown",null,null,"unresolved",null,null,null,2025],["SAMN54210921","MIGS Cultured Bacterial/Archaeal sample from Thiobacillus","2022",null,null,null,null,null,"uncertain",null,"conflicting evidence: environmental and host/clinical",null,"wastewater treatment plant","wastewater treatment plant","Secondary effluent from wastewater treatment plant",null,"unknown",null,null,"unresolved",null,null,null,2022],["SAMN54210922","MIGS Cultured Bacteri