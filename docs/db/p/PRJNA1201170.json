{"v":"3.0.0","project":{"accession":"PRJNA1201170","title":"Cross-continental comparison of antibiotic resistance and microbiome dynamics in wastewater (revealed by MinION sequencing): Slovakia vs. Taiwan","description":"We conducted a comprehensive analysis of the wastewater resistome, mobilome, and microbiome by sequencing influent and effluent samples collected from WWTPs in Slovakia and Taiwan. Employing ONT sequencing, we were able to comprehensively profile the resistome and mobilome, providing valuable insights into the microbiome dynamics across different geographical contexts. By leveraging the long-read capabilities of ONT, our study identifies complex genomic structures and MGEs associated with ARGs, allowing for a deeper exploration of the microbial interactions and resistance dissemination pathways.","organism":null,"data_type":"Raw sequence reads","center_name":"Slovak Academy of Sciences","submission_date":"2024/12/20 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN45928045","Metagenome or environmental sample from freshwater metagenome","2021-09-22","Taiwan","Taiwan","Taipei",25.03,121.56,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater",null,null,null,"ecological metagenomes","coordinate","TW",1668341,"probable","coordinates",null,"Taiwan:Taipei",2021],["SAMN45928046","Metagenome or environmental sample from freshwater metagenome","2021-07-05","Slovakia","Bratislava Region","Bratislava",48.14,17.1,"uncertain",null,"conflicting evidence: environmental and host/clinical","wastewater",null,null,null,"ecological metagenomes","coordinate","SK",3060972,"verified","text+coordinate