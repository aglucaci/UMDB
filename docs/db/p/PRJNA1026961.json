{"v":"3.0.0","project":{"accession":"PRJNA1026961","title":"Metagenomic sequencing of urban stormwater runoff","description":"Surface water was collected for 10 days of dry weather, then stormwater samples were collected at five locations that ranged in drainage area characteristics. Stormwater and surface water samples were mixed to observe the impact on the resistome, and monitored for 5 days. DNA was extracted from all samples via MP Biomedicals FastDNA Spin Kit. A composite sample of the extracts was prepared for each site and sampling event by combining the triplicate samples by an equal DNA mass. Metagenomic sequencing completed on Illumina NextSeq 2000 platform (151 bp paired end) at a sequencing depth of 650 Mbp. Deposited sequences are full-length, untrimmed reads.","organism":null,"data_type":"Raw sequence reads","center_name":"Marquette University","submission_date":"2023/10/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37769213","SUR_8_3","2023-08-03","United States","Wisconsin","Milwaukee",43.024969,-87.900941,"probable_urban","water_drainage","urban context stated at BioProject level only","surface water",null,null,null,null,"coordinate","US",5263045,"probable","coordinates",null,"USA:Wisconsin",2023],["SAMN37769214","SUR_8_4","2023-08-04","United States","Wisconsin","Milwaukee",43.024969,-87.900941,"probable_urban","water_drainage","urban context stated at BioProject level only","surface water",null,null,null,null,"coordinate","US",5263045,"probable","coordinates",null,"USA:Wisconsin",2023],["SAMN37769215","SUR_8_5","2023-08-05","United States","Wisconsin","Milwaukee",43.024969,-87.900941,"probable_urban",