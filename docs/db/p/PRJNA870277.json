{"v":"3.0.0","project":{"accession":"PRJNA870277","title":"Effect of static magnetic field on hydrogen and n-caproic acid production by dark fermentation with no pretreatment excess sludge as inoculum","description":"The effect of external static magnetic field on hydrogen production and its mechanism were studied by continuous dark fermentation with no pretreatment excess sludge as inoculum. External SMF by adding magnets on both sides of the reactor could accelerate the enrichment of Ethanoligenens and improve the activity of reduced coenzyme I so that the maximum hydrogen yield could reach 6.4 mol H2/mol glu. Moreover, the n-caproic acid production could be increased based on the enrichment of carbon chain extension microorganisms. The decline of hydrogen production was mainly due to hydrogenotrophic methanogenesis and acetic acid accumulation. This study provides a new direction for better understanding the interaction mechanism between magnetic field and microorganisms and improving the value of biological hydrogen production process.","organism":null,"data_type":"Raw sequence reads","center_name":"Xiangtan University","submission_date":"2022/08/17 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN30360224","raw.split.B.0","2020-07-29",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor siample",null,null,null,"Sludge","unknown",null,null,"unresolved",null,null,null,2020],["SAMN30360225","raw.split.A.0","2020-07-29",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","reactor siample",null,null,null,"Sludge","unknown",n