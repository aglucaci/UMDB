{"v":"3.0.0","project":{"accession":"PRJNA1287089","title":"Succession of Microbial Community Structure and Co-occurrence Network Dynamics during the Transition from Anaerobic Sludge to Aerobic Cultivation","description":"The transition between anaerobic and aerobic conditions represents a fundamental ecological process occurring ubiquitously in both natural ecosystems and engineered wastewater treatment systems. The aerobic adaptation process triggers substantial restructuring of microbial community composition in response to environmental gradients, driving functional specialization across diverse microbial taxa. This study employed systematic sampling across critical transition phases: initial anaerobic sludge (D0), early aerobic adaptation (D1, D3, D5), and stabilized aerobic operation (D15, D30), with COD and nitrogen removal efficiencies monitored as key performance metrics throughout the aerobic transition process.","organism":null,"data_type":"Raw sequence reads","center_name":"southwest university","submission_date":"2025/07/05 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN49812546","Metagenome or environmental sample from sludge metagenome","2023-08-25",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","Anaerobic sludge 0",null,null,null,null,"unknown",null,null,"unresolved",null,null,null,2023],["SAMN49812547","Metagenome or environmental sample from sludge metagenome","2023-08-25",null,null,null,null,null,"uncertain",null,"environmental sample; urban association not established","Aerobic sludge 1",null,null,null,null,"unknown",null,null,"unresolved",null,null,nul