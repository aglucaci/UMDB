{"v":"3.0.0","project":{"accession":"PRJNA1527142","title":"Mechanisms insights into stable nitrogen removal and sustained NOB photoinhibition in a photo-rotating biological contactor enhanced PN-algal symbiotic system under dual low temperature and low-ammonia stress","description":"To address the issues of nitrite-oxidizing bacteria (NOB) reactivation and instability in traditional partial nitrification (PN) under low temperature and low NH4+-N conditions, while suspended algal-bacterial symbiotic systems with NOB inhibition potential suffer from severe light shading and are difficult to engineer, this study constructed a blue light irradiated photo-rotating biological contactor coupled with PN-algal symbiosis system to explore the stability of nitrogen transformation, microbial succession and metabolic regulation mechanisms under low-temperature and low-NH4+-N stress.","organism":null,"data_type":"Raw sequence reads","center_name":"Suzhou University of Science and Technology","submission_date":"2026/09/11 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN63069766","Metagenome or environmental sample from sludge metagenome","2025-08-14","China","Jiangsu","Suzhou",31.306782,120.56025,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sluge",null,null,null,null,"coordinate","CN",1886760,"verified","text+coordinates",null,"China:Suzhou",2025],["SAMN63069767","Metagenome or environmental sample from sludge metagenome","2025-09-13","China","Jiangsu","Suzhou",31.306782,120.56025,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sluge",null,nu