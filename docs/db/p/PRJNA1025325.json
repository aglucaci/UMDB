{"v":"3.0.0","project":{"accession":"PRJNA1025325","title":"sludge samples collected from the  pyridine degradation reactors with different co-metabolites","description":"The efficiency of traditional pyridine degradation systems is subpar, and nitrogen removal is given less consideration. This study elucidated the synchronous removal performance of pyridine and pyridine-N when glucose or phenol were added and demonstrated the co-metabolic mechanism. Glucose could speed up pyridine oxidation and improve TN removal effectiveness by enhancing ammonia assimilation. Phenol would hinder pyridine from degrading, although it might remove TN through denitrification.","organism":null,"data_type":"Raw sequence reads","center_name":"Zhengzhou University","submission_date":"2023/10/07 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN37720718","activity sludge sample","2019-03-06","China","Henan","Zhengzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","aerobic reactor",null,null,null,null,"city","CN",1784658,"verified","text",null,"China: Zhengzhou",2019],["SAMN37720719","activity sludge sample","2019-05-07","China","Henan","Zhengzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","aerobic reactor",null,null,null,null,"city","CN",1784658,"verified","text",null,"China: Zhengzhou",2019],["SAMN37720720","activity sludge sample","2019-05-08","China","Henan","Zhengzhou",null,null,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","aerobic reactor",null,null,null,null,"city","CN",1784