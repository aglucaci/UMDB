{"v":"3.0.0","project":{"accession":"PRJNA1338101","title":"Microbiome analysis in female reproductive tract","description":"The aim of this study is to characterise the microbiome of the female reproductive tract (vagina, cervix, and endometrium) and adjacent sites (urine and rectum) using 16S rRNA gene sequencing in women with infertility. A total of 104 participants each provided a comprehensive set of samples during the mid-secretory phase, including a vaginal swab, cervical swab, endometrial Tao Brush, urine sample, and rectal swab. Environmental and procedural negative controls were also collected to ensure data quality.","organism":null,"data_type":"Raw sequence reads","center_name":"University of Granada","submission_date":"2025/10/06 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN52395414","Metagenome or environmental sample from air metagenome","2020-01-20","Spain","Andalusia","Granada",37.19,-3.6,"uncertain",null,"environmental sample; urban association not established","air control",null,null,null,null,"coordinate","ES",2517117,"verified","text+coordinates",null,"Spain: Granada, Granada",2020],["SAMN52395415","Metagenome or environmental sample from air metagenome","2020-02-21","Spain","Andalusia","Granada",37.19,-3.6,"uncertain",null,"environmental sample; urban association not established","air control",null,null,null,null,"coordinate","ES",2517117,"verified","text+coordinates",null,"Spain: Granada, Granada",2020],["SAMN52395416","Metagenome or environmental sample from air metagenome","2020","Spain","Andalusia","Granada",37.19,-3.6,"uncertain",null,"environmental sample; urban association not established","air