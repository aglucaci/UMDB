{"v":"3.0.0","project":{"accession":"PRJNA1395395","title":"Municipal sludge compost Metagenome","description":"Conventional aerobic composting of municipal sludge is often limited by low efficiency and unstable product quality. In this study, high-throughput sequencing was used to evaluate the composting performance of a self-selected hyperthermophilic consortium (NJ) as the experimental group, with a commercial inoculant (SY) as the control. The results showed that NJ exhibited better composting performance, including enhanced organic matter degradation, improved compost stabilization, and higher compost maturity compared with SY. Microbial community analysis indicated that NJ promoted a microbial structure more favorable for high-temperature composting. This study provides microbial evidence supporting the application of hyperthermophilic consortia in municipal sludge composting.","organism":"compost metagenome","data_type":"Metagenome","center_name":"Southeast University","submission_date":"2025/12/30 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN54365302","NJ_1","2023-01-04","China","Jiangsu","Nanjing",32.06,118.78,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge",null,null,null,"municipal sludge compost","coordinate","CN",1799962,"verified","text+coordinates",null,"China:Nanjing",2023],["SAMN54365303","NJ_2","2023-01-05","China","Jiangsu","Nanjing",32.06,118.78,"probable_urban","municipal_wastewater","city-level location without sample-site confirmation","sludge",null,null,null,"municipal sludge compost","coordinate","CN",1799962,"verified","text+coordinates",null,