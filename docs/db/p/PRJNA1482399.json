{"v":"3.0.0","project":{"accession":"PRJNA1482399","title":"Effects of a dispersin-containing detergent on bacterial communities in household washing machines","description":"This study investigates the effects of a dispersin-containing laundry detergent on bacterial communities in household washing machines. Six household washing machines were operated for 60 wash cycles using either a detergent containing dispersin or the same detergent without dispersin. Samples were collected from the pump sump and sump water before and after washing. Bacterial community composition was analysed by Oxford Nanopore full-length 16S rRNA gene amplicon sequencing, and bacterial abundance was quantified by qPCR. The dataset provides sequence data for comparative analyses of bacterial community composition under different detergent formulations.","organism":null,"data_type":"Raw sequence reads","center_name":"Furtwangen University","submission_date":"2026/06/26 00:00","last_update":null},"sample_cols":["accession","title","collection_date","country","region","city","lat","lon","urban_status","urban_context","eligibility_reason","isolation_source","env_broad_scale","env_local_scale","env_medium","host","location_resolution","country_iso2","place_id","location_status","location_method","location_note","geo_loc_raw","collection_year"],"samples":[["SAMN61121919",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN61121920",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN61121921",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,null,null,null,null,"unknown",null,null,"unresolved",null,null,null,null],["SAMN61121922",null,null,null,null,null,null,null,"uncertain",null,"no environmental-sample evidence",null,