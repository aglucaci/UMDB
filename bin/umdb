#!/usr/bin/env bash
# umdb: single entry point for the UMDB harvester and maintenance tasks.
# Works from any directory; always runs against this repository.
set -euo pipefail

# Resolve the repository root even when this file is reached through a symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
REPO_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
cd "$REPO_ROOT"

PY="${UMDB_PYTHON:-python3}"

# Banner: shown once per invocation, on stderr, only in an interactive
# terminal, so piped or redirected output (umdb queries > file) stays clean.
# Disable with UMDB_NO_BANNER=1.
banner() {
  [ -n "${UMDB_NO_BANNER:-}" ] && return 0
  [ -n "${UMDB_BANNER_SHOWN:-}" ] && return 0
  [ -t 2 ] || return 0
  export UMDB_BANNER_SHOWN=1
  local c="" d="" r=""
  if [ -z "${NO_COLOR:-}" ]; then c=$'\033[1;32m'; d=$'\033[2m'; r=$'\033[0m'; fi
  cat >&2 <<EOF
${c} _   _  __  __  ____   ____
| | | ||  \\/  ||  _ \\ | __ )
| | | || |\\/| || | | ||  _ \\
| |_| || |  | || |_| || |_) |
 \\___/ |_|  |_||____/ |____/${r}
${d}  Urban Microbiome Database${r}

EOF
}
banner

# Output detail: -q/--quiet (summaries only), default (stages, progress, ETAs),
# -v/--verbose (every NCBI request, cache hits, per-experiment lines).
# Accepted anywhere on the command line; not stripped for `umdb test`.
if [ "${1:-}" != "test" ] && [ "${1:-}" != "tests" ]; then
  _kept=()
  for _a in "$@"; do
    case "$_a" in
      -v|--verbose) export UMDB_VERBOSITY=2 ;;
      -q|--quiet) export UMDB_VERBOSITY=0 ;;
      *) _kept+=("$_a") ;;
    esac
  done
  set -- ${_kept[@]+"${_kept[@]}"}
fi
# Colour: on when this terminal shows it (children writing through pipes,
# e.g. `tee` in the backfill script, keep it). NO_COLOR or UMDB_COLOR=never
# turn it off.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -z "${UMDB_COLOR:-}" ]; then
  export UMDB_COLOR=always
fi

HARVESTER_CMDS=" crawl daily backfill-year curate-ai "

usage() {
  cat <<'EOF'
umdb: Urban Microbiome Database command line

Harvesting (each finishes by rebuilding docs/db):
  umdb crawl [opts]              paginate the query profiles, newest first
  umdb daily [opts]              records released in the last N days (--recent-days)
  umdb backfill-year --year Y    one calendar year, day by day
  umdb curate-ai [opts]          AI review of harvested records (needs OPENAI_API_KEY)
  umdb run <command> [opts]      same as above ("umdb run crawl ...")

Deep harvest:
  umdb deepest [years] [opts]    deepest possible search, year by year, 2007 .. now:
                                 every profile, every hit, re-fetches existing
                                 records and overwrites old data (= backfill --deepest)
  umdb backfill [years] [opts]   resumable year-by-year search for new records
                                 (e.g. "umdb backfill 2018 2024 --commit"; --help for options)
  umdb compact                   drop superseded records from data/ (newest per run wins)
  umdb repair                    re-fetch BioProjects cached under the wrong accession
  umdb catalog push|pull|status  store the harvested catalog in GitHub Release assets
                                 (pull --merge keeps local records; push --snapshot dates it)
  umdb scrub                     remove api_key/email from stored NCBI URLs (data/, docs/, logs/)
  umdb geo fetch [--force]       download the GeoNames gazetteer used to validate locations
  umdb geo check "USA: Portland, ME" [--lat N --lon E]
                                 show how one location string is resolved

Database and releases:
  umdb db build                  (re)build data/umdb.sqlite from data/ (offline, ~30 s)
  umdb db info                   build metadata and samples per eligibility tier
  umdb db shell                  open the database in sqlite3
  umdb db query "SQL"            run one SQL query (tab-separated output)
  umdb release [--version V]     write a Parquet/TSV release to dist/releases/<V>/
                                 (needs: pip install -r requirements-release.txt)

Data and site:
  umdb export                    rebuild docs/db from data/ (offline)
  umdb serve [port]              preview the website (default port 8000)
  umdb queries                   print the exact discovery queries
  umdb status                    catalog size, eligibility tiers, settings check

Research pipeline (Nextflow; see pipeline/README.md):
  umdb science [opts]            hypothesis tests on the catalog (= nextflow run pipeline ...)
  umdb science test              the same on the synthetic fixture (-profile test)

Development:
  umdb test                      run the offline test suite
  umdb install [dir]             put "umdb" on your PATH (symlink; default ~/.local/bin)
  umdb help                      this message

Output: progress, ETAs and summaries by default, coloured in a terminal.
  -v, --verbose    also show every NCBI request, cache hit and experiment
  -q, --quiet      summaries and warnings only
  NO_COLOR=1       plain output;  UMDB_NO_BANNER=1  hide the banner

Settings are read from .env in the repository root (see .env.example).
Add --help after a harvester command for its options, e.g. "umdb crawl --help".
EOF
}

harvester() { exec "$PY" -m scripts.umdb_harvester "$@"; }

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  run)
    [ $# -eq 0 ] && { echo "usage: umdb run <crawl|daily|backfill-year|curate-ai> [opts]" >&2; exit 2; }
    sub="$1"; shift
    if [[ "$HARVESTER_CMDS" != *" $sub "* ]]; then
      # Allow "umdb run backfill", "umdb run export", etc.
      exec "$REPO_ROOT/bin/umdb" "$sub" "$@"
    fi
    harvester "$sub" "$@"
    ;;
  crawl|daily|backfill-year|curate-ai)
    harvester "$cmd" "$@"
    ;;
  backfill|deep-backfill)
    exec "$REPO_ROOT/scripts/deep_backfill.sh" "$@"
    ;;
  deepest)
    exec "$REPO_ROOT/scripts/deep_backfill.sh" --deepest "$@"
    ;;
  repair|repair-bioprojects)
    harvester repair-bioprojects "$@"
    ;;
  geo)
    harvester geo "$@"
    ;;
  scrub|scrub-secrets)
    harvester scrub-secrets "$@"
    ;;
  compact)
    yes=0; rest=()
    for a in "$@"; do
      case "$a" in -y|--yes) yes=1 ;; *) rest+=("$a") ;; esac
    done
    case " ${rest[*]:-} " in *" -h "*|*" --help "*) harvester compact "${rest[@]}" ;; esac
    if [ $yes -eq 0 ] && [ -n "$(git status --porcelain --untracked-files=no -- data 2>/dev/null)" ]; then
      echo "data/ has uncommitted changes; compaction rewrites catalog files permanently." >&2
      printf "Continue? [y/N] " >&2; read -r reply
      case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted." >&2; exit 1 ;; esac
    fi
    harvester compact ${rest[@]+"${rest[@]}"}
    ;;
  export|rebuild)
    harvester export "$@"
    ;;
  db)
    sub="${1:-info}"; [ $# -gt 0 ] && shift
    case "$sub" in
      build) harvester db-build "$@" ;;
      info) harvester db-info "$@" ;;
      shell)
        [ -f data/umdb.sqlite ] || { echo "data/umdb.sqlite not found; run: umdb db build" >&2; exit 1; }
        exec sqlite3 -header -column data/umdb.sqlite "$@" ;;
      query)
        [ -f data/umdb.sqlite ] || { echo "data/umdb.sqlite not found; run: umdb db build" >&2; exit 1; }
        [ $# -ge 1 ] || { echo 'usage: umdb db query "SELECT ..."' >&2; exit 2; }
        exec sqlite3 -header -separator $'\t' data/umdb.sqlite "$1" ;;
      *) echo "usage: umdb db build|info|shell|query \"SQL\"" >&2; exit 2 ;;
    esac
    ;;
  release)
    harvester release "$@"
    ;;
  catalog)
    harvester catalog "${@:-status}"
    ;;
  serve|preview)
    port="${1:-8000}"
    echo "Serving docs/ at http://localhost:$port  (Ctrl-C to stop)"
    exec "$PY" -m http.server "$port" --directory docs
    ;;
  queries)
    PYTHONPATH="$REPO_ROOT/scripts" exec "$PY" -c \
      "from umdb_harvester.config import QUERY_PROFILES as Q, QUERY_PROFILES_VERSION as V
print('QUERY_PROFILES_VERSION', V, end='\n\n')
for k, v in Q.items(): print(k, v, sep='\n', end='\n\n')"
    ;;
  status)
    PYTHONPATH="$REPO_ROOT/scripts" exec "$PY" -c "
import json, os
from umdb_harvester import config as c
s = json.load(open('docs/db/summary.json')) if os.path.exists('docs/db/summary.json') else {}
print('Published release :', s.get('generated_utc', 'none'))
print('Runs / BioSamples / BioProjects :', s.get('totalRuns'), '/', s.get('totalBioSamples'), '/', s.get('totalProjects'))
for t in s.get('eligibility', []) or []:
    print(f\"  {t['name']:16} {t['runs']:>8} runs {t['biosamples']:>8} BioSamples\")
if not s.get('eligibility'):
    print('  (no eligibility tiers in this release; run: umdb export)')
seen = sum(1 for _ in open(c.SEEN_SRR_RUNS)) if os.path.exists(c.SEEN_SRR_RUNS) else 0
print('Runs ingested (seen list) :', seen)
print('NCBI_API_KEY set :', bool(c.NCBI_API_KEY), '| NCBI_EMAIL set :', bool(c.NCBI_EMAIL), '| OPENAI_API_KEY set :', bool(c.OPENAI_API_KEY))
print('Query profiles version :', c.QUERY_PROFILES_VERSION)
"
    ;;
  test|tests)
    exec "$PY" -m unittest discover tests "$@"
    ;;
  science)
    command -v nextflow >/dev/null || { echo "nextflow not found: https://www.nextflow.io/docs/latest/install.html" >&2; exit 1; }
    if [ "${1:-}" = "test" ]; then
      shift
      exec nextflow run "$REPO_ROOT/pipeline" -profile test "$@"
    fi
    exec nextflow run "$REPO_ROOT/pipeline" "$@"
    ;;
  install)
    target="${1:-$HOME/.local/bin}"
    mkdir -p "$target"
    ln -sf "$REPO_ROOT/bin/umdb" "$target/umdb"
    echo "Linked $target/umdb -> $REPO_ROOT/bin/umdb"
    case ":$PATH:" in
      *":$target:"*) echo "Ready: run 'umdb help'." ;;
      *) echo "Add it to your PATH, e.g.:  echo 'export PATH=\"$target:\$PATH\"' >> ~/.zshrc && source ~/.zshrc" ;;
    esac
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "umdb: unknown command '$cmd'" >&2
    echo "Run 'umdb help' for the list of commands." >&2
    exit 2
    ;;
esac
