manifest {
    name            = 'umdb-science'
    description     = 'Hypothesis tests on the Urban Microbiome Database (catalog, reads, ecology)'
    homePage        = 'https://github.com/aglucaci/UMDB'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // ---- inputs
    db               = "${projectDir}/../data/umdb.sqlite"
    geonames_dir     = "${projectDir}/../data/reference/geonames"
    outdir           = 'results'
    publish_dir_mode = 'copy'
    hash_db          = true

    // ---- external covariates (versioned in covariates/covariates_manifest.json)
    worldbank        = null      // pre-fetched long TSV (iso3, year, indicator, value) for reproducibility
    fetch_worldbank  = false     // or fetch WDI indicators from api.worldbank.org at run time
    worldbank_years  = '2010:2024'
    openflights_dir  = null      // directory with airports.dat and routes.dat (enables H5)
    koppen_raster    = null      // Köppen–Geiger GeoTIFF (needs rasterio); otherwise latitude bands
    min_city_pop     = 100000

    // ---- what to run
    hypotheses       = 'all'     // or e.g. 'C1,C3,H1'
    run_catalog      = true
    labels           = null      // completed C8 labeling sheet

    // ---- cohort selection (Track B input)
    select_cohort          = true
    cohort                 = null     // a precomputed cohort_runs.tsv instead of selecting one
    cohort_assays          = 'WGS'
    cohort_target          = 15000
    cohort_min_bases       = 1e9
    cohort_max_per_cell    = 50
    cohort_max_per_project = 300

    // ---- reads (Track B)
    run_reads          = false
    max_cohort_samples = 0          // >0 limits runs fetched (pilots)
    max_downloads      = 8
    max_spots          = 10000000   // spots streamed per run with fastq-dump -X; 0 = whole run
    subsample_reads    = 5000000    // reads (pairs) per sample after QC
    drop_below_depth   = true
    taxonomy_tool      = 'sylph'    // 'sylph' (GTDB) or 'metaphlan'
    sylph_db           = null       // e.g. gtdb-r220-c200-dbv1.syldb
    sylph_tax_dir      = null       // sylph-tax metadata directory
    sylph_taxonomy     = 'GTDB_r220'
    metaphlan_db       = null
    metaphlan_index    = 'mpa_vJun23_CHOCOPhlAnSGB_202403'
    functional         = false
    humann_nucleotide_db = null
    humann_protein_db  = null
    amr                = true
    resfinder_db       = null       // directory with a KMA-indexed ResFinder database
    resfinder_prefix   = 'resfinder'
    viral              = false
    genomad_db         = null

    // ---- precomputed profiles (feature x BioSample TSV) instead of reads
    species          = null
    functions        = null
    arg              = null

    // ---- statistics
    permutations     = 999
    max_samples      = 3000
    seed             = 20261119
    fail_fast        = false

    // ---- resources
    max_cpus         = 16       // caps on any one task; override for your machine or cluster
    max_memory       = '64.GB'
    max_time         = '48.h'
}

process {
    cpus   = 1
    memory = '4.GB'
    time   = '4.h'
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: 'analysis'       { conda = "${projectDir}/envs/analysis.yml" }
    withLabel: 'process_low'    { cpus = 2;  memory = { 6.GB * task.attempt };  time = '4.h' }
    withLabel: 'process_medium' { cpus = 4;  memory = { 12.GB * task.attempt }; time = '12.h' }
    withLabel: 'process_high'   { cpus = 12; memory = { 48.GB * task.attempt }; time = '24.h' }
    withLabel: 'network'        { errorStrategy = 'retry'; maxRetries = 4 }
    // a failing test is reported (and listed as "not run") without stopping the others
    withName: 'HYPOTHESIS'      { errorStrategy = params.fail_fast ? 'terminate' : 'ignore' }
    withName: 'SYLPH_PROFILE'   { memory = { 32.GB * task.attempt } }
    withName: 'HUMANN'          { memory = { 64.GB * task.attempt }; time = '48.h' }
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
}

profiles {
    conda {
        conda.enabled  = true
        conda.useMamba = false
        conda.cacheDir = "${projectDir}/.conda"
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
        wave.enabled   = true          // builds containers from the conda specs (Seqera Wave)
        wave.strategy  = ['conda']
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        wave.enabled   = true
        wave.strategy  = ['conda']
        wave.freeze    = true
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = { task.label.contains('process_high') ? 'bigmem' : 'standard' }
        executor.queueSize = 200
    }
    test {
        params.db              = "${projectDir}/tests/data/umdb_fixture.sqlite"
        params.geonames_dir    = "${projectDir}/tests/data/geonames"
        params.worldbank       = "${projectDir}/tests/data/worldbank.tsv"
        params.openflights_dir = "${projectDir}/tests/data/openflights"
        params.species         = "${projectDir}/tests/data/species.tsv"
        params.functions       = "${projectDir}/tests/data/functions.tsv"
        params.arg             = "${projectDir}/tests/data/arg.tsv"
        params.permutations    = 199
        params.cohort_target   = 100
        params.hash_db         = false
        params.outdir          = 'results-test'
        process.resourceLimits = [cpus: 4, memory: 8.GB, time: 2.h]
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
